funcion pon con renglon y columna y tinta y letra
    llama_al_sistema con PON_CASILLA y renglon por 256 mas columna y tinta por 256 mas letra
fin

funcion en_437 con primero y segundo
    si primero es 194
        si segundo es 183
            devuelve 250
        si no si segundo es 191
            devuelve 168
        si no si segundo es 161
            devuelve 173
        fin
        devuelve 63
    fin
    si segundo es 161
        devuelve 160
    si no si segundo es 169
        devuelve 130
    si no si segundo es 173
        devuelve 161
    si no si segundo es 179
        devuelve 162
    si no si segundo es 186
        devuelve 163
    si no si segundo es 177
        devuelve 164
    si no si segundo es 145
        devuelve 165
    si no si segundo es 188
        devuelve 129
    si no si segundo es 137
        devuelve 144
    si no si segundo es 167
        devuelve 135
    fin
    devuelve 63
fin

funcion texto_en con renglon y columna y texto y tinta
    c es columna
    primero es 0
    para cada letra en texto
        si letra es 194 o letra es 195
            primero es letra
        si no si primero es mayor que 0
            si c es menor o igual que COLUMNAS
                pon con renglon y c y tinta y (en_437 con primero y letra)
            fin
            primero es 0
            c es c mas 1
        si no
            si c es menor o igual que COLUMNAS
                pon con renglon y c y tinta y letra
            fin
            c es c mas 1
        fin
    fin
    devuelve c
fin

funcion limpia_renglon con renglon
    para cada c desde 1 hasta COLUMNAS
        pon con renglon y c y GRIS y 32
    fin
fin

funcion minuscula con c
    si c es mayor o igual que 65 y c es menor o igual que 90
        devuelve c mas 32
    fin
    devuelve c
fin

funcion es_letra con c
    si c es mayor o igual que 97 y c es menor o igual que 122
        devuelve verdadero
    fin
    si c es mayor o igual que 65 y c es menor o igual que 90
        devuelve verdadero
    fin
    devuelve c es 95 o (c es mayor o igual que 128 y c es menor que 256)
fin

funcion es_cifra con c
    devuelve c es mayor o igual que 48 y c es menor o igual que 57
fin

funcion byte_de con i
    devuelve elemento i de fuente
fin

funcion trozo_es con ini y lar y texto
    si lar no es igual a largo de texto
        devuelve falso
    fin
    i es 1
    para cada letra en texto
        si (minuscula con (elemento ini mas i menos 1 de fuente)) no es igual a letra
            devuelve falso
        fin
        i es i mas 1
    fin
    devuelve verdadero
fin

funcion mismos con ini_a y lar_a y ini_b y lar_b
    si lar_a no es igual a lar_b o lar_a es 0
        devuelve falso
    fin
    i es 0
    mientras i es menor que lar_a
        si (minuscula con (elemento ini_a mas i de fuente)) no es igual a (minuscula con (elemento ini_b mas i de fuente))
            devuelve falso
        fin
        i es i mas 1
    fin
    devuelve verdadero
fin

funcion anota_fallo con antes y ini y lar y despues
    comparte hay_fallo y fallo_linea y fallo_antes y fallo_ini y fallo_lar y fallo_despues
    si hay_fallo
        devuelve nada
    fin
    hay_fallo es verdadero
    fallo_linea es linea_actual
    fallo_antes es antes
    fallo_ini es ini
    fallo_lar es lar
    fallo_despues es despues
fin

funcion falla_texto con texto
    anota_fallo con texto y 0 y 0 y ""
fin

funcion blando con antes y ini y lar y despues
    si estricta
        anota_fallo con antes y ini y lar y despues
    fin
fin

funcion trocea
    comparte ntok y linea_actual
    ntok es 0
    i es 1
    linea es 1
    mientras i es menor o igual que mide y no hay_fallo
        c es elemento i de fuente
        linea_actual es linea
        si ntok mas 2 es mayor que TOPE_TOKENS
            falla_texto con "El programa es demasiado largo para mí."
        si no si c es 32
            i es i mas 1
        si no si c es 35
            mientras i es menor o igual que mide y (elemento i de fuente) no es igual a 10
                i es i mas 1
            fin
        si no si c es 10
            mete_token con T_LINEA y i y 1 y linea y 0
            linea es linea mas 1
            i es i mas 1
        si no si c es 40
            mete_token con T_ABRE y i y 1 y linea y 0
            i es i mas 1
        si no si c es 41
            mete_token con T_CIERRA y i y 1 y linea y 0
            i es i mas 1
        si no si c es 34
            empieza es i mas 1
            i es i mas 1
            mientras i es menor o igual que mide y (elemento i de fuente) no es igual a 34 y (elemento i de fuente) no es igual a 10
                i es i mas 1
            fin
            si i es mayor que mide o (elemento i de fuente) es 10
                falla_texto con "Faltan las comillas del final."
            si no
                mete_token con T_TEXTO y empieza y i menos empieza y linea y 0
                i es i mas 1
            fin
        si no si es_cifra con c
            empieza es i
            cuanto es 0
            mientras i es menor o igual que mide y (es_cifra con (elemento i de fuente))
                cifra es (elemento i de fuente) menos 48
                si cuanto es mayor que cociente con (9223372036854775807 menos cifra) y 10
                    falla_texto con "Ese número no cabe en 64 bits."
                    cuanto es 0
                si no
                    cuanto es cuanto por 10 mas cifra
                fin
                i es i mas 1
            fin
            si i es menor o igual que mide y (elemento i de fuente) es 46
                falla_texto con "Aquí solo hay números enteros."
            fin
            si i es menor o igual que mide y (es_letra con (elemento i de fuente))
                falla_texto con "Un número no puede llevar letras pegadas."
            fin
            mete_token con T_NUM y empieza y i menos empieza y linea y cuanto
        si no si es_letra con c
            empieza es i
            mientras i es menor o igual que mide y ((es_letra con (elemento i de fuente)) o (es_cifra con (elemento i de fuente)))
                i es i mas 1
            fin
            mete_token con T_PAL y empieza y i menos empieza y linea y 0
        si no
            anota_fallo con "No sé qué es este signo: " y i y 1 y ". Fal no usa signos, solo palabras."
            i es i mas 1
        fin
    fin
    mete_token con T_LINEA y mide mas 1 y 0 y linea y 0
    mete_token con T_FIN y mide mas 1 y 0 y linea y 0
fin

funcion mete_token con clase y ini y lar y linea y valor
    comparte ntok
    ntok es ntok mas 1
    elemento ntok de tok_clase es clase
    elemento ntok de tok_ini es ini
    elemento ntok de tok_lar es lar
    elemento ntok de tok_linea es linea
    elemento ntok de tok_valor es valor
fin

funcion clase_de con j
    si j es mayor que ntok
        devuelve T_FIN
    fin
    devuelve elemento j de tok_clase
fin

funcion actual
    devuelve clase_de con k
fin

funcion avanza
    comparte k y linea_actual
    si k es menor que ntok
        k es k mas 1
    fin
    linea_actual es elemento k de tok_linea
fin

funcion pal_en con j y texto
    si (clase_de con j) no es igual a T_PAL
        devuelve falso
    fin
    devuelve trozo_es con (elemento j de tok_ini) y (elemento j de tok_lar) y texto
fin

funcion pal con texto
    devuelve pal_en con k y texto
fin

funcion come con texto
    si pal con texto
        avanza
        devuelve verdadero
    fin
    devuelve falso
fin

funcion exige con texto y mensaje
    si come con texto
        devuelve verdadero
    fin
    falla_texto con mensaje
    devuelve falso
fin

funcion fin_de_linea
    si actual es T_LINEA
        avanza
    si no si actual no es igual a T_FIN
        anota_fallo con "Sobra algo al final de la línea: " y (elemento k de tok_ini) y (elemento k de tok_lar) y "."
    fin
fin

funcion salta_vacias
    mientras actual es T_LINEA
        avanza
    fin
fin

funcion es_reservada con ini y lar
    si trozo_es con ini y lar y "si" o trozo_es con ini y lar y "no" o trozo_es con ini y lar y "mientras" o trozo_es con ini y lar y "repite"
        devuelve verdadero
    fin
    si trozo_es con ini y lar y "para" o trozo_es con ini y lar y "funcion" o trozo_es con ini y lar y "fin" o trozo_es con ini y lar y "devuelve"
        devuelve verdadero
    fin
    si trozo_es con ini y lar y "escribe" o trozo_es con ini y lar y "es" o trozo_es con ini y lar y "mas" o trozo_es con ini y lar y "menos"
        devuelve verdadero
    fin
    si trozo_es con ini y lar y "por" o trozo_es con ini y lar y "entre" o trozo_es con ini y lar y "resto" o trozo_es con ini y lar y "y"
        devuelve verdadero
    fin
    si trozo_es con ini y lar y "o" o trozo_es con ini y lar y "con" o trozo_es con ini y lar y "de" o trozo_es con ini y lar y "verdadero"
        devuelve verdadero
    fin
    si trozo_es con ini y lar y "falso" o trozo_es con ini y lar y "comparte" o trozo_es con ini y lar y "detente" o trozo_es con ini y lar y "continua"
        devuelve verdadero
    fin
    devuelve trozo_es con ini y lar y "nada" o trozo_es con ini y lar y "pregunta"
fin

funcion emite con b
    comparte donde
    si donde es menor que TOPE_CODIGO
        elemento donde mas 1 de codigo es b
    fin
    donde es donde mas 1
fin

funcion emite_dos con a y b
    emite con a
    emite con b
fin

funcion emite_tres con a y b y c
    emite con a
    emite con b
    emite con c
fin

funcion emite_cuatro con a y b y c y d
    emite_dos con a y b
    emite_dos con c y d
fin

funcion emite32 con n
    v es n
    si v es menor que 0
        v es v mas 4294967296
    fin
    repite 4 veces
        emite con v resto 256
        v es cociente con v y 256
    fin
fin

funcion emite64 con n
    v es n
    repite 8 veces
        b es v resto 256
        si b es menor que 0
            b es b mas 256
        fin
        emite con b
        v es cociente con (v menos b) y 256
    fin
fin

funcion parche32 con sitio y n
    v es n
    si v es menor que 0
        v es v mas 4294967296
    fin
    i es 1
    repite 4 veces
        si sitio mas i es menor o igual que TOPE_CODIGO
            elemento sitio mas i de codigo es v resto 256
        fin
        v es cociente con v y 256
        i es i mas 1
    fin
fin

funcion salta_a con destino
    emite con 233
    emite32 con destino menos (donde mas 4)
fin

funcion salta_adelante
    emite con 233
    p es donde
    emite32 con 0
    devuelve p
fin

funcion salta_si con cc
    emite_dos con 15 y cc
    p es donde
    emite32 con 0
    devuelve p
fin

funcion salta_si_a con cc y destino
    emite_dos con 15 y cc
    emite32 con destino menos (donde mas 4)
fin

funcion aterriza con p
    parche32 con p y donde menos (p mas 4)
fin

funcion llama_a con destino
    emite con 232
    emite32 con destino menos (donde mas 4)
fin

funcion sitio_de con p
