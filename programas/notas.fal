usa "../comun/cifrado.fal"

PIDE_TICS es 3
DUERME es 4
LEE_TECLA es 11
PIDE_VENTANA es 12
PON_CASILLA es 13
GUARDA es 14
LEE_GUARDADO es 15
PIDE_MEMORIA es 16
NEGADO es 0 menos 10
SIN_MEMORIA es 0 menos 11

TECLA_INTRO es 256
TECLA_BORRA es 257
TECLA_FIN es 261

COLUMNAS es 38
RENGLONES es 15
ARRIBA es 4
ABAJO es 13
ANCHO_NOTA es 36
CABEN es 360
CABECERA es 48
FIRMA es 32
BLOQUES_ARGON es 2040
PASADAS es 3

GRIS es 7
GRIS_OSCURO es 8
VERDE_CLARO es 10
CIAN_CLARO es 11
ROJO_CLARO es 12
AMARILLO es 14
BLANCO es 15

MESA es 807395328
TALLER es MESA mas 2048
DOBLE es 4294967296

archivo es region con MESA y 512
estado es region con MESA mas 512 y 16 y 8
trabajo es region con MESA mas 640 y 16 y 8
clave_chacha es region con MESA mas 768 y 8 y 8
flujo es region con MESA mas 832 y 64
escrito es region con MESA mas 1024 y CABEN
secreta es region con MESA mas 1536 y 32
repetida es region con MESA mas 1600 y 32
claves es region con MESA mas 1664 y 64
clave_firma es region con MESA mas 1696 y 32
mirada es region con MESA mas 1728 y 32
azar es region con MESA mas 1792 y 64
mezcla es region con MESA mas 2560 y 24

MARCA es "NOT2"

largo_nota es 0
largo_secreta es 0
semilla es 0
veces_azar es 0
memoria_clave es 0
fila_fin es ARRIBA
columna_fin es 0

funcion descansa con centesimas
    llama_al_sistema con DUERME y centesimas
fin

funcion pon con renglon y columna y tinta y letra
    llama_al_sistema con PON_CASILLA y renglon por 256 mas columna y tinta por 256 mas letra
fin

funcion en_437 con segundo
    si segundo es 161
        devuelve 160
    si no si segundo es 169
        devuelve 130
    si no si segundo es 173
        devuelve 161
    si no si segundo es 179
        devuelve 162
    si no si segundo es 186
        devuelve 163
    si no si segundo es 177
        devuelve 164
    fin
    devuelve 63
fin

funcion texto_en con renglon y columna y texto y tinta
    c es columna
    a_medias es falso
    para cada letra en texto
        si letra es 195
            a_medias es verdadero
        si no si a_medias
            pon con renglon y c y tinta y (en_437 con letra)
            a_medias es falso
            c es c mas 1
        si no
            pon con renglon y c y tinta y letra
            c es c mas 1
        fin
    fin
fin

funcion limpia_renglon con renglon
    para cada c desde 1 hasta COLUMNAS
        pon con renglon y c y GRIS y 32
    fin
fin

funcion aviso con texto y tinta
    limpia_renglon con RENGLONES
    texto_en con RENGLONES y 2 y texto y tinta
fin

funcion para_aqui
    mientras verdadero
        descansa con 100
    fin
fin

funcion cuarto con a y b y c y d
    elemento a de trabajo es suma_doble con (elemento a de trabajo) y (elemento b de trabajo)
    elemento d de trabajo es gira_doble con (o_exclusivo con (elemento d de trabajo) y (elemento a de trabajo)) y 16
    elemento c de trabajo es suma_doble con (elemento c de trabajo) y (elemento d de trabajo)
    elemento b de trabajo es gira_doble con (o_exclusivo con (elemento b de trabajo) y (elemento c de trabajo)) y 12
    elemento a de trabajo es suma_doble con (elemento a de trabajo) y (elemento b de trabajo)
    elemento d de trabajo es gira_doble con (o_exclusivo con (elemento d de trabajo) y (elemento a de trabajo)) y 8
    elemento c de trabajo es suma_doble con (elemento c de trabajo) y (elemento d de trabajo)
    elemento b de trabajo es gira_doble con (o_exclusivo con (elemento b de trabajo) y (elemento c de trabajo)) y 7
fin

funcion bloque_chacha con contador y n_uno y n_dos y n_tres
    elemento 1 de estado es 1634760805
    elemento 2 de estado es 857760878
    elemento 3 de estado es 2036477234
    elemento 4 de estado es 1797285236
    para cada i desde 1 hasta 8
        elemento 4 mas i de estado es elemento i de clave_chacha
    fin
    elemento 13 de estado es contador
    elemento 14 de estado es n_uno
    elemento 15 de estado es n_dos
    elemento 16 de estado es n_tres
    copia_region con trabajo y 1 y estado y 1 y 16
    repite 10 veces
        cuarto con 1 y 5 y 9 y 13
        cuarto con 2 y 6 y 10 y 14
        cuarto con 3 y 7 y 11 y 15
        cuarto con 4 y 8 y 12 y 16
        cuarto con 1 y 6 y 11 y 16
        cuarto con 2 y 7 y 12 y 13
        cuarto con 3 y 8 y 9 y 14
        cuarto con 4 y 5 y 10 y 15
    fin
    para cada i desde 1 hasta 16
        elemento i de trabajo es suma_doble con (elemento i de trabajo) y (elemento i de estado)
    fin
fin

funcion bloque_a_bytes
    para cada i desde 1 hasta 16
        queda es elemento i de trabajo
        para cada j desde 1 hasta 4
            elemento (i menos 1) por 4 mas j de flujo es queda resto 256
            queda es cociente con queda y 256
        fin
    fin
fin

funcion palabra_le con bytes y desde
    n es 0
    para cada j desde 1 hasta 4
        n es n por 256 mas elemento desde mas 4 menos j de bytes
    fin
    devuelve n
fin

funcion cifra con cuantos
    contador es 1
    hecho es 0
    n_uno es palabra_le con archivo y 21
    n_dos es palabra_le con archivo y 25
    n_tres es palabra_le con archivo y 29
    mientras hecho es menor que cuantos
        bloque_chacha con contador y n_uno y n_dos y n_tres
        bloque_a_bytes
        j es 1
        mientras j es menor o igual que 64 y hecho es menor que cuantos
            sitio es CABECERA mas hecho mas 1
            elemento sitio de archivo es o_exclusivo con (elemento sitio de archivo) y (elemento j de flujo)
            j es j mas 1
            hecho es hecho mas 1
        fin
        contador es contador mas 1
    fin
fin

funcion remueve con tecla
    comparte semilla
    semilla es o_exclusivo con (gira_doble con semilla y 5) y ((llama_al_sistema con PIDE_TICS) mas tecla) resto DOBLE
fin

funcion saca_azar
    comparte veces_azar
    veces_azar es veces_azar mas 1
    si hay_azar
        palabras es region con MESA mas 1792 y 8 y 8
        para cada i desde 1 hasta 8
            elemento i de palabras es azar_del_procesador
        fin
        devuelve nada
    fin
    trozos es region con MESA mas 2560 y 3 y 8
    elemento 1 de trozos es semilla
    elemento 2 de trozos es llama_al_sistema con PIDE_TICS
    elemento 3 de trozos es veces_azar
    blake2b con TALLER y azar y 64 y mezcla y azar y 64
fin

funcion coinciden con esperado y desde y visto y cuantos
    distinto es 0
    para cada i desde 1 hasta cuantos
        distinto es distinto mas o_exclusivo con (elemento desde mas i menos 1 de esperado) y (elemento i de visto)
    fin
    si distinto es 0
        devuelve verdadero
    fin
    devuelve falso
fin

funcion sin_azar
    si hay_azar
        devuelve falso
    fin
    devuelve verdadero
fin

funcion olvida_claves
    para cada i desde 1 hasta 64
        elemento i de claves es 0
    fin
    para cada i desde 1 hasta 8
        elemento i de clave_chacha es 0
    fin
fin

funcion deriva_claves
    sal es region con MESA mas 4 y 16
    argon2id con memoria_clave y BLOQUES_ARGON y PASADAS y (region con MESA mas 1536 y largo_secreta) y sal y claves
    para cada i desde 1 hasta 8
        elemento i de clave_chacha es palabra_le con claves y (i menos 1) por 4 mas 1
    fin
    para cada i desde 1 hasta 32
        elemento i de secreta es 0
        elemento i de repetida es 0
    fin
fin

funcion comprobante_en con destino
    blake2b con TALLER y "comprobante" y 11 y clave_firma y destino y 16
fin

funcion pide_contrasena con frase y destino
    limpia_renglon con 6
    limpia_renglon con 8
    texto_en con 6 y 3 y frase y BLANCO
    cuantas es 0
    pon con 8 y 3 y CIAN_CLARO y 95
    mientras verdadero
        tecla es llama_al_sistema con LEE_TECLA
        si tecla es 0
            descansa con 2
        si no
            remueve con tecla
            si tecla es TECLA_INTRO y cuantas es mayor que 0
                limpia_renglon con 8
                devuelve cuantas
            si no si tecla es TECLA_BORRA y cuantas es mayor que 0
                pon con 8 y 3 mas cuantas y GRIS y 32
                cuantas es cuantas menos 1
                elemento cuantas mas 1 de destino es 0
                pon con 8 y 3 mas cuantas y CIAN_CLARO y 95
            si no si tecla es mayor o igual que 32 y tecla es menor que 256 y cuantas es menor que 32
                cuantas es cuantas mas 1
                elemento cuantas de destino es tecla
                pon con 8 y 2 mas cuantas y AMARILLO y 42
                pon con 8 y 3 mas cuantas y CIAN_CLARO y 95
            fin
        fin
    fin
fin

funcion iguales_las_dos con cuantas y otras
    si cuantas no es igual a otras
        devuelve falso
    fin
    para cada i desde 1 hasta 32
        si (elemento i de secreta) no es igual a (elemento i de repetida)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion es_de_ahora con leidos
    si leidos es menor que CABECERA mas FIRMA o leidos es mayor que CABECERA mas CABEN mas FIRMA
        devuelve falso
    fin
    i es 1
    para cada letra en MARCA
        si (elemento i de archivo) no es igual a letra
            devuelve falso
        fin
        i es i mas 1
    fin
    devuelve verdadero
fin

funcion abre_las_guardadas con leidos
    comparte largo_secreta y largo_nota
    largo_nota es leidos menos CABECERA menos FIRMA
    mientras verdadero
        largo_secreta es pide_contrasena con "Tu contraseña:" y secreta
        aviso con "Calculando la clave..." y GRIS
        deriva_claves
        comprobante_en con mirada
        si coinciden con archivo y 33 y mirada y 16
            blake2b con TALLER y archivo y CABECERA mas largo_nota y clave_firma y mirada y FIRMA
            intacta es coinciden con archivo y CABECERA mas largo_nota mas 1 y mirada y FIRMA
            si intacta
                cifra con largo_nota
                si largo_nota es mayor que 0
                    copia_region con escrito y 1 y archivo y CABECERA mas 1 y largo_nota
                fin
                devuelve nada
            fin
            olvida_claves
            largo_nota es 0
            limpia_renglon con 6
            texto_en con 6 y 3 y "Alguien ha tocado esta nota." y ROJO_CLARO
            texto_en con 8 y 3 y "No la abro: la firma no cuadra." y GRIS
            aviso con "Tu contraseña está bien." y GRIS
            para_aqui
        fin
        olvida_claves
        aviso con "No es esa. Espera un poco." y ROJO_CLARO
        descansa con 100
    fin
fin

funcion elige_contrasena
    comparte largo_secreta
    mientras verdadero
        largo_secreta es pide_contrasena con "Elige una contraseña:" y secreta
        otras es pide_contrasena con "Repítela:" y repetida
        si iguales_las_dos con largo_secreta y otras
            i es 1
            para cada letra en MARCA
                elemento i de archivo es letra
                i es i mas 1
            fin
            saca_azar
            copia_region con archivo y 5 y azar y 1 y 16
            aviso con "Calculando la clave..." y GRIS
            deriva_claves
            devuelve nada
        fin
        aviso con "No son iguales. Otra vez." y ROJO_CLARO
        para cada i desde 1 hasta 32
            elemento i de secreta es 0
            elemento i de repetida es 0
        fin
    fin
fin

funcion mide_nota
    comparte fila_fin y columna_fin
    fila_fin es ARRIBA
    columna_fin es 0
    i es 1
    mientras i es menor o igual que largo_nota
        letra es elemento i de escrito
        si letra es 10
            fila_fin es fila_fin mas 1
            columna_fin es 0
        si no
            si columna_fin es ANCHO_NOTA
                fila_fin es fila_fin mas 1
                columna_fin es 0
            fin
            columna_fin es columna_fin mas 1
        fin
        i es i mas 1
    fin
fin

funcion siguiente_fila
    si columna_fin es ANCHO_NOTA
        devuelve fila_fin mas 1
    fin
    devuelve fila_fin
fin

funcion siguiente_columna
    si columna_fin es ANCHO_NOTA
        devuelve 1
    fin
    devuelve columna_fin mas 1
fin

funcion pon_cursor con tinta y letra
    fila es siguiente_fila
    si fila es menor o igual que ABAJO
        pon con fila y (siguiente_columna) mas 1 y tinta y letra
    fin
fin

funcion pinta_nota
    para cada renglon desde ARRIBA hasta ABAJO
        limpia_renglon con renglon
    fin
    fila es ARRIBA
    columna es 0
    i es 1
    mientras i es menor o igual que largo_nota
        letra es elemento i de escrito
        si letra es 10
            fila es fila mas 1
            columna es 0
        si no
            si columna es ANCHO_NOTA
                fila es fila mas 1
                columna es 0
            fin
            columna es columna mas 1
            pon con fila y columna mas 1 y BLANCO y letra
        fin
        i es i mas 1
    fin
    mide_nota
    pon_cursor con CIAN_CLARO y 95
fin

funcion escribe_letra con letra
    comparte largo_nota
    si largo_nota es mayor o igual que CABEN
        aviso con "No cabe más." y AMARILLO
        devuelve nada
    fin
    si letra es 10 y fila_fin es mayor o igual que ABAJO
        aviso con "No caben más renglones." y AMARILLO
        devuelve nada
    fin
    si letra no es igual a 10 y siguiente_fila es mayor que ABAJO
        aviso con "No caben más renglones." y AMARILLO
        devuelve nada
    fin
    pon_cursor con GRIS y 32
    largo_nota es largo_nota mas 1
    elemento largo_nota de escrito es letra
    si letra no es igual a 10
        pon con siguiente_fila y (siguiente_columna) mas 1 y BLANCO y letra
    fin
    mide_nota
    pon_cursor con CIAN_CLARO y 95
fin

funcion borra_letra
    comparte largo_nota
    si largo_nota es 0
        devuelve nada
    fin
    pon_cursor con GRIS y 32
    si (elemento largo_nota de escrito) no es igual a 10
        pon con fila_fin y columna_fin mas 1 y GRIS y 32
    fin
    largo_nota es largo_nota menos 1
    mide_nota
    pon_cursor con CIAN_CLARO y 95
fin

funcion guarda_nota
    saca_azar
    copia_region con archivo y 21 y azar y 1 y 12
    comprobante_en con mirada
    copia_region con archivo y 33 y mirada y 1 y 16
    si largo_nota es mayor que 0
        copia_region con archivo y CABECERA mas 1 y escrito y 1 y largo_nota
    fin
    cifra con largo_nota
    blake2b con TALLER y archivo y CABECERA mas largo_nota y clave_firma y mirada y FIRMA
    copia_region con archivo y CABECERA mas largo_nota mas 1 y mirada y 1 y FIRMA
    aviso con "Esperando permiso..." y GRIS
    respuesta es llama_al_sistema con GUARDA y 0 y CABECERA mas largo_nota mas FIRMA
    si respuesta es mayor que 0
        aviso con "Guardada, cifrada y firmada." y VERDE_CLARO
    si no si respuesta es NEGADO
        aviso con "No me dejas guardarla." y AMARILLO
    si no
        aviso con "No he podido guardarla." y ROJO_CLARO
    fin
fin

llama_al_sistema con PIDE_VENTANA y COLUMNAS y RENGLONES
texto_en con 1 y 2 y "NOTAS" y AMARILLO
texto_en con 1 y 13 y "cifradas y firmadas" y GRIS_OSCURO
para cada raya desde 1 hasta COLUMNAS
    pon con 2 y raya y GRIS_OSCURO y 196
fin
semilla es (llama_al_sistema con PIDE_TICS) resto DOBLE
memoria_clave es llama_al_sistema con PIDE_MEMORIA
si memoria_clave es SIN_MEMORIA
    aviso con "No hay memoria para la clave." y ROJO_CLARO
    para_aqui
fin
aviso con "Dame el teclado para escribir." y GRIS
lo_leido es llama_al_sistema con LEE_GUARDADO y 0 y 512
si es_de_ahora con lo_leido
    abre_las_guardadas con lo_leido
si no
    si lo_leido es mayor que 0
        texto_en con 10 y 3 y "La guardada es de antes del día 12." y AMARILLO
        texto_en con 11 y 3 y "Si guardas esta, la pisas." y GRIS
    fin
    si sin_azar
        texto_en con 12 y 3 y "Sin RDRAND: azar de tus teclas." y GRIS
    fin
    elige_contrasena
fin
pinta_nota
aviso con "Fin guarda. Nada sale sin cifrar." y GRIS
mientras verdadero
    pulsada es llama_al_sistema con LEE_TECLA
    si pulsada es 0
        descansa con 2
    si no si pulsada es TECLA_FIN
        guarda_nota
    si no si pulsada es TECLA_INTRO
        escribe_letra con 10
    si no si pulsada es TECLA_BORRA
        borra_letra
    si no si pulsada es mayor o igual que 32 y pulsada es menor que 256
        escribe_letra con pulsada
    fin
fin
