funcion busca_red
    comparte puerto_red y hay_red
    para cada ranura desde 0 hasta 31
        si (lee_pci con ranura y 0) es TARJETA_RED
            barra_pci es lee_pci con ranura y BAR_0
            si (barra_pci resto 2) es 1
                puerto_red es barra_pci menos barra_pci resto 4
                hay_red es verdadero
            fin
            devuelve nada
        fin
    fin
fin

