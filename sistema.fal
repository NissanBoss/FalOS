control es region con rejilla mas ANCHO por ALTO por 2 y 12 y 8
elemento DONDE_RATON_X de control es 0 menos 1
lo_que_se_ve es pantalla
pantalla es region con pide_pagina y ANCHO por ALTO y 2
copia_region con pantalla y 1 y lo_que_se_ve y 1 y ANCHO por ALTO
memoria_de_video es 0
PCI_DIRECCION es 3320
PCI_DATOS es 3324
PCI_ACTIVO es 2147483648
TARJETA_QEMU es 286331444
BAR_0 es 16
GRAFICOS_INDICE es 462
GRAFICOS_DATOS es 463
VERSION_MINIMA es 45248
VERSION_MAXIMA es 45253

funcion lee_pci con ranura y registro
    pon_doble con PCI_DIRECCION y PCI_ACTIVO mas ranura por 2048 mas registro
    devuelve lee_doble de PCI_DATOS
fin

CUADRO_ANCHO es 960
CUADRO_ALTO es 600
SIN_VIDEO es 0
VIDEO_QEMU es 1
VIDEO_DEL_CARGADOR es 2
VIDEO_ORIGEN es 5
VIDEO_PASO es 6
VIDEO_MODO es 7
VIDEO_COLORES es 8
VIDEO_INICIO es 9
VIDEO_FILAS es 10
TOPE_PAGINAS_VIDEO es 64
modo_video es SIN_VIDEO
video_paginas es 0
ancho_del_cargador es 0
tabla_video_primera es 0
tabla_video_ultima es 0

funcion tabla_de_video con k y primer_byte y final
    tabla es pide_pagina
    entradas es region con tabla y 512 y 8
    base es memoria_de_video mas k por DOS_MEGAS
    para cada i desde 1 hasta 512
        marco es base mas (i menos 1) por PAGINA
        si marco mas PAGINA es mayor que primer_byte y marco es menor que final
            elemento i de entradas es marco mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
        fin
    fin
    devuelve tabla
fin

funcion pon_video con cual y valor
    elemento cual de control es valor
fin

funcion busca_pantalla_del_cargador
    comparte memoria_de_video y video_paginas y ancho_del_cargador y tabla_video_primera y tabla_video_ultima
    si datos_de_arranque es 0
        devuelve falso
    fin
    si no (bit_de_arranque con 4096)
        devuelve falso
    fin
    info es region con datos_de_arranque y 30 y 4
    direccion es (elemento 23 de info) mas (elemento 24 de info) por 4294967296
    bytes_por_fila es elemento 25 de info
    pixeles_ancho es elemento 26 de info
    pixeles_alto es elemento 27 de info
    formato es elemento 28 de info
    si (formato resto 256) no es igual a 32 o ((cociente con formato y 256) resto 256) no es igual a 1
        devuelve falso
    fin
    si pixeles_ancho es menor que CUADRO_ANCHO o pixeles_alto es menor que CUADRO_ALTO o bytes_por_fila es menor que pixeles_ancho por 4
        devuelve falso
    fin
    desde_pagina es direccion resto DOS_MEGAS
    paginas es cociente con (desde_pagina mas bytes_por_fila por pixeles_alto mas DOS_MEGAS menos 1) y DOS_MEGAS
    si paginas es mayor que TOPE_PAGINAS_VIDEO o direccion es menor que MEGA
        devuelve falso
    fin
    memoria_de_video es direccion menos desde_pagina
    video_paginas es paginas
    final es direccion mas bytes_por_fila por pixeles_alto
    si desde_pagina no es igual a 0
        tabla_video_primera es tabla_de_video con 0 y direccion y final
    fin
    si memoria_de_video mas paginas por DOS_MEGAS menos final es mayor o igual que PAGINA
        si paginas es 1 y tabla_video_primera no es igual a 0
            tabla_video_ultima es tabla_video_primera
        si no
            tabla_video_ultima es tabla_de_video con (paginas menos 1) y direccion y final
        fin
    fin
    pon_video con VIDEO_INICIO y desde_pagina
    pon_video con VIDEO_ORIGEN y desde_pagina mas (cociente con (pixeles_alto menos CUADRO_ALTO) y 2) por bytes_por_fila mas (cociente con (pixeles_ancho menos CUADRO_ANCHO) y 2) por 4
    pon_video con VIDEO_PASO y cociente con bytes_por_fila y 4
    pon_video con VIDEO_FILAS y pixeles_alto
    ancho_del_cargador es pixeles_ancho
    si ((cociente con formato y 16777216) resto 256) es 0
        a_rojo es (elemento 29 de info) resto 256
        a_verde es (cociente con (elemento 29 de info) y 65536) resto 256
        a_azul es (elemento 30 de info) resto 256
    si no
        a_rojo es (cociente con formato y 65536) resto 256
        a_verde es (elemento 29 de info) resto 256
        a_azul es (cociente con (elemento 29 de info) y 65536) resto 256
    fin
    pon_video con VIDEO_COLORES y a_rojo por 65536 mas a_verde por 256 mas a_azul
    devuelve verdadero
fin

funcion busca_tarjeta_qemu
    comparte memoria_de_video y video_paginas
    pon_palabra con GRAFICOS_INDICE y 0
    version es lee_palabra de GRAFICOS_DATOS
    si version es menor que VERSION_MINIMA o version es mayor que VERSION_MAXIMA
        devuelve falso
    fin
    para cada ranura desde 0 hasta 31
        si (lee_pci con ranura y 0) es TARJETA_QEMU
            base es lee_pci con ranura y BAR_0
            memoria_de_video es base menos base resto 16
            si (base resto 8) es 0 y memoria_de_video es mayor que 0 y (memoria_de_video resto DOS_MEGAS) es 0
                video_paginas es 2
                pon_video con VIDEO_INICIO y 0
                pon_video con VIDEO_ORIGEN y 70 por CUADRO_ANCHO por 4
                pon_video con VIDEO_PASO y CUADRO_ANCHO
                pon_video con VIDEO_FILAS y CUADRO_ALTO mas 70
                pon_video con VIDEO_COLORES y 16 por 65536 mas 8 por 256
                devuelve verdadero
            fin
            devuelve falso
        fin
    fin
    devuelve falso
fin

funcion busca_graficos
    comparte hay_graficos y lo_que_se_ve y modo_video
    si busca_pantalla_del_cargador
        modo_video es VIDEO_DEL_CARGADOR
    si no si busca_tarjeta_qemu
        modo_video es VIDEO_QEMU
    si no
        devuelve nada
    fin
    pon_video con VIDEO_MODO y modo_video
    hay_graficos es verdadero
    lo_que_se_ve es region con rejilla y ANCHO por ALTO y 2
fin

busca_graficos

