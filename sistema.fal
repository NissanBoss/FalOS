funcion es_intel_conocida con quien
    si (quien resto 65536) no es igual a 32902
        devuelve falso
    fin
    cual es cociente con quien y 65536
    si cual es 4307 o cual es 5434 o cual es 5435 o cual es 5466 o cual es 5465
        devuelve verdadero
    fin
    devuelve cual es mayor o igual que 5536 y cual es menor o igual que 5539
fin

funcion busca_intel
    comparte red_ranura y red_parte y red_quien y red_de_pch
    para cada ranura desde 0 hasta 31
        para cada parte desde 0 hasta 7
            quien es lee_pci_en con 0 y ranura y parte y 0
            si es_intel_conocida con quien
                red_ranura es ranura
                red_parte es parte
                red_quien es quien
                red_de_pch es (cociente con quien y 65536) no es igual a 4307
                devuelve verdadero
            fin
        fin
    fin
    devuelve falso
fin

funcion mando_red con encendido
    si red_como es RED_ENCENDIDA o red_como es RED_SE_CAE
        mando_pci con red_ranura y red_parte y encendido
    fin
fin

funcion despierta_en_pci con ranura y parte
    si ((cociente con (lee_pci_en con 0 y ranura y parte y 4) y 1048576) resto 2) es 0
        devuelve nada
    fin
    sitio es (lee_pci_en con 0 y ranura y parte y 52) resto 256
    vueltas es 0
    mientras sitio es mayor o igual que 64 y vueltas es menor que 48
        sitio es sitio menos sitio resto 4
        visto es lee_pci_en con 0 y ranura y parte y sitio
        si (visto resto 256) es 1
            estado es lee_pci_en con 0 y ranura y parte y sitio mas 4
            si (estado resto 4) no es igual a 0
                pon_pci_en con ranura y parte y sitio mas 4 y (estado resto 32768) menos estado resto 4
                para cada pausa desde 1 hasta 20000
                    basura es lee_puerto de 128
                fin
            fin
            devuelve nada
        fin
        sitio es (cociente con visto y 256) resto 256
        vueltas es vueltas mas 1
    fin
fin

funcion permiso_de_hoja_red con k
    si k es 1
        devuelve 3
    si no si k es menor o igual que 1 mas HOJAS_PARA_RECIBIR
        devuelve 2
    fin
    devuelve 1
fin

funcion prepara_intel
    comparte red_como y hay_red y red_registros
    si hay_red
        devuelve nada
    fin
    si no busca_intel
        devuelve nada
    fin
    si no hay_iommu
        red_como es RED_SIN_IOMMU
        devuelve nada
    fin
    si no (la_cubre con 0 y red_ranura y red_parte)
        red_como es RED_SIN_CUBRIR
        devuelve nada
    fin
    red_como es RED_RARA
    despierta_en_pci con red_ranura y red_parte
    si no (mide_barra con red_ranura y red_parte)
        devuelve nada
    fin
    si barra_mide es menor que REGISTROS_RED
        devuelve nada
    fin
    red_registros es barra_en
    arriba es dominio_limpio con 0 y red_ranura y red_parte
    para cada k desde 1 hasta PAGINAS_RED
        hoja es pide_pagina
        elemento k de red_hojas es hoja
        mapea_para_aparato con arriba y CAJA_RED mas (REGISTROS_RED mas k menos 1) por PAGINA y hoja y (permiso_de_hoja_red con k)
    fin
    si iommu_olvida
        red_como es RED_ENCENDIDA
        hay_red es verdadero
    fin
fin

prepara_intel

funcion sin_parpadeo
    basura es lee_puerto de 986
    pon_en_puerto con 960 y 48
    ajustes es lee_puerto de 961
    si ((cociente con ajustes y 8) resto 2) es 1
        ajustes es ajustes menos 8
    fin
    pon_en_puerto con 960 y ajustes
fin

si no hay_graficos
    sin_parpadeo
fin

