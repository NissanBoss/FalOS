pantalla es region con 753664 y ANCHO por ALTO y 2

fila es 1
columna es 1
color es GRIS

a_medias es 0

funcion pon_color con letra y fondo
    comparte color
    color es fondo por 16 mas letra
fin

funcion ve_a con f y c
    comparte fila y columna
    fila es f
    columna es c
    mueve_cursor
fin

funcion limpia
    para cada i desde 1 hasta ANCHO por ABAJO
        elemento i de pantalla es color por 256 mas 32
    fin
    ve_a con 1 y 1
fin

funcion mueve_cursor
    sitio es (fila menos 1) por ANCHO mas columna menos 1
    pon_en_puerto con 980 y 15
    pon_en_puerto con 981 y (sitio resto 256)
    pon_en_puerto con 980 y 14
    pon_en_puerto con 981 y (cociente con sitio y 256)
fin

funcion pon_letra con codigo
    comparte columna
    si codigo es 10
        baja
    si no
        elemento (fila menos 1) por ANCHO mas columna de pantalla es color por 256 mas codigo
        columna es columna mas 1
        si columna es mayor que ANCHO
            baja
        fin
    fin
fin

funcion baja
    comparte fila y columna
    columna es 1
    fila es fila mas 1
    si fila es mayor que ABAJO
        sube_todo
        fila es ABAJO
    fin
fin

funcion sube_todo
    para cada i desde ANCHO mas 1 hasta ANCHO por (ABAJO menos 1)
        elemento i de pantalla es elemento i mas ANCHO de pantalla
    fin
    para cada i desde ANCHO por (ABAJO menos 1) mas 1 hasta ANCHO por ABAJO
        elemento i de pantalla es color por 256 mas 32
    fin
fin

funcion pon_byte con b
    comparte a_medias
    si a_medias no es igual a 0
        pon_letra con (en_437 con a_medias y b)
        a_medias es 0
    si no si b es mayor o igual que 192
        a_medias es b
    si no si b es menor que 128
        pon_letra con b
    fin
fin

funcion en_437 con primero y segundo
    si primero es 195
        si segundo es 161
            devuelve 160
        si no si segundo es 169
            devuelve 130
        si no si segundo es 173
            devuelve 161
        si no si segundo es 179
            devuelve 162
        si no si segundo es 186
            devuelve 163
        si no si segundo es 177
            devuelve 164
        si no si segundo es 145
            devuelve 165
        si no si segundo es 188
            devuelve 129
        si no si segundo es 156
            devuelve 154
        si no si segundo es 137
            devuelve 144
        si no si segundo es 129
            devuelve 65
        si no si segundo es 141
            devuelve 73
        si no si segundo es 147
            devuelve 79
        si no si segundo es 154
            devuelve 85
        fin
    si no si primero es 194
        si segundo es 191
            devuelve 168
        si no si segundo es 161
            devuelve 173
        si no si segundo es 186
            devuelve 167
        si no si segundo es 170
            devuelve 166
        si no si segundo es 171
            devuelve 174
        si no si segundo es 187
            devuelve 175
        fin
    fin
    devuelve 63
fin

funcion pinta con t
    para cada b en t
        pon_byte con b
    fin
    mueve_cursor
fin

funcion pinta_linea con t
    pinta con t
    pinta con "\n"
fin

funcion pinta_numero con n
    si n es menor que 0
        pinta con "-"
        cifras con n
    si no
        cifras con 0 menos n
    fin
    mueve_cursor
fin

funcion cifras con n
    si n es menor que menos 9
        cifras con (cociente con n y 10)
    fin
    pon_letra con 48 menos (n resto 10)
fin

funcion pinta_dos con n
    si n es menor que 10
        pinta con "0"
    fin
    pinta_numero con n
fin

funcion hasta_columna con n
    mientras columna es menor que n
        pon_letra con 32
    fin
fin

