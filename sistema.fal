fin

funcion ancho_de_ventana con t
    devuelve (elemento t de anchos) mas 2
fin

funcion alto_de_ventana con t
    devuelve (elemento t de altos) mas 2
fin

funcion saca_de_encima con t
    comparte puestas
    i es 1
    quedan es 0
    mientras i es menor o igual que puestas
        otra es elemento i de encima
        si otra no es igual a t
            quedan es quedan mas 1
            elemento quedan de encima es otra
        fin
        i es i mas 1
    fin
    puestas es quedan
fin

funcion sube_ventana con t
    comparte puestas
    saca_de_encima con t
    elemento puestas mas 1 de encima es t
    puestas es puestas mas 1
    ensucia
fin

funcion limpia_ventana con t
    texto es texto_de con t
    para cada i desde 1 hasta (elemento t de anchos) por (elemento t de altos)
        elemento i de texto es GRIS por 256 mas 32
    fin
    elemento t de columna_de es 1
    elemento t de fila_de_ventana es 1
    olvida_seleccion_de con t
fin

funcion abre_ventana con t
    elemento t de anchos es TEXTO_ANCHO
    elemento t de altos es TEXTO_ALTO
    limpia_ventana con t
    elemento t de ventana_x es ANCHO menos (ancho_de_ventana con t) menos (t menos 1) por 3 menos 1
    elemento t de ventana_y es 3 mas (t menos 1) por 4
    elemento t de ventana_de es VENTANA_VIVA
    sube_ventana con t
fin

funcion cambia_tamano con columnas y renglones
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si (elemento t de ventana_de) no es igual a VENTANA_VIVA
        devuelve rechaza_a_actual
    fin
    si columnas es menor que ANCHO_MINIMO o columnas es mayor que ANCHO_MAXIMO o renglones es menor que ALTO_MINIMO o renglones es mayor que ALTO_MAXIMO
        devuelve rechaza_a_actual
    fin
    elemento t de anchos es columnas
    elemento t de altos es renglones
    limpia_ventana con t
    elemento t de ventana_x es entre_limites con (elemento t de ventana_x) y 1 y (ANCHO menos columnas menos 1)
    elemento t de ventana_y es entre_limites con (elemento t de ventana_y) y 2 y (ALTO menos renglones menos 1)
    ensucia
    devuelve 0
fin

funcion pon_en_casilla con sitio y valor
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si (elemento t de ventana_de) no es igual a VENTANA_VIVA
        devuelve rechaza_a_actual
    fin
    si sitio es menor que 0 o sitio es mayor que 65535 o valor es menor que 0 o valor es mayor que 4095
        devuelve rechaza_a_actual
    fin
    renglon es cociente con sitio y 256
    c es sitio resto 256
    tinta es cociente con valor y 256
    letra es valor resto 256
    si renglon es menor que 1 o renglon es mayor que (elemento t de altos) o c es menor que 1 o c es mayor que (elemento t de anchos)
        devuelve rechaza_a_actual
    fin
    si tinta es 0 o letra es menor que 32
        devuelve rechaza_a_actual
    fin
    texto es texto_de con t
    elemento (casilla_de_texto con t y renglon y c) de texto es valor
    ensucia
    devuelve 0
fin

funcion acaba_ventana con t
    si (elemento t de ventana_de) es VENTANA_VIVA
        elemento t de ventana_de es VENTANA_ACABADA
        ensucia
    fin
fin

funcion quita_ventana con t
    comparte agarrada
    elemento t de ventana_de es SIN_VENTANA
    saca_de_encima con t
    si agarrada es t
        agarrada es 0
    fin
    olvida_seleccion_de con t
    ensucia
fin

funcion salto_en_ventana con t
    elemento t de columna_de es 1
    renglon es elemento t de fila_de_ventana
    columnas es elemento t de anchos
    renglones es elemento t de altos
    si renglon es menor que renglones
        elemento t de fila_de_ventana es renglon mas 1
    si no
        texto es texto_de con t
        copia_region con texto y 1 y texto y columnas mas 1 y columnas por (renglones menos 1)
        para cada c desde 1 hasta columnas
            elemento (renglones menos 1) por columnas mas c de texto es GRIS por 256 mas 32
        fin
        olvida_seleccion_de con t
    fin
    ensucia
fin

funcion pon_en_ventana con t y letra
    c es elemento t de columna_de
    si c es mayor que (elemento t de anchos)
        salto_en_ventana con t
        c es 1
    fin
    texto es texto_de con t
    elemento (casilla_de_texto con t y (elemento t de fila_de_ventana) y c) de texto es BLANCO por 256 mas letra
    elemento t de columna_de es c mas 1
    ensucia
fin

funcion letra_de_programa con b
    t es actual
    si es_controlador con t
        devuelve nada
    fin
    medias es elemento t de medias_de
    si b es 10
        salto_en_ventana con t
        elemento t de medias_de es 0
    si no si b es mayor o igual que 192
        elemento t de medias_de es b
    si no si medias no es igual a 0 o b es menor que 128 y b es mayor o igual que 32
        letra es b
        si medias no es igual a 0
            letra es en_437 con medias y b
            elemento t de medias_de es 0
        fin
        pon_en_ventana con t y letra
    fin
fin

funcion letra_de_la_consola con valor
    comparte columna y color
    si valor es menor que 0 o valor es mayor o igual que CRUDA por 2
        devuelve nada
    fin
    sin_traducir es valor es mayor o igual que CRUDA
    v es valor resto CRUDA
    b es v resto 256
    tinta es cociente con v y 256
    medias es elemento TAREA_CONSOLA de medias_de
    si b es 13
        columna es 1
        mueve_cursor
        devuelve nada
    fin
    letra es 0
    si sin_traducir
        si b es mayor o igual que 32
            letra es b
        fin
    si no si b es 10
        letra es 10
        elemento TAREA_CONSOLA de medias_de es 0
    si no si b es mayor o igual que 192
        elemento TAREA_CONSOLA de medias_de es b
    si no si medias no es igual a 0
        letra es en_437 con medias y b
        elemento TAREA_CONSOLA de medias_de es 0
    si no si b es mayor o igual que 32 y b es menor que 128
        letra es b
    fin
    si letra es 0
        devuelve nada
    fin
    si tinta es 0
        tinta es GRIS
    fin
    antes es color
    color es tinta
    pon_letra con letra
    color es antes
    mueve_cursor
fin

funcion pon_en_vista con renglon y c y valor
    si renglon es mayor o igual que 1 y renglon es menor o igual que ALTO y c es mayor o igual que 1 y c es menor o igual que ANCHO
        elemento (renglon menos 1) por ANCHO mas c de lo_que_se_ve es valor
    fin
fin

funcion pon_texto_en_vista con renglon y c y texto y tinta
    i es 1
    mientras i es menor o igual que largo de texto
        pon_en_vista con renglon y c mas i menos 1 y tinta mas (elemento i de texto)
        i es i mas 1
    fin
fin

funcion pinta_ventana con t
    estado es elemento t de ventana_de
    si estado es SIN_VENTANA
        devuelve nada
    fin
    vx es elemento t de ventana_x
    vy es elemento t de ventana_y
    va es ancho_de_ventana con t
    columnas es elemento t de anchos
    tinta es color_de con t
    si estado es VENTANA_ACABADA
        tinta es GRIS_OSCURO
    fin
    titulo es tinta por 16 por 256
    linea es tinta por 256
    para cada c desde 0 hasta va menos 1
        pon_en_vista con vy y vx mas c y titulo mas 32
    fin
    pon_en_vista con vy y vx mas 1 y titulo mas 48 mas t
    nombre es nombre_de con t
    cuantas es largo de nombre
    si cuantas es mayor que 16
        cuantas es 16
    fin
    i es 1
    mientras i es menor o igual que cuantas
        pon_en_vista con vy y vx mas 2 mas i y titulo mas (elemento i de nombre)
        i es i mas 1
    fin
    si estado es VENTANA_ACABADA
        pon_texto_en_vista con vy y vx mas 4 mas cuantas y "ya no corre" y titulo
    si no si foco es t y 4 mas cuantas mas 16 es menor que va menos 4
        pon_texto_en_vista con vy y vx mas 4 mas cuantas y "tiene el teclado" y titulo
    si no si foco es t
        pon_texto_en_vista con vy y vx mas 4 mas cuantas y "teclado" y titulo
    fin
    boton es (ROJO por 16 mas BLANCO) por 256
    pon_en_vista con vy y vx mas va menos 4 y boton mas 32
    pon_en_vista con vy y vx mas va menos 3 y boton mas 120
    pon_en_vista con vy y vx mas va menos 2 y boton mas 32
    texto es texto_de con t
    para cada renglon desde 1 hasta elemento t de altos
        pon_en_vista con vy mas renglon y vx y linea mas 179
        primera es (renglon menos 1) por columnas
        para cada c desde 1 hasta columnas
            pon_en_vista con vy mas renglon y vx mas c y (elemento primera mas c de texto)
        fin
        pon_en_vista con vy mas renglon y vx mas va menos 1 y linea mas 179
    fin
    pie es vy mas (alto_de_ventana con t) menos 1
    pon_en_vista con pie y vx y linea mas 192
    para cada c desde 1 hasta va menos 2
        pon_en_vista con pie y vx mas c y linea mas 196
    fin
    pon_en_vista con pie y vx mas va menos 1 y linea mas 217
fin

funcion dentro_de_ventana con t y renglon y c
    si (elemento t de ventana_de) es SIN_VENTANA
        devuelve falso
    fin
    vx es elemento t de ventana_x
    vy es elemento t de ventana_y
    va es ancho_de_ventana con t
    vh es alto_de_ventana con t
    devuelve c es mayor o igual que vx y c es menor que vx mas va y renglon es mayor o igual que vy y renglon es menor que vy mas vh
fin

funcion hay_pregunta
    para cada t desde 1 hasta MAX_TAREAS
        estado es elemento t de estados_tarea
        si estado es CON_EL_DISCO y (elemento t de permiso_disco) es DISCO_PEDIDO
            devuelve verdadero
        fin
        si estado es CON_LA_RED y (elemento t de permiso_red) es DISCO_PEDIDO
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion ventana_en con renglon y c
    si hay_pregunta
        devuelve 0
    fin
    i es puestas
    mientras i es mayor o igual que 1
        t es elemento i de encima
        si dentro_de_ventana con t y renglon y c
            devuelve t
        fin
        i es i menos 1
    fin
    devuelve 0
fin

funcion compone
    si bloqueado
        pinta_cerrojo
    si no
        copia_region con lo_que_se_ve y 1 y pantalla y 1 y ANCHO por ALTO
        i es 1
        mientras i es menor o igual que puestas y no hay_pregunta
            pinta_ventana con (elemento i de encima)
            i es i mas 1
        fin
        pinta_seleccion
        pinta_aviso_disco
        pinta_aviso_red
        pinta_aviso_pegado
        pinta_portapapeles
        pinta_invitado
        pinta_codigo_usb
    fin
    pinta_reloj
    sitio es cursor_sitio
    renglon es (cociente con sitio y ANCHO) mas 1
    c es (sitio resto ANCHO) mas 1
    si (ventana_en con renglon y c) no es igual a 0 o foco no es igual a CONSOLA o bloqueado
        sitio es ANCHO por ALTO
    fin
    si hay_graficos
        elemento CURSOR_EN de control es sitio
        si raton_visto
            elemento DONDE_RATON_X de control es raton_x
            elemento DONDE_RATON_Y de control es raton_y
        fin
        devuelve nada
    fin
    pon_en_puerto con 980 y 15
    pon_en_puerto con 981 y (sitio resto 256)
    pon_en_puerto con 980 y 14
    pon_en_puerto con 981 y (cociente con sitio y 256)
    si raton_visto
        casilla es (cociente con raton_y y LETRA_ALTO) por ANCHO mas (cociente con raton_x y LETRA_ANCHO) mas 1
        valor es elemento casilla de lo_que_se_ve
        atributo es cociente con valor y 256
        al_reves es (atributo resto 16) por 16 mas (cociente con atributo y 16)
        elemento casilla de lo_que_se_ve es al_reves por 256 mas (valor resto 256)
    fin
fin

funcion pon_frase_en_vista con renglon y c y texto y tinta
    sitio es c
    a_medias es 0
    para cada b en texto
        si b es 195
            a_medias es b
        si no
            letra es b
            si a_medias no es igual a 0
                letra es en_437 con a_medias y b
                a_medias es 0
            fin
            pon_en_vista con renglon y sitio y tinta mas letra
            sitio es sitio mas 1
        fin
    fin
fin

funcion pinta_cerrojo
    fondo es (NEGRO por 16 mas GRIS) por 256
    i es 1
    mientras i es menor o igual que ANCHO por ALTO
        elemento i de lo_que_se_ve es fondo mas 32
        i es i mas 1
    fin
    copia_region con lo_que_se_ve y 1 y pantalla y 1 y ANCHO
    pon_frase_en_vista con 9 y 31 y "FalOS está bloqueado" y (NEGRO por 16 mas BLANCO) por 256
    pon_frase_en_vista con 12 y 25 y "Contraseña:" y fondo
    i es 1
    mientras i es menor o igual que clave_mide
        pon_en_vista con 12 y 36 mas i y (NEGRO por 16 mas AMARILLO) por 256 mas 42
        i es i mas 1
    fin
    pon_en_vista con 12 y 37 mas clave_mide y (NEGRO por 16 mas CIAN_CLARO) por 256 mas 95
    pon_frase_en_vista con 16 y 18 y "Intro sin escribir nada: entrar como invitado." y (NEGRO por 16 mas MAGENTA_CLARO) por 256
    si mensaje_cerrojo es NO_ES_ESA
        pon_frase_en_vista con 14 y 37 y "No es esa." y (NEGRO por 16 mas ROJO_CLARO) por 256
    si no si mensaje_cerrojo es COMPROBANDO
        pon_frase_en_vista con 14 y 37 y "Comprobando..." y fondo
    fin
    si usb_con_codigo
        marca es (AMARILLO por 16 mas NEGRO) por 256
        pon_frase_en_vista con 21 y 20 y " Teclado USB nuevo: teclea en él " y marca
        pon_texto_en_vista con 21 y 53 y (region con usb_en mas 1024 y CIFRAS_USB) y marca
        pon_en_vista con 21 y 59 y marca mas 32
    fin
    pon_frase_en_vista con 18 y 12 y "Los programas siguen, pero no ven tus teclas ni tu ratón," y (NEGRO por 16 mas GRIS_OSCURO) por 256
    pon_frase_en_vista con 19 y 12 y "y lo que pintan no sale hasta que vuelvas." y (NEGRO por 16 mas GRIS_OSCURO) por 256
fin

funcion pinta_aviso_red
    marca es (AMARILLO por 16 mas NEGRO) por 256
    si usando_red
        pon_texto_en_vista con 1 y 24 y " ping a " y marca
        pon_texto_en_vista con 1 y 32 y (region con red_en mas 64 y ip_texto_mide) y marca
        pon_en_vista con 1 y 32 mas ip_texto_mide y marca mas 32
        devuelve nada
    fin
    si aviso_red_hasta es 0 o red_lo_usa es 0
        devuelve nada
    fin
    pon_en_vista con 1 y 24 y (color_de con red_lo_usa) por 16 por 256 mas 32
    pon_en_vista con 1 y 25 y marca mas 32
    nombre es nombre_de con red_lo_usa
    pon_texto_en_vista con 1 y 26 y nombre y marca
    sigue es 26 mas largo de nombre
    pon_texto_en_vista con 1 y sigue y " habla con " y marca
    pon_texto_en_vista con 1 y sigue mas 11 y (region con red_en mas 192 y aviso_ip_mide) y marca
    pon_en_vista con 1 y sigue mas 11 mas aviso_ip_mide y marca mas 32
fin

funcion pinta_invitado
    si no invitado
        devuelve nada
    fin
    pon_texto_en_vista con 1 y 50 y " invitado " y (MAGENTA_CLARO por 16 mas NEGRO) por 256
fin

funcion pinta_codigo_usb
    si no usb_con_codigo
        devuelve nada
    fin
    marca es (AMARILLO por 16 mas NEGRO) por 256
    pon_frase_en_vista con 1 y 24 y " USB nuevo: teclea en él " y marca
    pon_texto_en_vista con 1 y 49 y (region con usb_en mas 1024 y CIFRAS_USB) y marca
    pon_en_vista con 1 y 55 y marca mas 32
fin

funcion pinta_aviso_disco
    si aviso_disco_hasta es 0 o disco_lo_usa es 0
        devuelve nada
    fin
    marca es (AMARILLO por 16 mas NEGRO) por 256
    pon_en_vista con 1 y 24 y (color_de con disco_lo_usa) por 16 por 256 mas 32
    pon_en_vista con 1 y 25 y marca mas 32
    nombre es nombre_de con disco_lo_usa
    pon_texto_en_vista con 1 y 26 y nombre y marca
    si disco_fallaba
        pon_texto_en_vista con 1 y 26 mas largo de nombre y " no queda guardado " y marca
    si no si disco_guardaba y no (guarda_de_verdad)
        pon_texto_en_vista con 1 y 26 mas largo de nombre y " guarda en memoria " y marca
    si no si disco_guardaba y disco_en_memoria
        pon_texto_en_vista con 1 y 26 mas largo de nombre y " guarda en el pendrive " y marca
    si no si invitado o disco_en_memoria
        pon_texto_en_vista con 1 y 26 mas largo de nombre y " lee de la memoria " y marca
    si no si disco_guardaba
        pon_texto_en_vista con 1 y 26 mas largo de nombre y " escribe en el disco " y marca
    si no
        pon_texto_en_vista con 1 y 26 mas largo de nombre y " lee del disco " y marca
    fin
fin

funcion pinta_reloj
    tinta es (AZUL por 16 mas BLANCO) por 256
    minutos es cociente con segundos_del_dia y 60
    h es cociente con minutos y 60
    m es minutos resto 60
    pon_en_vista con 1 y 61 y tinta mas 48 mas (cociente con h y 10)
    pon_en_vista con 1 y 62 y tinta mas 48 mas (h resto 10)
    pon_en_vista con 1 y 63 y tinta mas 58
    pon_en_vista con 1 y 64 y tinta mas 48 mas (cociente con m y 10)
    pon_en_vista con 1 y 65 y tinta mas 48 mas (m resto 10)
    pon_texto_en_vista con 1 y 67 y "UTC" y tinta
fin

funcion pinta_seleccion
    si sel_de es 0
        devuelve nada
    fin
    desde es sel_ancla
    hasta es sel_punta
    si hasta es menor que desde
        desde es sel_punta
        hasta es sel_ancla
    fin
    dueno es 0
    columnas es ANCHO
    arriba es 0
    izquierda es 0
    si sel_de no es igual a CONSOLA
        si (elemento sel_de de ventana_de) es SIN_VENTANA
            devuelve nada
        fin
        dueno es sel_de
        columnas es elemento sel_de de anchos
        arriba es elemento sel_de de ventana_y
        izquierda es elemento sel_de de ventana_x
    fin
    k es desde
    mientras k es menor o igual que hasta
        renglon es arriba mas (cociente con k y columnas) mas 1
        c es izquierda mas (k resto columnas) mas 1
        si (ventana_en con renglon y c) es dueno
            casilla es (renglon menos 1) por ANCHO mas c
            valor es elemento casilla de lo_que_se_ve
            atributo es cociente con valor y 256
            al_reves es (atributo resto 16) por 16 mas (cociente con atributo y 16)
            elemento casilla de lo_que_se_ve es al_reves por 256 mas (valor resto 256)
        fin
        k es k mas 1
    fin
fin

funcion tinta_de_sitio con t
    si t es CONSOLA
        devuelve BLANCO
    fin
    devuelve color_de con t
fin

funcion nombre_de_sitio con t
    si t es CONSOLA
        devuelve "la consola"
    fin
    devuelve nombre_de con t
fin

funcion pinta_aviso_pegado
    si aviso_pegado_hasta es 0
        devuelve nada
    fin
    marca es (AMARILLO por 16 mas NEGRO) por 256
    pon_en_vista con 1 y 24 y (tinta_de_sitio con pegado_en) por 16 por 256 mas 32
    pon_texto_en_vista con 1 y 25 y " pegaste en " y marca
    nombre es nombre_de_sitio con pegado_en
    pon_texto_en_vista con 1 y 37 y nombre y marca
    pon_en_vista con 1 y 37 mas largo de nombre y marca mas 32
fin

funcion pinta_portapapeles
    si copiadas es 0
        devuelve nada
    fin
    quedan es entre_limites con (cociente con (borra_portapapeles_en menos tics mas 99) y TICS_POR_SEGUNDO) y 1 y 99
    marca es (CIAN_CLARO por 16 mas NEGRO) por 256
    pon_en_vista con 1 y 9 y copiado_tinta por 16 por 256 mas 32
    pon_texto_en_vista con 1 y 10 y " copiado " y marca
    pon_en_vista con 1 y 19 y marca mas 48 mas (cociente con quedan y 10)
    pon_en_vista con 1 y 20 y marca mas 48 mas (quedan resto 10)
    pon_texto_en_vista con 1 y 21 y " s " y marca
fin

funcion copia_seleccion
    comparte copiadas y copiado_tinta y copiado_mide y borra_portapapeles_en y no_cabia
    si sel_de es 0
        devuelve nada
    fin
    desde es sel_ancla
    hasta es sel_punta
    si hasta es menor que desde
        desde es sel_punta
        hasta es sel_ancla
    fin
    hoja es pantalla
    columnas es ANCHO
    si sel_de no es igual a CONSOLA
        hoja es texto_de con sel_de
        columnas es elemento sel_de de anchos
    fin
    n es 0
    ultima_letra es 0
    saltando es verdadero
    k es desde
    mientras k es menor o igual que hasta y n es menor que CUPO_PORTAPAPELES
        letra es (elemento k mas 1 de hoja) resto 256
        si letra es menor o igual que 32
            si no saltando
                n es n mas 1
                elemento n de portapapeles es 32
            fin
        si no
            n es n mas 1
            elemento n de portapapeles es letra
            ultima_letra es n
            saltando es falso
        fin
        si (k resto columnas) es columnas menos 1 y k es menor que hasta
            n es ultima_letra
            si n es mayor que 0
                n es n mas 1
                elemento n de portapapeles es 32
            fin
            saltando es verdadero
        fin
        k es k mas 1
    fin
    no_cabia es falso
    mientras k es menor o igual que hasta
        si ((elemento k mas 1 de hoja) resto 256) es mayor que 32
            no_cabia es verdadero
        fin
        k es k mas 1
    fin
    i es ultima_letra mas 1
    mientras i es menor o igual que CUPO_PORTAPAPELES
        elemento i de portapapeles es 0
        i es i mas 1
    fin
    nombre es nombre_de_sitio con sel_de
    copiado_tinta es tinta_de_sitio con sel_de
    copiado_mide es entre_limites con (largo de nombre) y 0 y 32
    i es 1
    mientras i es menor o igual que copiado_mide
        elemento i de copiado_nombre es elemento i de nombre
        i es i mas 1
    fin
    olvida_seleccion
    copiadas es ultima_letra
    si ultima_letra es 0
        borra_portapapeles_en es 0
        devuelve nada
    fin
    borra_portapapeles_en es tics mas PLAZO_PORTAPAPELES
    apunta con R_COPIASTE y nombre y copiado_tinta y copiadas
    escribe "portapapeles: copiaste " sin salto
    escribe copiadas sin salto
    escribe " de " sin salto
    al_serie con nombre
    escribe ""
    ensucia
fin

funcion pega
    comparte entra y aviso_pegado_hasta y pegado_en
    si copiadas es 0
        escribe "portapapeles: vacío al pegar"
        devuelve nada
    fin
    destino es foco
    n es 0
    si destino es CONSOLA
        sin_sitio es falso
        mientras n es menor que copiadas y no sin_sitio
            siguiente es (entra mas 1) resto CAPACIDAD
            si siguiente es sale
                sin_sitio es verdadero
            si no
                elemento entra mas 1 de llegadas es elemento n mas 1 de portapapeles
                entra es siguiente
                n es n mas 1
            fin
        fin
    si no si (elemento destino de ventana_de) es VENTANA_VIVA
        mientras n es menor que copiadas y (guarda_tecla_de con destino y (elemento n mas 1 de portapapeles)) es 0
            n es n mas 1
        fin
    si no
        devuelve nada
    fin
    pegado_en es destino
    aviso_pegado_hasta es tics mas AVISO_PEGADO
    apunta con R_PEGASTE y (nombre_de_sitio con destino) y (tinta_de_sitio con destino) y n
    escribe "portapapeles: pegaste " sin salto
    escribe n sin salto
    escribe " en " sin salto
    al_serie con (nombre_de_sitio con destino)
    escribe ""
    ensucia
fin

funcion vacia_portapapeles con por_que
    comparte copiadas y borra_portapapeles_en
    habia es copiadas
    i es 1
    mientras i es menor o igual que CUPO_PORTAPAPELES
        elemento i de portapapeles es 0
        i es i mas 1
    fin
    copiadas es 0
    borra_portapapeles_en es 0
    para cada j desde 1 hasta 32
        elemento j de copiado_nombre es 0
    fin
    si habia es 0
        devuelve nada
    fin
    si por_que es A_MANO
        apunta con R_VACIASTE y "FalOS" y BLANCO y habia
    si no
        apunta con R_SE_BORRO y "FalOS" y BLANCO y por_que
    fin
    escribe "portapapeles: borrado, " sin salto
    escribe habia sin salto
    escribe " letras a ceros"
    ensucia
fin

funcion ensena_portapapeles
    si copiadas es 0
        pinta_linea con "  El portapapeles está vacío."
    si no
        pinta con "  Hay "
        pinta_cuantos con copiadas
        si copiadas es 1
            pinta con " letra"
        si no
            pinta con " letras"
        fin
        pinta con " que copiaste de "
        pinta_de con (region con copiado_nombre_en y copiado_mide) y copiado_tinta
        pinta con ". Se borra solo en "
        pinta_cuantos con (entre_limites con (cociente con (borra_portapapeles_en menos tics mas 99) y TICS_POR_SEGUNDO) y 1 y 99)
        pinta_linea con " s."
        si no_cabia
            pinta_linea con "  Lo que marcaste no cabía: copié las 100 primeras."
        fin
        pinta_linea con "  No te enseño qué es: lo verás al pegarlo con Ctrl+V."
    fin
    pon_color con GRIS_OSCURO y NEGRO
    pinta_linea con "  Ningún programa lo puede leer ni cambiar. Solo le llega lo que"
    pinta_linea con "  tú pegas, en la ventana que tiene el teclado, y nunca pulsa Intro."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion cierra_desde_la_ventana con t
    quita_ventana con t
    estado es elemento t de estados_tarea
    si estado no es igual a SIN_USAR y estado no es igual a CERRADA
        cierra_tarea con t y LA_PARARON
    fin
fin

funcion pulsa_en con renglon y c
    comparte agarrada y agarre y foco
    t es ventana_en con renglon y c
    antes es foco
    foco es CONSOLA
    olvida_seleccion
    si t es 0
        si renglon es mayor que 1
            empieza_seleccion con CONSOLA y renglon y c
        fin
        devuelve nada
    fin
    vx es elemento t de ventana_x
    va es ancho_de_ventana con t
    si renglon es (elemento t de ventana_y) y c es mayor o igual que vx mas va menos 4 y c es menor o igual que vx mas va menos 2
        cierra_desde_la_ventana con t
        devuelve nada
    fin
    sube_ventana con t
    si (elemento t de ventana_de) es VENTANA_VIVA
        foco es t
        si antes no es igual a t
            apunta_de con R_TECLADO y t y 0
        fin
    fin
    si renglon es (elemento t de ventana_y)
        agarrada es t
        agarre es c menos vx
    si no si c es mayor que vx y c es menor que vx mas va menos 1 y renglon es menor que (elemento t de ventana_y) mas (alto_de_ventana con t) menos 1
        empieza_seleccion con t y renglon y c
    fin
fin

funcion sitio_en_seleccion con renglon y c
    si sel_de es CONSOLA
        r es entre_limites con renglon y 2 y ALTO
        k es entre_limites con c y 1 y ANCHO
        devuelve (r menos 1) por ANCHO mas k menos 1
    fin
    columnas es elemento sel_de de anchos
    r es entre_limites con renglon menos (elemento sel_de de ventana_y) y 1 y (elemento sel_de de altos)
    k es entre_limites con c menos (elemento sel_de de ventana_x) y 1 y columnas
    devuelve (r menos 1) por columnas mas k menos 1
fin

funcion empieza_seleccion con t y renglon y c
    comparte sel_de y sel_ancla y sel_punta y seleccionando
    sel_de es t
    sel_ancla es sitio_en_seleccion con renglon y c
    sel_punta es sel_ancla
    seleccionando es verdadero
fin

funcion olvida_seleccion
    comparte sel_de y seleccionando
    si sel_de no es igual a 0
        ensucia
    fin
    sel_de es 0
    seleccionando es falso
fin

funcion olvida_seleccion_de con t
    si sel_de es t
        olvida_seleccion
    fin
fin

funcion arrastra_a con renglon y c
    comparte agarrada
    t es agarrada
    si (elemento t de ventana_de) es SIN_VENTANA
        agarrada es 0
        devuelve nada
    fin
    elemento t de ventana_x es entre_limites con (c menos agarre) y 1 y (ANCHO menos (ancho_de_ventana con t) mas 1)
    elemento t de ventana_y es entre_limites con renglon y 2 y (ALTO menos (alto_de_ventana con t) mas 1)
fin

funcion recibe_raton con a y b
    comparte raton_x y raton_y y raton_visto y botones_antes y agarrada y ultima_actividad y sel_punta y sel_de y seleccionando
    si actual no es igual a TAREA_TECLADO
        devuelve rechaza_a_actual
    fin
    si a es menor que 0 o a es mayor que 511 o b es menor que 0 o b es mayor que 4095
        devuelve RECHAZADA
    fin
    dx es a menos 256
    dy es (cociente con b y 8) menos 256
    botones es b resto 8
    raton_x es entre_limites con (raton_x mas dx) y 0 y (EN_ANCHO menos 1)
    raton_y es entre_limites con (raton_y menos dy) y 0 y (EN_ALTO menos 1)
    raton_visto es verdadero
    ultima_actividad es tics
    si bloqueado
        devuelve 0
    fin
    renglon es (cociente con raton_y y LETRA_ALTO) mas 1
    c es (cociente con raton_x y LETRA_ANCHO) mas 1
    pulsado es (botones resto 2) es 1
    lo_estaba es (botones_antes resto 2) es 1
    botones_antes es botones
    si pulsado y no lo_estaba
        pulsa_en con renglon y c
    si no si pulsado y agarrada no es igual a 0
        arrastra_a con renglon y c
    si no si pulsado y seleccionando
        sel_punta es sitio_en_seleccion con renglon y c
    si no si no pulsado
        agarrada es 0
        si seleccionando
            seleccionando es falso
            si sel_punta es sel_ancla
                sel_de es 0
            fin
        fin
    fin
    ensucia
    devuelve 0
fin

funcion se_puede_correr con t
    si t es CONSOLA
        devuelve no esperando o entra no es igual a sale o hay_cerradas o hay_orden o hay_encargos o falta_codigo o disco_listo o red_lista o pen_listo o (despierta_consola_en no es igual a 0 y tics es mayor o igual que despierta_consola_en)
    fin
    si (elemento t de estados_tarea) es DORMIDA y tics es mayor o igual que elemento t de hora_de_despertar
        elemento t de estados_tarea es EN_MARCHA
    fin
    devuelve (elemento t de estados_tarea) es EN_MARCHA
fin

funcion elige_tarea
    t es actual
    para cada vuelta desde 1 hasta ULTIMA_TAREA
        t es (t resto ULTIMA_TAREA) mas 1
        si se_puede_correr con t
            devuelve t
        fin
    fin
    devuelve CONSOLA
fin

funcion abre_puertos_de con t
    elemento BYTE_TECLADO de puertos es CERRADOS
    elemento BYTE_DISCO de puertos es CERRADOS
    elemento BYTE_GRAFICOS de puertos es CERRADOS
    elemento BYTE_GRAFICOS_ALTO de puertos es CERRADOS
    si t es TAREA_TECLADO
        elemento BYTE_TECLADO de puertos es SOLO_EL_96
    si no si t es TAREA_DISCO y no disco_en_memoria
        elemento BYTE_DISCO de puertos es LOS_OCHO
    si no si t es TAREA_PANTALLA y modo_video es VIDEO_QEMU
        elemento BYTE_GRAFICOS de puertos es INDICE_Y_DATOS
        elemento BYTE_GRAFICOS_ALTO de puertos es EL_DE_DETRAS
    fin
    si puerto_red no es igual a 0
        para cada k desde 1 hasta 4
            si t es TAREA_RED
                elemento (cociente con puerto_red y 8) mas k de puertos es LOS_OCHO
            si no
                elemento (cociente con puerto_red y 8) mas k de puertos es CERRADOS
            fin
        fin
    fin
fin

funcion cambia_de_tarea
    comparte actual
    elemento actual de contextos es contexto
    siguiente es elige_tarea
    si siguiente no es igual a actual
        actual es siguiente
        abre_puertos_de con actual
        tablas_al_volver con (elemento actual de raices)
        si actual no es igual a CONSOLA
            pila_de_entrada con (elemento actual de pilas)
        fin
        pon_contexto con (elemento actual de contextos)
    fin
fin

funcion despierta_con con t y valor
    marco es region con (elemento t de contextos) y 20 y 8
    elemento EN_RAX de marco es valor
    elemento t de estados_tarea es EN_MARCHA
fin

funcion avisa_a con t y aviso
    si (elemento t de estados_tarea) es EN_ESPERA
        elemento t de paciencia_gastada es 0
        despierta_con con t y aviso
    si no si (elemento t de avisos) es mayor o igual que 0
        elemento t de avisos es aviso
    fin
fin

funcion cierra_tarea con t y causa
    comparte hay_cerradas y peticion_abierta y disco_listo y resultado_disco y foco y peticion_red y red_lista y resultado_red y pen_presente y peticion_pen y pen_listo y resultado_pen
    si foco es t
        foco es CONSOLA
        ensucia
    fin
    elemento t de causas es causa
    elemento t de estados_tarea es CERRADA
    elemento t de cerrada_en es tics
    hay_cerradas es verdadero
    si t es TAREA_DISCO y peticion_abierta
        peticion_abierta es falso
        resultado_disco es SIN_CONTROLADOR
        disco_listo es verdadero
    fin
    si t es TAREA_RED y peticion_red
        peticion_red es falso
        resultado_red es SIN_CONTROLADOR
        red_lista es verdadero
    fin
    si t es TAREA_USB
        pen_presente es falso
        si peticion_pen
            peticion_pen es falso
            resultado_pen es SIN_CONTROLADOR
            pen_listo es verdadero
        fin
    fin
    para cada otra desde 1 hasta MAX_TAREAS
        estado es elemento otra de estados_tarea
        si (elemento otra de atendiendo_a) es t
            elemento otra de atendiendo_a es 0
        fin
        si (estado es PREGUNTANDO o estado es ESPERA_RESPUESTA) y (elemento otra de hablando_con) es t
            despierta_con con otra y RECHAZADA
        fin
    fin
fin

funcion sitio_de_llave con t y llave
    devuelve (t menos 1) por LLAVES mas llave
fin

funcion sigue_viva con t
    estado es elemento t de estados_tarea
    devuelve estado no es igual a SIN_USAR y estado no es igual a CERRADA
fin

funcion abre_llave con t y llave
    si llave es menor que 1 o llave es mayor que LLAVES
        devuelve 0
    fin
    sitio es sitio_de_llave con t y llave
    destino es elemento sitio de llave_a
    si destino es 0
        devuelve 0
    fin
    si (elemento destino de generaciones) no es igual a (elemento sitio de llave_generacion)
        devuelve 0
    fin
    si no (sigue_viva con destino)
        devuelve 0
    fin
    devuelve destino
fin

funcion pregunta_a con llave y valor
    yo es actual
    destino es abre_llave con yo y llave
    si destino es 0 o destino es yo
        elemento yo de rechazos_de es (elemento yo de rechazos_de) mas 1
        devuelve nada
    fin
    elemento yo de mensajes_de es (elemento yo de mensajes_de) mas 1
    elemento yo de hablando_con es destino
    si (elemento destino de estados_tarea) es ESCUCHANDO
        elemento destino de atendiendo_a es yo
        elemento yo de estados_tarea es ESPERA_RESPUESTA
        despierta_con con destino y valor
    si no
        elemento yo de mensaje_de es valor
        elemento yo de estados_tarea es PREGUNTANDO
    fin
    cambia_de_tarea
fin

funcion escucha_mensaje
    yo es actual
    pendiente es elemento yo de atendiendo_a
    si pendiente no es igual a 0
        elemento yo de atendiendo_a es 0
        despierta_con con pendiente y RECHAZADA
    fin
    para cada otra desde 1 hasta MAX_TAREAS
        si (elemento otra de estados_tarea) es PREGUNTANDO y (elemento otra de hablando_con) es yo
            elemento otra de estados_tarea es ESPERA_RESPUESTA
            elemento yo de atendiendo_a es otra
            devuelve elemento otra de mensaje_de
        fin
    fin
    elemento yo de estados_tarea es ESCUCHANDO
    cambia_de_tarea
    devuelve 0
fin

funcion contesta_a con valor
    yo es actual
    quien es elemento yo de atendiendo_a
    si quien es 0
        devuelve RECHAZADA
    fin
    elemento yo de atendiendo_a es 0
    despierta_con con quien y valor
    devuelve 0
fin

funcion rechaza_a_actual
    elemento actual de rechazos_de es (elemento actual de rechazos_de) mas 1
    devuelve RECHAZADA
fin

funcion aguarda_aviso con respuesta
    comparte peticion_abierta y disco_listo y resultado_disco y tecla_sin_leer y raton_sin_leer y peticion_red y red_lista y resultado_red y peticion_pen y pen_listo y resultado_pen
    yo es actual
    si no (es_controlador con yo)
        devuelve rechaza_a_actual
    fin
    si yo es TAREA_DISCO y peticion_abierta y respuesta no es igual a SIN_RESPUESTA
        resultado_disco es respuesta
        peticion_abierta es falso
        disco_listo es verdadero
    fin
    si yo es TAREA_RED y peticion_red y respuesta no es igual a SIN_RESPUESTA
        resultado_red es respuesta
        peticion_red es falso
        red_lista es verdadero
    fin
    si yo es TAREA_USB y peticion_pen y respuesta no es igual a SIN_RESPUESTA
        resultado_pen es respuesta
        peticion_pen es falso
        pen_listo es verdadero
    fin
    aviso es elemento yo de avisos
    si aviso no es igual a 0
        elemento yo de avisos es 0
        elemento yo de paciencia_gastada es 0
        devuelve aviso
    fin
    si yo es TAREA_TECLADO
        tecla_sin_leer es falso
        raton_sin_leer es falso
        abre_entrada
    fin
    elemento yo de estados_tarea es EN_ESPERA
    cambia_de_tarea
    devuelve 0
fin

TOPE_DE_PUERTOS es 64
PEN_NADA es 0
PEN_NUEVO es 1
PEN_CERRADO es 2
PEN_ABIERTO es 3
PEN_ROTO es 4
PEN_OTRO es 5
PIDE_LEE es 100
PIDE_DISCO es 120
PIDE_ESCRIBE es 140
PIDE_ASIENTA es 160
HOJA_PENDRIVE es 24
MIDE_RANURA es 16384
MIDE_SOBRE es 512
MIDE_CARGA es 15872
MIDE_ENTRADA es 552
ENTRADAS_PENDRIVE es 28
MARCA_PENDRIVE es "FALPEN01"
PARA_EL_PENDRIVE es "pendrive:"
PLAZO_PENDRIVE es 6000
pen_copia es region con pen_zona y MIDE_RANURA
pen_sobre es region con pen_zona mas MIDE_RANURA y MIDE_RANURA
pen_lectura es region con pen_zona mas 2 por MIDE_RANURA y MIDE_RANURA
pen_apunte es region con pen_zona mas 3 por MIDE_RANURA y 1024
pen_primera es region con pen_zona mas 3 por MIDE_RANURA mas PAGINA y PAGINA
pen_firma es region con pen_zona mas 3 por MIDE_RANURA mas 2 por PAGINA y 32
pen_estado es PEN_NADA
pen_presente es falso
pen_veces es 0
pen_validada es 0
pen_puerto es 0
pen_seq es 0
pen_ranura es 1
pen_mejor es 0
pen_restaurando es falso
pen_debe es falso
peticion_pen es falso
pen_listo es falso
resultado_pen es 0

funcion recibe_pendrive con puerto y enchufado
    comparte pen_presente y pen_veces y pen_puerto y hay_encargos
    si actual no es igual a TAREA_USB
        devuelve rechaza_a_actual
    fin
    si puerto es menor que 1 o puerto es mayor que TOPE_DE_PUERTOS o enchufado es menor que 0 o enchufado es mayor que 1
        devuelve rechaza_a_actual
    fin
    pen_presente es enchufado es 1
    si pen_presente
        pen_veces es pen_veces mas 1
        pen_puerto es puerto
        si pen_debe
            hay_encargos es verdadero
        fin
    fin
    devuelve 0
fin

USB_NADA es 0
USB_ACEPTADO es 1
USB_ESPERA es 2
USB_IGNORADO es 3
USB_DE_ARRANQUE es 300
USB_ESTABLE es 1000
USB_CASTIGO es 3000
INTENTOS_USB es 3
CIFRAS_USB es 6
usb_en es pide_pagina
puertos_usb es region con usb_en y TOPE_DE_PUERTOS y 8
codigo_usb es region con usb_en mas 1024 y 16
escrito_usb es region con usb_en mas 1040 y 16
usb_desde es 0
usb_caidas es 0
usb_probando es 0
usb_con_codigo es falso
usb_llevan es 0
usb_fallos es 0
usb_castigo_hasta es 0
falta_codigo es falso
falta_en es 0
falta_leia es falso
falta_interrupcion es falso
probando_dma es falso

funcion olvida_puertos_usb
    comparte usb_probando y usb_con_codigo
    para cada p desde 1 hasta TOPE_DE_PUERTOS
        elemento p de puertos_usb es USB_NADA
    fin
    usb_probando es 0
    usb_con_codigo es falso
    ensucia
fin

funcion recibe_teclado con puerto y enchufado
    comparte usb_probando y usb_con_codigo y falta_codigo
    si actual no es igual a TAREA_USB
        devuelve rechaza_a_actual
    fin
    si puerto es menor que 1 o puerto es mayor que TOPE_DE_PUERTOS o enchufado es menor que 0 o enchufado es mayor que 1
        devuelve rechaza_a_actual
    fin
    si enchufado es 0
        elemento puerto de puertos_usb es USB_NADA
        si usb_probando es puerto
            usb_probando es 0
            usb_con_codigo es falso
            ensucia
        fin
        devuelve 0
    fin
    si (elemento puerto de puertos_usb) no es igual a USB_NADA
        devuelve 0
    fin
    bebe_del_reloj con 0
    si (elemento TAREA_USB de generaciones) es 1 y tics es menor que usb_desde mas USB_DE_ARRANQUE
        elemento puerto de puertos_usb es USB_ACEPTADO
        apunta con R_USB y "FalOS" y BLANCO y puerto
    si no
        elemento puerto de puertos_usb es USB_ESPERA
        apunta con R_USB_NUEVO y "FalOS" y BLANCO y puerto
        falta_codigo es verdadero
    fin
    devuelve 0
fin

funcion recibe_tecla_usb con tecla y puerto
    si puerto es menor que 1 o puerto es mayor que TOPE_DE_PUERTOS
        devuelve rechaza_a_actual
    fin
    si (elemento puerto de puertos_usb) es USB_ACEPTADO
        bebe_del_reloj con VALE_USB
        devuelve entra_tecla con tecla
    fin
    si (elemento puerto de puertos_usb) es USB_ESPERA y usb_probando es puerto y usb_con_codigo
        cifra_de_codigo con tecla
        devuelve 0
    fin
    devuelve RECHAZADA
fin

funcion cifra_de_codigo con tecla
    comparte usb_llevan y usb_probando y usb_con_codigo y usb_fallos y usb_castigo_hasta y falta_codigo
    si tecla es TECLA_BORRA y usb_llevan es mayor que 0
        usb_llevan es usb_llevan menos 1
    fin
    si tecla es menor que 48 o tecla es mayor que 57
        devuelve nada
    fin
    usb_llevan es usb_llevan mas 1
    elemento usb_llevan de escrito_usb es tecla
    si usb_llevan es menor que CIFRAS_USB
        devuelve nada
    fin
    acierta es verdadero
    para cada i desde 1 hasta CIFRAS_USB
        si (elemento i de escrito_usb) no es igual a (elemento i de codigo_usb)
            acierta es falso
        fin
    fin
    usb_llevan es 0
    usb_con_codigo es falso
    ensucia
    si acierta
        elemento usb_probando de puertos_usb es USB_ACEPTADO
        apunta con R_USB_BUENO y "FalOS" y BLANCO y usb_probando
        usb_probando es 0
        usb_fallos es 0
        devuelve nada
    fin
    usb_fallos es usb_fallos mas 1
    si usb_fallos es menor que INTENTOS_USB
        falta_codigo es verdadero
        devuelve nada
    fin
    elemento usb_probando de puertos_usb es USB_IGNORADO
    apunta con R_USB_MALO y "FalOS" y BLANCO y usb_probando
    usb_fallos es 0
    usb_probando es 0
    usb_castigo_hasta es tics mas USB_CASTIGO
fin

funcion hay_teclado_esperando
    para cada p desde 1 hasta TOPE_DE_PUERTOS
        si (elemento p de puertos_usb) es USB_ESPERA
            devuelve p
        fin
    fin
    devuelve 0
fin

funcion nuevo_codigo
    comparte falta_codigo y usb_probando y usb_con_codigo y usb_llevan
    desactiva_interrupciones
    falta_codigo es falso
    puerto es usb_probando
    si puerto es 0
        puerto es hay_teclado_esperando
    fin
    aplaza es puerto es 0 o usb_con_codigo o tics es menor que usb_castigo_hasta
    activa_interrupciones
    si aplaza
        devuelve nada
    fin
    saca_sal con escrito_usb y 1
    desactiva_interrupciones
    para cada i desde 1 hasta CIFRAS_USB
        elemento i de codigo_usb es 48 mas ((elemento i por 2 de escrito_usb) por 256 mas elemento i por 2 menos 1 de escrito_usb) resto 10
    fin
    si (elemento puerto de puertos_usb) es USB_ESPERA
        usb_probando es puerto
        usb_llevan es 0
        usb_con_codigo es verdadero
        ensucia
    fin
    activa_interrupciones
    al_serie con "usb: teclado nuevo en el puerto "
    escribe puerto sin salto
    escribe ", pide código"
fin

funcion de_quien_es_la_falta con aparato
    si usb_como es USB_LISTO y aparato es usb_ranura por 8 mas usb_parte
        devuelve TAREA_USB
    si no si red_como es RED_ENCENDIDA y aparato es red_ranura por 8 mas red_parte
        devuelve TAREA_RED
    fin
    devuelve 0
fin

funcion mira_faltas
    comparte falta_en y falta_leia y falta_interrupcion
    r es region con registros_iommu y 1024 y 4
    si ((elemento 14 de r) resto 4) es menor que 2
        devuelve nada
    fin
    de_quien es 0
    para cada i desde 0 hasta faltas_cuantas menos 1
        k es faltas_en mas i por 4
        arriba_falta es elemento k mas 3 de r
        si (cociente con arriba_falta y BIT_31) es 1
            suya es de_quien_es_la_falta con (elemento k mas 2 de r) resto 65536
            si suya no es igual a 0
                de_quien es suya
                falta_en es (elemento k de r) menos (elemento k de r) resto PAGINA mas (elemento k mas 1 de r) por 4294967296
                falta_leia es ((cociente con arriba_falta y BIT_30) resto 2) es 1
                falta_interrupcion es (arriba_falta resto 256) es mayor o igual que 32
            fin
            elemento k mas 3 de r es BIT_31
        fin
    fin
    elemento 14 de r es 1
    si de_quien es 0
        devuelve nada
    fin
    si de_quien es TAREA_RED
        mando_red con 0
    fin
    si sigue_viva con de_quien
        cierra_tarea con de_quien y TOCO_LO_AJENO
        apunta con R_USB_DMA y (nombre_de con de_quien) y AZUL_CLARO y 0
    fin
fin

funcion recibe_tecla con tecla y puerto
    si actual es TAREA_USB
        devuelve recibe_tecla_usb con tecla y puerto
    si no si actual no es igual a TAREA_TECLADO
        devuelve rechaza_a_actual
    fin
    devuelve entra_tecla con tecla
fin

funcion entra_tecla con tecla
    comparte entra y foco y ultima_actividad
    si tecla es menor que 1 o tecla es mayor que TECLA_PEGA
        devuelve RECHAZADA
    fin
    ultima_actividad es tics
    si tecla es TECLA_ESCAPE
        foco es CONSOLA
        ensucia
        devuelve 0
    fin
    si tecla es TECLA_COPIA
        si no bloqueado
            copia_seleccion
        fin
        devuelve 0
    fin
    si tecla es TECLA_PEGA
        si no bloqueado
            pega
        fin
        devuelve 0
    fin
    si foco no es igual a CONSOLA y no bloqueado
        devuelve guarda_tecla_de con foco y tecla
    fin
    si consola_libre y entra es sale
        devuelve da_a_la_consola con tecla
    fin
    siguiente es (entra mas 1) resto CAPACIDAD
    si siguiente es sale
        devuelve RECHAZADA
    fin
    elemento entra mas 1 de llegadas es tecla
    entra es siguiente
    devuelve 0
fin

funcion consola_libre
    devuelve modo_clave es SIN_CLAVE y no bloqueado y no hay_orden y (elemento TAREA_CONSOLA de estados_tarea) no es igual a CON_UNA_ORDEN
fin

funcion da_a_la_consola con tecla
    hecho es guarda_tecla_de con TAREA_CONSOLA y tecla
    avisa_a con TAREA_CONSOLA y AVISO_TECLA
    devuelve hecho
fin

funcion guarda_tecla_de con t y tecla
    sitio es elemento t de entran_de
    siguiente es (sitio mas 1) resto COLA_TECLAS
    si siguiente es (elemento t de salen_de)
        devuelve RECHAZADA
    fin
    pon_en_cola con t y sitio y tecla
    elemento t de entran_de es siguiente
    devuelve 0
fin

funcion tecla_de_cola con t y sitio
    si t es TAREA_CONSOLA
        devuelve elemento sitio mas 1 de teclas_consola
    fin
    devuelve elemento (t menos 1) por COLA_TECLAS mas sitio mas 1 de teclas_de
fin

funcion pon_en_cola con t y sitio y tecla
    si t es TAREA_CONSOLA
        elemento sitio mas 1 de teclas_consola es tecla
    si no
        elemento (t menos 1) por COLA_TECLAS mas sitio mas 1 de teclas_de es tecla
    fin
fin

funcion da_tecla
    t es actual
    si (es_controlador con t) y t no es igual a TAREA_CONSOLA
        devuelve rechaza_a_actual
    fin
    sitio es elemento t de salen_de
    si sitio es (elemento t de entran_de)
        devuelve 0
    fin
    tecla es tecla_de_cola con t y sitio
    elemento t de salen_de es (sitio mas 1) resto COLA_TECLAS
    elemento t de teclas_recibidas es (elemento t de teclas_recibidas) mas 1
    devuelve tecla
fin

funcion da_memoria
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si (elemento t de memoria_grande_de) no es igual a 0
        devuelve MEMORIA_GRANDE
    fin
    fisica es pide_dos_megas
    si fisica es 0
        devuelve SIN_MEMORIA
    fin
    elemento t de memoria_grande_de es fisica
    directorio es region con (elemento t de directorios) y 512 y 8
    elemento SITIO_GRANDE de directorio es fisica mas PRESENTE mas ESCRIBIBLE mas USUARIO mas GRANDE mas prohibe_ejecutar
    devuelve MEMORIA_GRANDE
fin

funcion encarga con pedido y desde y cuantos
    comparte hay_encargos
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si desde es menor que 0 o cuantos es menor que 1 o cuantos es mayor que TOPE_GUARDADO o desde es mayor que PAGINA menos cuantos
        devuelve RECHAZADA
    fin
    si pedido es GUARDA y cuantos es mayor que TOPE_CIFRABLE
        devuelve RECHAZADA
    fin
    elemento t de pedido_de es pedido
    elemento t de desde_de es desde
    elemento t de cuantos_de es cuantos
    elemento t de estados_tarea es CON_EL_DISCO
    hay_encargos es verdadero
    cambia_de_tarea
    devuelve 0
fin

funcion pide_red con desde y cuantos
    comparte hay_encargos
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si desde es menor que 0 o cuantos es menor que 7 o cuantos es mayor que 6 mas TOPE_DATOS_RED o desde es mayor que PAGINA menos cuantos
        devuelve rechaza_a_actual
    fin
    pedida es region con (elemento t de mesas) mas desde y cuantos
    ip es numero_de con pedida y 1 y 4
    puerto es numero_de con pedida y 5 y 2
    si puerto es 0 o (ip es 0 y puerto no es igual a 53)
        devuelve rechaza_a_actual
    fin
    elemento t de pedido_de es CONECTA
    elemento t de desde_de es desde
    elemento t de cuantos_de es cuantos
    elemento t de destino_de es ip por 65536 mas puerto
    elemento t de estados_tarea es CON_LA_RED
    hay_encargos es verdadero
    cambia_de_tarea
    devuelve 0
fin

funcion al_llamar
    marco es region con contexto y 20 y 8
    numero es elemento EN_RAX de marco
    a es elemento EN_RDI de marco
    elemento EN_RAX de marco es 0
    si numero es SALIR
        elemento actual de codigos es a
        cierra_tarea con actual y SALIO
        cambia_de_tarea
    si no si numero es MANDA_LETRA y actual es TAREA_CONSOLA
        letra_de_la_consola con a
    si no si numero es MANDA_LETRA
        si a es mayor o igual que 0 y a es menor que 256
            letra_de_programa con a
        fin
    si no si numero es CEDE
        si es_controlador con actual
            elemento actual de paciencia_gastada es 0
        fin
        cambia_de_tarea
    si no si numero es PIDE_TICS
        elemento EN_RAX de marco es tics
    si no si numero es DUERME y a es mayor o igual que 0 y a es menor que 100000
        elemento actual de hora_de_despertar es tics mas a
        elemento actual de estados_tarea es DORMIDA
        cambia_de_tarea
    si no si numero es HAZ_PREGUNTA
        elemento EN_RAX de marco es RECHAZADA
        pregunta_a con a y (elemento EN_RSI de marco)
    si no si numero es ESCUCHA
        elemento EN_RAX de marco es escucha_mensaje
    si no si numero es CONTESTA
        elemento EN_RAX de marco es contesta_a con a
    si no si numero es ESPERA_AVISO
        elemento EN_RAX de marco es aguarda_aviso con a
    si no si numero es ENTREGA_TECLA
        elemento EN_RAX de marco es recibe_tecla con a y (elemento EN_RSI de marco)
    si no si numero es ENTREGA_RATON
        elemento EN_RAX de marco es recibe_raton con a y (elemento EN_RSI de marco)
    si no si numero es LEE_TECLA
        elemento EN_RAX de marco es da_tecla
    si no si numero es PIDE_VENTANA
        elemento EN_RAX de marco es cambia_tamano con a y (elemento EN_RSI de marco)
    si no si numero es PON_CASILLA
        elemento EN_RAX de marco es pon_en_casilla con a y (elemento EN_RSI de marco)
    si no si numero es PIDE_MEMORIA
        elemento EN_RAX de marco es da_memoria
    si no si numero es GUARDA o numero es LEE_GUARDADO
        elemento EN_RAX de marco es encarga con numero y a y (elemento EN_RSI de marco)
    si no si numero es CONECTA
        elemento EN_RAX de marco es pide_red con a y (elemento EN_RSI de marco)
    si no si numero es AVISA_TECLADO
        elemento EN_RAX de marco es recibe_teclado con a y (elemento EN_RSI de marco)
    si no si numero es AVISA_PENDRIVE
        elemento EN_RAX de marco es recibe_pendrive con a y (elemento EN_RSI de marco)
    si no si numero es PIDE_ORDEN
        elemento EN_RAX de marco es recibe_orden con a y (elemento EN_RSI de marco)
    si no
        elemento EN_RAX de marco es rechaza_a_actual
    fin
fin

funcion al_fallar con numero y codigo y direccion
    marco es region con contexto y 20 y 8
    rip es elemento EN_RIP de marco
    elemento actual de codigos es codigo
    elemento actual de direcciones es direccion
    elemento actual de registro_rax es elemento EN_RAX de marco
    elemento actual de registro_rdx es elemento EN_RDX de marco
    elemento actual de instrucciones es 0
    fin_codigo es DONDE_VAN mas elemento actual de programa_tamano
    si rip es mayor o igual que DONDE_VAN y rip es menor que fin_codigo
        byte es region con rip y 1
        elemento actual de instrucciones es elemento 1 de byte
    fin
    cierra_tarea con actual y numero
    cambia_de_tarea
fin

funcion abre_entrada
    pon_en_puerto con CONTROLADOR_DATOS y TODAS_ABIERTAS
    pon_en_puerto con ESCLAVO_DATOS y ESCLAVO_ABIERTO
fin

funcion cierra_entrada
    pon_en_puerto con CONTROLADOR_DATOS y SIN_TECLADO
    pon_en_puerto con ESCLAVO_DATOS y ESCLAVO_CERRADO
fin

funcion bebe_del_reloj con cuanto_vale
    comparte sorbos y calidad_azar
    pon_en_puerto con RELOJ_ORDEN y 0
    byte_bajo es lee_puerto de RELOJ
    byte_alto es lee_puerto de RELOJ
    sorbos es sorbos mas 1
    calidad_azar es calidad_azar mas cuanto_vale
    elemento (sorbos resto CABEN_SORBOS) mas 1 de pozo es tics por 65536 mas byte_alto por 256 mas byte_bajo
fin

funcion al_pulsar
    comparte tecla_sin_leer
    tecla_sin_leer es verdadero
    bebe_del_reloj con VALE_INTERRUPCION
    cierra_entrada
    pon_en_puerto con CONTROLADOR y YA_ESTA
    avisa_a con TAREA_TECLADO y AVISO_TECLA
    cambia_de_tarea
fin

funcion al_mover
    comparte raton_sin_leer
    raton_sin_leer es verdadero
    bebe_del_reloj con VALE_INTERRUPCION
    cierra_entrada
    pon_en_puerto con ESCLAVO y YA_ESTA
    pon_en_puerto con CONTROLADOR y YA_ESTA
    avisa_a con TAREA_TECLADO y AVISO_RATON
    cambia_de_tarea
fin

funcion al_falso_del_esclavo
    pon_en_puerto con CONTROLADOR y YA_ESTA
fin

funcion puede_escribir_8042
    para cada vuelta desde 1 hasta 100000
        si ((lee_puerto de ESTADO_8042) resto 4) es menor que 2
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion hay_byte_8042
    para cada vuelta desde 1 hasta 100000
        si ((lee_puerto de ESTADO_8042) resto 2) es 1
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion orden_8042 con valor
    si puede_escribir_8042
        pon_en_puerto con ESTADO_8042 y valor
    fin
fin

funcion dato_8042 con valor
    si puede_escribir_8042
        pon_en_puerto con DATOS_8042 y valor
    fin
fin

funcion manda_al_raton con valor
    orden_8042 con 212
    dato_8042 con valor
    si hay_byte_8042
        devuelve (lee_puerto de DATOS_8042) es 250
    fin
    devuelve falso
fin

funcion prepara_raton
    comparte hay_raton y hay_8042
    hay_8042 es (lee_puerto de ESTADO_8042) no es igual a 255
    si no hay_8042
        devuelve nada
    fin
    repite 16 veces
        si ((lee_puerto de ESTADO_8042) resto 2) es 1
            basura es lee_puerto de DATOS_8042
        fin
    fin
    orden_8042 con 168
    orden_8042 con 32
    si no hay_byte_8042
        devuelve nada
    fin
    ajustes es lee_puerto de DATOS_8042
    si ((cociente con ajustes y 2) resto 2) es 0
        ajustes es ajustes mas 2
    fin
    si ((cociente con ajustes y 32) resto 2) es 1
        ajustes es ajustes menos 32
    fin
    orden_8042 con 96
    dato_8042 con ajustes
    por_defecto es manda_al_raton con 246
    activado es manda_al_raton con 244
    hay_raton es por_defecto y activado
fin

funcion vigila con t
    estado es elemento t de estados_tarea
    si estado es SIN_USAR o estado es CERRADA o estado es EN_ESPERA o estado es CON_UNA_ORDEN
        devuelve nada
    fin
    si estado es EN_MARCHA y t no es igual a actual
        devuelve nada
    fin
    elemento t de paciencia_gastada es (elemento t de paciencia_gastada) mas 1
    si (elemento t de paciencia_gastada) es mayor que PACIENCIA
        cierra_tarea con t y SE_COLGO
    fin
fin

funcion tic_del_usb
    comparte falta_codigo
    si (tics resto TICS_POR_SEGUNDO) es 0 y usb_probando es 0 y hay_teclado_esperando no es igual a 0
        falta_codigo es verdadero
    fin
    si (elemento TAREA_USB de avisos) es 0
        avisa_a con TAREA_USB y AVISO_TIC
    fin
fin

funcion al_tic
    comparte tics y tics_dormido y pantalla_sucia y aviso_disco_hasta y aviso_pegado_hasta y aviso_red_hasta
    tics es tics mas 1
    si (tics resto TICS_POR_SEGUNDO) es 0
        mira_el_reloj
    fin
    si aviso_disco_hasta no es igual a 0 y tics es mayor o igual que aviso_disco_hasta
        aviso_disco_hasta es 0
        pantalla_sucia es verdadero
    fin
    si aviso_pegado_hasta no es igual a 0 y tics es mayor o igual que aviso_pegado_hasta
        aviso_pegado_hasta es 0
        pantalla_sucia es verdadero
    fin
    si aviso_red_hasta no es igual a 0 y tics es mayor o igual que aviso_red_hasta y no usando_red y udp_tarea es 0
        aviso_red_hasta es 0
        pantalla_sucia es verdadero
    fin
    si borra_portapapeles_en no es igual a 0
        si tics es mayor o igual que borra_portapapeles_en
            vacia_portapapeles con POR_TIEMPO
        si no si (tics resto TICS_POR_SEGUNDO) es 0
            pantalla_sucia es verdadero
        fin
    fin
    elemento actual de tiempo_de es (elemento actual de tiempo_de) mas 1
    si actual es CONSOLA y esperando
        tics_dormido es tics_dormido mas 1
    fin
    si hay_cerrojo y no bloqueado y tics menos ultima_actividad es mayor o igual que PLAZO_BLOQUEO
        bloquea_ya con POR_QUIETO
    fin
    pon_en_puerto con CONTROLADOR y YA_ESTA
    vigila con TAREA_TECLADO
    vigila con TAREA_DISCO
    vigila con TAREA_PANTALLA
    vigila con TAREA_RED
    vigila con TAREA_CONSOLA
    vigila con TAREA_USB
    si hay_iommu y (tics resto 10) es 0 y no probando_dma
        mira_faltas
    fin
    si usb_como es USB_LISTO
        tic_del_usb
    fin
    si pantalla_sucia y no hay_graficos
        pantalla_sucia es falso
        compone
    si no si pantalla_sucia y (elemento TAREA_PANTALLA de avisos) es 0
        pantalla_sucia es falso
        compone
        avisa_a con TAREA_PANTALLA y AVISO_PINTA
    fin
    cambia_de_tarea
fin

funcion siguiente_tecla
    comparte sale y esperando
    desactiva_interrupciones
    mientras sale es entra o hay_orden
        si hay_cerradas
            activa_interrupciones
            recoge_tareas con verdadero
        si no si hay_orden
            activa_interrupciones
            haz_la_orden
        si no si hay_encargos
            activa_interrupciones
            atiende_encargos
        si no si falta_codigo
            activa_interrupciones
            nuevo_codigo
        si no
            esperando es verdadero
            espera_interrupcion
            esperando es falso
        fin
        desactiva_interrupciones
    fin
    codigo es elemento sale mas 1 de llegadas
    sale es (sale mas 1) resto CAPACIDAD
    activa_interrupciones
    devuelve codigo
fin

funcion atiende con tecla
    si modo_clave no es igual a SIN_CLAVE
        atiende_clave con tecla
    si no
        desactiva_interrupciones
        da_a_la_consola con tecla
        activa_interrupciones
    fin
fin

funcion prepara_interrupciones
    pon_en_puerto con CONTROLADOR y 17
    pon_en_puerto con ESCLAVO y 17
    pon_en_puerto con CONTROLADOR_DATOS y 32
    pon_en_puerto con ESCLAVO_DATOS y 40
    pon_en_puerto con CONTROLADOR_DATOS y 4
    pon_en_puerto con ESCLAVO_DATOS y 2
    pon_en_puerto con CONTROLADOR_DATOS y 1
    pon_en_puerto con ESCLAVO_DATOS y 1
    abre_entrada
    divisor es cociente con 1193182 y TICS_POR_SEGUNDO
    pon_en_puerto con RELOJ_ORDEN y 54
    pon_en_puerto con RELOJ y (divisor resto 256)
    pon_en_puerto con RELOJ y (cociente con divisor y 256)
    atiende_interrupcion con 32 y al_tic
    atiende_interrupcion con 33 y al_pulsar
    atiende_interrupcion con 44 y al_mover
    atiende_interrupcion con 47 y al_falso_del_esclavo
    atiende_llamadas con al_llamar
    atiende_fallos con al_fallar
    activa_interrupciones
fin

funcion minuscula con c
    si c es mayor o igual que 65 y c es menor o igual que 90
        devuelve c mas 32
    fin
    devuelve c
fin

funcion resto_es con primera y nombre
    si escritas menos primera mas 1 no es igual a largo de nombre
        devuelve falso
    fin
    para cada i desde 1 hasta largo de nombre
        si (minuscula con (elemento primera mas i menos 1 de orden)) no es igual a (elemento i de nombre)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion recibe_orden con codigo y cuantos
    comparte hay_orden y orden_pedida y escritas
    t es actual
    si t no es igual a TAREA_CONSOLA
        devuelve rechaza_a_actual
    fin
    si codigo es menor que 1 o codigo es mayor que O_BORRA_PENDRIVE o cuantos es menor que 0 o cuantos es mayor que LARGO_ORDEN
        devuelve rechaza_a_actual
    fin
    mesa es region con (elemento t de mesas) y LARGO_ORDEN
    i es 1
    mientras i es menor o igual que cuantos
        si (elemento i de mesa) es menor que 32
            devuelve rechaza_a_actual
        fin
        elemento i de orden es elemento i de mesa
        i es i mas 1
    fin
    escritas es cuantos
    orden_pedida es codigo
    hay_orden es verdadero
    devuelve_teclas_de_la_consola
    elemento t de estados_tarea es CON_UNA_ORDEN
    elemento t de paciencia_gastada es 0
    cambia_de_tarea
    devuelve 0
fin

funcion devuelve_teclas_de_la_consola
    comparte sale
    t es TAREA_CONSOLA
    mientras (elemento t de entran_de) no es igual a (elemento t de salen_de)
        ultimo es ((elemento t de entran_de) mas COLA_TECLAS menos 1) resto COLA_TECLAS
        elemento t de entran_de es ultimo
        antes es (sale mas CAPACIDAD menos 1) resto CAPACIDAD
        si antes no es igual a entra
            elemento antes mas 1 de llegadas es tecla_de_cola con t y ultimo
            sale es antes
        fin
    fin
fin

funcion haz_la_orden
    comparte hay_orden
    hay_orden es falso
    codigo es orden_pedida
    si codigo es O_LIMPIA
        limpia
        barra
        ve_a con 3 y 1
    si no si codigo es O_HORA
        hora
    si no si codigo es O_COLORES
        colores
    si no si codigo es O_ENCENDIDO
        encendido
    si no si codigo es O_MEMORIA
        memoria
    si no si codigo es O_PROGRAMAS
        programas
    si no si codigo es O_TAREAS
        tareas
    si no si codigo es O_PERMISOS
        permisos
    si no si codigo es O_REGISTRO
        ensena_registro
    si no si codigo es O_PERMITE
        permite
    si no si codigo es O_PROHIBE
        prohibe
    si no si codigo es O_TECLADO
        da_el_teclado
    si no si codigo es O_LANZA
        lanza
    si no si codigo es O_PARA
        para_tarea
    si no si codigo es O_DISCO
        orden_disco
    si no si codigo es O_LEE
        lee_archivo
    si no si codigo es O_PORTAPAPELES
        ensena_portapapeles
    si no si codigo es O_OLVIDA_PORTAPAPELES
        vacia_portapapeles con A_MANO
        pinta_linea con "  Borrado: donde estaba solo quedan ceros."
        pinta_linea con ""
    si no si codigo es O_OLVIDA
        olvida
    si no si codigo es O_DEJA_SIEMPRE
        decide_guardar con 1 y DISCO_SI y verdadero
    si no si codigo es O_DEJA
        decide_guardar con 1 y DISCO_SI y falso
    si no si codigo es O_NIEGA
        decide_guardar con 1 y DISCO_NO y falso
    si no si codigo es O_CUELGA
        estropea con 1 y AVISO_CUELGA
    si no si codigo es O_ROMPE
        estropea con 1 y AVISO_ROMPE
    si no si codigo es O_REINICIA
        reinicia
    si no si codigo es O_CERROJO
        pon_cerrojo
    si no si codigo es O_BLOQUEA
        orden_bloquea
    si no si codigo es O_SIN_CERROJO
        quita_cerrojo
    si no si codigo es O_INVITADO
        orden_invitado
    si no si codigo es O_PING y escritas es 0
        orden_ping con 0
    si no si codigo es O_PING
        orden_ping con 1
    si no si codigo es O_RED
        orden_red
    si no si codigo es O_TABLAS
        orden_tablas
    si no si codigo es O_DMA
        orden_dma
    si no si codigo es O_USB
        orden_usb
    si no si codigo es O_PENDRIVE
        orden_pendrive
    si no si codigo es O_BORRA_PENDRIVE
        borra_pendrive
    fin
    vuelve_la_consola
fin

funcion vuelve_la_consola
    comparte consola_olvida
    si modo_clave no es igual a SIN_CLAVE
        devuelve nada
    fin
    si (elemento TAREA_CONSOLA de estados_tarea) es CON_UNA_ORDEN y columna no es igual a 1
        pinta con "\n"
    fin
    desactiva_interrupciones
    si (elemento TAREA_CONSOLA de estados_tarea) es CON_UNA_ORDEN y consola_olvida
        despierta_con con TAREA_CONSOLA y OLVIDA_TODO
    si no si (elemento TAREA_CONSOLA de estados_tarea) es CON_UNA_ORDEN
        despierta_con con TAREA_CONSOLA y 0
    si no
        si consola_olvida
            guarda_tecla_de con TAREA_CONSOLA y TECLA_OLVIDA
        fin
        guarda_tecla_de con TAREA_CONSOLA y TECLA_REPINTA
        avisa_a con TAREA_CONSOLA y AVISO_TECLA
    fin
    consola_olvida es falso
    activa_interrupciones
fin

funcion lee_cmos con registro
    pon_en_puerto con 112 y registro
    devuelve lee_puerto de 113
fin

funcion del_reloj con registro
    v es lee_cmos con registro
    si ((lee_cmos con 11) resto 8) es mayor o igual que 4
        devuelve v
    fin
    devuelve (cociente con v y 16) por 10 mas (v resto 16)
fin

funcion mira_el_reloj
    comparte segundos_del_dia y pantalla_sucia
    si (lee_cmos con 10) es mayor o igual que 128
        devuelve nada
    fin
    antes es cociente con segundos_del_dia y 60
    segundos_del_dia es ((del_reloj con 4) por 60 mas (del_reloj con 2)) por 60 mas (del_reloj con 0)
    si (cociente con segundos_del_dia y 60) no es igual a antes
        pantalla_sucia es verdadero
    fin
fin

funcion pinta_hora con s
    pinta_dos con (cociente con s y 3600)
    pinta con ":"
    pinta_dos con ((cociente con s y 60) resto 60)
    pinta con ":"
    pinta_dos con (s resto 60)
fin

funcion hora
    pinta con "  Son las "
    pon_color con BLANCO y NEGRO
    pinta_hora con segundos_del_dia
    pon_color con GRIS y NEGRO
    pinta_linea con " en UTC."
    pinta_linea con ""
fin

funcion nombre_color con c
    si c es 0
        devuelve "negro"
    si no si c es 1
        devuelve "azul"
    si no si c es 2
        devuelve "verde"
    si no si c es 3
        devuelve "cian"
    si no si c es 4
        devuelve "rojo"
    si no si c es 5
        devuelve "magenta"
    si no si c es 6
        devuelve "marrón"
    si no si c es 7
        devuelve "gris"
    si no si c es 8
        devuelve "gris oscuro"
    si no si c es 9
        devuelve "azul claro"
    si no si c es 10
        devuelve "verde claro"
    si no si c es 11
        devuelve "cian claro"
    si no si c es 12
        devuelve "rojo claro"
    si no si c es 13
        devuelve "magenta claro"
    si no si c es 14
        devuelve "amarillo"
    fin
    devuelve "blanco"
fin

funcion muestra_color con c
    pon_color con c y NEGRO
    pon_letra con 219
    pon_letra con 219
    pon_letra con 219
    pon_color con GRIS y NEGRO
    pinta con " "
    pinta con (nombre_color con c)
fin

funcion colores
    para cada c desde 0 hasta 7
        pinta con "  "
        muestra_color con c
        hasta_columna con 30
        muestra_color con c mas 8
        pinta_linea con ""
    fin
    pinta_linea con ""
fin

funcion encendido
    segundos es cociente con tics y TICS_POR_SEGUNDO
    minutos es cociente con segundos y 60
    pinta con "  Llevo encendido "
    pon_color con BLANCO y NEGRO
    si minutos es mayor que 0
        pinta_numero con minutos
        pinta con " min "
    fin
    pinta_numero con segundos resto 60
    pinta con " s"
    pon_color con GRIS y NEGRO
    pinta con ", y he dormido el "
    pon_color con BLANCO y NEGRO
    pinta_numero con (cociente con tics_dormido por 100 y tics mas 1)
    pinta con " %"
    pon_color con GRIS y NEGRO
    pinta_linea con " del tiempo."
    pinta_linea con ""
fin

funcion cuantas_en con estado
    n es 0
    para cada p desde 1 hasta total_paginas
        si (elemento p de estados) es estado
            n es n mas 1
        fin
    fin
    devuelve n
fin

funcion pinta_tamano con paginas
    kb es paginas por 4
    si kb es menor que 10240
        pinta_numero con kb
        pinta con " KB"
    si no
        pinta_numero con (cociente con kb y 1024)
        pinta con " MB"
    fin
fin

funcion trozo_de_barra con c y celdas
    pon_color con c y NEGRO
    repite celdas veces
        pon_letra con 219
    fin
fin

funcion celdas_de con n
    celdas es cociente con n por 60 y total_paginas
    si n es mayor que 0 y celdas es 0
        devuelve 1
    fin
    devuelve celdas
fin

funcion leyenda con c y nombre y paginas
    pinta con "  "
    pon_color con c y NEGRO
    pon_letra con 254
    pon_color con GRIS y NEGRO
    pinta con " "
    pinta con nombre
    hasta_columna con 44
    pon_color con BLANCO y NEGRO
    pinta_tamano con paginas
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion memoria
    reservadas es cuantas_en con RESERVADA
    mias es cuantas_en con MIA
    prestadas es cuantas_en con PRESTADA
    libres es cuantas_en con LIBRE
    pinta con "  Tengo "
    pon_color con BLANCO y NEGRO
    pinta_numero con (cociente con ram mas (cociente con MEGA y 2) y MEGA)
    pinta con " MB"
    pon_color con GRIS y NEGRO
    pinta_linea con " de memoria, en páginas de 4 KB."
    pinta_linea con ""
    pinta con "  "
    trozo_de_barra con GRIS_OSCURO y (celdas_de con reservadas)
    trozo_de_barra con AZUL_CLARO y (celdas_de con mias)
    trozo_de_barra con AMARILLO y (celdas_de con prestadas)
    trozo_de_barra con VERDE y 60 menos (celdas_de con reservadas) menos (celdas_de con mias) menos (celdas_de con prestadas)
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    pinta_linea con ""
    leyenda con GRIS_OSCURO y "de la BIOS y los aparatos" y reservadas
    leyenda con AZUL_CLARO y "yo: código, pila y tablas" y mias
    leyenda con AMARILLO y "prestadas: tablas y lo que escribes" y prestadas
    leyenda con VERDE y "libres" y libres
    pinta_linea con ""
    prueba es pide_pagina
    hoja es region con prueba y 512 y 8
    elemento 1 de hoja es 1234
    suelta_pagina con prueba
    otra es pide_pagina
    vista es region con otra y 512 y 8
    en_blanco es (elemento 1 de vista) es 0
    suelta_pagina con otra
    pinta_linea con "  Presto una página, escriben en ella, me la devuelven y se la presto"
    pinta con "  a otro: "
    si otra es prueba y en_blanco
        pon_color con VERDE_CLARO y NEGRO
        pinta_linea con "le llega en blanco."
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "le llega con lo que dejó el primero."
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    pinta_linea con "  Y el procesador hace cumplir esto, también a mí:"
    protegido con "mi código es de solo lectura" y verdadero
    protegido con "los datos no se pueden ejecutar" y prohibe_ejecutar no es igual a 0
    protegido con "la dirección 0 no existe" y verdadero
    pinta_linea con ""
fin

funcion protegido con frase y si_esta
    si si_esta
        pon_color con VERDE_CLARO y NEGRO
        pinta con "    sí  "
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta con "    no  "
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con frase
fin

avisado_de_reiniciar es falso

funcion reinicia
    comparte avisado_de_reiniciar
    si pen_debe y no avisado_de_reiniciar
        avisado_de_reiniciar es verdadero
        pon_color con AMARILLO y NEGRO
        pinta_linea con "  Lo último no ha llegado al pendrive, y si reinicio se pierde. Enchúfalo,"
        pinta_linea con "  o repite reinicia si te da igual."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    desactiva_interrupciones
    vacia_memoria_invitado
    olvida_llave
    pon_en_puerto con 100 y 254
    congela
fin

funcion programas
    respuesta es pide_archivo con "programas.txt" y "" y 0
    si respuesta es menor que 0 o respuesta es mayor que TOPE_BUZON
        fallo_de_disco con respuesta
    si no
        pinta_buzon con respuesta
        pinta_linea con ""
    fin
fin

funcion hueco_libre
    para cada t desde 1 hasta MAX_TAREAS
        si (elemento t de estados_tarea) es SIN_USAR
            devuelve t
        fin
    fin
    devuelve 0
fin

funcion apunta_pagina con t y nueva
    lista es region con (elemento t de listas_de_paginas) y 512 y 8
    cuantas es (elemento t de paginas_usadas) mas 1
    elemento t de paginas_usadas es cuantas
    elemento cuantas de lista es nueva
fin

funcion pagina_de_tarea con t
    nueva es pide_pagina
    apunta_pagina con t y nueva
    devuelve nueva
fin

funcion pon_del_nucleo con t y principio y tope y permisos
    directorio es region con (elemento t de directorios) y 512 y 8
    direccion es principio
    mientras direccion es menor que tope
        sitio es (cociente con direccion y DOS_MEGAS) mas 1
        si (elemento sitio de directorio) es 0
            elemento sitio de directorio es (pagina_de_tarea con t) mas PRESENTE mas ESCRIBIBLE
        fin
        tabla es elemento sitio de directorio
        hojas es region con (tabla menos (tabla resto PAGINA)) y 512 y 8
        elemento ((cociente con direccion y PAGINA) resto 512) mas 1 de hojas es direccion mas permisos
        direccion es direccion mas PAGINA
    fin
fin

funcion monta_programa con t y archivo y total
    comparte primera_de_codigo
    raiz es pagina_de_tarea con t
    nivel_3 es pagina_de_tarea con t
    nivel_2 es pagina_de_tarea con t
    hojas es pagina_de_tarea con t
    arriba es region con raiz y 512 y 8
    medio es region con nivel_3 y 512 y 8
    directorio es region con nivel_2 y 512 y 8
    entradas es region con hojas y 512 y 8
    elemento t de directorios es nivel_2
    pon_del_nucleo con t y inicio_de_la_entrada y final_de_la_entrada y PRESENTE
    pon_del_nucleo con t y inicio_de_los_descriptores y final_de_los_descriptores y (PRESENTE mas prohibe_ejecutar)
    elemento 1 de arriba es nivel_3 mas PRESENTE mas ESCRIBIBLE mas USUARIO
    elemento 1 de medio es nivel_2 mas PRESENTE mas ESCRIBIBLE mas USUARIO
    elemento (cociente con DONDE_VAN y DOS_MEGAS) mas 1 de directorio es hojas mas PRESENTE mas ESCRIBIBLE mas USUARIO
    mesa es pagina_de_tarea con t
    elemento t de mesas es mesa
    elemento SITIO_MESA de entradas es mesa mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
    si t es TAREA_PANTALLA
        elemento SITIO_BUZON de entradas es rejilla mas PRESENTE mas USUARIO mas prohibe_ejecutar
        para cada p desde 1 hasta PAGINAS_TALLER
            taller es pagina_de_tarea con t
            elemento SITIO_TALLER mas p de entradas es taller mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
        fin
        para cada k desde 1 hasta video_paginas
            entrada es memoria_de_video mas (k menos 1) por DOS_MEGAS mas PRESENTE mas ESCRIBIBLE mas USUARIO mas GRANDE mas prohibe_ejecutar
            si k es 1 y tabla_video_primera no es igual a 0
                entrada es tabla_video_primera mas PRESENTE mas ESCRIBIBLE mas USUARIO
            si no si k es video_paginas y tabla_video_ultima no es igual a 0
                entrada es tabla_video_ultima mas PRESENTE mas ESCRIBIBLE mas USUARIO
            fin
            elemento SITIO_VIDEO mas k menos 1 de directorio es entrada
        fin
    si no si (es_controlador con t) y t no es igual a TAREA_CONSOLA
        si t es TAREA_USB
            monta_usb con t y directorio
        si no si t es TAREA_RED y red_como es RED_ENCENDIDA
            monta_red con t y directorio
        fin
        buzon es pagina_de_tarea con t
        elemento t de buzones es buzon
        elemento SITIO_BUZON de entradas es buzon mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
        si t es TAREA_DISCO y disco_en_memoria
            monta_disco_en_memoria con t y directorio y mesa
        fin
    fin
    primera_de_codigo es (elemento t de paginas_usadas) mas 1
    de_codigo es paginas_de con archivo
    en_total es paginas_de con total
    para cada p desde 1 hasta en_total
        trozo es pagina_de_tarea con t
        si p es menor o igual que de_codigo
            elemento p de entradas es trozo mas PRESENTE mas USUARIO
        si no
            elemento p de entradas es trozo mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
        fin
    fin
    devuelve raiz
fin

SITIO_USB es 410
SITIO_RED es 412

funcion monta_red con t y directorio
    tabla es pagina_de_tarea con t
    hojas es region con tabla y 512 y 8
    para cada k desde 0 hasta 5
        si k no es igual a 1 y k no es igual a 4
            elemento k mas 1 de hojas es red_registros mas k por PAGINA mas PRESENTE mas ESCRIBIBLE mas USUARIO mas SIN_CACHE mas prohibe_ejecutar
        fin
    fin
    para cada k desde 1 hasta PAGINAS_RED
        hoja es elemento k de red_hojas
        ceros es region con hoja y 512 y 8
        para cada i desde 1 hasta 512
            elemento i de ceros es 0
        fin
        elemento REGISTROS_RED mas k de hojas es hoja mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
    fin
    elemento SITIO_RED de directorio es tabla mas PRESENTE mas ESCRIBIBLE mas USUARIO
fin

funcion monta_usb con t y directorio
    tabla es pagina_de_tarea con t
    hojas es region con tabla y 512 y 8
    para cada k desde 1 hasta usb_mide
        elemento k de hojas es usb_registros mas (k menos 1) por PAGINA mas PRESENTE mas ESCRIBIBLE mas USUARIO mas SIN_CACHE mas prohibe_ejecutar
    fin
    para cada k desde 1 hasta PAGINAS_USB
        hoja es elemento k de usb_hojas
        ceros es region con hoja y 512 y 8
        para cada i desde 1 hasta 512
            elemento i de ceros es 0
        fin
        elemento TOPE_REGISTROS_USB mas k de hojas es hoja mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
    fin
    elemento SITIO_USB de directorio es tabla mas PRESENTE mas ESCRIBIBLE mas USUARIO
fin

funcion paginas_de con bytes
    devuelve cociente con (bytes mas PAGINA menos 1) y PAGINA
fin

SITIO_DISCO_EN_MEMORIA es 400
TOPE_DISCO_EN_MEMORIA es 8 por DOS_MEGAS
disco_en_memoria es modulo_hasta es mayor que 0

funcion bytes_del_modulo
    largo es modulo_hasta menos modulo_desde
    si largo es mayor que TOPE_DISCO_EN_MEMORIA
        devuelve TOPE_DISCO_EN_MEMORIA
    fin
    devuelve largo
fin

funcion monta_disco_en_memoria con t y directorio y mesa
    largo es bytes_del_modulo
    para cada k desde 1 hasta cociente con (largo mas DOS_MEGAS menos 1) y DOS_MEGAS
        tabla es pagina_de_tarea con t
        hojas es region con tabla y 512 y 8
        para cada i desde 1 hasta 512
            sitio es (k menos 1) por DOS_MEGAS mas (i menos 1) por PAGINA
            si sitio es menor que largo
                elemento i de hojas es modulo_desde mas sitio mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
            fin
        fin
        elemento SITIO_DISCO_EN_MEMORIA mas k menos 1 de directorio es tabla mas PRESENTE mas ESCRIBIBLE mas USUARIO
    fin
    sectores es cociente con largo y 512
    cifras_mesa es region con mesa mas 4092 y 4
    para cada i desde 1 hasta 4
        elemento 5 menos i de cifras_mesa es sectores resto 256
        sectores es cociente con sectores y 256
    fin
fin

funcion pagina_de_codigo con t y p
    lista es region con (elemento t de listas_de_paginas) y 512 y 8
    devuelve elemento primera_de_codigo mas p menos 1 de lista
fin

funcion reserva_tarea con t y archivo y total y entrada
    elemento t de avisos es 0
    si t es TAREA_TECLADO y tecla_sin_leer
        elemento t de avisos es AVISO_TECLA
    si no si t es TAREA_TECLADO y raton_sin_leer
        elemento t de avisos es AVISO_RATON
    fin
    elemento t de paciencia_gastada es 0
    elemento t de listas_de_paginas es pide_pagina
    elemento t de paginas_usadas es 0
    elemento t de programa_tamano es archivo
    elemento t de tiempo_de es 0
    elemento t de columna_de es 1
    elemento t de medias_de es 0
    elemento t de generaciones es (elemento t de generaciones) mas 1
    elemento t de atendiendo_a es 0
    elemento t de hablando_con es 0
    elemento t de mensajes_de es 0
    elemento t de rechazos_de es 0
    elemento t de entran_de es 0
    elemento t de salen_de es 0
    elemento t de teclas_recibidas es 0
    elemento t de permiso_disco es DISCO_SIN_PEDIR
    elemento t de permiso_red es DISCO_SIN_PEDIR
    elemento t de destino_permiso es 0
    elemento t de raices es monta_programa con t y archivo y total
    pila es pagina_de_tarea con t
    pon_del_nucleo con t y pila y (pila mas PAGINA) y (PRESENTE mas ESCRIBIBLE mas prohibe_ejecutar)
    elemento t de pilas es pila mas PAGINA
    marco es region con pila mas PAGINA menos TAMANO_MARCO y 20 y 8
    elemento EN_RIP de marco es entrada
    elemento EN_CS de marco es SEGMENTO_CODIGO
    elemento EN_BANDERAS de marco es BANDERAS
    elemento EN_SS de marco es SEGMENTO_DATOS
    elemento t de contextos es pila mas PAGINA menos TAMANO_MARCO
fin

funcion estrena_tarea con t
    si no (es_controlador con t)
        abre_ventana con t
    fin
    elemento t de estados_tarea es EN_MARCHA
fin

funcion lanza_controlador con t
    imagen es imagen_de con t
    reserva_tarea con t y (elemento 3 de imagen) y (elemento 4 de imagen) y (elemento 2 de imagen)
    para cada p desde 1 hasta paginas_de con (elemento 3 de imagen)
        hoja es region con (pagina_de_codigo con t y p) y 512 y 8
        desde es (p menos 1) por 512
        cuantas es (largo de imagen) menos desde
        si cuantas es mayor que 512
            cuantas es 512
        fin
        copia_region con hoja y 1 y imagen y desde mas 1 y cuantas
    fin
    si t es TAREA_USB
        estrena_usb
    si no si t es TAREA_RED
        estrena_red
    fin
    estrena_tarea con t
fin

red_desde es 0
red_caidas es 0

funcion estrena_red
    comparte red_desde
    red_desde es tics
    mando_red con 2
fin

funcion estrena_usb
    comparte usb_desde
    buzon es region con (elemento TAREA_USB de buzones) y 1024 y 4
    elemento 1 de buzon es usb_mide
    usb_desde es tics
    olvida_puertos_usb
    faltas es cuenta_faltas
    mando_usb con 6
fin

funcion trozo_de_orden con primera
    si primera es mayor que escritas
        devuelve ""
    fin
    devuelve region con orden_en mas primera menos 1 y escritas menos primera mas 1
fin

funcion rechaza_programa con nombre y motivo
    pon_color con ROJO_CLARO y NEGRO
    pinta con "  No cargo "
    pinta con nombre
    pinta con ": "
    pon_color con BLANCO y NEGRO
    pinta_linea con motivo
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    al_serie con "rechazado: "
    al_serie con nombre
    escribe ""
fin

funcion mentira_de con firma y entrada y archivo y total
    si firma no es igual a MAGIA
        devuelve "no es un programa."
    fin
    si archivo es menor que LARGO_CABECERA o archivo es mayor que TOPE_PROGRAMA
        devuelve "dice que ocupa algo imposible."
    fin
    si total es menor que archivo o total es mayor que TOPE_PROGRAMA
        devuelve "pide más memoria de la que doy."
    fin
    si entrada es menor que DONDE_VAN mas LARGO_CABECERA o entrada es mayor o igual que DONDE_VAN mas archivo
        devuelve "quiere empezar fuera de sí mismo."
    fin
    devuelve nada
fin

funcion trae_programa con t y nombre y archivo y primero
    para cada p desde 1 hasta paginas_de con archivo
        desde es (p menos 1) por PAGINA
        esperados es archivo menos desde
        si esperados es mayor que PAGINA
            esperados es PAGINA
        fin
        respuesta es primero
        si p es mayor que 1
            respuesta es pide_archivo con nombre y ".prg" y p menos 1
        fin
        si respuesta es menor que 0
            devuelve respuesta
        fin
        si respuesta no es igual a esperados
            devuelve MAS_CORTO
        fin
        buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
        hoja es region con (pagina_de_codigo con t y p) y PAGINA
        copia_region con hoja y 1 y buzon y 1 y esperados
    fin
    devuelve 0
fin

funcion lanza
    nombre es trozo_de_orden con 1
    t es hueco_libre
    si t es 0
        pinta_linea con "  Ya hay cuatro programas corriendo. Cierra uno con: para N"
        pinta_linea con ""
        devuelve nada
    fin
    primero es pide_archivo con nombre y ".prg" y 0
    si primero es NO_ESTA
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ningún programa con ese nombre. Mira: programas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
    si no si primero es menor que 0 o primero es mayor que TOPE_BUZON
        fallo_de_disco con primero
    si no si primero es menor que LARGO_CABECERA
        rechaza_programa con nombre y "no es un programa."
    si no
        cabecera es region con (elemento TAREA_DISCO de buzones) y 4 y 8
        firma es elemento 1 de cabecera
        entrada es elemento 2 de cabecera
        archivo es elemento 3 de cabecera
        total es elemento 4 de cabecera
        motivo es mentira_de con firma y entrada y archivo y total
        si motivo no es igual a nada
            rechaza_programa con nombre y motivo
        si no
            carga_programa con t y nombre y archivo y total y entrada y primero
        fin
    fin
fin

funcion carga_programa con t y nombre y archivo y total y entrada y primero
    apunta_nombre con t y nombre
    reserva_tarea con t y archivo y total y entrada
    traido es trae_programa con t y nombre y archivo y primero
    si traido es 0
        estrena_tarea con t
        pinta con "  "
        pinta con nombre
        pinta con ": "
        pon_color con BLANCO y NEGRO
        pinta_numero con (cociente con archivo y 1024)
        pinta con " KB"
        pon_color con GRIS y NEGRO
        pinta_linea con " leídos del disco. Nace sin permisos, en su propia caja."
        pinta_linea con ""
    si no si traido es MAS_CORTO
        suelta_tarea con t
        rechaza_programa con nombre y "es más corto de lo que dice."
    si no
        suelta_tarea con t
        fallo_de_disco con traido
    fin
fin

funcion numero_entre con primera y ultima
    n es 0
    si primera es mayor que ultima
        devuelve 0
    fin
    para cada i desde primera hasta ultima
        letra es elemento i de orden
        si letra es menor que 48 o letra es mayor que 57 o n es mayor que 1000
            devuelve 0
        fin
        n es n por 10 mas letra menos 48
    fin
    devuelve n
fin

funcion para_tarea
    t es numero_entre con 1 y escritas
    si t es menor que 1 o t es mayor que ULTIMA_TAREA o t es CONSOLA o (elemento t de estados_tarea) es SIN_USAR
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ninguna tarea con ese número. Mira: tareas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
    si no
        desactiva_interrupciones
        cierra_tarea con t y LA_PARARON
        quita_ventana con t
        activa_interrupciones
        recoge_tareas con falso
    fin
fin

funcion cuenta_paginas con directorio y sitios y de_usuario
    entradas es region con directorio y 512 y 8
    cuantas es 0
    para cada d desde 1 hasta sitios
        bits es mitad_baja con (elemento d de entradas)
        suya es ((cociente con bits y USUARIO) resto 2) es 1
        si (bits resto 2) es 1 y ((cociente con bits y GRANDE) resto 2) es 1
            si suya es de_usuario
                cuantas es cuantas mas 512
            fin
        si no si (bits resto 2) es 1
            tabla es elemento d de entradas
            hojas es region con (tabla menos (tabla resto PAGINA)) y 512 y 8
            para cada i desde 1 hasta 512
                hoja es mitad_baja con (elemento i de hojas)
                suya es ((cociente con hoja y USUARIO) resto 2) es 1
                si (hoja resto 2) es 1 y suya es de_usuario
                    cuantas es cuantas mas 1
                fin
            fin
        fin
    fin
    devuelve cuantas
fin

funcion orden_tablas
    t es numero_entre con 1 y escritas
    si t es menor que 1 o t es mayor que ULTIMA_TAREA o t es CONSOLA o (elemento t de estados_tarea) es SIN_USAR
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ninguna tarea con ese número. Mira: tareas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    suyas es cuenta_paginas con (elemento t de directorios) y 512 y verdadero
    del_nucleo es cuenta_paginas con (elemento t de directorios) y 512 y falso
    antes es cuenta_paginas con directorio_nucleo y (cociente con VISIBLE y DOS_MEGAS) y falso
    pinta con "  En las tablas de "
    pon_color con (color_de con t) y NEGRO
    pinta con (nombre_de con t)
    pon_color con GRIS y NEGRO
    pinta con " hay "
    pon_color con BLANCO y NEGRO
    pinta_numero con suyas
    pon_color con GRIS y NEGRO
    pinta con " páginas suyas y "
    pon_color con BLANCO y NEGRO
    pinta_numero con del_nucleo
    pon_color con GRIS y NEGRO
    pinta_linea con " del núcleo:"
    pinta_linea con "  las justas para entrar en FalOS y volver."
    pinta con "  Antes eran "
    pinta_numero con antes
    pinta_linea con ": todo el núcleo, con un permiso que Meltdown se salta."
    pinta_linea con ""
    al_serie con (nombre_de con t)
    escribe " tablas: " sin salto
    escribe suyas sin salto
    escribe " suyas, " sin salto
    escribe del_nucleo sin salto
    escribe " del núcleo, antes " sin salto
    escribe antes
fin

funcion da_el_teclado
    comparte foco
    t es numero_entre con 1 y escritas
    bien es t es mayor o igual que 1 y t es menor o igual que MAX_TAREAS
    si bien
        bien es (elemento t de ventana_de) es VENTANA_VIVA y sigue_viva con t
    fin
    si no bien
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ningún programa con ese número. Mira: tareas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    desactiva_interrupciones
    si foco no es igual a t
        apunta_de con R_TECLADO y t y 0
    fin
    foco es t
    sube_ventana con t
    activa_interrupciones
    pinta con "  Lo que escribas va a "
    pon_color con (color_de con t) y NEGRO
    pinta con (nombre_de con t)
    pon_color con GRIS y NEGRO
    pinta_linea con ". Con Esc vuelve aquí."
    pinta_linea con ""
fin

funcion nombre_estado con t
    e es elemento t de estados_tarea
    si e es DORMIDA
        devuelve "durmiendo"
    si no si e es ESCUCHANDO
        devuelve "escuchando"
    si no si e es PREGUNTANDO o e es ESPERA_RESPUESTA
        devuelve "esperando"
    si no si e es EN_ESPERA
        devuelve "esperando trabajo"
    si no si e es CON_EL_DISCO y (elemento t de permiso_disco) es DISCO_PEDIDO
        devuelve "pide permiso"
    si no si e es CON_EL_DISCO
        devuelve "con el disco"
    si no si e es CON_LA_RED y (elemento t de permiso_red) es DISCO_PEDIDO
        devuelve "pide permiso"
    si no si e es CON_LA_RED
        devuelve "con la red"
    si no si e es CON_UNA_ORDEN
        devuelve "con una orden"
    si no si e es CERRADA
        devuelve "cerrándose"
    fin
    devuelve "corriendo"
fin

funcion linea_de_tarea con t
    pinta con "  "
    pon_color con (color_de con t) y NEGRO
    pinta_numero con t
    pinta con " "
    hasta_columna con 6
    pinta con (nombre_de con t)
    pon_color con GRIS y NEGRO
    hasta_columna con 17
    pinta con (nombre_estado con t)
    hasta_columna con 36
    pinta_numero con (cociente con (elemento t de tiempo_de) y TICS_POR_SEGUNDO)
    pinta con " s de procesador"
    hasta_columna con 58
    pinta_tamano con (elemento t de paginas_usadas) mas 1
    si (elemento t de reinicios_de) es mayor que 0
        hasta_columna con 68
        pinta_numero con (elemento t de reinicios_de)
        si (elemento t de reinicios_de) es 1
            pinta con " reinicio"
        si no
            pinta con " reinicios"
        fin
    fin
    pinta_linea con ""
fin

funcion tareas
    para cada t desde 1 hasta MAX_TAREAS
        si (elemento t de estados_tarea) no es igual a SIN_USAR
            linea_de_tarea con t
        fin
    fin
    linea_de_tarea con TAREA_TECLADO
    linea_de_tarea con TAREA_DISCO
    si hay_graficos
        linea_de_tarea con TAREA_PANTALLA
    fin
    si hay_red
        linea_de_tarea con TAREA_RED
    fin
    si usb_como es USB_LISTO
        linea_de_tarea con TAREA_USB
    fin
    linea_de_tarea con TAREA_CONSOLA
    pinta_linea con ""
fin

funcion cabecera_de_tarea con t
    pinta con "  "
    pon_color con (color_de con t) y NEGRO
    pinta_numero con t
    pinta con "  "
    pinta con (nombre_de con t)
    pon_color con GRIS y NEGRO
    hasta_columna con 17
fin

funcion permisos
    hay es falso
    para cada t desde 1 hasta MAX_TAREAS
        si sigue_viva con t
            hay es verdadero
            cabecera_de_tarea con t
            ninguna es verdadero
            para cada llave desde 1 hasta LLAVES
                destino es abre_llave con t y llave
                si destino no es igual a 0
                    si ninguna
                        pinta con "habla con "
                    si no
                        pinta con ", "
                    fin
                    ninguna es falso
                    pon_color con (color_de con destino) y NEGRO
                    pinta con (nombre_de con destino)
                    pon_color con GRIS y NEGRO
                fin
            fin
            si (elemento t de permiso_red) es DISCO_SI
                si no ninguna
                    pinta_linea con ""
                    hasta_columna con 17
                fin
                ninguna es falso
                pinta con "por la red, con "
                pinta_destino con (elemento t de destino_permiso)
            fin
            si ninguna
                pinta con "sin permisos"
            fin
            pinta_linea con ""
            hasta_columna con 17
            pon_color con GRIS_OSCURO y NEGRO
            pinta_numero con (elemento t de mensajes_de)
            pinta con " preguntas, "
            pinta_numero con (elemento t de rechazos_de)
            pinta_linea con " rechazadas"
            pon_color con GRIS y NEGRO
        fin
    fin
    cabecera_de_tarea con TAREA_TECLADO
    pinta_linea con "solo el puerto 96, para leer las teclas"
    cabecera_de_tarea con TAREA_DISCO
    pinta_linea con "solo los puertos del 496 al 503, los del disco"
    si hay_graficos
        cabecera_de_tarea con TAREA_PANTALLA
        pinta_linea con "solo la imagen, y lee lo que hay que pintar sin tocarlo"
    fin
    si hay_red
        cabecera_de_tarea con TAREA_RED
        si red_como es RED_ENCENDIDA
            pinta con "solo 4 páginas de registros de la tarjeta y sus "
            pinta_numero con PAGINAS_RED
            pinta_linea con " de memoria"
            hasta_columna con 17
            pinta_linea con "y el aparato, solo las suyas: de lo demás no ve nada"
        si no
            pinta con "solo los puertos del "
            pinta_numero con puerto_red
            pinta con " al "
            pinta_numero con puerto_red mas 31
            pinta_linea con ", los de la tarjeta"
        fin
    fin
    si usb_como es USB_LISTO
        cabecera_de_tarea con TAREA_USB
        pinta con "solo los registros del controlador USB y sus "
        pinta_numero con PAGINAS_USB
        pinta_linea con " páginas"
        hasta_columna con 17
        pinta_linea con "y lo mismo el aparato: de lo demás no ve nada"
    fin
    pinta_linea con ""
    pinta_siempre
    pinta_linea con ""
fin

primer_numero es 0
segundo_numero es 0

funcion dos_numeros con primera
    comparte primer_numero y segundo_numero
    hueco es primera
    mientras hueco es menor que escritas y (elemento hueco de orden) no es igual a 32
        hueco es hueco mas 1
    fin
    primer_numero es numero_entre con primera y hueco menos 1
    segundo_numero es numero_entre con hueco mas 1 y escritas
fin

funcion tareas_buenas
    para cada n desde 1 hasta 2
        t es primer_numero
        si n es 2
            t es segundo_numero
        fin
        si t es menor que 1 o t es mayor que MAX_TAREAS
            devuelve falso
        fin
        si no (sigue_viva con t)
            devuelve falso
        fin
    fin
    devuelve primer_numero no es igual a segundo_numero
fin

funcion no_hay_esas_tareas
    pon_color con ROJO_CLARO y NEGRO
    pinta_linea con "  Necesito dos tareas que existan y sean distintas. Mira: tareas"
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion llave_hacia con t y destino
    para cada llave desde 1 hasta LLAVES
        si (abre_llave con t y llave) es destino
            devuelve llave
        fin
    fin
    devuelve 0
fin

funcion llave_libre con t
    para cada llave desde 1 hasta LLAVES
        si (abre_llave con t y llave) es 0
            devuelve llave
        fin
    fin
    devuelve 0
fin

funcion permite
    dos_numeros con 1
    si no tareas_buenas
        no_hay_esas_tareas
        devuelve nada
    fin
    si (llave_hacia con primer_numero y segundo_numero) no es igual a 0
        pinta_linea con "  Ya tenía ese permiso."
        pinta_linea con ""
        devuelve nada
    fin
    llave es llave_libre con primer_numero
    si llave es 0
        pinta_linea con "  Esa tarea no puede llevar más permisos."
        pinta_linea con ""
        devuelve nada
    fin
    sitio es sitio_de_llave con primer_numero y llave
    desactiva_interrupciones
    elemento sitio de llave_generacion es elemento segundo_numero de generaciones
    elemento sitio de llave_a es segundo_numero
    activa_interrupciones
    pon_color con VERDE_CLARO y NEGRO
    pinta con "  "
    pinta con (nombre_de con primer_numero)
    pinta con " ya puede hablar con "
    pinta_linea con (nombre_de con segundo_numero)
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion prohibe
    dos_numeros con 1
    si no tareas_buenas
        no_hay_esas_tareas
        devuelve nada
    fin
    llave es llave_hacia con primer_numero y segundo_numero
    si llave es 0
        pinta_linea con "  No tenía ese permiso."
        pinta_linea con ""
        devuelve nada
    fin
    elemento (sitio_de_llave con primer_numero y llave) de llave_a es 0
    pon_color con ROJO_CLARO y NEGRO
    pinta con "  "
    pinta con (nombre_de con primer_numero)
    pinta con " ya no puede hablar con "
    pinta_linea con (nombre_de con segundo_numero)
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    al_serie con (nombre_de con primer_numero)
    escribe " pierde el permiso tras " sin salto
    escribe (elemento primer_numero de mensajes_de) sin salto
    escribe " preguntas"
fin

funcion pinta_hex con n
    si n es menor que 0
        pinta con "una dirección imposible"
    si no
        pinta con "0x"
        cifras_hex con 0 menos n
        mueve_cursor
    fin
fin

funcion cifras_hex con n
    si n es menor o igual que menos 16
        cifras_hex con (cociente con n y 16)
    fin
    cifra es 0 menos (n resto 16)
    si cifra es menor que 10
        pon_letra con 48 mas cifra
    si no
        pon_letra con 55 mas cifra
    fin
fin

funcion puerto_legible con t
    d es elemento t de registro_rdx
    devuelve d es mayor o igual que 0 y d es menor que 65536
fin

funcion cuenta_lectura con t
    puerto es elemento t de registro_rdx
    si (puerto_legible con t) y puerto es 96
        pinta_linea con "quiso espiar lo que escribes en el teclado."
    si no si (puerto_legible con t) y puerto es mayor o igual que 496 y puerto es menor o igual que 503
        pinta_linea con "quiso leer el disco por su cuenta."
    si no
        pinta_linea con "quiso leer de un aparato."
    fin
    pinta_linea con "  Ese puerto no es suyo, y el procesador lo ha parado."
fin

funcion cuenta_general con t
    instruccion es elemento t de instrucciones
    si instruccion es 238 y puerto_legible con t
        puerto es elemento t de registro_rdx
        valor es elemento t de registro_rax
        si puerto es 100 y valor es 254
            pinta_linea con "quiso apagar el ordenador."
        si no
            pinta con "quiso escribir en el puerto "
            pinta_numero con puerto
            pinta_linea con "."
        fin
        pinta_linea con "  Ese puerto no es suyo, y el procesador lo ha parado."
    si no si instruccion es 236 o instruccion es 102
        cuenta_lectura con t
    si no
        pinta_linea con "quiso usar una instrucción reservada al núcleo."
    fin
fin

funcion cuenta_pagina con t
    codigo es elemento t de codigos
    direccion es elemento t de direcciones
    escribiendo es ((cociente con codigo y 2) resto 2) es 1
    si ((cociente con codigo y 16) resto 2) es 1
        pinta con "quiso ejecutar "
        pinta_hex con direccion
        pinta_linea con ", que no es código."
    si no si direccion es mayor o igual que DONDE_VAN y direccion es menor que DONDE_VAN mas TOPE_PROGRAMA
        pinta_linea con "quiso reescribir su propio código, que es de solo lectura."
    si no si direccion es mayor o igual que DONDE_VAN o direccion es menor que 0
        pinta con "quiso tocar "
        pinta_hex con direccion
        pinta_linea con ", que no existe."
    si no
        si escribiendo
            pinta con "quiso escribir en "
        si no
            pinta con "quiso leer "
        fin
        pinta_hex con direccion
        pinta_linea con ", que es memoria del núcleo."
        si (codigo resto 2) es 1
            pinta_linea con "  Esa memoria no es suya, y el procesador no le deja tocarla."
        si no
            pinta_linea con "  Ni siquiera está en sus tablas: desde ahí, el núcleo no existe."
            al_serie con (nombre_de con t)
            escribe " no tiene el núcleo en sus tablas"
        fin
    fin
fin

funcion ultima_linea con t
    renglon es elemento t de fila_de_ventana
    si (elemento t de columna_de) es 1 y renglon es mayor que 1
        renglon es renglon menos 1
    fin
    texto es texto_de con t
    final es elemento t de anchos
    mientras final es mayor que 0 y ((elemento (casilla_de_texto con t y renglon y final) de texto) resto 256) es 32
        final es final menos 1
    fin
    c es 1
    mientras c es menor o igual que final
        pon_letra con ((elemento (casilla_de_texto con t y renglon y c) de texto) resto 256)
        c es c mas 1
    fin
    mueve_cursor
fin

funcion cuenta_falta con t
    pon_color con ROJO_CLARO y NEGRO
    pinta con "  "
    pinta con (nombre_de con t)
    pon_color con BLANCO y NEGRO
    si falta_interrupcion
        pinta_linea con " quiso fingir una interrupción. El IOMMU no le ha dejado."
    si no
        si falta_leia
            pinta con " mandó al aparato leer "
        si no
            pinta con " mandó al aparato escribir en "
        fin
        pinta_hex con falta_en
        pinta_linea con ", que no es suyo."
        pinta_linea con "  El IOMMU no le ha dejado."
    fin
    al_serie con (nombre_de con t)
    al_serie con ": DMA parado por el IOMMU en "
    escribe falta_en
fin

funcion cuenta_el_final con t
    causa es elemento t de causas
    nombre es nombre_de con t
    si causa es SE_COLGO
        pon_color con ROJO_CLARO y NEGRO
        pinta con "  "
        pinta con nombre
        pon_color con BLANCO y NEGRO
        pinta_linea con " lleva 1 s sin contestar: se ha colgado."
    si no si causa es SALIO
        pinta con "  "
        pinta con nombre
        si es_controlador con t
            pinta_linea con " ha reventado por dentro."
        si no si (elemento t de codigos) no es igual a 0
            pinta_linea con " ha reventado:"
            pinta con "  "
            ultima_linea con t
            pinta_linea con ""
        si no
            pinta_linea con " ha terminado."
        fin
    si no si causa es LA_PARARON
        pinta con "  He cerrado "
        pinta con nombre
        pinta_linea con "."
        si no (es_controlador con t)
            pinta con "  Le habían llegado "
            pon_color con BLANCO y NEGRO
            pinta_numero con (elemento t de teclas_recibidas)
            pon_color con GRIS y NEGRO
            si (elemento t de teclas_recibidas) es 1
                pinta_linea con " tecla tuya."
            si no
                pinta_linea con " teclas tuyas."
            fin
        fin
        al_serie con nombre
        escribe " cerrado con " sin salto
        escribe (elemento t de mensajes_de) sin salto
        escribe " preguntas y " sin salto
        escribe (elemento t de rechazos_de) sin salto
        escribe " rechazadas"
    si no si causa es TOCO_LO_AJENO
        cuenta_falta con t
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta con "  "
        pinta con nombre
        pon_color con BLANCO y NEGRO
        pinta con " "
        si causa es 13
            cuenta_general con t
        si no si causa es 14
            cuenta_pagina con t
        si no
            pinta con "ha roto algo: excepción "
            pinta_numero con causa
            pinta_linea con "."
        fin
        si no (es_controlador con t)
            pon_color con VERDE_CLARO y NEGRO
            pinta_linea con "  Lo he cerrado. Todo lo demás sigue en marcha."
        fin
        al_serie con nombre
        escribe " cerrado por la excepción " sin salto
        escribe causa
    fin
    si no (es_controlador con t)
        si (elemento t de teclas_recibidas) es mayor que 0
            desactiva_interrupciones
            apunta_de con R_TECLAS y t y (elemento t de teclas_recibidas)
            activa_interrupciones
        fin
        al_serie con nombre
        escribe " recibió " sin salto
        escribe (elemento t de teclas_recibidas) sin salto
        escribe " teclas"
    fin
    pon_color con GRIS y NEGRO
fin

funcion suelta_tarea con t
    suelta_dos_megas con (elemento t de memoria_grande_de)
    elemento t de memoria_grande_de es 0
    lista es region con (elemento t de listas_de_paginas) y 512 y 8
    para cada i desde 1 hasta elemento t de paginas_usadas
        suelta_pagina con (elemento i de lista)
    fin
    suelta_pagina con (elemento t de listas_de_paginas)
    si no (es_controlador con t)
        acaba_ventana con t
    fin
    para cada llave desde 1 hasta LLAVES
        elemento (sitio_de_llave con t y llave) de llave_a es 0
    fin
    elemento t de estados_tarea es SIN_USAR
fin

funcion vuelve_a_lanzar con t
    elemento t de reinicios_de es (elemento t de reinicios_de) mas 1
    lanza_controlador con t
    pon_color con VERDE_CLARO y NEGRO
    tardado es (tics menos (elemento t de cerrada_en)) por 10
    pinta con "  He lanzado otro en "
    si tardado es 0
        pinta con "menos de 10"
    si no
        pinta_numero con tardado
    fin
    pinta_linea con " ms. Todo lo demás sigue en marcha."
    pon_color con GRIS y NEGRO
    al_serie con (nombre_de con t)
    escribe " reiniciado, y van " sin salto
    escribe (elemento t de reinicios_de)
fin

funcion recoge_tareas con en_el_indicador
    comparte hay_cerradas y columna
    hay_cerradas es falso
    alguna es falso
    para cada t desde 1 hasta ULTIMA_TAREA
        si t no es igual a CONSOLA y (elemento t de estados_tarea) es CERRADA
            si en_el_indicador y no alguna
                base es (fila menos 1) por ANCHO
                para cada c desde 1 hasta ANCHO
                    elemento base mas c de pantalla es color por 256 mas 32
                fin
                columna es 1
            fin
            alguna es verdadero
            cuenta_el_final con t
            suelta_tarea con t
            si t es TAREA_USB
                recoge_usb
            si no si t es TAREA_RED y red_como es RED_ENCENDIDA
                recoge_intel
            si no si es_controlador con t
                vuelve_a_lanzar con t
            fin
            pinta_linea con ""
        fin
    fin
    si alguna y en_el_indicador
        vuelve_la_consola
    fin
fin

funcion recoge_intel
    comparte red_caidas y red_como y hay_red
    mando_red con 0
    si (elemento TAREA_RED de cerrada_en) menos red_desde es mayor que USB_ESTABLE
        red_caidas es 0
    fin
    red_caidas es red_caidas mas 1
    si red_caidas es mayor que 5
        red_como es RED_SE_CAE
        hay_red es falso
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  El controlador de la red se cae en cuanto arranca. No lanzo más."
        pon_color con GRIS y NEGRO
        al_serie con "red: no lanzo más"
        escribe ""
        devuelve nada
    fin
    vuelve_a_lanzar con TAREA_RED
fin

funcion recoge_usb
    comparte usb_caidas y usb_como
    mando_usb con 0
    si (elemento TAREA_USB de cerrada_en) menos usb_desde es mayor que USB_ESTABLE
        usb_caidas es 0
    fin
    usb_caidas es usb_caidas mas 1
    si usb_caidas es mayor que 5
        usb_como es USB_SE_CAE
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  El controlador USB se cae en cuanto arranca. No lanzo más."
        pon_color con GRIS y NEGRO
        al_serie con "usb: no lanzo más"
        escribe ""
        devuelve nada
    fin
    si no calla_usb
        usb_como es USB_NO_PARA
        mando_usb con 0
        pinta_por_que_no_usb
        devuelve nada
    fin
    vuelve_a_lanzar con TAREA_USB
fin

ORDEN_ARRANCA_RED es 1
ORDEN_ENVIA_RED es 2
ORDEN_RECIBE_RED es 3
ORDEN_ENLACE_RED es 4
ORDEN_CALLA_RED es 5
TOPE_TRAMA es 1514
NO_HAY_TARJETA es 0 menos 1
NO_SALE es 0 menos 2
NADIE_CONTESTA es 0 menos 20
SIN_CABLE es 0 menos 21
SIN_DIRECCION es 0 menos 22
PLAZO_RED es 10 por TICS_POR_SEGUNDO
PLAZO_CABLE es 8 por TICS_POR_SEGUNDO
TOPE_PRESTAMO es 86400
ID_PING es 17985
DATOS_PING es "FalOS: solo sale si tu lo pides."
PINGS es 4
LLEGA_NADA es 0
LLEGA_ARP es 1
LLEGA_ECO es 2
LLEGA_UDP es 3
LLEGA_DHCP es 4
DHCP_PREGUNTA es 1
DHCP_OFRECE es 2
DHCP_PIDE es 3
DHCP_ACEPTA es 5
DHCP_NIEGA es 6
TOPE_DATOS_RED es 512
red_en es pide_pagina
mi_mac es region con red_en y 6
mac_destino es region con red_en mas 8 y 6
todos es region con red_en mas 16 y 6
mac_pregunta es region con red_en mas 24 y 6
ip_texto es region con red_en mas 64 y 16
conexion es region con red_en mas 128 y 64
aviso_ip es region con red_en mas 192 y 16
para cada byte_todos desde 1 hasta 6
    elemento byte_todos de todos es 255
fin
red_arrancada es 0
mi_ip es 167772687
salida_ip es 167772674
dns_ip es 167772675
vecinos es 256
vence_en es 0
dhcp_id es 0
dhcp_espera es 0
dhcp_tipo es 0
dhcp_ip es 0
dhcp_vecinos es 0
dhcp_salida es 0
dhcp_dns es 0
dhcp_servidor es 0
dhcp_dura es 0
enlace_movido es falso
velocidad_red es 0
azar_red es region con red_en mas 256 y 16
si red_como es RED_ENCENDIDA
    mi_ip es 0
    salida_ip es 0
    dns_ip es 0
fin
tramas_enviadas es 0
tramas_recibidas es 0
usando_red es falso
ip_texto_mide es 0
ip_pedida es 0
ip_buscada es 0
eco_esperado es 0
udp_ip es 0
udp_puerto es 0
udp_local es 0
udp_tarea es 0
udp_recibidos es 0
aviso_ip_mide es 0

funcion pide_a_la_red con peticion
    comparte peticion_red y red_lista y esperando
    recoge_tareas con falso
    si no hay_red
        devuelve NO_HAY_TARJETA
    fin
    buzon es region con (elemento TAREA_RED de buzones) y TOPE_BUZON
    si red_como es RED_ENCENDIDA
        elemento 1 de buzon es 0
        si red_de_pch
            elemento 1 de buzon es 1
        fin
        si peticion es ORDEN_ARRANCA_RED
            copia_region con buzon y 3 y mi_mac y 1 y 6
        fin
    si no
        elemento 1 de buzon es cociente con puerto_red y 256
        elemento 2 de buzon es puerto_red resto 256
    fin
    desactiva_interrupciones
    red_lista es falso
    peticion_red es verdadero
    limite es tics mas PLAZO_RED
    avisa_a con TAREA_RED y peticion
    mientras no red_lista
        si tics es mayor que limite y sigue_viva con TAREA_RED
            cierra_tarea con TAREA_RED y SE_COLGO
        si no
            esperando es verdadero
            espera_interrupcion
            esperando es falso
            desactiva_interrupciones
        fin
    fin
    red_lista es falso
    activa_interrupciones
    devuelve resultado_red
fin

funcion buzon_red
    devuelve region con (elemento TAREA_RED de buzones) y TOPE_BUZON
fin

funcion inventa_mac
    saca_sal con azar_red y 1
    copia_region con mi_mac y 1 y azar_red y 1 y 6
    elemento 1 de mi_mac es (elemento 1 de mi_mac) menos ((elemento 1 de mi_mac) resto 4) mas 2
fin

funcion asegura_red
    comparte red_arrancada
    si (elemento TAREA_RED de generaciones) es red_arrancada
        devuelve 0
    fin
    si red_como es RED_ENCENDIDA y (elemento 1 de mi_mac) es 0
        inventa_mac
    fin
    si red_como es RED_ENCENDIDA
        hecho es pide_a_la_red con ORDEN_CALLA_RED
        si hecho es menor que 0
            devuelve hecho
        fin
        mando_red con 6
    fin
    hecho es pide_a_la_red con ORDEN_ARRANCA_RED
    si hecho es menor que 0
        devuelve hecho
    fin
    si no (red_como es RED_ENCENDIDA)
        copia_region con mi_mac y 1 y buzon_red y 3 y 6
    fin
    red_arrancada es elemento TAREA_RED de generaciones
    al_serie con "red: tarjeta en marcha"
    escribe ""
    devuelve 0
fin

funcion pon_numero_en con zona y sitio y valor y cuantos
    queda es valor
    i es sitio mas cuantos menos 1
    mientras i es mayor o igual que sitio
        elemento i de zona es queda resto 256
        queda es cociente con queda y 256
        i es i menos 1
    fin
fin

funcion numero_de con zona y sitio y cuantos
    n es 0
    para cada i desde sitio hasta sitio mas cuantos menos 1
        n es n por 256 mas elemento i de zona
    fin
    devuelve n
fin

funcion suma_palabras con zona y sitio y cuantos
    suma es 0
    i es 0
    mientras i es menor que cuantos
        byte_alto es elemento sitio mas i de zona
        byte_bajo es 0
        si i mas 1 es menor que cuantos
            byte_bajo es elemento sitio mas i mas 1 de zona
        fin
        suma es suma mas byte_alto por 256 mas byte_bajo
        i es i mas 2
    fin
    devuelve suma
fin

funcion dobla con suma
    mientras suma es mayor que 65535
        suma es (suma resto 65536) mas cociente con suma y 65536
    fin
    devuelve suma
fin

funcion suma_de_control con zona y sitio y cuantos
    doblada es dobla con (suma_palabras con zona y sitio y cuantos)
    devuelve 65535 menos doblada
fin

funcion envia_trama con largo
    comparte tramas_enviadas y red_arrancada
    zona es buzon_red
    elemento 41 de zona es cociente con largo y 256
    elemento 42 de zona es largo resto 256
    hecho es pide_a_la_red con ORDEN_ENVIA_RED
    si hecho es mayor que 0
        tramas_enviadas es tramas_enviadas mas 1
    si no si red_como es RED_ENCENDIDA
        red_arrancada es 0
    fin
    devuelve hecho
fin

funcion cabecera_ethernet con zona y destino y que_lleva
    copia_region con zona y 513 y destino y 1 y 6
    copia_region con zona y 519 y mi_mac y 1 y 6
    pon_numero_en con zona y 525 y que_lleva y 2
fin

funcion envia_arp con operacion y mac_a y ip_a
    zona es buzon_red
    cabecera_ethernet con zona y mac_a y 2054
    pon_numero_en con zona y 527 y 1 y 2
    pon_numero_en con zona y 529 y 2048 y 2
    elemento 531 de zona es 6
    elemento 532 de zona es 4
    pon_numero_en con zona y 533 y operacion y 2
    copia_region con zona y 535 y mi_mac y 1 y 6
    pon_numero_en con zona y 541 y mi_ip y 4
    si operacion es 1
        pon_numero_en con zona y 545 y 0 y 6
    si no
        copia_region con zona y 545 y mac_a y 1 y 6
    fin
    pon_numero_en con zona y 551 y ip_a y 4
    devuelve envia_trama con 42
fin

funcion envia_eco con numero
    zona es buzon_red
    cabecera_ethernet con zona y mac_destino y 2048
    elemento 527 de zona es 69
    elemento 528 de zona es 0
    pon_numero_en con zona y 529 y 28 mas largo de DATOS_PING y 2
    pon_numero_en con zona y 531 y numero y 2
    pon_numero_en con zona y 533 y 0 y 2
    elemento 535 de zona es 64
    elemento 536 de zona es 1
    pon_numero_en con zona y 537 y 0 y 2
    pon_numero_en con zona y 539 y mi_ip y 4
    pon_numero_en con zona y 543 y ip_pedida y 4
    pon_numero_en con zona y 537 y (suma_de_control con zona y 527 y 20) y 2
    elemento 547 de zona es 8
    elemento 548 de zona es 0
    pon_numero_en con zona y 549 y 0 y 2
    pon_numero_en con zona y 551 y ID_PING y 2
    pon_numero_en con zona y 553 y numero y 2
    i es 554
    para cada letra en DATOS_PING
        i es i mas 1
        elemento i de zona es letra
    fin
    pon_numero_en con zona y 549 y (suma_de_control con zona y 547 y 8 mas largo de DATOS_PING) y 2
    devuelve envia_trama con 42 mas largo de DATOS_PING
fin

funcion mira_lo_que_llega
    comparte tramas_recibidas
    largo es pide_a_la_red con ORDEN_RECIBE_RED
    si largo es menor que 42 o largo es mayor que TOPE_TRAMA
        devuelve LLEGA_NADA
    fin
    tramas_recibidas es tramas_recibidas mas 1
    zona es buzon_red
    lleva es numero_de con zona y 525 y 2
    si lleva es 2054 y mi_ip no es igual a 0 y (numero_de con zona y 551 y 4) es mi_ip
        operacion es numero_de con zona y 533 y 2
        quien es numero_de con zona y 541 y 4
        si operacion es 1
            copia_region con mac_pregunta y 1 y zona y 535 y 6
            envia_arp con 2 y mac_pregunta y quien
        si no si operacion es 2 y quien es ip_buscada
            copia_region con mac_destino y 1 y zona y 535 y 6
            devuelve LLEGA_ARP
        fin
        devuelve LLEGA_NADA
    fin
    si lleva no es igual a 2048 o (elemento 527 de zona) no es igual a 69
        devuelve LLEGA_NADA
    fin
    si (elemento 536 de zona) es 17 y dhcp_espera no es igual a 0
        devuelve mira_dhcp con zona y largo
    fin
    si (elemento 536 de zona) es 17
        devuelve mira_udp con zona y largo
    fin
    si (elemento 536 de zona) no es igual a 1
        devuelve LLEGA_NADA
    fin
    si (numero_de con zona y 543 y 4) no es igual a mi_ip o (numero_de con zona y 539 y 4) no es igual a ip_pedida
        devuelve LLEGA_NADA
    fin
    si (elemento 547 de zona) es 0 y (numero_de con zona y 551 y 2) es ID_PING y (numero_de con zona y 553 y 2) es eco_esperado
        devuelve LLEGA_ECO
    fin
    devuelve LLEGA_NADA
fin

funcion espera_un_tic
    comparte esperando y despierta_consola_en
    despierta_consola_en es tics mas 1
    desactiva_interrupciones
    mientras tics es menor que despierta_consola_en
        esperando es verdadero
        espera_interrupcion
        esperando es falso
        desactiva_interrupciones
    fin
    despierta_consola_en es 0
    activa_interrupciones
fin

funcion espera_que_llegue con que y plazo
    limite es tics mas plazo
    mientras tics es menor que limite
        van es tramas_recibidas
        visto es mira_lo_que_llega
        si visto es que
            devuelve verdadero
        fin
        si visto es LLEGA_NADA y van es tramas_recibidas
            espera_un_tic
        fin
    fin
    devuelve falso
fin

funcion busca_mac_de con ip
    comparte ip_buscada
    ip_buscada es ip
    para cada intento desde 1 hasta 3
        hecho es envia_arp con 1 y todos y ip
        si hecho es menor que 0
            devuelve hecho
        fin
        si espera_que_llegue con LLEGA_ARP y TICS_POR_SEGUNDO
            devuelve 0
        fin
    fin
    devuelve NADIE_CONTESTA
fin

funcion es_de_aqui con ip
    devuelve (cociente con ip y vecinos) es cociente con mi_ip y vecinos
fin

funcion cuatro_de_azar
    saca_sal con azar_red y 1
    devuelve numero_de con azar_red y 1 y 4
fin

funcion opcion_de_una con zona y i y cual y valor
    elemento i de zona es cual
    elemento i mas 1 de zona es 1
    elemento i mas 2 de zona es valor
    devuelve i mas 3
fin

funcion opcion_de_cuatro con zona y i y cual y valor
    elemento i de zona es cual
    elemento i mas 1 de zona es 4
    pon_numero_en con zona y i mas 2 y valor y 4
    devuelve i mas 6
fin

funcion envia_dhcp con que_digo
    zona es buzon_red
    cabecera_ethernet con zona y todos y 2048
    elemento 527 de zona es 69
    elemento 528 de zona es 0
    pon_numero_en con zona y 529 y 328 y 2
    pon_numero_en con zona y 531 y 0 y 4
    elemento 535 de zona es 64
    elemento 536 de zona es 17
    pon_numero_en con zona y 537 y 0 y 2
    pon_numero_en con zona y 539 y 0 y 4
    pon_numero_en con zona y 543 y 4294967295 y 4
    pon_numero_en con zona y 537 y (suma_de_control con zona y 527 y 20) y 2
    pon_numero_en con zona y 547 y 68 y 2
    pon_numero_en con zona y 549 y 67 y 2
    pon_numero_en con zona y 551 y 308 y 2
    pon_numero_en con zona y 553 y 0 y 2
    para cada i desde 555 hasta 854
        elemento i de zona es 0
    fin
    elemento 555 de zona es 1
    elemento 556 de zona es 1
    elemento 557 de zona es 6
    pon_numero_en con zona y 559 y dhcp_id y 4
    elemento 565 de zona es 128
    copia_region con zona y 583 y mi_mac y 1 y 6
    pon_numero_en con zona y 791 y 1669485411 y 4
    i es opcion_de_una con zona y 795 y 53 y que_digo
    si que_digo es DHCP_PIDE
        i es opcion_de_cuatro con zona y i y 50 y dhcp_ip
        i es opcion_de_cuatro con zona y i y 54 y dhcp_servidor
    fin
    elemento i de zona es 55
    elemento i mas 1 de zona es 3
    elemento i mas 2 de zona es 1
    elemento i mas 3 de zona es 3
    elemento i mas 4 de zona es 6
    elemento i mas 5 de zona es 255
    suma es (suma_palabras con zona y 539 y 8) mas 17 mas 308
    suma es suma mas (suma_palabras con zona y 547 y 308)
    doblada es dobla con suma
    control_udp es 65535 menos doblada
    si control_udp es 0
        control_udp es 65535
    fin
    pon_numero_en con zona y 553 y control_udp y 2
    devuelve envia_trama con 342
fin

funcion lee_opciones_dhcp con zona y i y final
    comparte dhcp_tipo y dhcp_vecinos y dhcp_salida y dhcp_dns y dhcp_servidor y dhcp_dura
    dhcp_tipo es 0
    dhcp_vecinos es 0
    dhcp_salida es 0
    dhcp_dns es 0
    servidor es 0
    dhcp_dura es 0
    mientras i es menor o igual que final
        cual es elemento i de zona
        si cual es 255
            i es final mas 1
        si no si cual es 0
            i es i mas 1
        si no si i mas 1 es mayor que final
            devuelve falso
        si no
            mide es elemento i mas 1 de zona
            si i mas 1 mas mide es mayor que final
                devuelve falso
            fin
            si cual es 53 y mide es 1
                dhcp_tipo es elemento i mas 2 de zona
            si no si cual es 1 y mide es 4
                dhcp_vecinos es 4294967296 menos (numero_de con zona y i mas 2 y 4)
            si no si cual es 3 y mide es mayor o igual que 4
                dhcp_salida es numero_de con zona y i mas 2 y 4
            si no si cual es 6 y mide es mayor o igual que 4
                dhcp_dns es numero_de con zona y i mas 2 y 4
            si no si cual es 51 y mide es 4
                dhcp_dura es numero_de con zona y i mas 2 y 4
            si no si cual es 54 y mide es 4
                servidor es numero_de con zona y i mas 2 y 4
            fin
            i es i mas 2 mas mide
        fin
    fin
    si dhcp_espera es DHCP_OFRECE
        dhcp_servidor es servidor
    fin
    devuelve servidor no es igual a 0 y servidor es dhcp_servidor
fin

funcion es_ip_de_alguien con ip
    primero es cociente con ip y 16777216
    devuelve primero es mayor que 0 y primero es menor que 224 y primero no es igual a 127
fin

funcion es_hueco_bueno con hueco
    n es 4
    mientras n es menor que hueco y n es menor que 16777216
        n es n por 2
    fin
    devuelve n es hueco
fin

funcion mira_dhcp con zona y largo
    comparte dhcp_ip y dhcp_salida y dhcp_dns
    si (numero_de con zona y 547 y 2) no es igual a 67 o (numero_de con zona y 549 y 2) no es igual a 68
        devuelve LLEGA_NADA
    fin
    datos es (numero_de con zona y 551 y 2) menos 8
    si datos es menor que 241 o datos es mayor que largo menos 42
        devuelve LLEGA_NADA
    fin
    si (elemento 555 de zona) no es igual a 2 o (numero_de con zona y 559 y 4) no es igual a dhcp_id
        devuelve LLEGA_NADA
    fin
    para cada i desde 1 hasta 6
        si (elemento 582 mas i de zona) no es igual a (elemento i de mi_mac)
            devuelve LLEGA_NADA
        fin
    fin
    si (numero_de con zona y 791 y 4) no es igual a 1669485411
        devuelve LLEGA_NADA
    fin
    si no (lee_opciones_dhcp con zona y 795 y 554 mas datos)
        devuelve LLEGA_NADA
    fin
    si dhcp_espera es DHCP_ACEPTA y dhcp_tipo es DHCP_NIEGA
        devuelve LLEGA_DHCP
    fin
    si dhcp_tipo no es igual a dhcp_espera
        devuelve LLEGA_NADA
    fin
    ip es numero_de con zona y 571 y 4
    si dhcp_espera es DHCP_ACEPTA y ip no es igual a dhcp_ip
        devuelve LLEGA_NADA
    fin
    si no (es_ip_de_alguien con ip) o no (es_hueco_bueno con dhcp_vecinos)
        devuelve LLEGA_NADA
    fin
    si (ip resto dhcp_vecinos) es 0 o (ip resto dhcp_vecinos) es dhcp_vecinos menos 1
        devuelve LLEGA_NADA
    fin
    si dhcp_salida es ip o (cociente con dhcp_salida y dhcp_vecinos) no es igual a cociente con ip y dhcp_vecinos
        dhcp_salida es 0
    fin
    si no (es_ip_de_alguien con dhcp_dns)
        dhcp_dns es 0
    fin
    dhcp_ip es ip
    devuelve LLEGA_DHCP
fin

funcion pide_direccion
    comparte mi_ip y salida_ip y dns_ip y vecinos y vence_en y dhcp_id y dhcp_espera
    dhcp_id es cuatro_de_azar
    plazo es 2 por TICS_POR_SEGUNDO
    repite 4 veces
        dhcp_espera es DHCP_OFRECE
        hecho es envia_dhcp con DHCP_PREGUNTA
        ofrecida es falso
        si hecho es mayor que 0
            ofrecida es espera_que_llegue con LLEGA_DHCP y plazo
        fin
        si ofrecida
            dhcp_espera es DHCP_ACEPTA
            hecho es envia_dhcp con DHCP_PIDE
            si hecho es mayor que 0 y (espera_que_llegue con LLEGA_DHCP y plazo) y dhcp_tipo es DHCP_ACEPTA
                dhcp_espera es 0
                mi_ip es dhcp_ip
                salida_ip es dhcp_salida
                dns_ip es dhcp_dns
                vecinos es dhcp_vecinos
                dura es dhcp_dura
                si dura es 0 o dura es mayor que TOPE_PRESTAMO
                    dura es TOPE_PRESTAMO
                fin
                vence_en es tics mas dura por (cociente con TICS_POR_SEGUNDO y 2)
                devuelve 0
            fin
        fin
        si hecho es menor que 0
            dhcp_espera es 0
            devuelve hecho
        fin
        plazo es plazo mas TICS_POR_SEGUNDO
    fin
    dhcp_espera es 0
    devuelve SIN_DIRECCION
fin

funcion mira_enlace
    comparte velocidad_red y enlace_movido
    visto es pide_a_la_red con ORDEN_ENLACE_RED
    velocidad_red es 0
    si visto es mayor que 0
        velocidad_red es visto
    fin
    si visto es mayor o igual que 0 y (elemento 57 de buzon_red) es 1
        enlace_movido es verdadero
    fin
    devuelve visto
fin

funcion olvida_direccion
    comparte mi_ip y salida_ip y dns_ip y red_arrancada
    mi_ip es 0
    salida_ip es 0
    dns_ip es 0
    red_arrancada es 0
    inventa_mac
fin

funcion asegura_direccion
    comparte enlace_movido
    si no (red_como es RED_ENCENDIDA)
        devuelve asegura_red
    fin
    hecho es asegura_red
    si hecho es menor que 0
        devuelve hecho
    fin
    visto es mira_enlace
    si visto es mayor que 0 y no enlace_movido y mi_ip no es igual a 0 y tics es menor que vence_en
        devuelve 0
    fin
    si mi_ip no es igual a 0 y (visto es 0 o enlace_movido)
        olvida_direccion
        hecho es asegura_red
        si hecho es menor que 0
            devuelve hecho
        fin
        visto es 0
    fin
    limite es tics mas PLAZO_CABLE
    mientras visto es 0 y tics es menor que limite
        repite 10 veces
            espera_un_tic
        fin
        visto es mira_enlace
    fin
    si visto es menor que 0
        devuelve visto
    fin
    si visto es 0
        al_serie con "red: sin cable"
        escribe ""
        devuelve SIN_CABLE
    fin
    visto es mira_enlace
    enlace_movido es falso
    hecho es pide_direccion
    si hecho es 0
        al_serie con "red: dirección "
        al_serie con (escribe_ip con mi_ip)
        escribe ""
        desactiva_interrupciones
        apunta con R_DIRECCION y (escribe_ip con mi_ip) y BLANCO y 0
        activa_interrupciones
    si no
        al_serie con "red: nadie me da dirección"
        escribe ""
        desactiva_interrupciones
        apunta con R_SIN_DIRECCION y "FalOS" y BLANCO y 0
        activa_interrupciones
    fin
    devuelve hecho
fin

funcion lee_ip con primera
    si primera es mayor que escritas
        devuelve 0
    fin
    ip es 0
    parte es 0
    digitos es 0
    puntos es 0
    para cada i desde primera hasta escritas
        letra es elemento i de orden
        si letra es 46
            si digitos es 0
                devuelve 0
            fin
            ip es ip por 256 mas parte
            parte es 0
            digitos es 0
            puntos es puntos mas 1
        si no si letra es mayor o igual que 48 y letra es menor o igual que 57
            parte es parte por 10 mas letra menos 48
            digitos es digitos mas 1
            si parte es mayor que 255 o digitos es mayor que 3
                devuelve 0
            fin
        si no
            devuelve 0
        fin
    fin
    si puntos no es igual a 3 o digitos es 0
        devuelve 0
    fin
    devuelve ip por 256 mas parte
fin

funcion escribe_ip con ip
    comparte ip_texto_mide
    ip_texto_mide es 0
    para cada parte desde 1 hasta 4
        trozo es (cociente con ip y (potencia_de_256 con 4 menos parte)) resto 256
        si trozo es mayor o igual que 100
            ip_texto_mide es ip_texto_mide mas 1
            elemento ip_texto_mide de ip_texto es 48 mas cociente con trozo y 100
        fin
        si trozo es mayor o igual que 10
            ip_texto_mide es ip_texto_mide mas 1
            elemento ip_texto_mide de ip_texto es 48 mas (cociente con trozo y 10) resto 10
        fin
        ip_texto_mide es ip_texto_mide mas 1
        elemento ip_texto_mide de ip_texto es 48 mas trozo resto 10
        si parte es menor que 4
            ip_texto_mide es ip_texto_mide mas 1
            elemento ip_texto_mide de ip_texto es 46
        fin
    fin
    devuelve region con red_en mas 64 y ip_texto_mide
fin

funcion potencia_de_256 con cuantas
    n es 1
    repite cuantas veces
        n es n por 256
    fin
    devuelve n
fin

funcion cifra_hexadecimal con n
    si n es menor que 10
        devuelve 48 mas n
    fin
    devuelve 87 mas n
fin

funcion pinta_mac con mac
    para cada i desde 1 hasta 6
        pon_letra con (cifra_hexadecimal con (cociente con (elemento i de mac) y 16))
        pon_letra con (cifra_hexadecimal con ((elemento i de mac) resto 16))
        si i es menor que 6
            pinta con ":"
        fin
    fin
fin

funcion fallo_de_red con motivo
    pon_color con ROJO_CLARO y NEGRO
    si motivo es NO_HAY_TARJETA
        pinta_linea con "  La tarjeta no contesta."
    si no si motivo es NO_SALE
        pinta_linea con "  La tarjeta no ha podido enviarlo."
    si no si motivo es SIN_CABLE
        pinta_linea con "  No hay cable de red, o el otro lado está apagado."
    si no si motivo es SIN_DIRECCION
        pinta_linea con "  Nadie en esta red me da una dirección."
    si no
        pinta_linea con "  El programa de la red ha caído antes de contestar."
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion sin_tarjeta
    pon_color con ROJO_CLARO y NEGRO
    si red_como es RED_SIN_IOMMU
        pinta_linea con "  Hay una tarjeta de red Intel, pero no la enciendo: sin IOMMU podría leer"
        pinta_linea con "  y escribir toda la memoria. Mira dma."
    si no si red_como es RED_SIN_CUBRIR
        pinta_linea con "  Hay una tarjeta de red Intel, pero no la enciendo: el IOMMU no la vigila."
    si no si red_como es RED_RARA
        pinta_linea con "  Hay una tarjeta de red Intel, pero no la sé usar como está puesta."
    si no si red_como es RED_SE_CAE
        pinta_linea con "  El controlador de la red se caía en cuanto arrancaba, y ya no lo lanzo."
    si no si disco_en_memoria
        pinta_linea con "  Este ordenador no tiene una tarjeta de red de las que sé usar: la NE2000"
        pinta_linea con "  y las Intel I217, I218 y 82574. Así que aquí no salgo a la red."
    si no
        pinta_linea con "  No hay tarjeta de red. FalOS sabe usar la NE2000: arráncalo con"
        pinta_linea con "  -nic user,model=ne2k_pci"
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    al_serie con "red: no hay tarjeta"
    escribe ""
fin

funcion conexion_de con t
    mide es 0
    nombre es nombre_de con t
    para cada b en nombre
        mide es mide mas 1
        elemento mide de conexion es b
    fin
    mide es mide mas 1
    elemento mide de conexion es 32
    destino es elemento t de destino_de
    si destino es menor que 65536
        para cada b en "el DNS de la red"
            mide es mide mas 1
            elemento mide de conexion es b
        fin
        devuelve region con red_en mas 128 y mide
    fin
    texto es escribe_ip con (cociente con destino y 65536)
    para cada b en texto
        mide es mide mas 1
        elemento mide de conexion es b
    fin
    mide es mide mas 1
    elemento mide de conexion es 58
    puerto es destino resto 65536
    tope es 1
    mientras tope por 10 es menor o igual que puerto
        tope es tope por 10
    fin
    mientras tope es mayor que 0
        mide es mide mas 1
        elemento mide de conexion es 48 mas (cociente con puerto y tope) resto 10
        tope es cociente con tope y 10
    fin
    devuelve region con red_en mas 128 y mide
fin

funcion pinta_puerto con puerto
    si puerto es 53
        pinta con " (DNS)"
    si no si puerto es 123
        pinta con " (la hora)"
    si no si puerto es 80
        pinta con " (web)"
    si no si puerto es 443
        pinta con " (web cifrada)"
    fin
fin

funcion pinta_destino con destino
    si destino es menor que 65536
        pinta con "el DNS de esta red"
        devuelve nada
    fin
    pinta con (escribe_ip con (cociente con destino y 65536))
    pinta con ":"
    pinta_numero con destino resto 65536
fin

funcion pide_permiso_red con t
    comparte columna y foco
    foco es CONSOLA
    olvida_seleccion
    base es (fila menos 1) por ANCHO
    para cada c desde 1 hasta ANCHO
        elemento base mas c de pantalla es color por 256 mas 32
    fin
    columna es 1
    destino es elemento t de destino_de
    puerto es destino resto 65536
    mandaria es (elemento t de cuantos_de) menos 6
    pon_color con (color_de con t) y NEGRO
    pinta con "  "
    pinta con (nombre_de con t)
    pon_color con BLANCO y NEGRO
    si destino es menor que 65536
        pinta con " quiere preguntar al DNS de esta red"
        si dns_ip no es igual a 0
            pinta con ", "
            pinta con (escribe_ip con dns_ip)
        fin
    si no
        pinta con " quiere conectarse a "
        pinta con (escribe_ip con (cociente con destino y 65536))
    fin
    pinta con ", puerto "
    pinta_numero con puerto
    pinta_puerto con puerto
    pinta_linea con "."
    pon_color con GRIS y NEGRO
    pinta con "  Mandaría "
    pinta_numero con mandaria
    si mandaria es 1
        pinta con " byte. Si le dejas: deja "
    si no
        pinta con " bytes. Si le dejas: deja "
    fin
    pinta_numero con t
    pinta con ". Si no: niega "
    pinta_numero con t
    pinta_linea con "."
    si mi_ip es 0 y hay_red
        pinta_linea con "  Como aún no tengo dirección en esta red, antes le pediría una."
    fin
    pinta_linea con "  Hasta que me contestes, espera, y no sale nada. Y escondo las"
    pinta_linea con "  ventanas, para que ninguna tape esto ni pinte una pregunta falsa."
    pinta_linea con ""
    al_serie con (nombre_de con t)
    escribe " pide permiso para conectarse"
    vuelve_la_consola
fin

funcion decide_red con t y permiso
    comparte hay_encargos
    texto es conexion_de con t
    desactiva_interrupciones
    elemento t de permiso_red es permiso
    hay_encargos es verdadero
    si permiso es DISCO_SI
        apunta con R_DEJASTE_RED y texto y (color_de con t) y 0
    si no
        apunta con R_NEGASTE_RED y texto y (color_de con t) y 0
    fin
    activa_interrupciones
    destino es elemento t de destino_de
    pinta con "  "
    si permiso es DISCO_SI
        pon_color con VERDE_CLARO y NEGRO
        pinta con (nombre_de con t)
        pinta con " puede hablar con "
        pinta_destino con destino
        pinta_linea con " hasta que se cierre. Con nadie más."
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta con (nombre_de con t)
        pinta con " no se conectará a "
        pinta_destino con destino
        pinta_linea con ". No ha salido nada."
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion atiende_red con t
    destino es elemento t de destino_de
    permiso es elemento t de permiso_red
    si destino no es igual a (elemento t de destino_permiso)
        permiso es DISCO_SIN_PEDIR
    fin
    si permiso es DISCO_SIN_PEDIR
        elemento t de permiso_red es DISCO_PEDIDO
        elemento t de destino_permiso es destino
        pide_permiso_red con t
    si no si permiso es DISCO_SI
        termina_conexion con t y (conecta_de con t)
    si no si permiso es DISCO_NO
        termina_conexion con t y NEGADO
    fin
fin

funcion conecta_de con t
    comparte udp_ip y udp_puerto y udp_local y udp_tarea y udp_recibidos y red_lo_usa y aviso_red_hasta y aviso_ip_mide
    si no hay_red
        devuelve NO_HAY_TARJETA
    fin
    hecho es asegura_direccion
    si hecho es menor que 0
        devuelve hecho
    fin
    destino es elemento t de destino_de
    udp_ip es cociente con destino y 65536
    si udp_ip es 0
        udp_ip es dns_ip
    fin
    si udp_ip es 0
        devuelve NADIE_CONTESTA
    fin
    udp_puerto es destino resto 65536
    udp_local es 49152 mas cuatro_de_azar resto 16384
    udp_recibidos es 0
    texto es escribe_ip con udp_ip
    copia_region con aviso_ip y 1 y texto y 1 y largo de texto
    aviso_ip_mide es largo de texto
    red_lo_usa es t
    plazo es 3 por TICS_POR_SEGUNDO
    aviso_red_hasta es tics mas plazo
    ensucia
    salto es salida_ip
    si es_de_aqui con udp_ip
        salto es udp_ip
    fin
    si salto es 0
        devuelve NADIE_CONTESTA
    fin
    hecho es busca_mac_de con salto
    si hecho es menor que 0
        devuelve hecho
    fin
    udp_tarea es t
    hecho es envia_udp con t
    si hecho es menor que 0
        udp_tarea es 0
        devuelve hecho
    fin
    llego es espera_que_llegue con LLEGA_UDP y plazo
    udp_tarea es 0
    aviso_red_hasta es tics mas plazo
    si llego
        devuelve udp_recibidos
    fin
    devuelve NADIE_CONTESTA
fin

funcion envia_udp con t
    zona es buzon_red
    datos es (elemento t de cuantos_de) menos 6
    pedida es region con (elemento t de mesas) mas (elemento t de desde_de) y (elemento t de cuantos_de)
    cabecera_ethernet con zona y mac_destino y 2048
    elemento 527 de zona es 69
    elemento 528 de zona es 0
    pon_numero_en con zona y 529 y 28 mas datos y 2
    pon_numero_en con zona y 531 y tramas_enviadas resto 65536 y 2
    pon_numero_en con zona y 533 y 0 y 2
    elemento 535 de zona es 64
    elemento 536 de zona es 17
    pon_numero_en con zona y 537 y 0 y 2
    pon_numero_en con zona y 539 y mi_ip y 4
    pon_numero_en con zona y 543 y udp_ip y 4
    pon_numero_en con zona y 537 y (suma_de_control con zona y 527 y 20) y 2
    pon_numero_en con zona y 547 y udp_local y 2
    pon_numero_en con zona y 549 y udp_puerto y 2
    pon_numero_en con zona y 551 y 8 mas datos y 2
    pon_numero_en con zona y 553 y 0 y 2
    copia_region con zona y 555 y pedida y 7 y datos
    suma es (suma_palabras con zona y 539 y 8) mas 17 mas 8 mas datos
    suma es suma mas (suma_palabras con zona y 547 y 8 mas datos)
    doblada es dobla con suma
    control_udp es 65535 menos doblada
    si control_udp es 0
        control_udp es 65535
    fin
    pon_numero_en con zona y 553 y control_udp y 2
    devuelve envia_trama con 42 mas datos
fin

funcion mira_udp con zona y largo
    comparte udp_recibidos
    si udp_tarea es 0
        devuelve LLEGA_NADA
    fin
    si (numero_de con zona y 543 y 4) no es igual a mi_ip o (numero_de con zona y 539 y 4) no es igual a udp_ip
        devuelve LLEGA_NADA
    fin
    si (numero_de con zona y 547 y 2) no es igual a udp_puerto o (numero_de con zona y 549 y 2) no es igual a udp_local
        devuelve LLEGA_NADA
    fin
    datos es (numero_de con zona y 551 y 2) menos 8
    cabe_trama es largo menos 42
    si datos es menor que 0 o datos es mayor que cabe_trama
        devuelve LLEGA_NADA
    fin
    desde es elemento udp_tarea de desde_de
    cabe es PAGINA menos desde
    si datos es mayor que cabe
        datos es cabe
    fin
    suya es region con (elemento udp_tarea de mesas) mas desde y cabe
    copia_region con suya y 1 y zona y 555 y datos
    udp_recibidos es datos
    devuelve LLEGA_UDP
fin

funcion termina_conexion con t y hecho
    texto es conexion_de con t
    al_serie con (nombre_de con t)
    escribe " habló con la red: " sin salto
    escribe hecho
    desactiva_interrupciones
    si hecho es NEGADO
        apunta con R_RED_NEGADA y texto y (color_de con t) y 0
    si no si hecho es mayor que 0
        apunta con R_HABLO y texto y (color_de con t) y hecho
    si no
        apunta con R_HABLO y texto y (color_de con t) y 0
    fin
    si (elemento t de estados_tarea) es CON_LA_RED
        despierta_con con t y hecho
    fin
    activa_interrupciones
fin

funcion pinta_direccion
    pinta con "  Me presento como "
    pon_color con VERDE_CLARO y NEGRO
    pinta_mac con mi_mac
    pon_color con GRIS y NEGRO
    pinta_linea con ", recién inventada. La de verdad no sale."
    pinta con "  La red me da "
    pinta con (escribe_ip con mi_ip)
    si salida_ip no es igual a 0
        pinta con ". Se sale por "
        pinta con (escribe_ip con salida_ip)
    fin
    pinta_linea con "."
fin

funcion orden_ping con primera
    comparte usando_red y ip_pedida y eco_esperado
    si no hay_red
        sin_tarjeta
        devuelve nada
    fin
    ip_pedida es 0
    si primera es mayor que 0
        ip_pedida es lee_ip con primera
    fin
    si primera es mayor que 0 y ip_pedida es 0
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  Eso no es una dirección. Prueba: ping 1.1.1.1"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    tenia es mi_ip
    si tenia es 0
        pinta_linea con "  Espero a que la tarjeta enganche, y le pido una dirección a la red..."
    fin
    hecho es asegura_direccion
    si hecho es menor que 0
        fallo_de_red con hecho
        devuelve nada
    fin
    si mi_ip no es igual a tenia
        pinta_direccion
    fin
    si ip_pedida es 0
        ip_pedida es salida_ip
    fin
    salto es salida_ip
    si es_de_aqui con ip_pedida
        salto es ip_pedida
    fin
    si salto es 0
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  Esta red no me ha dicho por dónde se sale."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    pinta con "  Ping a "
    pinta con (escribe_ip con ip_pedida)
    pinta con " desde "
    pinta con (escribe_ip con mi_ip)
    pinta_linea con ". Sale porque lo has pedido tú."
    texto es escribe_ip con ip_pedida
    usando_red es verdadero
    ensucia
    hecho es busca_mac_de con salto
    si hecho es menor que 0
        usando_red es falso
        ensucia
        si hecho es NADIE_CONTESTA
            pon_color con ROJO_CLARO y NEGRO
            pinta_linea con "  Nadie en la red dice tener esa dirección."
            pon_color con GRIS y NEGRO
            pinta_linea con ""
        si no
            fallo_de_red con hecho
        fin
        desactiva_interrupciones
        apunta con R_PING y texto y BLANCO y 0
        activa_interrupciones
        al_serie con "ping: nadie contesta"
        escribe ""
        devuelve nada
    fin
    pon_color con GRIS_OSCURO y NEGRO
    si salto es ip_pedida
        pinta con "  Su tarjeta es la "
    si no
        pinta con "  La salida de la red, "
        pinta con (escribe_ip con salida_ip)
        pinta con ", es la tarjeta "
        texto es escribe_ip con ip_pedida
    fin
    pinta_mac con mac_destino
    pinta_linea con "."
    pon_color con GRIS y NEGRO
    llegadas es 0
    para cada numero desde 1 hasta PINGS
        eco_esperado es numero
        enviado_en es tics
        hecho es envia_eco con numero
        si hecho es menor que 0
            fallo_de_red con hecho
        si no si espera_que_llegue con LLEGA_ECO y TICS_POR_SEGUNDO
            llegadas es llegadas mas 1
            tardo es (tics menos enviado_en) por 10
            pinta con "  Respuesta de "
            pinta con texto
            pinta con ": "
            pinta_numero con largo de DATOS_PING
            si tardo es 0
                pinta_linea con " bytes, en menos de 10 ms"
            si no
                pinta con " bytes, en "
                pinta_numero con tardo
                pinta_linea con " ms"
            fin
            al_serie con "ping: respuesta "
            escribe numero
        si no
            pinta_linea con "  No contesta."
        fin
        mientras numero es menor que PINGS y tics es menor que enviado_en mas TICS_POR_SEGUNDO
            espera_un_tic
        fin
    fin
    usando_red es falso
    ensucia
    pinta con "  "
    pinta_numero con PINGS
    pinta con " enviados, "
    pinta_numero con llegadas
    pinta_linea con " recibidos."
    pinta_linea con "  Lo pediste tú. Un programa solo sale a la red si tú le dejas."
    pinta_linea con ""
    desactiva_interrupciones
    apunta con R_PING y texto y BLANCO y llegadas
    activa_interrupciones
    al_serie con "ping: "
    al_serie con texto
    al_serie con " contesta "
    escribe llegadas
fin

APARATO_EDU es 300421684
BUFFER_EDU es 262144
DE_LA_MEMORIA es 1
A_LA_MEMORIA es 3
BYTES_DMA es 16
primera_falta es 0
trozo_del_aparato es 0

funcion pon_pci con ranura y registro y valor
    pon_doble con PCI_DIRECCION y PCI_ACTIVO mas ranura por 2048 mas registro
    pon_doble con PCI_DATOS y valor
fin

funcion cuenta_faltas
    comparte primera_falta
    si no hay_iommu
        devuelve 0
    fin
    r es region con registros_iommu y 1024 y 4
    vistas es 0
    para cada i desde 0 hasta faltas_cuantas menos 1
        k es faltas_en mas i por 4
        arriba_falta es elemento k mas 3 de r
        si ((cociente con arriba_falta y BIT_31) resto 2) es 1
            si vistas es 0
                primera_falta es (elemento k de r) menos (elemento k de r) resto PAGINA mas (elemento k mas 1 de r) por 4294967296
            fin
            vistas es vistas mas 1
            elemento k mas 3 de r es BIT_31
        fin
    fin
    elemento 14 de r es 1
    devuelve vistas
fin

funcion dma_edu con aparato y origen y destino y sentido
    r es region con aparato y 64 y 8
    elemento 17 de r es origen
    elemento 18 de r es destino
    elemento 19 de r es BYTES_DMA
    elemento 20 de r es sentido
    empezo es tics
    mientras ((elemento 20 de r) resto 2) es 1 y tics menos empezo es menor que TICS_POR_SEGUNDO
    fin
fin

funcion bytes_iguales con a y b
    para cada i desde 1 hasta BYTES_DMA
        si (elemento i de a) no es igual a (elemento i de b)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion pinta_byte con b
    cifras_de es "0123456789ABCDEF"
    pon_letra con elemento (cociente con b y 16) mas 1 de cifras_de
    pon_letra con elemento (b resto 16) mas 1 de cifras_de
    mueve_cursor
fin

funcion pinta_estado_iommu
    si hay_iommu
        pon_color con VERDE_CLARO y NEGRO
        pinta con "  IOMMU encendido"
        pon_color con GRIS y NEGRO
        pinta con ", en "
        pinta_hex con fisica_iommu
        pinta_linea con ". Ningún aparato de los que vigila"
        pinta_linea con "  toca la memoria si no le doy un trozo."
        si rmrr_cuantos es mayor que 0
            pinta con "  La BIOS ha pedido "
            pinta_numero con rmrr_cuantos
            pinta_linea con " trozos para sus aparatos, y se los he dado."
        fin
        si unidad_grafica
            pinta_linea con "  La unidad que vigila la tarjeta gráfica la dejo apagada."
        fin
        si unidades_sin_tocar es mayor que 0
            pon_color con AMARILLO y NEGRO
            pinta con "  Hay "
            pinta_numero con unidades_sin_tocar
            pinta_linea con " unidades más que aún no sé encender."
            pon_color con GRIS y NEGRO
        fin
        si interrupciones_cerradas
            pinta_linea con "  Y ninguno de esos puede fingir una interrupción."
        si no
            pon_color con AMARILLO y NEGRO
            pinta_linea con "  Pero todavía pueden fingir una interrupción."
            pon_color con GRIS y NEGRO
        fin
        devuelve nada
    fin
    pon_color con ROJO_CLARO y NEGRO
    si por_que_no_iommu es IOMMU_SIN_ACPI
        pinta_linea con "  No hay IOMMU: no encuentro las tablas ACPI que dicen dónde está."
    si no si por_que_no_iommu es IOMMU_SIN_DMAR
        pinta_linea con "  No hay IOMMU: este ordenador no tiene, o está apagado en la BIOS."
    si no si por_que_no_iommu es IOMMU_RMRR_RARO
        pinta_linea con "  No enciendo el IOMMU: la BIOS pide trozos que no sé dar."
    si no si por_que_no_iommu es IOMMU_SIN_NIVELES
        pinta_linea con "  No enciendo el IOMMU: sus tablas no son de 3 ni de 4 niveles."
    si no si por_que_no_iommu es IOMMU_LO_PEDISTE
        pinta_linea con "  No enciendo el IOMMU: me lo pediste al arrancar, con sin_iommu."
    si no
        pinta_linea con "  No enciendo el IOMMU: no responde."
    fin
    pinta_linea con "  Cualquier aparato puede leer y escribir toda la memoria."
    pon_color con GRIS y NEGRO
fin

funcion pinta_por_que_no_usb
    pon_color con AMARILLO y NEGRO
    si usb_como es USB_NO_HAY
        pinta_linea con "  No encuentro ningún controlador USB 3 (xHCI)."
    si no si usb_como es USB_SIN_IOMMU
        pinta_linea con "  Hay un controlador USB, pero no lo enciendo: sin IOMMU podría leer y"
        pinta_linea con "  escribir toda la memoria. Mira dma."
    si no si usb_como es USB_SIN_CUBRIR
        pinta_linea con "  Hay un controlador USB, pero no lo enciendo: el IOMMU no lo vigila."
    si no si usb_como es USB_NO_PARA
        pinta_linea con "  Hay un controlador USB, pero no me obedece, y no lo enciendo."
    si no si usb_como es USB_RARO
        pinta_linea con "  Hay un controlador USB con los registros donde no los sé usar."
    si no
        pinta_linea con "  El controlador USB se caía en cuanto arrancaba, y ya no lo lanzo."
    fin
    pon_color con GRIS y NEGRO
fin

funcion pinta_cuatro_hex con n
    pinta_byte con cociente con n y 256
    pinta_byte con n resto 256
fin

funcion orden_usb
    si usb_como no es igual a USB_LISTO
        pinta_por_que_no_usb
        pinta_linea con ""
        al_serie con "usb: apagado, motivo "
        escribe usb_como
        devuelve nada
    fin
    pinta con "  Controlador xHCI "
    pinta_cuatro_hex con usb_quien resto 65536
    pinta con ":"
    pinta_cuatro_hex con cociente con usb_quien y 65536
    pinta con ", en la ranura "
    pinta_numero con usb_ranura
    pinta_linea con ". Lo lleva un programa sin"
    pinta con "  permisos, y el aparato solo alcanza "
    pinta_numero con PAGINAS_USB
    pinta_linea con " páginas: lo vigila el IOMMU."
    buzon es region con (elemento TAREA_USB de buzones) y 1024 y 4
    si (elemento 2 de buzon) no es igual a 1
        pon_color con AMARILLO y NEGRO
        pinta con "  Todavía no funciona. Dice "
        pinta_numero con elemento 2 de buzon
        pinta_linea con "."
        pon_color con GRIS y NEGRO
    fin
    vistos es 0
    para cada p desde 1 hasta TOPE_DE_PUERTOS
        si (elemento 512 mas (p menos 1) por 4 mas 4 de buzon) no es igual a 0
            vistos es vistos mas 1
            linea_de_puerto con p y (elemento 512 mas (p menos 1) por 4 mas 1 de buzon) y (elemento 512 mas (p menos 1) por 4 mas 2 de buzon)
        fin
    fin
    si vistos es 0
        pinta_linea con "  No hay nada enchufado."
    fin
    pinta_linea con ""
    al_serie con "usb: en marcha, enchufados "
    escribe vistos
fin

funcion linea_de_puerto con p y clase y quien
    pinta con "  puerto "
    pinta_numero con p
    hasta_columna con 14
    pinta_cuatro_hex con cociente con quien y 65536
    pinta con ":"
    pinta_cuatro_hex con quien resto 65536
    hasta_columna con 26
    suyo es elemento p de puertos_usb
    si clase es 1 y suyo es USB_ACEPTADO
        pon_color con VERDE_CLARO y NEGRO
        pinta_linea con "teclado"
    si no si clase es 1 y suyo es USB_IGNORADO
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "teclado, y no le hago caso: falló el código 3 veces"
    si no si clase es 1
        pon_color con AMARILLO y NEGRO
        pinta_linea con "teclado, y no le hago caso hasta que teclee el código"
    si no si clase es 2
        pinta_linea con "no es un teclado ni mi pendrive, y no lo uso"
    si no si clase es 3
        pon_color con AMARILLO y NEGRO
        pinta_linea con "no me entiendo con él"
    si no si clase es 4
        pinta_linea con "no cabe: solo llevo 4 aparatos a la vez"
    si no si clase es 5
        pon_color con VERDE_CLARO y NEGRO
        pinta_linea con "el pendrive de FalOS"
    si no si clase es 6
        pinta_linea con "un pendrive, y no es el de FalOS: no lo toco"
    si no
        pinta_linea con "recién enchufado"
    fin
    pon_color con GRIS y NEGRO
fin

funcion orden_dma
    comparte trozo_del_aparato y probando_dma
    pinta_estado_iommu
    ranura es 0 menos 1
    para cada r desde 0 hasta 31
        si ranura es menor que 0 y (lee_pci con r y 0) es APARATO_EDU
            ranura es r
        fin
    fin
    si ranura es menor que 0
        pinta_linea con "  Para probarlo hace falta el aparato de prueba de QEMU: -device edu"
        pinta_linea con ""
        al_serie con "dma: no hay aparato de prueba"
        escribe ""
        devuelve nada
    fin
    barra_pci es lee_pci con ranura y BAR_0
    mando es (lee_pci con ranura y 4) resto 65536
    mando es (sin_bit con (sin_bit con mando y 4) y 2) mas 6
    pon_pci con ranura y 4 y mando
    aparato es por_ventana con HUECO_APARATO y (barra_pci menos barra_pci resto 16)
    si trozo_del_aparato es 0
        trozo_del_aparato es pide_pagina
        si hay_iommu
            arriba es dominio_de con 0 y ranura y 0
            mapea_para_aparato con arriba y trozo_del_aparato y trozo_del_aparato y 3
            olvidado es iommu_olvida
        fin
    fin
    probando_dma es verdadero
    cuenta_faltas
    trozo es trozo_del_aparato
    ajena es pide_pagina
    suyo es region con trozo y PAGINA
    otra es region con ajena y BYTES_DMA
    para cada i desde 1 hasta PAGINA
        elemento i de suyo es 0
    fin
    para cada i desde 1 hasta BYTES_DMA
        elemento i de suyo es i por 13
        elemento i de otra es 255
    fin
    dma_edu con aparato y trozo y BUFFER_EDU y DE_LA_MEMORIA
    dma_edu con aparato y BUFFER_EDU y trozo mas 2048 y A_LA_MEMORIA
    copia_bien es bytes_iguales con suyo y (region con trozo mas 2048 y BYTES_DMA)
    codigo es region con inicio_del_codigo y BYTES_DMA
    dma_edu con aparato y inicio_del_codigo y BUFFER_EDU y DE_LA_MEMORIA
    dma_edu con aparato y BUFFER_EDU y trozo mas 1024 y A_LA_MEMORIA
    leido es region con trozo mas 1024 y BYTES_DMA
    lo_ha_leido es bytes_iguales con codigo y leido
    faltas_leyendo es cuenta_faltas
    leyendo_en es primera_falta
    dma_edu con aparato y trozo y BUFFER_EDU y DE_LA_MEMORIA
    dma_edu con aparato y BUFFER_EDU y ajena y A_LA_MEMORIA
    intacta es verdadero
    para cada i desde 1 hasta BYTES_DMA
        si (elemento i de otra) no es igual a 255
            intacta es falso
        fin
    fin
    faltas_escribiendo es cuenta_faltas
    escribiendo_en es primera_falta
    faltas es faltas_leyendo mas faltas_escribiendo
    probando_dma es falso
    suelta_pagina con ajena
    pinta con "  El aparato de prueba, en la ranura "
    pinta_numero con ranura
    pinta con ", tiene una página suya, la "
    pinta_hex con trozo
    pinta_linea con "."
    pinta con "  Copiar dentro de su página:"
    hasta_columna con 45
    si copia_bien
        pon_color con VERDE_CLARO y NEGRO
        pinta_linea con "bien"
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "no ha podido"
    fin
    pon_color con GRIS y NEGRO
    pinta con "  Leer mi código, en "
    pinta_hex con inicio_del_codigo
    pinta con ":"
    hasta_columna con 45
    si lo_ha_leido
        pon_color con ROJO_CLARO y NEGRO
        pinta con "lo ha leído:"
        para cada i desde 1 hasta 4
            pinta con " "
            pinta_byte con elemento i de leido
        fin
        pinta_linea con ""
    si no si faltas_leyendo es mayor que 0
        pon_color con VERDE_CLARO y NEGRO
        pinta_linea con "bloqueado"
    si no
        pon_color con AMARILLO y NEGRO
        pinta_linea con "no lo ha leído, y no sé por qué"
    fin
    pon_color con GRIS y NEGRO
    pinta con "  Escribir en una página que no es suya:"
    hasta_columna con 45
    si intacta y faltas_escribiendo es mayor que 0
        pon_color con VERDE_CLARO y NEGRO
        pinta_linea con "bloqueado"
    si no si intacta
        pon_color con AMARILLO y NEGRO
        pinta_linea con "no la ha escrito, y no sé por qué"
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "la ha escrito"
    fin
    pon_color con GRIS y NEGRO
    si faltas_leyendo es 1 y faltas_escribiendo es 1
        pinta con "  El IOMMU ha apuntado los dos intentos: leer "
        pinta_hex con leyendo_en
        pinta_linea con ""
        pinta con "  y escribir en "
        pinta_hex con escribiendo_en
        pinta_linea con "."
    si no si faltas es mayor que 0
        pinta con "  El IOMMU ha apuntado "
        pinta_numero con faltas
        pinta_linea con " intentos."
    fin
    pinta_linea con ""
    al_serie con "dma: copia "
    si copia_bien
        al_serie con "bien"
    si no
        al_serie con "mal"
    fin
    si lo_ha_leido
        al_serie con ", lee el núcleo"
    si no
        al_serie con ", lee bloqueado"
    fin
    si intacta
        al_serie con ", escribe bloqueado, faltas "
    si no
        al_serie con ", escribe en lo ajeno, faltas "
    fin
    escribe faltas
fin

funcion orden_red_intel
    visto es mira_enlace
    pinta con "  Tarjeta de red Intel "
    pinta_cuatro_hex con red_quien resto 65536
    pinta con ":"
    pinta_cuatro_hex con cociente con red_quien y 65536
    pinta con ", en la ranura "
    pinta_numero con red_ranura
    pinta_linea con ". La lleva un programa sin"
    pinta con "  permisos, y el aparato solo alcanza "
    pinta_numero con PAGINAS_RED
    pinta_linea con " páginas: lo vigila el IOMMU."
    si visto es mayor que 0
        pinta con "  Cable enganchado, a "
        pinta_numero con visto
        pinta_linea con " Mb por segundo."
    si no si visto es 0
        pinta_linea con "  Sin cable, o todavía enganchando."
    si no
        pinta_linea con "  La tarjeta no contesta."
    fin
    pinta con "  Me presento como "
    pinta_mac con mi_mac
    pinta_linea con ", inventada. La de verdad no sale."
    si mi_ip es 0
        pinta_linea con "  Aún no le he pedido dirección a la red: solo al usarla, con ping."
    si no
        pinta con "  La red me ha dado "
        pinta con (escribe_ip con mi_ip)
        pinta_linea con "."
    fin
    pinta con "  Han salido "
    pinta_numero con tramas_enviadas
    pinta con " tramas y han llegado "
    pinta_numero con tramas_recibidas
    pinta_linea con "."
    si visto es mayor o igual que 0
        zona es buzon_red
        pon_color con GRIS_OSCURO y NEGRO
        pinta con "  Para avisarme si falla: estado "
        pinta_al_reves con zona y 49
        pinta con ", mando "
        pinta_al_reves con zona y 53
        pinta con ", cable "
        pinta_byte con elemento 58 de zona
        pinta_byte con elemento 59 de zona
        pinta_linea con "."
        pon_color con GRIS y NEGRO
    fin
    pinta_linea con ""
    al_serie con "red: intel, cable a "
    escribe visto sin salto
    al_serie con ", enviadas "
    escribe tramas_enviadas
fin

funcion pinta_al_reves con zona y sitio
    i es 3
    mientras i es mayor o igual que 0
        pinta_byte con elemento sitio mas i de zona
        i es i menos 1
    fin
fin

funcion orden_red
    si no hay_red
        sin_tarjeta
        devuelve nada
    fin
    hecho es asegura_red
    si hecho es menor que 0
        fallo_de_red con hecho
        devuelve nada
    fin
    si red_como es RED_ENCENDIDA
        orden_red_intel
        devuelve nada
    fin
    pinta con "  Tarjeta de red NE2000, en los puertos del "
    pinta_numero con puerto_red
    pinta con " al "
    pinta_numero con puerto_red mas 31
    pinta_linea con "."
    pinta con "  Su dirección es "
    pinta_mac con mi_mac
    pinta_linea con ", y la mía en la red, 10.0.2.15."
    pinta con "  Han salido "
    pinta_numero con tramas_enviadas
    pinta con " tramas y han llegado "
    pinta_numero con tramas_recibidas
    pinta_linea con "."
    pinta_linea con "  Salen con ping, o cuando dejas a un programa hablar con alguien, y"
    pinta_linea con "  solo con ese. El programa que maneja la tarjeta solo toca sus 32 puertos."
    pinta_linea con ""
    al_serie con "red: enviadas "
    escribe tramas_enviadas
fin

funcion pide_al_pen con pedido
    comparte peticion_pen y pen_listo y esperando
    recoge_tareas con falso
    desactiva_interrupciones
    si no pen_presente
        activa_interrupciones
        devuelve FALTA_PENDRIVE
    fin
    si pedido es mayor que PIDE_DISCO y pen_veces no es igual a pen_validada
        activa_interrupciones
        devuelve OTRO_PENDRIVE
    fin
    pen_listo es falso
    peticion_pen es verdadero
    limite es tics mas PLAZO_PENDRIVE
    avisa_a con TAREA_USB y pedido
    mientras no pen_listo
        si tics es mayor que limite y sigue_viva con TAREA_USB
            cierra_tarea con TAREA_USB y SE_COLGO
        si no
            esperando es verdadero
            espera_interrupcion
            esperando es falso
            desactiva_interrupciones
        fin
    fin
    pen_listo es falso
    activa_interrupciones
    si resultado_pen es 0
        devuelve 0
    fin
    devuelve NO_QUEDA
fin

funcion hoja_del_pen
    devuelve region con (elemento HOJA_PENDRIVE de usb_hojas) y PAGINA
fin

funcion usb_ocupado
    buzon es region con (elemento TAREA_USB de buzones) y 1024 y 4
    si (elemento 2 de buzon) es 0
        devuelve verdadero
    fin
    para cada p desde 1 hasta TOPE_DE_PUERTOS
        base es 512 mas (p menos 1) por 4
        si (elemento base mas 4 de buzon) no es igual a 0 y (elemento base mas 1 de buzon) es 0
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion espera_al_pendrive
    comparte esperando
    mientras no pen_presente y usb_como es USB_LISTO y tics es menor que usb_desde mas 1000
        si tics es mayor que usb_desde mas 200
            si no usb_ocupado
                devuelve nada
            fin
        fin
        recoge_tareas con falso
        desactiva_interrupciones
        esperando es verdadero
        espera_interrupcion
        esperando es falso
        activa_interrupciones
    fin
fin

funcion el_mismo_disco
    si (pide_al_pen con PIDE_DISCO) no es igual a 0
        devuelve falso
    fin
    hoja es hoja_del_pen
    i es 1
    mientras i es menor o igual que PAGINA
        si (elemento i de hoja) no es igual a (elemento i de pen_primera)
            devuelve falso
        fin
        i es i mas 1
    fin
    devuelve verdadero
fin

funcion lleva_marca con trozo
    i es 1
    para cada letra en MARCA_PENDRIVE
        si (elemento i de trozo) no es igual a letra
            devuelve falso
        fin
        i es i mas 1
    fin
    devuelve verdadero
fin

funcion lee_ranura con r
    para cada p desde 0 hasta 3
        hecho es pide_al_pen con PIDE_LEE mas 1 mas r por 4 mas p
        si hecho es menor que 0
            devuelve hecho
        fin
        copia_region con pen_lectura y p por PAGINA mas 1 y hoja_del_pen y 1 y PAGINA
    fin
    devuelve 0
fin

funcion claves_del_pendrive
    mensaje es region con llave_en mas 192 y 64
    i es 0
    para cada b en PARA_EL_PENDRIVE
        i es i mas 1
        elemento i de mensaje es b
    fin
    blake2b con taller_llave y mensaje y i y llave y claves_programa y 64
    para cada j desde 1 hasta 64
        elemento j de mensaje es 0
    fin
fin

funcion firma_de con trozo
    blake2b con taller_llave y trozo y MIDE_RANURA y (region con llave_en mas 96 y 32) y firma_vista y 32
fin

funcion ranura_buena
    si no (lleva_marca con pen_lectura)
        devuelve falso
    fin
    copia_region con pen_firma y 1 y pen_lectura y 109 y 32
    para cada i desde 109 hasta 140
        elemento i de pen_lectura es 0
    fin
    claves_del_pendrive
    firma_de con pen_lectura
    distinto es 0
    para cada i desde 1 hasta 32
        distinto es distinto mas o_exclusivo con (elemento i de firma_vista) y (elemento i de pen_firma)
    fin
    olvida_claves_programa
    devuelve distinto es 0
fin

funcion valida_pendrive
    comparte pen_validada
    si no pen_presente
        devuelve FALTA_PENDRIVE
    fin
    si pen_veces es pen_validada
        devuelve 0
    fin
    van es pen_veces
    si no el_mismo_disco
        devuelve OTRO_PENDRIVE
    fin
    si pen_seq es 0
        para cada r desde 0 hasta 1
            si (pide_al_pen con PIDE_LEE mas 1 mas r por 4) no es igual a 0 o (lleva_marca con hoja_del_pen)
                devuelve OTRO_PENDRIVE
            fin
        fin
    si no
        si (lee_ranura con pen_ranura) es menor que 0
            devuelve OTRO_PENDRIVE
        fin
        si no ranura_buena
            devuelve OTRO_PENDRIVE
        fin
        si (le32_de con pen_lectura y 9) no es igual a pen_seq
            devuelve OTRO_PENDRIVE
        fin
    fin
    pen_validada es van
    devuelve 0
fin

funcion manda_al_pen con r y p
    copia_region con hoja_del_pen y 1 y pen_sobre y p por PAGINA mas 1 y PAGINA
    devuelve pide_al_pen con PIDE_ESCRIBE mas 1 mas r por 4 mas p
fin

funcion escribe_ranura con r
    comparte pen_seq y pen_ranura
    i es 1
    mientras i es menor o igual que MIDE_SOBRE
        elemento i de pen_sobre es 0
        i es i mas 1
    fin
    i es 1
    para cada letra en MARCA_PENDRIVE
        elemento i de pen_sobre es letra
        i es i mas 1
    fin
    pon_le32 con pen_sobre y 9 y pen_seq mas 1
    copia_region con pen_sobre y 13 y cerrojo y 1 y TOPE_CERROJO
    saca_sal con pen_sobre y 97
    para cada i desde 109 hasta 112
        elemento i de pen_sobre es 0
    fin
    copia_region con pen_sobre y MIDE_SOBRE mas 1 y pen_copia y 1 y MIDE_CARGA
    claves_del_pendrive
    chacha20 con taller_chacha y claves_programa y (region con pen_zona mas MIDE_RANURA mas 96 y 12) y pen_sobre y MIDE_SOBRE mas 1 y MIDE_CARGA
    firma_de con pen_sobre
    copia_region con pen_sobre y 109 y firma_vista y 1 y 32
    olvida_claves_programa
    para cada p desde 1 hasta 3
        hecho es manda_al_pen con r y p
        si hecho es menor que 0
            devuelve hecho
        fin
    fin
    hecho es pide_al_pen con PIDE_ASIENTA
    si hecho es menor que 0
        devuelve hecho
    fin
    hecho es manda_al_pen con r y 0
    si hecho es menor que 0
        devuelve hecho
    fin
    hecho es pide_al_pen con PIDE_ASIENTA
    si hecho es menor que 0
        devuelve hecho
    fin
    hecho es lee_ranura con r
    si hecho es menor que 0
        devuelve hecho
    fin
    i es 1
    mientras i es menor o igual que MIDE_RANURA
        si (elemento i de pen_lectura) no es igual a (elemento i de pen_sobre)
            devuelve NO_QUEDA
        fin
        i es i mas 1
    fin
    pen_seq es pen_seq mas 1
    pen_ranura es r
    devuelve 0
fin

funcion escribe_pendrive con las_dos
    comparte pen_debe
    si no hay_llave o no hay_cerrojo
        devuelve SIN_LLAVE
    fin
    hecho es valida_pendrive
    si hecho es mayor o igual que 0
        hecho es escribe_ranura con 1 menos pen_ranura
    fin
    si hecho es mayor o igual que 0 y las_dos
        hecho es escribe_ranura con 1 menos pen_ranura
    fin
    pen_debe es hecho es menor que 0
    si pen_debe
        desactiva_interrupciones
        apunta con R_PEN_FALLO y "FalOS" y BLANCO y 0
        activa_interrupciones
    fin
    al_serie con "pendrive: copia "
    escribe pen_seq sin salto
    al_serie con ", "
    escribe hecho
    devuelve hecho
fin

funcion se_llama con trozo y base y nombre
    i es 1
    para cada letra en nombre
        si (elemento base mas i de trozo) no es igual a letra
            devuelve falso
        fin
        i es i mas 1
    fin
    si i es mayor que 32
        devuelve verdadero
    fin
    devuelve (elemento base mas i de trozo) es 0
fin

funcion entrada_del_pen con nombre_mide
    para cada e desde 0 hasta ENTRADAS_PENDRIVE menos 1
        base es e por MIDE_ENTRADA
        igual_todo es verdadero
        i es 1
        mientras igual_todo y i es menor o igual que 32
            suya es 0
            si i es menor o igual que nombre_mide
                suya es elemento i de pen_apunte
            fin
            si (elemento base mas i de pen_copia) no es igual a suya
                igual_todo es falso
            fin
            i es i mas 1
        fin
        si igual_todo
            devuelve base
        fin
    fin
    devuelve 0 menos 1
fin

funcion aplica_al_pendrive con peticion
    nombre_mide es 0
    mientras nombre_mide es menor que 32 y (elemento nombre_mide mas 1 de pen_apunte) no es igual a 0
        nombre_mide es nombre_mide mas 1
    fin
    si nombre_mide es 0 o (se_llama con pen_apunte y 0 y "llave.sis") o (se_llama con pen_apunte y 0 y "cerrojo.sis")
        devuelve 0
    fin
    base es entrada_del_pen con nombre_mide
    si peticion es ORDEN_OLVIDA y base es menor que 0
        devuelve 0
    fin
    si base es menor que 0
        base es entrada_del_pen con 0
    fin
    si base es menor que 0
        devuelve LLENO
    fin
    i es 1
    mientras i es menor o igual que MIDE_ENTRADA
        elemento base mas i de pen_copia es 0
        i es i mas 1
    fin
    si peticion es ORDEN_GUARDA
        copia_region con pen_copia y base mas 1 y pen_apunte y 1 y nombre_mide
        elemento base mas 33 de pen_copia es elemento 41 de pen_apunte
        elemento base mas 34 de pen_copia es elemento 42 de pen_apunte
        copia_region con pen_copia y base mas 41 y pen_apunte y 513 y 512
    fin
    si pen_estado es PEN_ABIERTO
        devuelve escribe_pendrive con peticion es ORDEN_OLVIDA
    fin
    devuelve 0
fin

funcion cuantos_en_el_pen
    cuantos es 0
    para cada e desde 0 hasta ENTRADAS_PENDRIVE menos 1
        si (elemento e por MIDE_ENTRADA mas 1 de pen_copia) no es igual a 0
            cuantos es cuantos mas 1
        fin
    fin
    devuelve cuantos
fin

funcion vuelca_pendrive
    comparte pen_restaurando
    pen_restaurando es verdadero
    malos es 0
    para cada e desde 0 hasta ENTRADAS_PENDRIVE menos 1
        base es e por MIDE_ENTRADA
        si (elemento base mas 1 de pen_copia) no es igual a 0
            recoge_tareas con falso
            buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
            copia_region con buzon y 1 y pen_copia y base mas 1 y 32
            elemento 33 de buzon es 0
            elemento 41 de buzon es elemento base mas 33 de pen_copia
            elemento 42 de buzon es elemento base mas 34 de pen_copia
            copia_region con buzon y 513 y pen_copia y base mas 41 y 512
            si (pide_al_disco con ORDEN_GUARDA) es menor que 0
                malos es malos mas 1
            fin
        fin
    fin
    pen_restaurando es falso
    devuelve malos
fin

funcion abre_pendrive
    comparte pen_estado y pen_seq y pen_ranura y pen_validada
    van es pen_veces
    buena es 0 menos 1
    para cada vuelta desde 0 hasta 1
        si buena es menor que 0
            r es pen_mejor
            si vuelta es 1
                r es 1 menos pen_mejor
            fin
            si (lee_ranura con r) es 0
                si ranura_buena
                    buena es r
                fin
            fin
        fin
    fin
    si buena es menor que 0
        pen_estado es PEN_ROTO
        desactiva_interrupciones
        apunta con R_PEN_TOCADO y "FalOS" y BLANCO y 0
        activa_interrupciones
        pinta_linea con ""
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  La contraseña es buena, pero lo del pendrive no cuadra: se ha estropeado"
        pinta_linea con "  o alguien lo ha tocado. No lo abro, ni escribo encima."
        pon_color con GRIS y NEGRO
        pinta_linea con "  Para borrarlo y empezar de cero: pendrive borra"
        pinta_linea con ""
        al_serie con "pendrive: no cuadra"
        escribe ""
        devuelve nada
    fin
    claves_del_pendrive
    chacha20 con taller_chacha y claves_programa y (region con pen_zona mas 2 por MIDE_RANURA mas 96 y 12) y pen_lectura y MIDE_SOBRE mas 1 y MIDE_CARGA
    olvida_claves_programa
    copia_region con pen_copia y 1 y pen_lectura y MIDE_SOBRE mas 1 y MIDE_CARGA
    pen_seq es le32_de con pen_lectura y 9
    pen_ranura es buena
    pen_validada es van
    pen_estado es PEN_ABIERTO
    desactiva_interrupciones
    apunta con R_PEN_ABRE y "FalOS" y BLANCO y cuantos_en_el_pen
    activa_interrupciones
    si buena no es igual a pen_mejor
        pinta_linea con ""
        pon_color con AMARILLO y NEGRO
        pinta_linea con "  La última copia del pendrive está a medias o la han tocado, así que he"
        pinta_linea con "  abierto la de antes."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
    fin
    malos es vuelca_pendrive
    si malos es mayor que 0
        pon_color con AMARILLO y NEGRO
        pinta con "  No me caben en la memoria "
        pinta_numero con malos
        pinta_linea con " archivos de los que hay en el pendrive."
        pon_color con GRIS y NEGRO
    fin
    al_serie con "pendrive: abierto, archivos "
    escribe cuantos_en_el_pen sin salto
    al_serie con ", copia "
    escribe pen_seq
    lee_siempre
fin

funcion mira_el_pendrive
    comparte pen_estado y pen_mejor y pen_validada y hay_cerrojo
    si no pen_posible
        devuelve nada
    fin
    copia_region con pen_primera y 1 y (region con modulo_desde y PAGINA) y 1 y PAGINA
    espera_al_pendrive
    si no pen_presente
        pon_color con AMARILLO y NEGRO
        pinta_linea con "  No encuentro el pendrive del que arranqué, así que lo que guardes se"
        pinta_linea con "  borra al apagar. Escribe pendrive para saber más."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        al_serie con "pendrive: no está"
        escribe ""
        devuelve nada
    fin
    van es pen_veces
    pen_estado es PEN_ROTO
    si no el_mismo_disco
        pen_estado es PEN_OTRO
        al_serie con "pendrive: otro"
        escribe ""
        devuelve nada
    fin
    mejor es 0 menos 1
    mejor_seq es 0
    para cada r desde 0 hasta 1
        si (pide_al_pen con PIDE_LEE mas 1 mas r por 4) es menor que 0
            al_serie con "pendrive: no se lee"
            escribe ""
            devuelve nada
        fin
        hoja es hoja_del_pen
        si (lleva_marca con hoja) y (elemento 16 de hoja) es 51
            seq es le32_de con hoja y 9
            si mejor es menor que 0 o seq es mayor que mejor_seq
                mejor es r
                mejor_seq es seq
                copia_region con cerrojo y 1 y hoja y 13 y TOPE_CERROJO
            fin
        fin
    fin
    pen_validada es van
    si mejor es menor que 0
        pen_estado es PEN_NUEVO
        al_serie con "pendrive: nuevo"
        escribe ""
        devuelve nada
    fin
    pen_mejor es mejor
    pen_estado es PEN_CERRADO
    hay_cerrojo es verdadero
    al_serie con "pendrive: cerrado, copia "
    escribe mejor_seq
    desactiva_interrupciones
    bloquea_ya con AL_ARRANCAR
    activa_interrupciones
fin

funcion orden_pendrive
    si no disco_en_memoria
        pinta_linea con "  No he arrancado desde un pendrive: lo que guardas va al disco."
        pinta_linea con ""
        devuelve nada
    fin
    si usb_como no es igual a USB_LISTO
        pinta_linea con "  No puedo escribir en el pendrive: lo que guardes se borra al apagar."
        pinta_por_que_no_usb
        pinta_linea con ""
        devuelve nada
    fin
    si no pen_posible
        pinta_linea con "  No me queda memoria para guardar en el pendrive con seguridad."
        pinta_linea con ""
        devuelve nada
    fin
    si pen_estado es PEN_NADA
        pinta_linea con "  Al arrancar no lo encontré, así que hasta que reinicies con él puesto"
        pinta_linea con "  lo que guardes se borra al apagar. Va en un puerto USB, sin hub."
    si no si pen_estado es PEN_NUEVO
        pinta_linea con "  No he escrito nada en él, y sin contraseña no lo haré. Pónsela con"
        pinta_linea con "  cerrojo, y lo que guardes irá al pendrive, cifrado."
    si no si pen_estado es PEN_CERRADO
        pinta_linea con "  Lo que hay está cifrado, y sin la contraseña no lo abro."
    si no si pen_estado es PEN_ROTO
        pinta_linea con "  Lo que hay no cuadra o no se lee, así que no lo abro ni escribo encima."
        pinta_linea con "  Para borrarlo y empezar de cero: pendrive borra"
    si no si pen_estado es PEN_OTRO
        pinta_linea con "  El que hay puesto no es el que usé para arrancar, y no lo toco."
    si no
        pinta con "  Lo que guardas va al pendrive, cifrado con tu contraseña. Archivos: "
        pinta_numero con cuantos_en_el_pen
        pinta_linea con "."
        pinta con "  Van "
        pinta_numero con pen_seq
        pinta_linea con " copias. Siempre hay dos, la última y la de antes, y miden lo"
        pinta_linea con "  mismo guardes lo que guardes: desde fuera no se sabe cuánto es."
        pon_color con AMARILLO y NEGRO
        si no pen_presente
            pinta_linea con "  Ahora mismo no está enchufado."
        fin
        si pen_debe
            pinta_linea con "  Lo último no ha llegado a él. Cuando lo enchufes, lo escribo."
        fin
        pon_color con GRIS y NEGRO
    fin
    pinta_linea con ""
    al_serie con "pendrive: estado "
    escribe pen_estado sin salto
    al_serie con ", archivos "
    escribe cuantos_en_el_pen sin salto
    al_serie con ", copia "
    escribe pen_seq
fin

funcion borra_pendrive
    comparte pen_estado y pen_seq y pen_ranura y pen_validada
    si invitado
        pinta_linea con "  En modo invitado no toco el pendrive."
        pinta_linea con ""
        devuelve nada
    fin
    si pen_estado no es igual a PEN_ABIERTO y pen_estado no es igual a PEN_ROTO
        pinta_linea con "  No tengo nada tuyo que borrar en el pendrive. Mira: pendrive"
        pinta_linea con ""
        devuelve nada
    fin
    van es pen_veces
    hecho es FALTA_PENDRIVE
    si pen_presente
        hecho es OTRO_PENDRIVE
        si el_mismo_disco
            hecho es 0
            pen_validada es van
        fin
    fin
    i es 1
    mientras i es menor o igual que MIDE_RANURA
        elemento i de pen_sobre es 0
        i es i mas 1
    fin
    para cada r desde 0 hasta 1
        para cada p desde 0 hasta 3
            si hecho es 0
                hecho es manda_al_pen con r y p
            fin
        fin
    fin
    si hecho es 0
        hecho es pide_al_pen con PIDE_ASIENTA
    fin
    al_serie con "pendrive: borrado, "
    escribe hecho
    si hecho es menor que 0
        fallo_de_disco con hecho
        devuelve nada
    fin
    pen_estado es PEN_NUEVO
    pen_seq es 0
    pen_ranura es 1
    desactiva_interrupciones
    apunta con R_PEN_BORRADO y "FalOS" y BLANCO y 0
    activa_interrupciones
    pinta_linea con "  Borrado: donde estaban las dos copias, ahora solo hay ceros. Lo que"
    pinta_linea con "  tienes ahora vive en la memoria hasta que apagues."
    pinta_linea con "  Para volver a guardar en él, pon una contraseña con cerrojo."
    pinta_linea con ""
fin

funcion pide_al_disco con peticion
    comparte peticion_abierta y disco_listo y esperando
    si invitado y (peticion es ORDEN_GUARDA o peticion es ORDEN_OLVIDA)
        devuelve EN_INVITADO
    fin
    recoge_tareas con falso
    al_pen es pen_posible y no pen_restaurando y (peticion es ORDEN_GUARDA o peticion es ORDEN_OLVIDA)
    si al_pen
        copia_region con pen_apunte y 1 y (region con (elemento TAREA_DISCO de buzones) y 1024) y 1 y 1024
    fin
    desactiva_interrupciones
    disco_listo es falso
    peticion_abierta es verdadero
    avisa_a con TAREA_DISCO y peticion
    mientras no disco_listo
        esperando es verdadero
        espera_interrupcion
        esperando es falso
        desactiva_interrupciones
    fin
    disco_listo es falso
    activa_interrupciones
    hecho es resultado_disco
    si al_pen y hecho es mayor o igual que 0
        queda es aplica_al_pendrive con peticion
        si queda es menor que 0
            devuelve queda
        fin
    fin
    devuelve hecho
fin

funcion fallo_de_disco con motivo
    pon_color con ROJO_CLARO y NEGRO
    si motivo es NO_HAY_DISCO
        pinta_linea con "  No hay ningún disco conectado."
    si no si motivo es NO_ES_MIO
        pinta_linea con "  Ese disco no tiene mi formato."
    si no si motivo es NO_ESTA
        pinta_linea con "  No hay ningún archivo con ese nombre. Mira: disco"
    si no si motivo es NO_SE_LEE
        pinta_linea con "  El disco no me deja leer ese trozo."
    si no si motivo es DANADO
        pinta_linea con "  No entiendo el índice de este disco, así que no lo toco."
    si no si motivo es NO_SE_ESCRIBE
        pinta_linea con "  El disco no me deja escribir."
    si no si motivo es LLENO
        pinta_linea con "  El índice del disco está lleno."
    si no si motivo es PROHIBIDO
        pinta_linea con "  Ese nombre no vale."
    si no si motivo es EN_INVITADO
        pinta_linea con "  En modo invitado no escribo nada en el disco."
    si no si motivo es REPETIDO
        pinta_linea con "  Hay dos archivos con ese nombre en el disco, y no sé cuál es el bueno."
    si no si motivo es FALTA_PENDRIVE
        pinta_linea con "  El pendrive no está puesto. En la memoria sí ha cambiado, hasta que apagues."
    si no si motivo es OTRO_PENDRIVE
        pinta_linea con "  Ese no es el pendrive de antes, y no lo toco. En la memoria sí ha cambiado."
    si no si motivo es NO_QUEDA
        pinta_linea con "  No consigo escribir en el pendrive. En la memoria sí ha cambiado."
    si no
        pinta_linea con "  El programa del disco ha caído antes de contestar."
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion pinta_buzon con cuantos
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    i es 1
    mientras i es menor o igual que cuantos
        pon_byte con (elemento i de buzon)
        i es i mas 1
    fin
    mueve_cursor
fin

funcion orden_disco
    respuesta es pide_al_disco con ORDEN_LISTA
    si respuesta es menor que 0 o respuesta es mayor que TOPE_BUZON
        fallo_de_disco con respuesta
    si no
        pinta_buzon con respuesta
        pinta_linea con ""
        si disco_en_memoria
            pinta_linea con "  Lo ha leído un programa sin permisos, que no toca ningún puerto."
        si no
            pinta_linea con "  Lo ha leído un programa sin permisos, que solo toca ocho puertos."
        fin
        pinta_linea con ""
    fin
fin

funcion nombre_al_buzon con nombre y cola
    recoge_tareas con falso
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    i es 0
    para cada b en nombre
        i es i mas 1
        elemento i de buzon es b
    fin
    para cada b en cola
        i es i mas 1
        elemento i de buzon es b
    fin
    elemento i mas 1 de buzon es 0
    devuelve buzon
fin

funcion pide_archivo con nombre y cola y trozo
    nombre_al_buzon con nombre y cola
    devuelve pide_al_disco con ORDEN_TROZO mas trozo
fin

funcion haz_encargo con t
    nombre es nombre_de con t
    cuantos es elemento t de cuantos_de
    suya es region con (elemento t de mesas) mas (elemento t de desde_de) y cuantos
    si largo de nombre mas 4 es mayor que NOMBRE_EN_DISCO
        devuelve NO_ESTA
    fin
    lee es (elemento t de pedido_de) es LEE_GUARDADO
    si invitado y lee
        devuelve lee_de_memoria con nombre y suya y cuantos
    si no si invitado
        devuelve guarda_en_memoria con nombre y suya y cuantos
    si no si lee
        devuelve lee_cifrado con nombre y suya y cuantos
    fin
    devuelve guarda_cifrado con nombre y suya y cuantos
fin

funcion nueva_llave
    comparte hay_llave
    si no hay_azar y calidad_azar es menor que MINIMO_AZAR
        pon_color con AMARILLO y NEGRO
        pinta_linea con "  Este procesador no trae generador de azar, y aún no he visto"
        pinta_linea con "  bastantes teclas para sacarlo de ti. Escribe algo y vuelve a probar."
        pon_color con GRIS y NEGRO
        devuelve falso
    fin
    saca_sal con llave y 1
    saca_sal con llave y 17
    hay_llave es verdadero
    devuelve verdadero
fin

funcion olvida_llave
    comparte hay_llave
    para cada i desde 1 hasta 32
        elemento i de llave es 0
    fin
    hay_llave es falso
fin

funcion olvida_claves_programa
    para cada i desde 1 hasta 64
        elemento i de claves_programa es 0
    fin
    para cada i desde 1 hasta 32
        elemento i de firma_vista es 0
    fin
fin

funcion borra_claro con cuantos
    claro es region con claro_en y PAGINA
    i es 1
    mientras i es menor o igual que cuantos
        elemento i de claro es 0
        i es i mas 1
    fin
fin

funcion deriva_claves_de con nombre
    mensaje es region con llave_en mas 192 y 64
    i es 0
    para cada b en PARA_DERIVAR
        i es i mas 1
        elemento i de mensaje es b
    fin
    para cada b en nombre
        i es i mas 1
        elemento i de mensaje es b
    fin
    blake2b con taller_llave y mensaje y i y llave y claves_programa y 64
    para cada j desde 1 hasta 64
        elemento j de mensaje es 0
    fin
fin

funcion guarda_llave
    buzon es nombre_al_buzon con "llave" y ".sis"
    elemento 41 de buzon es 0
    elemento 42 de buzon es TOPE_LLAVE
    i es 513
    para cada letra en MARCA_LLAVE
        elemento i de buzon es letra
        i es i mas 1
    fin
    copia_region con buzon y 517 y llave y 1 y 32
    respuesta es pide_al_disco con ORDEN_GUARDA
    para cada j desde 513 hasta 512 mas TOPE_LLAVE
        elemento j de buzon es 0
    fin
    al_serie con "llave.sis guardado: "
    escribe respuesta
    devuelve respuesta
fin

funcion lee_llave
    comparte hay_llave
    si hay_cerrojo
        devuelve nada
    fin
    traido es pide_archivo con "llave" y ".sis" y 0
    si traido es NO_ESTA o traido es NO_HAY_DISCO
        devuelve nada
    fin
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    bien es traido es TOPE_LLAVE
    i es 1
    para cada letra en MARCA_LLAVE
        si bien y (elemento i de buzon) no es igual a letra
            bien es falso
        fin
        i es i mas 1
    fin
    al_serie con "llave.sis leido: "
    escribe traido
    si no bien
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No entiendo llave.sis. Lo que guardaron los programas antes no"
        pinta_linea con "  se podrá abrir, y lo nuevo irá con una llave nueva."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    copia_region con llave y 1 y buzon y 5 y 32
    para cada j desde 1 hasta TOPE_LLAVE
        elemento j de buzon es 0
    fin
    hay_llave es verdadero
fin

funcion guarda_cifrado con nombre y suya y cuantos
    si no hay_llave
        si hay_cerrojo
            devuelve SIN_LLAVE
        fin
        si no nueva_llave
            devuelve SIN_LLAVE
        fin
        hecho es guarda_llave
        si hecho es menor que 0
            olvida_llave
            devuelve hecho
        fin
    fin
    claro es region con claro_en y PAGINA
    total es cuantos mas SOBRE_GUARDADO
    i es 1
    para cada letra en MARCA_GUARDADO
        elemento i de claro es letra
        i es i mas 1
    fin
    saca_sal con claro y 5
    copia_region con claro y 17 y suya y 1 y cuantos
    deriva_claves_de con nombre
    chacha20 con taller_chacha y claves_programa y (region con claro_en mas 4 y 12) y claro y 17 y cuantos
    blake2b con taller_llave y claro y 16 mas cuantos y (region con llave_en mas 96 y 32) y (region con claro_en mas 16 mas cuantos y 32) y 32
    olvida_claves_programa
    buzon es nombre_al_buzon con nombre y ".dat"
    elemento 41 de buzon es cociente con total y 256
    elemento 42 de buzon es total resto 256
    copia_region con buzon y 513 y claro y 1 y total
    borra_claro con total
    hecho es pide_al_disco con ORDEN_GUARDA
    si hecho es menor que 0
        devuelve hecho
    fin
    devuelve cuantos
fin

funcion es_de_los_nuestros con buzon y traido
    si traido es menor que SOBRE_GUARDADO o traido es mayor que TOPE_CIFRABLE mas SOBRE_GUARDADO
        devuelve falso
    fin
    i es 1
    para cada letra en MARCA_GUARDADO
        si (elemento i de buzon) no es igual a letra
            devuelve falso
        fin
        i es i mas 1
    fin
    devuelve verdadero
fin

funcion lee_cifrado con nombre y suya y cuantos
    traido es pide_archivo con nombre y ".dat" y 0
    si traido es menor que 0
        devuelve traido
    fin
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    si no (es_de_los_nuestros con buzon y traido)
        devuelve SIN_CIFRAR
    fin
    si no hay_llave
        devuelve SIN_LLAVE
    fin
    claro es region con claro_en y PAGINA
    copia_region con claro y 1 y buzon y 1 y traido
    largo es traido menos SOBRE_GUARDADO
    deriva_claves_de con nombre
    blake2b con taller_llave y claro y 16 mas largo y (region con llave_en mas 96 y 32) y firma_vista y 32
    distinto es 0
    para cada i desde 1 hasta 32
        distinto es distinto mas o_exclusivo con (elemento i de firma_vista) y (elemento 16 mas largo mas i de claro)
    fin
    si distinto no es igual a 0
        olvida_claves_programa
        borra_claro con traido
        devuelve TOCADO
    fin
    chacha20 con taller_chacha y claves_programa y (region con claro_en mas 4 y 12) y claro y 17 y largo
    olvida_claves_programa
    dados es largo
    si dados es mayor que cuantos
        dados es cuantos
    fin
    copia_region con suya y 1 y claro y 17 y dados
    borra_claro con traido
    devuelve dados
fin

funcion hueco_de con nombre y crea
    cuantas es largo de nombre
    para cada k desde 1 hasta HUECOS
        si (elemento k de huecos_nombre_mide) es cuantas
            mismo es verdadero
            para cada i desde 1 hasta cuantas
                si (elemento (k menos 1) por 32 mas i de huecos_nombres) no es igual a (elemento i de nombre)
                    mismo es falso
                fin
            fin
            si mismo
                devuelve k
            fin
        fin
    fin
    si no crea
        devuelve 0
    fin
    para cada k desde 1 hasta HUECOS
        si (elemento k de huecos_nombre_mide) es 0
            para cada i desde 1 hasta cuantas
                elemento (k menos 1) por 32 mas i de huecos_nombres es elemento i de nombre
            fin
            elemento k de huecos_nombre_mide es cuantas
            devuelve k
        fin
    fin
    devuelve 0
fin

funcion guarda_en_memoria con nombre y suya y cuantos
    k es hueco_de con nombre y verdadero
    si k es 0
        devuelve LLENO
    fin
    hueco es region con huecos_datos_en mas (k menos 1) por TOPE_CIFRABLE y TOPE_CIFRABLE
    para cada i desde 1 hasta TOPE_CIFRABLE
        elemento i de hueco es 0
    fin
    copia_region con hueco y 1 y suya y 1 y cuantos
    elemento k de huecos_mide es cuantos
    devuelve cuantos
fin

funcion lee_de_memoria con nombre y suya y cuantos
    k es hueco_de con nombre y falso
    si k es 0
        devuelve NO_ESTA
    fin
    dados es elemento k de huecos_mide
    si dados es mayor que cuantos
        dados es cuantos
    fin
    copia_region con suya y 1 y (region con huecos_datos_en mas (k menos 1) por TOPE_CIFRABLE y TOPE_CIFRABLE) y 1 y dados
    devuelve dados
fin

funcion olvida_de_memoria con nombre
    k es hueco_de con nombre y falso
    si k es 0
        devuelve NO_ESTA
    fin
    habia es elemento k de huecos_mide
    hueco es region con huecos_datos_en mas (k menos 1) por TOPE_CIFRABLE y TOPE_CIFRABLE
    para cada i desde 1 hasta TOPE_CIFRABLE
        elemento i de hueco es 0
    fin
    para cada i desde 1 hasta 32
        elemento (k menos 1) por 32 mas i de huecos_nombres es 0
    fin
    elemento k de huecos_mide es 0
    elemento k de huecos_nombre_mide es 0
    devuelve habia
fin

funcion vacia_memoria_invitado
    indice es region con huecos_en y PAGINA
    datos_aparte es region con huecos_datos_en y PAGINA
    i es 1
    mientras i es menor o igual que PAGINA
        elemento i de indice es 0
        elemento i de datos_aparte es 0
        i es i mas 1
    fin
fin

funcion entra_invitado
    comparte invitado y bloqueado y modo_clave y mensaje_cerrojo y apuntados y consola_olvida y foco y agarrada
    desactiva_interrupciones
    para cada t desde 1 hasta MAX_TAREAS
        estado es elemento t de estados_tarea
        si estado no es igual a SIN_USAR y estado no es igual a CERRADA
            cierra_tarea con t y LA_PARARON
        fin
        si (elemento t de ventana_de) no es igual a SIN_VENTANA
            quita_ventana con t
        fin
    fin
    olvida_llave
    olvida_seleccion
    vacia_portapapeles con AL_BLOQUEAR
    invitado es verdadero
    bloqueado es falso
    modo_clave es SIN_CLAVE
    mensaje_cerrojo es NADA_QUE_DECIR
    foco es CONSOLA
    agarrada es 0
    para cada i desde 1 hasta 512
        elemento i de apuntes es 0
    fin
    i es 1
    mientras i es menor o igual que 4096
        elemento i de apuntes_nombres es 0
        i es i mas 1
    fin
    apuntados es 0
    apunta con R_INVITADO y "FalOS" y BLANCO y 0
    activa_interrupciones
    recoge_tareas con falso
    consola_olvida es verdadero
    limpia
    barra
    ve_a con 3 y 1
    pon_color con MAGENTA_CLARO y NEGRO
    pinta_linea con "  Modo invitado."
    pon_color con GRIS y NEGRO
    pinta_linea con "  No escribo nada en el disco: lo que guarden los programas vive en"
    pinta_linea con "  memoria, y al reiniciar no queda nada. Lo de antes sigue cifrado,"
    pinta_linea con "  y sin la contraseña no hay forma de abrirlo."
    pinta_linea con "  Para volver a lo tuyo, reinicia."
    pinta_linea con ""
    escribe "modo invitado"
    ensucia
fin

funcion orden_invitado
    si invitado
        pinta_linea con "  Ya estás en modo invitado."
        pinta_linea con ""
        devuelve nada
    fin
    entra_invitado
fin

funcion atiende_encargos
    comparte hay_encargos
    hay_encargos es falso
    si pen_debe y pen_estado es PEN_ABIERTO y pen_presente y no invitado
        hecho es escribe_pendrive con verdadero
    fin
    para cada t desde 1 hasta MAX_TAREAS
        si (elemento t de estados_tarea) es CON_EL_DISCO
            pedido es elemento t de pedido_de
            permiso es elemento t de permiso_disco
            si pedido es GUARDA y permiso es DISCO_SIN_PEDIR y no invitado y (esta_siempre con (nombre_de con t)) es mayor que 0
                elemento t de permiso_disco es DISCO_SI
                permiso es DISCO_SI
            fin
            si pedido es GUARDA y permiso es DISCO_SIN_PEDIR
                elemento t de permiso_disco es DISCO_PEDIDO
                pide_permiso_de con t
            si no si pedido es LEE_GUARDADO o permiso es DISCO_SI
                termina_encargo con t y (haz_encargo con t)
            si no si permiso es DISCO_NO
                termina_encargo con t y NEGADO
            fin
        fin
        si (elemento t de estados_tarea) es CON_LA_RED
            atiende_red con t
        fin
    fin
fin

funcion guarda_de_verdad
    devuelve no invitado y (pen_estado es PEN_ABIERTO o no disco_en_memoria)
fin

funcion termina_encargo con t y hecho
    comparte aviso_disco_hasta y disco_lo_usa y disco_guardaba y disco_fallaba
    al_serie con (nombre_de con t)
    disco_fallaba es hecho es FALTA_PENDRIVE o hecho es OTRO_PENDRIVE o hecho es NO_QUEDA
    si hecho es mayor o igual que 0 o disco_fallaba
        disco_lo_usa es t
        disco_guardaba es (elemento t de pedido_de) es GUARDA
        aviso_disco_hasta es tics mas 3 por TICS_POR_SEGUNDO
        ensucia
    fin
    si (elemento t de pedido_de) es GUARDA y invitado
        escribe " guardó en la memoria: " sin salto
    si no si (elemento t de pedido_de) es GUARDA y pen_estado es PEN_ABIERTO
        escribe " guardó en el pendrive: " sin salto
    si no si (elemento t de pedido_de) es GUARDA y disco_en_memoria
        escribe " guardó en la memoria: " sin salto
    si no si (elemento t de pedido_de) es GUARDA
        escribe " guardó en el disco: " sin salto
    si no si invitado o disco_en_memoria
        escribe " leyó de la memoria: " sin salto
    si no
        escribe " leyó del disco: " sin salto
    fin
    escribe hecho
    desactiva_interrupciones
    si (elemento t de pedido_de) es GUARDA y hecho es mayor o igual que 0 y no (guarda_de_verdad)
        apunta_de con R_GUARDO_MEMORIA y t y hecho
    si no si (elemento t de pedido_de) es GUARDA y hecho es mayor o igual que 0
        apunta_de con R_GUARDO y t y hecho
    si no si hecho es TOCADO
        apunta_de con R_TOCADO y t y 0
    si no si hecho es SIN_CIFRAR
        apunta_de con R_SIN_CIFRAR y t y 0
    si no si hecho es mayor o igual que 0 y invitado
        apunta_de con R_LEYO_MEMORIA y t y hecho
    si no si (elemento t de pedido_de) es GUARDA y hecho es NEGADO
        apunta_de con R_NEGADO y t y 0
    si no si hecho es mayor o igual que 0
        apunta_de con R_LEYO y t y hecho
    si no si hecho es NO_ESTA
        apunta_de con R_BUSCO y t y 0
    fin
    si (elemento t de estados_tarea) es CON_EL_DISCO
        despierta_con con t y hecho
    fin
    activa_interrupciones
fin

funcion pide_permiso_de con t
    comparte columna y foco
    foco es CONSOLA
    olvida_seleccion
    base es (fila menos 1) por ANCHO
    para cada c desde 1 hasta ANCHO
        elemento base mas c de pantalla es color por 256 mas 32
    fin
    columna es 1
    pon_color con (color_de con t) y NEGRO
    pinta con "  "
    pinta con (nombre_de con t)
    pon_color con BLANCO y NEGRO
    pinta con " quiere guardar "
    pinta_numero con (elemento t de cuantos_de)
    si no (guarda_de_verdad)
        pinta_linea con " bytes, solo en memoria."
    si no si disco_en_memoria
        pinta_linea con " bytes en el pendrive, cifrados."
    si no
        pinta con " bytes en el disco, en "
        pinta con (nombre_de con t)
        pinta_linea con ".dat, cifrados."
    fin
    pon_color con GRIS y NEGRO
    pinta con "  Si le dejas: deja "
    pinta_numero con t
    pinta con ". Si no: niega "
    pinta_numero con t
    pinta_linea con ". Hasta que me contestes, espera."
    pinta_linea con "  Y escondo las ventanas, para que ninguna tape esto ni pinte una falsa."
    pinta_linea con ""
    al_serie con (nombre_de con t)
    escribe " pide permiso para guardar"
    desactiva_interrupciones
    apunta_de con R_PIDE y t y (elemento t de cuantos_de)
    activa_interrupciones
    vuelve_la_consola
fin

funcion decide_guardar con primera y permiso y pide_siempre
    comparte hay_encargos
    para_siempre es pide_siempre y no invitado
    t es numero_entre con primera y escritas
    bien es t es mayor o igual que 1 y t es menor o igual que MAX_TAREAS
    si bien
        bien es sigue_viva con t
    fin
    si no bien y permiso es DISCO_NO
        nombre es trozo_de_orden con primera
        si (esta_siempre con nombre) es mayor que 0
            quita_siempre con nombre y GRIS
            pon_color con ROJO_CLARO y NEGRO
            pinta con "  "
            pinta con nombre
            pinta_linea con " ya no guardará nada sin preguntarte."
            pon_color con GRIS y NEGRO
            pinta_linea con ""
            devuelve nada
        fin
    fin
    si no bien
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ningún programa con ese número. Mira: tareas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    si (elemento t de estados_tarea) es CON_LA_RED y (elemento t de permiso_red) es DISCO_PEDIDO
        decide_red con t y permiso
        devuelve nada
    fin
    desactiva_interrupciones
    elemento t de permiso_disco es permiso
    hay_encargos es verdadero
    si permiso es DISCO_SI y para_siempre
        apunta_de con R_SIEMPRE y t y 0
    si no si permiso es DISCO_SI
        apunta_de con R_DEJASTE y t y 0
    si no
        apunta_de con R_NEGASTE y t y 0
    fin
    activa_interrupciones
    nombre es nombre_de con t
    pinta con "  "
    si permiso es DISCO_SI y para_siempre
        si anade_siempre con nombre
            pon_color con VERDE_CLARO y NEGRO
            pinta con nombre
            si guarda_de_verdad
                pinta_linea con " puede guardar siempre, también cuando reinicies."
            si no
                pinta_linea con " puede guardar siempre, hasta que apagues."
            fin
            pon_color con GRIS y NEGRO
            pinta con "  Para quitárselo: niega "
            pinta_linea con nombre
        si no
            pon_color con AMARILLO y NEGRO
            pinta con nombre
            pinta_linea con " puede guardar hasta que se cierre. Lo de siempre"
            pinta_linea con "  no he podido apuntarlo en el disco."
        fin
    si no si permiso es DISCO_SI
        pon_color con VERDE_CLARO y NEGRO
        pinta con nombre
        si no (guarda_de_verdad)
            pinta_linea con " puede guardar en memoria hasta que se cierre."
        si no
            pinta_linea con " puede guardar en su archivo hasta que se cierre."
        fin
        si pide_siempre y invitado
            pon_color con GRIS y NEGRO
            pinta_linea con "  En modo invitado no apunto nada para siempre."
        fin
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta con nombre
        pinta_linea con " no guardará nada en el disco."
        si (esta_siempre con nombre) es mayor que 0
            quita_siempre con nombre y (color_de con t)
            pon_color con GRIS y NEGRO
            pinta_linea con "  Y le he quitado el permiso para siempre."
        fin
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion olvida
    nombre es trozo_de_orden con 1
    nombre_al_buzon con nombre y ".dat"
    si invitado
        respuesta es olvida_de_memoria con nombre
    si no
        respuesta es pide_al_disco con ORDEN_OLVIDA
    fin
    si respuesta es NO_ESTA
        pinta con "  "
        pinta con nombre
        pinta_linea con " no tiene nada guardado."
        pinta_linea con ""
    si no si respuesta es menor que 0
        fallo_de_disco con respuesta
        al_serie con nombre
        escribe " no se ha olvidado: " sin salto
        escribe respuesta
    si no
        pon_color con VERDE_CLARO y NEGRO
        pinta con "  He borrado "
        pinta con nombre
        pinta con ".dat: "
        pinta_numero con respuesta
        si disco_en_memoria y guarda_de_verdad
            pinta_linea con " bytes, también de las dos copias del pendrive."
        si no
            pinta_linea con " bytes. Donde estaban, ahora solo hay ceros."
        fin
        desactiva_interrupciones
        apunta con R_OLVIDASTE y nombre y GRIS y respuesta
        activa_interrupciones
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        al_serie con nombre
        escribe " olvidado: " sin salto
        escribe respuesta
    fin
fin

funcion lee_archivo
    si invitado y escritas es mayor que 4 y resto_es con escritas menos 3 y ".sis"
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  El invitado no lee los .sis: ahí va lo que protege tu contraseña."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    respuesta es pide_archivo con (trozo_de_orden con 1) y "" y 0
    si respuesta es menor que 0 o respuesta es mayor que TOPE_BUZON
        fallo_de_disco con respuesta
    si no
        pon_color con BLANCO y NEGRO
        pinta_buzon con respuesta
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        escribe "archivo leido: " sin salto
        escribe respuesta
    fin
fin

funcion estropea con primera y aviso
    objetivo es 0
    si resto_es con primera y "teclado"
        objetivo es TAREA_TECLADO
    si no si resto_es con primera y "disco"
        objetivo es TAREA_DISCO
    si no si hay_graficos y resto_es con primera y "pantalla"
        objetivo es TAREA_PANTALLA
    si no si hay_red y resto_es con primera y "red"
        objetivo es TAREA_RED
    si no si resto_es con primera y "consola"
        objetivo es TAREA_CONSOLA
    si no si usb_como es USB_LISTO y resto_es con primera y "usb"
        objetivo es TAREA_USB
    fin
    si objetivo es 0
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  Solo sé hacerlo con teclado, disco, pantalla, red, usb o consola."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    si objetivo es TAREA_RED y aviso es AVISO_ROMPE
        mando_red con 6
    fin
    desactiva_interrupciones
    avisa_a con objetivo y aviso
    activa_interrupciones
fin

funcion apunta con clase y nombre y tinta y numero
    comparte apuntados
    cuantas es largo de nombre
    si cuantas es mayor que 32
        cuantas es 32
    fin
    si apuntados es mayor que 0
        base es ((apuntados menos 1) resto CUPO_REGISTRO) por 8
        sitio es ((apuntados menos 1) resto CUPO_REGISTRO) por 32
        mismo es (elemento base mas 2 de apuntes) es clase y (elemento base mas 4 de apuntes) es numero y (elemento base mas 5 de apuntes) es cuantas
        i es 1
        mientras mismo y i es menor o igual que cuantas
            si (elemento sitio mas i de apuntes_nombres) no es igual a (elemento i de nombre)
                mismo es falso
            fin
            i es i mas 1
        fin
        si mismo
            elemento base mas 1 de apuntes es segundos_del_dia
            elemento base mas 6 de apuntes es (elemento base mas 6 de apuntes) mas 1
            devuelve nada
        fin
    fin
    base es (apuntados resto CUPO_REGISTRO) por 8
    sitio es (apuntados resto CUPO_REGISTRO) por 32
    elemento base mas 1 de apuntes es segundos_del_dia
    elemento base mas 2 de apuntes es clase
    elemento base mas 3 de apuntes es tinta
    elemento base mas 4 de apuntes es numero
    elemento base mas 5 de apuntes es cuantas
    elemento base mas 6 de apuntes es 1
    i es 1
    mientras i es menor o igual que cuantas
        elemento sitio mas i de apuntes_nombres es elemento i de nombre
        i es i mas 1
    fin
    apuntados es apuntados mas 1
fin

funcion apunta_de con clase y t y numero
    apunta con clase y (nombre_de con t) y (color_de con t) y numero
fin

funcion es_tuya con clase
    si clase es R_PEN_ABRE o clase es R_PEN_BORRADO o clase es R_CERROJO o clase es R_BLOQUEASTE o clase es R_ABRISTE o clase es R_SIN_CERROJO
        devuelve verdadero
    fin
    si clase es R_COPIASTE o clase es R_PEGASTE o clase es R_VACIASTE o clase es R_INVITADO o clase es R_PING o clase es R_DEJASTE_RED o clase es R_NEGASTE_RED
        devuelve verdadero
    fin
    devuelve clase es mayor o igual que R_DEJASTE y clase es menor o igual que R_TECLADO
fin

funcion pinta_de con nombre y tinta
    pon_color con tinta y NEGRO
    pinta con nombre
    pon_color con GRIS y NEGRO
fin

funcion pinta_cuantos con n
    pon_color con BLANCO y NEGRO
    pinta_numero con n
    pon_color con GRIS y NEGRO
fin

funcion pinta_apunte con k
    base es (k resto CUPO_REGISTRO) por 8
    clase es elemento base mas 2 de apuntes
    tinta es elemento base mas 3 de apuntes
    n es elemento base mas 4 de apuntes
    veces es elemento base mas 6 de apuntes
    nombre es region con apuntes_nombres_en mas (k resto CUPO_REGISTRO) por 32 y (elemento base mas 5 de apuntes)
    destino es nombre
    si clase es mayor o igual que R_HABLO y clase es menor o igual que R_NEGASTE_RED
        sitio_nombre es apuntes_nombres_en mas (k resto CUPO_REGISTRO) por 32
        largo_nombre es elemento base mas 5 de apuntes
        corte es 1
        mientras corte es menor que largo_nombre y (elemento corte de nombre) no es igual a 32
            corte es corte mas 1
        fin
        destino es region con sitio_nombre mas corte y largo_nombre menos corte
        nombre es region con sitio_nombre y corte menos 1
    fin
    al_serie con nombre
    escribe " apunte " sin salto
    escribe clase sin salto
    escribe " " sin salto
    escribe n
    pon_color con GRIS_OSCURO y NEGRO
    pinta con "  "
    pinta_hora con (elemento base mas 1 de apuntes)
    hasta_columna con 13
    si es_tuya con clase
        pinta_de con "tú" y BLANCO
    si no si clase es R_DIRECCION
        pinta_de con "FalOS" y BLANCO
    si no
        pinta_de con nombre y tinta
    fin
    pinta con " "
    hasta_columna con 25
    si clase es R_LEYO
        pinta con "leyó "
        pinta_cuantos con n
        pinta con " bytes de "
        pinta con nombre
        pinta con ".dat"
    si no si clase es R_BUSCO
        pinta con "buscó "
        pinta con nombre
        pinta con ".dat y no había nada"
    si no si clase es R_PIDE
        pinta con "pidió guardar "
        pinta_cuantos con n
        pinta con " bytes"
    si no si clase es R_GUARDO
        pinta con "guardó "
        pinta_cuantos con n
        pinta con " bytes en "
        pinta con nombre
        pinta con ".dat"
    si no si clase es R_NEGADO
        pinta_de con "quiso guardar y no le dejé" y ROJO_CLARO
    si no si clase es R_TECLAS
        pinta con "se cerró con "
        pinta_cuantos con n
        si n es 1
            pinta con " tecla tuya"
        si no
            pinta con " teclas tuyas"
        fin
    si no si clase es R_LEE_LISTA
        pinta con "leyó quién guarda sin preguntarte"
    si no si clase es R_GUARDA_LISTA
        pinta con "apuntó quién guarda sin preguntarte"
    si no si clase es R_DEJASTE
        pinta con "dejaste guardar a "
        pinta_de con nombre y tinta
    si no si clase es R_SIEMPRE
        pinta con "dejaste guardar siempre a "
        pinta_de con nombre y tinta
    si no si clase es R_NEGASTE
        pinta con "no dejaste guardar a "
        pinta_de con nombre y tinta
    si no si clase es R_QUITASTE
        pinta con "quitaste el siempre a "
        pinta_de con nombre y tinta
    si no si clase es R_OLVIDASTE
        pinta con "borraste "
        pinta con nombre
        pinta con ".dat, "
        pinta_cuantos con n
        pinta con " bytes"
    si no si clase es R_TECLADO
        pinta con "diste el teclado a "
        pinta_de con nombre y tinta
    si no si clase es R_CERROJO
        pinta con "pusiste contraseña a la pantalla"
    si no si clase es R_BLOQUEASTE
        pinta con "bloqueaste la pantalla"
    si no si clase es R_SE_BLOQUEO
        pinta con "bloqueó la pantalla: 5 minutos sin tocarla"
    si no si clase es R_ABRISTE
        pinta con "abriste la pantalla"
    si no si clase es R_MALA
        pinta_de con "alguien probó una contraseña mala" y ROJO_CLARO
    si no si clase es R_SIN_CERROJO
        pinta con "quitaste la contraseña de la pantalla"
    si no si clase es R_COPIASTE
        pinta con "copiaste "
        pinta_cuantos con n
        pinta con " letras de "
        pinta_de con nombre y tinta
    si no si clase es R_PEGASTE
        pinta con "pegaste "
        pinta_cuantos con n
        pinta con " letras en "
        pinta_de con nombre y tinta
    si no si clase es R_VACIASTE
        pinta con "borraste el portapapeles"
    si no si clase es R_SE_BORRO y n es AL_BLOQUEAR
        pinta con "borró el portapapeles al bloquear"
    si no si clase es R_SE_BORRO
        pinta con "borró el portapapeles: pasaron 30 s"
    si no si clase es R_INVITADO
        pinta con "entraste como invitado: nada se escribe en el disco"
    si no si clase es R_TOCADO
        pinta_de con "pidió su archivo; estaba tocado y no se lo di" y ROJO_CLARO
    si no si clase es R_SIN_CIFRAR
        pinta_de con "pidió su archivo; no iba cifrado y no se lo di" y ROJO_CLARO
    si no si clase es R_GUARDO_MEMORIA
        pinta con "guardó "
        pinta_cuantos con n
        pinta con " bytes, solo en memoria"
    si no si clase es R_LEYO_MEMORIA
        pinta con "leyó "
        pinta_cuantos con n
        pinta con " bytes de la memoria"
    si no si clase es R_PING
        pinta con "hiciste ping a "
        pinta con nombre
        pinta con ": "
        pinta_numero con n
        pinta con " de 4 contestan"
    si no si clase es R_HABLO y n es mayor que 0
        pinta con "habló con "
        pinta con destino
        pinta con ": "
        pinta_cuantos con n
        pinta con " bytes de vuelta"
    si no si clase es R_HABLO
        pinta con "habló con "
        pinta con destino
        pinta con ": nadie contestó"
    si no si clase es R_RED_NEGADA
        pinta_de con "no le dejé hablar con " y ROJO_CLARO
        pinta_de con destino y ROJO_CLARO
    si no si clase es R_DEJASTE_RED
        pinta con "dejaste a "
        pinta_de con nombre y tinta
        pinta con " hablar con "
        pinta con destino
    si no si clase es R_NEGASTE_RED
        pinta con "no dejaste a "
        pinta_de con nombre y tinta
        pinta con " hablar con "
        pinta con destino
    si no si clase es R_USB
        pinta con "aceptó el teclado del puerto USB "
        pinta_cuantos con n
        pinta con ", al arrancar"
    si no si clase es R_USB_NUEVO
        pinta con "vio un teclado nuevo en el puerto USB "
        pinta_cuantos con n
    si no si clase es R_USB_BUENO
        pinta con "aceptó el teclado del puerto USB "
        pinta_cuantos con n
        pinta con ": tecleó el código"
    si no si clase es R_USB_MALO
        pinta_de con "no acepta el teclado del puerto USB " y ROJO_CLARO
        pinta_cuantos con n
        pinta con ": 3 códigos malos"
    si no si clase es R_USB_DMA
        pinta_de con "quiso salir de su memoria; lo paró el IOMMU" y ROJO_CLARO
    si no si clase es R_PEN_ABRE
        pinta con "abriste lo guardado en el pendrive: "
        pinta_cuantos con n
        pinta con " archivos"
    si no si clase es R_PEN_TOCADO
        pinta_de con "lo guardado en el pendrive no cuadra" y ROJO_CLARO
    si no si clase es R_PEN_FALLO
        pinta_de con "no consiguió escribir en el pendrive" y ROJO_CLARO
    si no si clase es R_PEN_BORRADO
        pinta con "borraste lo guardado en el pendrive"
    si no si clase es R_DIRECCION
        pinta con "pidió dirección a la red, y le dio "
        pinta con nombre
    si no si clase es R_SIN_DIRECCION
        pinta con "pidió dirección a la red, y nadie se la dio"
    fin
    si veces es mayor que 1
        pon_color con GRIS_OSCURO y NEGRO
        pinta con " ("
        pinta_numero con veces
        pinta con " veces)"
        pon_color con GRIS y NEGRO
    fin
    pinta_linea con ""
fin

funcion ensena_registro
    si apuntados es 0
        pinta_linea con "  Todavía nadie ha leído ni guardado nada."
        pinta_linea con ""
        devuelve nada
    fin
    desde es 0
    si apuntados es mayor que CUPO_REGISTRO
        desde es apuntados menos CUPO_REGISTRO
    fin
    pon_color con GRIS_OSCURO y NEGRO
    pinta_linea con "  hora UTC  quién       qué"
    pon_color con GRIS y NEGRO
    k es desde
    mientras k es menor que apuntados
        pinta_apunte con k
        k es k mas 1
    fin
    pinta_linea con ""
    pon_color con GRIS_OSCURO y NEGRO
    si desde es mayor que 0
        pinta con "  Antes hubo "
        pinta_numero con desde
        pinta_linea con " más, ya olvidados: guardo los 16 últimos."
    fin
    pinta_linea con "  Este registro solo vive en memoria. No lo escribo en el disco,"
    pinta_linea con "  se borra al apagar y ningún programa lo puede leer."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion esta_siempre con nombre
    i es 1
    mientras i es menor o igual que siempre_mide
        final es i
        mientras final es menor o igual que siempre_mide y (elemento final de siempre) no es igual a 10
            final es final mas 1
        fin
        si (final menos i) es (largo de nombre)
            parecido es verdadero
            j es 1
            mientras parecido y j es menor o igual que largo de nombre
                si (minuscula con (elemento i mas j menos 1 de siempre)) no es igual a (minuscula con (elemento j de nombre))
                    parecido es falso
                fin
                j es j mas 1
            fin
            si parecido
                devuelve i
            fin
        fin
        i es final mas 1
    fin
    devuelve 0
fin

funcion guarda_siempre
    respuesta es 0
    buzon es nombre_al_buzon con "permisos" y ".sis"
    si siempre_mide es 0
        respuesta es pide_al_disco con ORDEN_OLVIDA
        si respuesta es NO_ESTA
            respuesta es 0
        fin
    si no
        elemento 41 de buzon es cociente con siempre_mide y 256
        elemento 42 de buzon es siempre_mide resto 256
        copia_region con buzon y 513 y siempre y 1 y siempre_mide
        respuesta es pide_al_disco con ORDEN_GUARDA
    fin
    si respuesta es mayor o igual que 0
        desactiva_interrupciones
        apunta con R_GUARDA_LISTA y "FalOS" y BLANCO y siempre_mide
        activa_interrupciones
    fin
    al_serie con "permisos.sis guardado: "
    escribe respuesta
    devuelve respuesta
fin

funcion anade_siempre con nombre
    comparte siempre_mide
    si (esta_siempre con nombre) es mayor que 0
        devuelve verdadero
    fin
    viejo es siempre_mide
    si siempre_mide mas (largo de nombre) mas 1 es mayor que TOPE_SIEMPRE
        devuelve falso
    fin
    para cada b en nombre
        siempre_mide es siempre_mide mas 1
        elemento siempre_mide de siempre es b
    fin
    siempre_mide es siempre_mide mas 1
    elemento siempre_mide de siempre es 10
    si (guarda_siempre) es menor que 0
        siempre_mide es viejo
        devuelve falso
    fin
    devuelve verdadero
fin

funcion quita_siempre con nombre y tinta
    comparte siempre_mide
    i es esta_siempre con nombre
    si i es 0
        devuelve nada
    fin
    quitar es (largo de nombre) mas 1
    j es i
    mientras j mas quitar es menor o igual que siempre_mide
        elemento j de siempre es elemento j mas quitar de siempre
        j es j mas 1
    fin
    siempre_mide es siempre_mide menos quitar
    desactiva_interrupciones
    apunta con R_QUITASTE y nombre y tinta y 0
    activa_interrupciones
    guarda_siempre
fin

funcion lee_siempre
    comparte siempre_mide
    siempre_mide es 0
    traido es pide_archivo con "permisos" y ".sis" y 0
    si traido es menor que 1 o traido es mayor que TOPE_SIEMPRE
        devuelve nada
    fin
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    si (elemento traido de buzon) no es igual a 10
        devuelve nada
    fin
    i es 1
    mientras i es menor o igual que traido
        b es elemento i de buzon
        si b no es igual a 10 y (b es menor que 33 o b es mayor que 126)
            devuelve nada
        fin
        i es i mas 1
    fin
    copia_region con siempre y 1 y buzon y 1 y traido
    siempre_mide es traido
    desactiva_interrupciones
    apunta con R_LEE_LISTA y "FalOS" y BLANCO y traido
    activa_interrupciones
    al_serie con "permisos.sis leido: "
    escribe traido
fin

funcion pinta_siempre
    si siempre_mide es 0
        pinta_linea con "  Ningún programa guarda sin preguntarte."
        devuelve nada
    fin
    pinta con "  Guardan sin preguntarte: "
    pon_color con BLANCO y NEGRO
    i es 1
    mientras i es menor o igual que siempre_mide
        b es elemento i de siempre
        si b es 10 y i es menor que siempre_mide
            pinta con ", "
        si no si b no es igual a 10
            pon_letra con b
        fin
        i es i mas 1
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    pinta_linea con "  Para quitárselo a uno: niega y su nombre."
fin

funcion olvida_lo_escrito
    comparte clave_mide y primera_mide
    para cada i desde 1 hasta 32
        elemento i de clave_escrita es 0
        elemento i de clave_primera es 0
    fin
    para cada i desde 1 hasta 64
        elemento i de comprobada es 0
    fin
    clave_mide es 0
    primera_mide es 0
fin

funcion bloquea_ya con por_que
    comparte bloqueado y foco y agarrada y modo_clave y mensaje_cerrojo y malas y cortado
    si bloqueado o no hay_cerrojo o invitado
        devuelve nada
    fin
    si modo_clave es CLAVE_NUEVA o modo_clave es CLAVE_REPITE
        cortado es verdadero
    fin
    bloqueado es verdadero
    foco es CONSOLA
    agarrada es 0
    olvida_seleccion
    olvida_lo_escrito
    modo_clave es CLAVE_ABRE
    mensaje_cerrojo es NADA_QUE_DECIR
    malas es 0
    si por_que es POR_TI
        apunta con R_BLOQUEASTE y "FalOS" y BLANCO y 0
    si no si por_que es POR_QUIETO
        apunta con R_SE_BLOQUEO y "FalOS" y BLANCO y 0
    fin
    vacia_portapapeles con AL_BLOQUEAR
    ensucia
fin

funcion saca_sal con destino y desde
    comparte vueltas_azar
    si hay_azar
        trozos es region con azar_en y 2 y 8
        elemento 1 de trozos es azar_del_procesador
        elemento 2 de trozos es azar_del_procesador
        copia_region con destino y desde y (region con azar_en y 16) y 1 y 16
        elemento 1 de trozos es 0
        elemento 2 de trozos es 0
        devuelve nada
    fin
    vueltas_azar es vueltas_azar mas 1
    elemento CABEN_SORBOS mas 1 de pozo es tics
    elemento CABEN_SORBOS mas 2 de pozo es segundos_del_dia
    elemento CABEN_SORBOS mas 3 de pozo es sorbos
    elemento CABEN_SORBOS mas 4 de pozo es vueltas_azar
    blake2b con taller_azar y pozo_bytes y CABEN_SORBOS por 8 mas 32 y estado_azar y salida_azar y 64
    copia_region con estado_azar y 1 y salida_azar y 1 y 32
    copia_region con destino y desde y salida_azar y 33 y 16
    para cada i desde 1 hasta 64
        elemento i de salida_azar es 0
    fin
fin

funcion huella_de con sal y salida y version
    si version es 51 y pen_posible
        argon2id con memoria_cerrojo y BLOQUES_PENDRIVE y PASADAS_PENDRIVE y (region con clave_en y clave_mide) y sal y salida
        devuelve nada
    fin
    argon2id con memoria_cerrojo y BLOQUES_CERROJO y PASADAS_CERROJO y (region con clave_en y clave_mide) y sal y salida
fin

funcion es_la_buena
    distinto es 0
    para cada i desde 1 hasta 32
        distinto es distinto mas o_exclusivo con (elemento 20 mas i de cerrojo) y (elemento i de comprobada)
    fin
    si distinto es 0
        devuelve verdadero
    fin
    devuelve falso
fin

funcion pon_cerrojo
    comparte modo_clave
    si invitado
        pinta_linea con "  En modo invitado no se toca la contraseña."
        pinta_linea con ""
        devuelve nada
    fin
    si memoria_cerrojo es 0
        pinta_linea con "  No me quedan 2 MB seguidos para Argon2id, así que no puedo."
        pinta_linea con ""
        devuelve nada
    fin
    pinta_linea con "  No guardo tu contraseña: guardo su huella, hecha con Argon2id."
    pinta_linea con "  Si le das a Intro sin escribir nada, todo sigue como está."
    pinta con "  Contraseña nueva: "
    olvida_lo_escrito
    modo_clave es CLAVE_NUEVA
fin

funcion orden_bloquea
    si invitado
        pinta_linea con "  En modo invitado no hay nada tuyo que bloquear."
        pinta_linea con ""
        devuelve nada
    fin
    si no hay_cerrojo
        pinta_linea con "  Primero ponle contraseña: cerrojo."
        pinta_linea con ""
        devuelve nada
    fin
    desactiva_interrupciones
    bloquea_ya con POR_TI
    activa_interrupciones
fin

funcion quita_cerrojo
    comparte hay_cerrojo
    si invitado
        pinta_linea con "  En modo invitado no se toca la contraseña."
        pinta_linea con ""
        devuelve nada
    fin
    si no hay_cerrojo
        pinta_linea con "  La pantalla no tiene contraseña."
        pinta_linea con ""
        devuelve nada
    fin
    si pen_estado es PEN_ABIERTO
        pinta_linea con "  En el pendrive no: ahí la llave solo va cerrada con tu contraseña."
        pinta_linea con "  Si quieres borrarlo: pendrive borra"
        pinta_linea con ""
        devuelve nada
    fin
    si hay_llave
        hecho es guarda_llave
        si hecho es menor que 0
            fallo_de_disco con hecho
            pinta_linea con "  No he podido dejar la llave en el disco, así que la dejo puesta."
            devuelve nada
        fin
    fin
    nombre_al_buzon con "cerrojo" y ".sis"
    respuesta es pide_al_disco con ORDEN_OLVIDA
    al_serie con "cerrojo.sis olvidado: "
    escribe respuesta
    si respuesta es menor que 0 y respuesta no es igual a NO_ESTA
        fallo_de_disco con respuesta
        devuelve nada
    fin
    hay_cerrojo es falso
    para cada i desde 1 hasta TOPE_CERROJO
        elemento i de cerrojo es 0
    fin
    desactiva_interrupciones
    apunta con R_SIN_CERROJO y "FalOS" y BLANCO y 0
    activa_interrupciones
    pinta_linea con "  Quitada, y su huella borrada del disco con ceros."
    si hay_llave
        pon_color con AMARILLO y NEGRO
        pinta_linea con "  Lo guardado sigue cifrado, pero la llave queda en el disco sin"
        pinta_linea con "  contraseña: quien se lleve el disco lo puede abrir."
        pon_color con GRIS y NEGRO
    fin
    pinta_linea con ""
fin

funcion guarda_cerrojo
    comparte hay_cerrojo
    fichero es region con clave_en mas 256 y TOPE_CERROJO
    i es 1
    para cada letra en MARCA_CERROJO
        elemento i de fichero es letra
        i es i mas 1
    fin
    si pen_posible
        elemento 4 de fichero es 51
    fin
    saca_sal con fichero y 5
    huella_de con (region con clave_en mas 260 y 16) y (region con clave_en mas 276 y 64) y (elemento 4 de fichero)
    estrenada es no hay_llave
    si estrenada y no nueva_llave
        para cada i desde 1 hasta TOPE_CERROJO
            elemento i de fichero es 0
        fin
        pinta_linea con "  No la he guardado, así que todo sigue como estaba."
        devuelve nada
    fin
    para cada i desde 1 hasta 32
        elemento 52 mas i de fichero es o_exclusivo con (elemento 52 mas i de fichero) y (elemento i de llave)
    fin
    buzon es nombre_al_buzon con "cerrojo" y ".sis"
    elemento 41 de buzon es 0
    elemento 42 de buzon es TOPE_CERROJO
    copia_region con buzon y 513 y fichero y 1 y TOPE_CERROJO
    respuesta es pide_al_disco con ORDEN_GUARDA
    al_serie con "cerrojo.sis guardado: "
    escribe respuesta
    para cada i desde 1 hasta TOPE_CERROJO
        elemento 512 mas i de buzon es 0
    fin
    si respuesta es menor que 0
        si estrenada
            olvida_llave
        fin
        para cada i desde 1 hasta TOPE_CERROJO
            elemento i de fichero es 0
        fin
        fallo_de_disco con respuesta
        pinta_linea con "  No la he guardado, así que todo sigue como estaba."
        devuelve nada
    fin
    copia_region con cerrojo y 1 y fichero y 1 y TOPE_CERROJO
    para cada i desde 1 hasta TOPE_CERROJO
        elemento i de fichero es 0
    fin
    hay_cerrojo es verdadero
    nombre_al_buzon con "llave" y ".sis"
    sobra es pide_al_disco con ORDEN_OLVIDA
    si sobra no es igual a NO_ESTA
        al_serie con "llave.sis olvidado: "
        escribe sobra
    fin
    desactiva_interrupciones
    apunta con R_CERROJO y "FalOS" y BLANCO y 0
    activa_interrupciones
    si disco_en_memoria
        acaba_cerrojo_del_pendrive
        devuelve nada
    fin
    pon_color con VERDE_CLARO y NEGRO
    pinta_linea con "  Hecho. Para entrar hará falta, también al arrancar. Y la llave"
    pinta_linea con "  que cifra lo que guardan los programas solo se abre con ella."
    pon_color con GRIS y NEGRO
    pinta_linea con "  Escribe bloquea para bloquear ya. Y me bloqueo solo si pasan"
    pinta_linea con "  5 minutos sin que toques el teclado ni el ratón."
fin

funcion acaba_cerrojo_del_pendrive
    comparte pen_estado
    antes es pen_estado
    si antes no es igual a PEN_NUEVO y antes no es igual a PEN_ABIERTO
        pon_color con AMARILLO y NEGRO
        pinta_linea con "  Hecho, pero solo hasta que apagues: no tengo dónde guardarla."
        pinta_linea con "  Escribe pendrive para saber por qué."
        pon_color con GRIS y NEGRO
        devuelve nada
    fin
    pinta_linea con "  Escribiendo en el pendrive. No lo quites todavía..."
    hecho es escribe_pendrive con verdadero
    si hecho es menor que 0
        fallo_de_disco con hecho
        si antes es PEN_NUEVO
            pinta_linea con "  La contraseña vale hasta que apagues, y nada queda en el pendrive."
        si no
            pinta_linea con "  En el pendrive puede seguir valiendo la contraseña de antes."
        fin
        devuelve nada
    fin
    pen_estado es PEN_ABIERTO
    pon_color con VERDE_CLARO y NEGRO
    pinta_linea con "  Hecho. Lo guardado y lo que guardes va al pendrive, cifrado, y sin esta"
    pinta_linea con "  contraseña no se abre. Si la olvidas no hay otra forma: ni yo puedo."
    pon_color con GRIS y NEGRO
    pinta_linea con "  Quien se lo lleve puede probar contraseñas sin parar: que sea larga."
    pinta_linea con "  Escribe bloquea para bloquear ya, y a los 5 minutos me bloqueo solo."
fin

funcion abre_cerrojo
    comparte bloqueado y modo_clave y mensaje_cerrojo y malas y cortado y ultima_actividad y hay_llave
    si clave_mide es 0
        entra_invitado
        vuelve_la_consola
        devuelve nada
    fin
    mensaje_cerrojo es COMPROBANDO
    ensucia
    version es elemento 4 de cerrojo
    nueva es version es mayor o igual que 50
    si nueva
        huella_de con (region con cerrojo_en mas 4 y 16) y comprobada y version
    si no
        huella_de con (region con cerrojo_en mas 4 y 16) y (region con clave_en mas 128 y 32) y version
    fin
    buena es es_la_buena
    si buena y nueva
        para cada i desde 1 hasta 32
            elemento i de llave es o_exclusivo con (elemento 52 mas i de cerrojo) y (elemento 32 mas i de comprobada)
        fin
        hay_llave es verdadero
    fin
    olvida_lo_escrito
    si no buena
        malas es malas mas 1
        mensaje_cerrojo es NO_ES_ESA
        desactiva_interrupciones
        apunta con R_MALA y "FalOS" y BLANCO y 0
        activa_interrupciones
        ensucia
        devuelve nada
    fin
    desactiva_interrupciones
    bloqueado es falso
    modo_clave es SIN_CLAVE
    mensaje_cerrojo es NADA_QUE_DECIR
    ultima_actividad es tics
    apunta con R_ABRISTE y "FalOS" y BLANCO y 0
    activa_interrupciones
    si pen_estado es PEN_CERRADO
        abre_pendrive
    fin
    si cortado
        pinta_linea con ""
        pinta_linea con "  Me bloqueé antes de que acabaras la contraseña. Nada cambia."
        pinta_linea con ""
        cortado es falso
    fin
    si malas es mayor que 0
        pinta_linea con ""
        pon_color con AMARILLO y NEGRO
        pinta con "  Mientras estaba bloqueado, alguien probó "
        pinta_numero con malas
        si malas es 1
            pinta_linea con " contraseña mala."
        si no
            pinta_linea con " contraseñas malas."
        fin
        pon_color con GRIS y NEGRO
        pinta_linea con "  Lo tienes en registro."
        pinta_linea con ""
        malas es 0
    fin
    vuelve_la_consola
    ensucia
fin

funcion atiende_clave con tecla
    comparte clave_mide y columna y mensaje_cerrojo
    si tecla es TECLA_INTRO
        termina_clave
    si no si tecla es TECLA_BORRA y clave_mide es mayor que 0
        elemento clave_mide de clave_escrita es 0
        clave_mide es clave_mide menos 1
        si modo_clave es CLAVE_ABRE
            ensucia
        si no
            columna es columna menos 1
            pinta con " "
            columna es columna menos 1
            mueve_cursor
        fin
    si no si tecla es mayor o igual que 32 y tecla es menor que 256 y clave_mide es menor que 32
        clave_mide es clave_mide mas 1
        elemento clave_mide de clave_escrita es tecla
        si modo_clave es CLAVE_ABRE
            mensaje_cerrojo es NADA_QUE_DECIR
            ensucia
        si no
            pinta con "*"
        fin
    fin
fin

funcion termina_clave
    comparte modo_clave y primera_mide y clave_mide
    si modo_clave es CLAVE_ABRE
        abre_cerrojo
        devuelve nada
    fin
    pinta_linea con ""
    si modo_clave es CLAVE_NUEVA
        si clave_mide es 0
            pinta_linea con "  Nada cambia."
            acaba_clave
            devuelve nada
        fin
        copia_region con clave_primera y 1 y clave_escrita y 1 y 32
        primera_mide es clave_mide
        para cada i desde 1 hasta 32
            elemento i de clave_escrita es 0
        fin
        clave_mide es 0
        pinta con "  Repítela: "
        modo_clave es CLAVE_REPITE
        devuelve nada
    fin
    iguales es clave_mide es primera_mide
    para cada i desde 1 hasta 32
        si (elemento i de clave_escrita) no es igual a (elemento i de clave_primera)
            iguales es falso
        fin
    fin
    si iguales y clave_mide es mayor que 0
        pinta_linea con "  Calculando la huella..."
        guarda_cerrojo
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No son iguales. No cambio nada."
        pon_color con GRIS y NEGRO
    fin
    acaba_clave
fin

funcion acaba_clave
    comparte modo_clave
    olvida_lo_escrito
    modo_clave es SIN_CLAVE
    pinta_linea con ""
    vuelve_la_consola
fin

funcion lee_cerrojo
    comparte hay_cerrojo
    traido es pide_archivo con "cerrojo" y ".sis" y 0
    si traido es menor que 0 y traido no es igual a REPETIDO
        devuelve nada
    fin
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    version es elemento 4 de buzon
    bien es (traido es TOPE_CERROJO y version es 50) o (traido es VIEJO_CERROJO y version es 49)
    i es 1
    para cada letra en MARCA_CERROJO
        si bien y i es menor que 4 y (elemento i de buzon) no es igual a letra
            bien es falso
        fin
        i es i mas 1
    fin
    al_serie con "cerrojo.sis leido: "
    escribe traido
    si no bien o memoria_cerrojo es 0
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No entiendo cerrojo.sis, así que arranco sin contraseña."
        pinta_linea con "  Si no lo has tocado tú, alguien ha estado en el disco."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    copia_region con cerrojo y 1 y buzon y 1 y traido
    hay_cerrojo es verdadero
    si version es 49
        pon_color con AMARILLO y NEGRO
        pinta_linea con "  Tu contraseña es de antes del día 14. Al entrar, vuelve a ponerla"
        pinta_linea con "  con cerrojo: hasta entonces los programas no pueden guardar nada."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
    fin
    desactiva_interrupciones
    bloquea_ya con AL_ARRANCAR
    activa_interrupciones
fin

funcion barra
    pon_color con BLANCO y AZUL
    ve_a con 1 y 1
    para cada c desde 1 hasta ANCHO
        pinta con " "
    fin
    ve_a con 1 y 3
    pinta con "FalOS"
    ve_a con 1 y 74
    pinta con "día 24"
    pon_color con GRIS y NEGRO
fin

funcion portada
    pon_color con GRIS y NEGRO
    limpia
    barra
    ve_a con 3 y 3
    pon_color con BLANCO y NEGRO
    pinta_linea con "Hola. Soy FalOS, un sistema operativo escrito en Fal."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    si hay_graficos
        pinta_linea con "  Arranqué en modo de 64 bits. La letra que lees la he dibujado yo,"
        pinta_linea con "  píxel a píxel, y la pinta un programa sin permisos."
    si no
        pinta_linea con "  Arranqué en modo de 64 bits. Esta tarjeta no me deja pintar píxeles,"
        pinta_linea con "  así que esto va en modo de texto, casilla a casilla."
    fin
    pinta_linea con ""
    pinta_linea con "  Hago varias cosas a la vez. Los programas salen del disco y nacen sin"
    pinta_linea con "  permisos, solo hablan entre ellos si tú les dejas, y si intentan algo"
    pinta_linea con "  más, los cierro. El teclado, el disco, la pantalla y esta consola ya"
    pinta_linea con "  no van dentro de mí: son programas, y si se cuelgan, lanzo otros."
    pinta_linea con ""
    si disco_en_memoria
        pon_color con VERDE_CLARO y NEGRO
        si pen_posible
            pinta_linea con "  He arrancado desde un pendrive, y no toco ningún disco de este"
            pinta_linea con "  ordenador. Con contraseña (cerrojo), lo que guardes va al pendrive,"
            pinta_linea con "  cifrado. Sin ella no escribo en él, y se borra al apagar."
        si no
            pinta_linea con "  He arrancado desde un pendrive. Mi disco va entero en la memoria:"
            pinta_linea con "  no toco ningún disco de este ordenador, y lo que guardes se borra"
            pinta_linea con "  al apagar."
        fin
        pon_color con GRIS y NEGRO
    si no
        pinta_linea con "  Cada programa sale en su ventana, y el borde lo pinto yo, del color"
        pinta_linea con "  de su caja. Él no puede tocarlo. Y lo que escribes solo le llega"
        pinta_linea con "  al programa al que tú le das el teclado."
    fin
    pinta_linea con ""
    pinta_linea con "  Hay un juego en el disco (lanza serpiente) y un bloc de notas"
    pinta_linea con "  (lanza notas) que guarda lo que escribes cifrado con tu clave."
    pinta_linea con "  Y registro te dice qué programa ha tocado tus cosas, y cuándo."
    pinta_linea con "  Con cerrojo, la pantalla pide contraseña para entrar."
    pinta_linea con "  Lo que copias con Ctrl+C no lo puede leer ningún programa, y lo que"
    pinta_linea con "  guardan va cifrado, cada uno con su clave. Con ping pruebo la red, y"
    pinta_linea con "  un programa solo se conecta a donde tú le dejes. Y mi memoria ni"
    pinta_linea con "  siquiera está en sus tablas: Meltdown no encuentra nada que leer."
    si no hay_azar
        pinta_linea con "  Este procesador no trae generador de azar, así que las llaves las"
        pinta_linea con "  saco del instante exacto en que pulsas cada tecla."
    fin
    pon_color con AMARILLO y NEGRO
    pinta_linea con "  Escribe ayuda para ver lo que sé hacer, o reto si quieres romperme."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

escribe "FalOS arrancado"
si modo_video es VIDEO_DEL_CARGADOR
    al_serie con "pantalla del cargador: "
    escribe ancho_del_cargador sin salto
    al_serie con " por "
    escribe (elemento VIDEO_FILAS de control)
fin
si disco_en_memoria
    al_serie con "disco en memoria: "
    escribe cociente con bytes_del_modulo y 1024
fin
portada
compone
si hay_graficos
    lanza_controlador con TAREA_PANTALLA
fin
lanza_controlador con TAREA_TECLADO
lanza_controlador con TAREA_DISCO
si hay_red
    lanza_controlador con TAREA_RED
fin
si hay_red y puerto_red no es igual a 0
    al_serie con "red: NE2000 en el puerto "
    escribe puerto_red
fin
si red_como no es igual a RED_NO_HAY
    al_serie con "red: intel "
    escribe red_como
fin
lanza_controlador con TAREA_CONSOLA
si usb_como es USB_LISTO
    lanza_controlador con TAREA_USB
fin
al_serie con "usb: "
escribe usb_como
si hay_iommu
    al_serie con "iommu: encendido, todo el DMA bloqueado salvo "
    escribe rmrr_cuantos sin salto
    escribe " trozos de la BIOS"
si no
    al_serie con "iommu: no, motivo "
    escribe por_que_no_iommu
fin
prepara_raton
si hay_raton
    escribe "ratón listo"
fin
si hay_azar
    escribe "azar: del procesador"
si no
    escribe "azar: del reloj, en cada tecla"
fin
si no hay_8042
    escribe "teclado: no hay controlador PS/2"
    si usb_como no es igual a USB_LISTO
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No encuentro el teclado PS/2, y tampoco puedo usar uno USB, así que no"
        pinta_linea con "  podré leer lo que escribas."
        pinta_por_que_no_usb
        pinta_linea con "  Prueba a activar en la BIOS el VT-d, o USB Legacy y el CSM."
        pinta_linea con ""
    fin
fin
mira_el_reloj
prepara_interrupciones
cierra_interrupciones_ajenas
lee_siempre
lee_cerrojo
mira_el_pendrive
lee_llave
vuelve_la_consola
escribe "pantalla lista"

mientras verdadero
    atiende con siguiente_tecla
fin
