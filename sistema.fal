elemento CONSOLA de estados_tarea es EN_MARCHA
elemento CONSOLA de raices es raiz_nucleo

teclado_imagen es incluye_programa de "controladores/teclado.fal"
disco_imagen es incluye_programa de "controladores/disco.fal"
pantalla_imagen es incluye_programa de "controladores/pantalla.fal"

funcion imagen_de con t
    si t es TAREA_TECLADO
        devuelve teclado_imagen
    si no si t es TAREA_DISCO
        devuelve disco_imagen
    fin
    devuelve pantalla_imagen
fin

funcion nombre_de con t
    si t es TAREA_TECLADO
        devuelve "teclado"
    si no si t es TAREA_DISCO
        devuelve "disco"
    si no si t es TAREA_PANTALLA
        devuelve "pantalla"
    fin
    devuelve region con nombres_en mas (t menos 1) por 32 y (elemento t de nombre_mide)
fin

funcion apunta_nombre con t y nombre
    cuantas es largo de nombre
    si cuantas es mayor que 32
        cuantas es 32
    fin
    para cada i desde 1 hasta cuantas
        elemento (t menos 1) por 32 mas i de nombres es elemento i de nombre
    fin
    elemento t de nombre_mide es cuantas
fin

funcion al_serie con t
    para cada b en t
        mientras ((lee_puerto de 1021) resto 64) es menor que 32
        fin
        pon_en_puerto con 1016 y b
    fin
fin

funcion color_de con t
    si t es 1
        devuelve VERDE_CLARO
    si no si t es 2
        devuelve AMARILLO
    si no si t es 3
        devuelve MAGENTA_CLARO
    si no si t es 4
        devuelve CIAN_CLARO
    fin
    devuelve AZUL_CLARO
fin

TEXTO_ANCHO es 34
TEXTO_ALTO es 6
ANCHO_MINIMO es 10
ANCHO_MAXIMO es 60
ALTO_MINIMO es 3
ALTO_MAXIMO es 18
CASILLAS es 2048
SIN_VENTANA es 0
VENTANA_VIVA es 1
VENTANA_ACABADA es 2
EN_ANCHO es 960
EN_ALTO es 600
LETRA_ANCHO es 12
LETRA_ALTO es 24

ventana_de es region con pide_pagina y 512 y 8
ventana_x es region con pide_pagina y 512 y 8
ventana_y es region con pide_pagina y 512 y 8
fila_de_ventana es region con pide_pagina y 512 y 8
anchos es region con pide_pagina y 512 y 8
altos es region con pide_pagina y 512 y 8
hojas_de_texto es region con pide_pagina y 512 y 8
para cada con_texto desde 1 hasta MAX_TAREAS
    elemento con_texto de hojas_de_texto es pide_pagina
fin
encima es region con pide_pagina y 512 y 8
puestas es 0

raton_x es cociente con EN_ANCHO y 2
raton_y es cociente con EN_ALTO y 2
raton_visto es falso
botones_antes es 0
agarrada es 0
agarre es 0

funcion es_controlador con t
    devuelve t es mayor que CONSOLA
fin

funcion entre_limites con valor y minimo y maximo
    si valor es menor que minimo
        devuelve minimo
    si no si valor es mayor que maximo
        devuelve maximo
    fin
    devuelve valor
fin

funcion texto_de con t
    devuelve region con (elemento t de hojas_de_texto) y CASILLAS y 2
fin

funcion casilla_de_texto con t y renglon y c
    devuelve (renglon menos 1) por (elemento t de anchos) mas c
fin

funcion ancho_de_ventana con t
    devuelve (elemento t de anchos) mas 2
fin

funcion alto_de_ventana con t
    devuelve (elemento t de altos) mas 2
fin

funcion saca_de_encima con t
    comparte puestas
    i es 1
    quedan es 0
    mientras i es menor o igual que puestas
        otra es elemento i de encima
        si otra no es igual a t
            quedan es quedan mas 1
            elemento quedan de encima es otra
        fin
        i es i mas 1
    fin
    puestas es quedan
fin

funcion sube_ventana con t
    comparte puestas
    saca_de_encima con t
    elemento puestas mas 1 de encima es t
    puestas es puestas mas 1
    ensucia
fin

funcion limpia_ventana con t
    texto es texto_de con t
    para cada i desde 1 hasta (elemento t de anchos) por (elemento t de altos)
        elemento i de texto es GRIS por 256 mas 32
    fin
    elemento t de columna_de es 1
    elemento t de fila_de_ventana es 1
    olvida_seleccion_de con t
fin

funcion abre_ventana con t
    elemento t de anchos es TEXTO_ANCHO
    elemento t de altos es TEXTO_ALTO
    limpia_ventana con t
    elemento t de ventana_x es ANCHO menos (ancho_de_ventana con t) menos (t menos 1) por 3 menos 1
    elemento t de ventana_y es 3 mas (t menos 1) por 4
    elemento t de ventana_de es VENTANA_VIVA
    sube_ventana con t
fin

funcion cambia_tamano con columnas y renglones
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si (elemento t de ventana_de) no es igual a VENTANA_VIVA
        devuelve rechaza_a_actual
    fin
    si columnas es menor que ANCHO_MINIMO o columnas es mayor que ANCHO_MAXIMO o renglones es menor que ALTO_MINIMO o renglones es mayor que ALTO_MAXIMO
        devuelve rechaza_a_actual
    fin
    elemento t de anchos es columnas
    elemento t de altos es renglones
    limpia_ventana con t
    elemento t de ventana_x es entre_limites con (elemento t de ventana_x) y 1 y (ANCHO menos columnas menos 1)
    elemento t de ventana_y es entre_limites con (elemento t de ventana_y) y 2 y (ALTO menos renglones menos 1)
    ensucia
    devuelve 0
fin

funcion pon_en_casilla con sitio y valor
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si (elemento t de ventana_de) no es igual a VENTANA_VIVA
        devuelve rechaza_a_actual
    fin
    si sitio es menor que 0 o sitio es mayor que 65535 o valor es menor que 0 o valor es mayor que 4095
        devuelve rechaza_a_actual
    fin
    renglon es cociente con sitio y 256
    c es sitio resto 256
    tinta es cociente con valor y 256
    letra es valor resto 256
    si renglon es menor que 1 o renglon es mayor que (elemento t de altos) o c es menor que 1 o c es mayor que (elemento t de anchos)
        devuelve rechaza_a_actual
    fin
    si tinta es 0 o letra es menor que 32
        devuelve rechaza_a_actual
    fin
    texto es texto_de con t
    elemento (casilla_de_texto con t y renglon y c) de texto es valor
    ensucia
    devuelve 0
fin

funcion acaba_ventana con t
    si (elemento t de ventana_de) es VENTANA_VIVA
        elemento t de ventana_de es VENTANA_ACABADA
        ensucia
    fin
fin

funcion quita_ventana con t
    comparte agarrada
    elemento t de ventana_de es SIN_VENTANA
    saca_de_encima con t
    si agarrada es t
        agarrada es 0
    fin
    olvida_seleccion_de con t
    ensucia
fin

funcion salto_en_ventana con t
    elemento t de columna_de es 1
    renglon es elemento t de fila_de_ventana
    columnas es elemento t de anchos
    renglones es elemento t de altos
    si renglon es menor que renglones
        elemento t de fila_de_ventana es renglon mas 1
    si no
        texto es texto_de con t
        copia_region con texto y 1 y texto y columnas mas 1 y columnas por (renglones menos 1)
        para cada c desde 1 hasta columnas
            elemento (renglones menos 1) por columnas mas c de texto es GRIS por 256 mas 32
        fin
        olvida_seleccion_de con t
    fin
    ensucia
fin

funcion pon_en_ventana con t y letra
    c es elemento t de columna_de
    si c es mayor que (elemento t de anchos)
        salto_en_ventana con t
        c es 1
    fin
    texto es texto_de con t
    elemento (casilla_de_texto con t y (elemento t de fila_de_ventana) y c) de texto es BLANCO por 256 mas letra
    elemento t de columna_de es c mas 1
    ensucia
fin

funcion letra_de_programa con b
    t es actual
    si es_controlador con t
        devuelve nada
    fin
    medias es elemento t de medias_de
    si b es 10
        salto_en_ventana con t
        elemento t de medias_de es 0
    si no si b es mayor o igual que 192
        elemento t de medias_de es b
    si no si medias no es igual a 0 o b es menor que 128 y b es mayor o igual que 32
        letra es b
        si medias no es igual a 0
            letra es en_437 con medias y b
            elemento t de medias_de es 0
        fin
        pon_en_ventana con t y letra
    fin
fin

funcion pon_en_vista con renglon y c y valor
    si renglon es mayor o igual que 1 y renglon es menor o igual que ALTO y c es mayor o igual que 1 y c es menor o igual que ANCHO
        elemento (renglon menos 1) por ANCHO mas c de lo_que_se_ve es valor
    fin
fin

funcion pon_texto_en_vista con renglon y c y texto y tinta
    i es 1
    mientras i es menor o igual que largo de texto
        pon_en_vista con renglon y c mas i menos 1 y tinta mas (elemento i de texto)
        i es i mas 1
    fin
fin

funcion pinta_ventana con t
    estado es elemento t de ventana_de
    si estado es SIN_VENTANA
        devuelve nada
    fin
    vx es elemento t de ventana_x
    vy es elemento t de ventana_y
    va es ancho_de_ventana con t
    columnas es elemento t de anchos
    tinta es color_de con t
    si estado es VENTANA_ACABADA
        tinta es GRIS_OSCURO
    fin
    titulo es tinta por 16 por 256
    linea es tinta por 256
    para cada c desde 0 hasta va menos 1
        pon_en_vista con vy y vx mas c y titulo mas 32
    fin
    pon_en_vista con vy y vx mas 1 y titulo mas 48 mas t
    nombre es nombre_de con t
    cuantas es largo de nombre
    si cuantas es mayor que 16
        cuantas es 16
    fin
    i es 1
    mientras i es menor o igual que cuantas
        pon_en_vista con vy y vx mas 2 mas i y titulo mas (elemento i de nombre)
        i es i mas 1
    fin
    si estado es VENTANA_ACABADA
        pon_texto_en_vista con vy y vx mas 4 mas cuantas y "ya no corre" y titulo
    si no si foco es t y 4 mas cuantas mas 16 es menor que va menos 4
        pon_texto_en_vista con vy y vx mas 4 mas cuantas y "tiene el teclado" y titulo
    si no si foco es t
        pon_texto_en_vista con vy y vx mas 4 mas cuantas y "teclado" y titulo
    fin
    boton es (ROJO por 16 mas BLANCO) por 256
    pon_en_vista con vy y vx mas va menos 4 y boton mas 32
    pon_en_vista con vy y vx mas va menos 3 y boton mas 120
    pon_en_vista con vy y vx mas va menos 2 y boton mas 32
    texto es texto_de con t
    para cada renglon desde 1 hasta elemento t de altos
        pon_en_vista con vy mas renglon y vx y linea mas 179
        primera es (renglon menos 1) por columnas
        para cada c desde 1 hasta columnas
            pon_en_vista con vy mas renglon y vx mas c y (elemento primera mas c de texto)
        fin
        pon_en_vista con vy mas renglon y vx mas va menos 1 y linea mas 179
    fin
    pie es vy mas (alto_de_ventana con t) menos 1
    pon_en_vista con pie y vx y linea mas 192
    para cada c desde 1 hasta va menos 2
        pon_en_vista con pie y vx mas c y linea mas 196
    fin
    pon_en_vista con pie y vx mas va menos 1 y linea mas 217
fin

funcion dentro_de_ventana con t y renglon y c
    si (elemento t de ventana_de) es SIN_VENTANA
        devuelve falso
    fin
    vx es elemento t de ventana_x
    vy es elemento t de ventana_y
    va es ancho_de_ventana con t
    vh es alto_de_ventana con t
    devuelve c es mayor o igual que vx y c es menor que vx mas va y renglon es mayor o igual que vy y renglon es menor que vy mas vh
fin

funcion ventana_en con renglon y c
    i es puestas
    mientras i es mayor o igual que 1
        t es elemento i de encima
        si dentro_de_ventana con t y renglon y c
            devuelve t
        fin
        i es i menos 1
    fin
    devuelve 0
fin

funcion compone
    si bloqueado
        pinta_cerrojo
    si no
        copia_region con lo_que_se_ve y 1 y pantalla y 1 y ANCHO por ALTO
        i es 1
        mientras i es menor o igual que puestas
            pinta_ventana con (elemento i de encima)
            i es i mas 1
        fin
        pinta_seleccion
        pinta_aviso_disco
        pinta_aviso_pegado
        pinta_portapapeles
    fin
    pinta_reloj
    sitio es cursor_sitio
    renglon es (cociente con sitio y ANCHO) mas 1
    c es (sitio resto ANCHO) mas 1
    si (ventana_en con renglon y c) no es igual a 0 o foco no es igual a CONSOLA o bloqueado
        sitio es ANCHO por ALTO
    fin
    si hay_graficos
        elemento CURSOR_EN de control es sitio
        si raton_visto
            elemento DONDE_RATON_X de control es raton_x
            elemento DONDE_RATON_Y de control es raton_y
        fin
        devuelve nada
    fin
    pon_en_puerto con 980 y 15
    pon_en_puerto con 981 y (sitio resto 256)
    pon_en_puerto con 980 y 14
    pon_en_puerto con 981 y (cociente con sitio y 256)
    si raton_visto
        casilla es (cociente con raton_y y LETRA_ALTO) por ANCHO mas (cociente con raton_x y LETRA_ANCHO) mas 1
        valor es elemento casilla de lo_que_se_ve
        atributo es cociente con valor y 256
        al_reves es (atributo resto 16) por 16 mas (cociente con atributo y 16)
        elemento casilla de lo_que_se_ve es al_reves por 256 mas (valor resto 256)
    fin
fin

funcion pon_frase_en_vista con renglon y c y texto y tinta
    sitio es c
    a_medias es 0
    para cada b en texto
        si b es 195
            a_medias es b
        si no
            letra es b
            si a_medias no es igual a 0
                letra es en_437 con a_medias y b
                a_medias es 0
            fin
            pon_en_vista con renglon y sitio y tinta mas letra
            sitio es sitio mas 1
        fin
    fin
fin

funcion pinta_cerrojo
    fondo es (NEGRO por 16 mas GRIS) por 256
    i es 1
    mientras i es menor o igual que ANCHO por ALTO
        elemento i de lo_que_se_ve es fondo mas 32
        i es i mas 1
    fin
    copia_region con lo_que_se_ve y 1 y pantalla y 1 y ANCHO
    pon_frase_en_vista con 9 y 31 y "FalOS está bloqueado" y (NEGRO por 16 mas BLANCO) por 256
    pon_frase_en_vista con 12 y 25 y "Contraseña:" y fondo
    i es 1
    mientras i es menor o igual que clave_mide
        pon_en_vista con 12 y 36 mas i y (NEGRO por 16 mas AMARILLO) por 256 mas 42
        i es i mas 1
    fin
    pon_en_vista con 12 y 37 mas clave_mide y (NEGRO por 16 mas CIAN_CLARO) por 256 mas 95
    si mensaje_cerrojo es NO_ES_ESA
        pon_frase_en_vista con 14 y 37 y "No es esa." y (NEGRO por 16 mas ROJO_CLARO) por 256
    si no si mensaje_cerrojo es COMPROBANDO
        pon_frase_en_vista con 14 y 37 y "Comprobando..." y fondo
    fin
    pon_frase_en_vista con 18 y 12 y "Los programas siguen, pero no ven tus teclas ni tu ratón," y (NEGRO por 16 mas GRIS_OSCURO) por 256
    pon_frase_en_vista con 19 y 12 y "y lo que pintan no sale hasta que vuelvas." y (NEGRO por 16 mas GRIS_OSCURO) por 256
fin

funcion pinta_aviso_disco
    si aviso_disco_hasta es 0 o disco_lo_usa es 0
        devuelve nada
    fin
    marca es (AMARILLO por 16 mas NEGRO) por 256
    pon_en_vista con 1 y 24 y (color_de con disco_lo_usa) por 16 por 256 mas 32
    pon_en_vista con 1 y 25 y marca mas 32
    nombre es nombre_de con disco_lo_usa
    pon_texto_en_vista con 1 y 26 y nombre y marca
    si disco_guardaba
        pon_texto_en_vista con 1 y 26 mas largo de nombre y " escribe en el disco " y marca
    si no
        pon_texto_en_vista con 1 y 26 mas largo de nombre y " lee del disco " y marca
    fin
fin

funcion pinta_reloj
    tinta es (AZUL por 16 mas BLANCO) por 256
    minutos es cociente con segundos_del_dia y 60
    h es cociente con minutos y 60
    m es minutos resto 60
    pon_en_vista con 1 y 61 y tinta mas 48 mas (cociente con h y 10)
    pon_en_vista con 1 y 62 y tinta mas 48 mas (h resto 10)
    pon_en_vista con 1 y 63 y tinta mas 58
    pon_en_vista con 1 y 64 y tinta mas 48 mas (cociente con m y 10)
    pon_en_vista con 1 y 65 y tinta mas 48 mas (m resto 10)
    pon_texto_en_vista con 1 y 67 y "UTC" y tinta
fin

funcion pinta_seleccion
    si sel_de es 0
        devuelve nada
    fin
    desde es sel_ancla
    hasta es sel_punta
    si hasta es menor que desde
        desde es sel_punta
        hasta es sel_ancla
    fin
    dueno es 0
    columnas es ANCHO
    arriba es 0
    izquierda es 0
    si sel_de no es igual a CONSOLA
        si (elemento sel_de de ventana_de) es SIN_VENTANA
            devuelve nada
        fin
        dueno es sel_de
        columnas es elemento sel_de de anchos
        arriba es elemento sel_de de ventana_y
        izquierda es elemento sel_de de ventana_x
    fin
    k es desde
    mientras k es menor o igual que hasta
        renglon es arriba mas (cociente con k y columnas) mas 1
        c es izquierda mas (k resto columnas) mas 1
        si (ventana_en con renglon y c) es dueno
            casilla es (renglon menos 1) por ANCHO mas c
            valor es elemento casilla de lo_que_se_ve
            atributo es cociente con valor y 256
            al_reves es (atributo resto 16) por 16 mas (cociente con atributo y 16)
            elemento casilla de lo_que_se_ve es al_reves por 256 mas (valor resto 256)
        fin
        k es k mas 1
    fin
fin

funcion tinta_de_sitio con t
    si t es CONSOLA
        devuelve BLANCO
    fin
    devuelve color_de con t
fin

funcion nombre_de_sitio con t
    si t es CONSOLA
        devuelve "la consola"
    fin
    devuelve nombre_de con t
fin

funcion pinta_aviso_pegado
    si aviso_pegado_hasta es 0
        devuelve nada
    fin
    marca es (AMARILLO por 16 mas NEGRO) por 256
    pon_en_vista con 1 y 24 y (tinta_de_sitio con pegado_en) por 16 por 256 mas 32
    pon_texto_en_vista con 1 y 25 y " pegaste en " y marca
    nombre es nombre_de_sitio con pegado_en
    pon_texto_en_vista con 1 y 37 y nombre y marca
    pon_en_vista con 1 y 37 mas largo de nombre y marca mas 32
fin

funcion pinta_portapapeles
    si copiadas es 0
        devuelve nada
    fin
    quedan es entre_limites con (cociente con (borra_portapapeles_en menos tics mas 99) y TICS_POR_SEGUNDO) y 1 y 99
    marca es (CIAN_CLARO por 16 mas NEGRO) por 256
    pon_en_vista con 1 y 9 y copiado_tinta por 16 por 256 mas 32
    pon_texto_en_vista con 1 y 10 y " copiado " y marca
    pon_en_vista con 1 y 19 y marca mas 48 mas (cociente con quedan y 10)
    pon_en_vista con 1 y 20 y marca mas 48 mas (quedan resto 10)
    pon_texto_en_vista con 1 y 21 y " s " y marca
fin

funcion copia_seleccion
    comparte copiadas y copiado_tinta y copiado_mide y borra_portapapeles_en y no_cabia
    si sel_de es 0
        devuelve nada
    fin
    desde es sel_ancla
    hasta es sel_punta
    si hasta es menor que desde
        desde es sel_punta
        hasta es sel_ancla
    fin
    hoja es pantalla
    columnas es ANCHO
    si sel_de no es igual a CONSOLA
        hoja es texto_de con sel_de
        columnas es elemento sel_de de anchos
    fin
    n es 0
    ultima_letra es 0
    saltando es verdadero
    k es desde
    mientras k es menor o igual que hasta y n es menor que CUPO_PORTAPAPELES
        letra es (elemento k mas 1 de hoja) resto 256
        si letra es menor o igual que 32
            si no saltando
                n es n mas 1
                elemento n de portapapeles es 32
            fin
        si no
            n es n mas 1
            elemento n de portapapeles es letra
            ultima_letra es n
            saltando es falso
        fin
        si (k resto columnas) es columnas menos 1 y k es menor que hasta
            n es ultima_letra
            si n es mayor que 0
                n es n mas 1
                elemento n de portapapeles es 32
            fin
            saltando es verdadero
        fin
        k es k mas 1
    fin
    no_cabia es falso
    mientras k es menor o igual que hasta
        si ((elemento k mas 1 de hoja) resto 256) es mayor que 32
            no_cabia es verdadero
        fin
        k es k mas 1
    fin
    i es ultima_letra mas 1
    mientras i es menor o igual que CUPO_PORTAPAPELES
        elemento i de portapapeles es 0
        i es i mas 1
    fin
    nombre es nombre_de_sitio con sel_de
    copiado_tinta es tinta_de_sitio con sel_de
    copiado_mide es entre_limites con (largo de nombre) y 0 y 32
    i es 1
    mientras i es menor o igual que copiado_mide
        elemento i de copiado_nombre es elemento i de nombre
        i es i mas 1
    fin
    olvida_seleccion
    copiadas es ultima_letra
    si ultima_letra es 0
        borra_portapapeles_en es 0
        devuelve nada
    fin
    borra_portapapeles_en es tics mas PLAZO_PORTAPAPELES
    apunta con R_COPIASTE y nombre y copiado_tinta y copiadas
    escribe "portapapeles: copiaste " sin salto
    escribe copiadas sin salto
    escribe " de " sin salto
    al_serie con nombre
    escribe ""
    ensucia
fin

funcion pega
    comparte entra y aviso_pegado_hasta y pegado_en
    si copiadas es 0
        escribe "portapapeles: vacío al pegar"
        devuelve nada
    fin
    destino es foco
    n es 0
    si destino es CONSOLA
        sin_sitio es falso
        mientras n es menor que copiadas y no sin_sitio
            siguiente es (entra mas 1) resto CAPACIDAD
            si siguiente es sale
                sin_sitio es verdadero
            si no
                elemento entra mas 1 de llegadas es elemento n mas 1 de portapapeles
                entra es siguiente
                n es n mas 1
            fin
        fin
    si no si (elemento destino de ventana_de) es VENTANA_VIVA
        mientras n es menor que copiadas y (guarda_tecla_de con destino y (elemento n mas 1 de portapapeles)) es 0
            n es n mas 1
        fin
    si no
        devuelve nada
    fin
    pegado_en es destino
    aviso_pegado_hasta es tics mas AVISO_PEGADO
    apunta con R_PEGASTE y (nombre_de_sitio con destino) y (tinta_de_sitio con destino) y n
    escribe "portapapeles: pegaste " sin salto
    escribe n sin salto
    escribe " en " sin salto
    al_serie con (nombre_de_sitio con destino)
    escribe ""
    ensucia
fin

funcion vacia_portapapeles con por_que
    comparte copiadas y borra_portapapeles_en
    habia es copiadas
    i es 1
    mientras i es menor o igual que CUPO_PORTAPAPELES
        elemento i de portapapeles es 0
        i es i mas 1
    fin
    copiadas es 0
    borra_portapapeles_en es 0
    para cada j desde 1 hasta 32
        elemento j de copiado_nombre es 0
    fin
    si habia es 0
        devuelve nada
    fin
    si por_que es A_MANO
        apunta con R_VACIASTE y "FalOS" y BLANCO y habia
    si no
        apunta con R_SE_BORRO y "FalOS" y BLANCO y por_que
    fin
    escribe "portapapeles: borrado, " sin salto
    escribe habia sin salto
    escribe " letras a ceros"
    ensucia
fin

funcion ensena_portapapeles
    si copiadas es 0
        pinta_linea con "  El portapapeles está vacío."
    si no
        pinta con "  Hay "
        pinta_cuantos con copiadas
        si copiadas es 1
            pinta con " letra"
        si no
            pinta con " letras"
        fin
        pinta con " que copiaste de "
        pinta_de con (region con copiado_nombre_en y copiado_mide) y copiado_tinta
        pinta con ". Se borra solo en "
        pinta_cuantos con (entre_limites con (cociente con (borra_portapapeles_en menos tics mas 99) y TICS_POR_SEGUNDO) y 1 y 99)
        pinta_linea con " s."
        si no_cabia
            pinta_linea con "  Lo que marcaste no cabía: copié las 100 primeras."
        fin
        pinta_linea con "  No te enseño qué es: lo verás al pegarlo con Ctrl+V."
    fin
    pon_color con GRIS_OSCURO y NEGRO
    pinta_linea con "  Ningún programa lo puede leer ni cambiar. Solo le llega lo que"
    pinta_linea con "  tú pegas, en la ventana que tiene el teclado, y nunca pulsa Intro."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion cierra_desde_la_ventana con t
    quita_ventana con t
    estado es elemento t de estados_tarea
    si estado no es igual a SIN_USAR y estado no es igual a CERRADA
        cierra_tarea con t y LA_PARARON
    fin
fin

funcion pulsa_en con renglon y c
    comparte agarrada y agarre y foco
    t es ventana_en con renglon y c
    antes es foco
    foco es CONSOLA
    olvida_seleccion
    si t es 0
        si renglon es mayor que 1
            empieza_seleccion con CONSOLA y renglon y c
        fin
        devuelve nada
    fin
    vx es elemento t de ventana_x
    va es ancho_de_ventana con t
    si renglon es (elemento t de ventana_y) y c es mayor o igual que vx mas va menos 4 y c es menor o igual que vx mas va menos 2
        cierra_desde_la_ventana con t
        devuelve nada
    fin
    sube_ventana con t
    si (elemento t de ventana_de) es VENTANA_VIVA
        foco es t
        si antes no es igual a t
            apunta_de con R_TECLADO y t y 0
        fin
    fin
    si renglon es (elemento t de ventana_y)
        agarrada es t
        agarre es c menos vx
    si no si c es mayor que vx y c es menor que vx mas va menos 1 y renglon es menor que (elemento t de ventana_y) mas (alto_de_ventana con t) menos 1
        empieza_seleccion con t y renglon y c
    fin
fin

funcion sitio_en_seleccion con renglon y c
    si sel_de es CONSOLA
        r es entre_limites con renglon y 2 y ALTO
        k es entre_limites con c y 1 y ANCHO
        devuelve (r menos 1) por ANCHO mas k menos 1
    fin
    columnas es elemento sel_de de anchos
    r es entre_limites con renglon menos (elemento sel_de de ventana_y) y 1 y (elemento sel_de de altos)
    k es entre_limites con c menos (elemento sel_de de ventana_x) y 1 y columnas
    devuelve (r menos 1) por columnas mas k menos 1
fin

funcion empieza_seleccion con t y renglon y c
    comparte sel_de y sel_ancla y sel_punta y seleccionando
    sel_de es t
    sel_ancla es sitio_en_seleccion con renglon y c
    sel_punta es sel_ancla
    seleccionando es verdadero
fin

funcion olvida_seleccion
    comparte sel_de y seleccionando
    si sel_de no es igual a 0
        ensucia
    fin
    sel_de es 0
    seleccionando es falso
fin

funcion olvida_seleccion_de con t
    si sel_de es t
        olvida_seleccion
    fin
fin

funcion arrastra_a con renglon y c
    comparte agarrada
    t es agarrada
    si (elemento t de ventana_de) es SIN_VENTANA
        agarrada es 0
        devuelve nada
    fin
    elemento t de ventana_x es entre_limites con (c menos agarre) y 1 y (ANCHO menos (ancho_de_ventana con t) mas 1)
    elemento t de ventana_y es entre_limites con renglon y 2 y (ALTO menos (alto_de_ventana con t) mas 1)
fin

funcion recibe_raton con a y b
    comparte raton_x y raton_y y raton_visto y botones_antes y agarrada y ultima_actividad y sel_punta y sel_de y seleccionando
    si actual no es igual a TAREA_TECLADO
        devuelve rechaza_a_actual
    fin
    si a es menor que 0 o a es mayor que 511 o b es menor que 0 o b es mayor que 4095
        devuelve RECHAZADA
    fin
    dx es a menos 256
    dy es (cociente con b y 8) menos 256
    botones es b resto 8
    raton_x es entre_limites con (raton_x mas dx) y 0 y (EN_ANCHO menos 1)
    raton_y es entre_limites con (raton_y menos dy) y 0 y (EN_ALTO menos 1)
    raton_visto es verdadero
    ultima_actividad es tics
    si bloqueado
        devuelve 0
    fin
    renglon es (cociente con raton_y y LETRA_ALTO) mas 1
    c es (cociente con raton_x y LETRA_ANCHO) mas 1
    pulsado es (botones resto 2) es 1
    lo_estaba es (botones_antes resto 2) es 1
    botones_antes es botones
    si pulsado y no lo_estaba
        pulsa_en con renglon y c
    si no si pulsado y agarrada no es igual a 0
        arrastra_a con renglon y c
    si no si pulsado y seleccionando
        sel_punta es sitio_en_seleccion con renglon y c
    si no si no pulsado
        agarrada es 0
        si seleccionando
            seleccionando es falso
            si sel_punta es sel_ancla
                sel_de es 0
            fin
        fin
    fin
    ensucia
    devuelve 0
fin

funcion se_puede_correr con t
    si t es CONSOLA
        devuelve no esperando o entra no es igual a sale o hay_cerradas o hay_encargos o disco_listo
    fin
    si (elemento t de estados_tarea) es DORMIDA y tics es mayor o igual que elemento t de hora_de_despertar
        elemento t de estados_tarea es EN_MARCHA
    fin
    devuelve (elemento t de estados_tarea) es EN_MARCHA
fin

funcion elige_tarea
    t es actual
    para cada vuelta desde 1 hasta ULTIMA_TAREA
        t es (t resto ULTIMA_TAREA) mas 1
        si se_puede_correr con t
            devuelve t
        fin
    fin
    devuelve CONSOLA
fin

funcion abre_puertos_de con t
    elemento BYTE_TECLADO de puertos es CERRADOS
    elemento BYTE_DISCO de puertos es CERRADOS
    elemento BYTE_GRAFICOS de puertos es CERRADOS
    elemento BYTE_GRAFICOS_ALTO de puertos es CERRADOS
    si t es TAREA_TECLADO
        elemento BYTE_TECLADO de puertos es SOLO_EL_96
    si no si t es TAREA_DISCO
        elemento BYTE_DISCO de puertos es LOS_OCHO
    si no si t es TAREA_PANTALLA
        elemento BYTE_GRAFICOS de puertos es INDICE_Y_DATOS
        elemento BYTE_GRAFICOS_ALTO de puertos es EL_DE_DETRAS
    fin
fin

funcion cambia_de_tarea
    comparte actual
    elemento actual de contextos es contexto
    siguiente es elige_tarea
    si siguiente no es igual a actual
        actual es siguiente
        abre_puertos_de con actual
        usa_tablas con (elemento actual de raices)
        si actual no es igual a CONSOLA
            pila_de_entrada con (elemento actual de pilas)
        fin
        pon_contexto con (elemento actual de contextos)
    fin
fin

funcion despierta_con con t y valor
    marco es region con (elemento t de contextos) y 20 y 8
    elemento EN_RAX de marco es valor
    elemento t de estados_tarea es EN_MARCHA
fin

funcion avisa_a con t y aviso
    si (elemento t de estados_tarea) es EN_ESPERA
        elemento t de paciencia_gastada es 0
        despierta_con con t y aviso
    si no
        elemento t de avisos es aviso
    fin
fin

funcion cierra_tarea con t y causa
    comparte hay_cerradas y peticion_abierta y disco_listo y resultado_disco y foco
    si foco es t
        foco es CONSOLA
        ensucia
    fin
    elemento t de causas es causa
    elemento t de estados_tarea es CERRADA
    elemento t de cerrada_en es tics
    hay_cerradas es verdadero
    si t es TAREA_DISCO y peticion_abierta
        peticion_abierta es falso
        resultado_disco es SIN_CONTROLADOR
        disco_listo es verdadero
    fin
    para cada otra desde 1 hasta MAX_TAREAS
        estado es elemento otra de estados_tarea
        si (elemento otra de atendiendo_a) es t
            elemento otra de atendiendo_a es 0
        fin
        si (estado es PREGUNTANDO o estado es ESPERA_RESPUESTA) y (elemento otra de hablando_con) es t
            despierta_con con otra y RECHAZADA
        fin
    fin
fin

funcion sitio_de_llave con t y llave
    devuelve (t menos 1) por LLAVES mas llave
fin

funcion sigue_viva con t
    estado es elemento t de estados_tarea
    devuelve estado no es igual a SIN_USAR y estado no es igual a CERRADA
fin

funcion abre_llave con t y llave
    si llave es menor que 1 o llave es mayor que LLAVES
        devuelve 0
    fin
    sitio es sitio_de_llave con t y llave
    destino es elemento sitio de llave_a
    si destino es 0
        devuelve 0
    fin
    si (elemento destino de generaciones) no es igual a (elemento sitio de llave_generacion)
        devuelve 0
    fin
    si no (sigue_viva con destino)
        devuelve 0
    fin
    devuelve destino
fin

funcion pregunta_a con llave y valor
    yo es actual
    destino es abre_llave con yo y llave
    si destino es 0 o destino es yo
        elemento yo de rechazos_de es (elemento yo de rechazos_de) mas 1
        devuelve nada
    fin
    elemento yo de mensajes_de es (elemento yo de mensajes_de) mas 1
    elemento yo de hablando_con es destino
    si (elemento destino de estados_tarea) es ESCUCHANDO
        elemento destino de atendiendo_a es yo
        elemento yo de estados_tarea es ESPERA_RESPUESTA
        despierta_con con destino y valor
    si no
        elemento yo de mensaje_de es valor
        elemento yo de estados_tarea es PREGUNTANDO
    fin
    cambia_de_tarea
fin

funcion escucha_mensaje
    yo es actual
    pendiente es elemento yo de atendiendo_a
    si pendiente no es igual a 0
        elemento yo de atendiendo_a es 0
        despierta_con con pendiente y RECHAZADA
    fin
    para cada otra desde 1 hasta MAX_TAREAS
        si (elemento otra de estados_tarea) es PREGUNTANDO y (elemento otra de hablando_con) es yo
            elemento otra de estados_tarea es ESPERA_RESPUESTA
            elemento yo de atendiendo_a es otra
            devuelve elemento otra de mensaje_de
        fin
    fin
    elemento yo de estados_tarea es ESCUCHANDO
    cambia_de_tarea
    devuelve 0
fin

funcion contesta_a con valor
    yo es actual
    quien es elemento yo de atendiendo_a
    si quien es 0
        devuelve RECHAZADA
    fin
    elemento yo de atendiendo_a es 0
    despierta_con con quien y valor
    devuelve 0
fin

funcion rechaza_a_actual
    elemento actual de rechazos_de es (elemento actual de rechazos_de) mas 1
    devuelve RECHAZADA
fin

funcion aguarda_aviso con respuesta
    comparte peticion_abierta y disco_listo y resultado_disco y tecla_sin_leer y raton_sin_leer
    yo es actual
    si no (es_controlador con yo)
        devuelve rechaza_a_actual
    fin
    si yo es TAREA_DISCO y peticion_abierta y respuesta no es igual a SIN_RESPUESTA
        resultado_disco es respuesta
        peticion_abierta es falso
        disco_listo es verdadero
    fin
    aviso es elemento yo de avisos
    si aviso no es igual a 0
        elemento yo de avisos es 0
        elemento yo de paciencia_gastada es 0
        devuelve aviso
    fin
    si yo es TAREA_TECLADO
        tecla_sin_leer es falso
        raton_sin_leer es falso
        abre_entrada
    fin
    elemento yo de estados_tarea es EN_ESPERA
    cambia_de_tarea
    devuelve 0
fin

funcion recibe_tecla con tecla
    comparte entra y foco y ultima_actividad
    si actual no es igual a TAREA_TECLADO
        devuelve rechaza_a_actual
    fin
    si tecla es menor que 1 o tecla es mayor que TECLA_PEGA
        devuelve RECHAZADA
    fin
    ultima_actividad es tics
    si tecla es TECLA_ESCAPE
        foco es CONSOLA
        ensucia
        devuelve 0
    fin
    si tecla es TECLA_COPIA
        si no bloqueado
            copia_seleccion
        fin
        devuelve 0
    fin
    si tecla es TECLA_PEGA
        si no bloqueado
            pega
        fin
        devuelve 0
    fin
    si foco no es igual a CONSOLA y no bloqueado
        devuelve guarda_tecla_de con foco y tecla
    fin
    siguiente es (entra mas 1) resto CAPACIDAD
    si siguiente es sale
        devuelve RECHAZADA
    fin
    elemento entra mas 1 de llegadas es tecla
    entra es siguiente
    devuelve 0
fin

funcion guarda_tecla_de con t y tecla
    sitio es elemento t de entran_de
    siguiente es (sitio mas 1) resto COLA_TECLAS
    si siguiente es (elemento t de salen_de)
        devuelve RECHAZADA
    fin
    elemento (t menos 1) por COLA_TECLAS mas sitio mas 1 de teclas_de es tecla
    elemento t de entran_de es siguiente
    devuelve 0
fin

funcion da_tecla
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    sitio es elemento t de salen_de
    si sitio es (elemento t de entran_de)
        devuelve 0
    fin
    tecla es elemento (t menos 1) por COLA_TECLAS mas sitio mas 1 de teclas_de
    elemento t de salen_de es (sitio mas 1) resto COLA_TECLAS
    elemento t de teclas_recibidas es (elemento t de teclas_recibidas) mas 1
    devuelve tecla
fin

funcion da_memoria
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si (elemento t de memoria_grande_de) no es igual a 0
        devuelve MEMORIA_GRANDE
    fin
    fisica es pide_dos_megas
    si fisica es 0
        devuelve SIN_MEMORIA
    fin
    elemento t de memoria_grande_de es fisica
    directorio es region con (elemento t de directorios) y 512 y 8
    elemento SITIO_GRANDE de directorio es fisica mas PRESENTE mas ESCRIBIBLE mas USUARIO mas GRANDE mas prohibe_ejecutar
    usa_tablas con (elemento t de raices)
    devuelve MEMORIA_GRANDE
fin

funcion encarga con pedido y desde y cuantos
    comparte hay_encargos
    t es actual
    si es_controlador con t
        devuelve rechaza_a_actual
    fin
    si desde es menor que 0 o cuantos es menor que 1 o cuantos es mayor que TOPE_GUARDADO o desde mas cuantos es mayor que PAGINA
        devuelve RECHAZADA
    fin
    elemento t de pedido_de es pedido
    elemento t de desde_de es desde
    elemento t de cuantos_de es cuantos
    elemento t de estados_tarea es CON_EL_DISCO
    hay_encargos es verdadero
    cambia_de_tarea
    devuelve 0
fin

funcion al_llamar
    marco es region con contexto y 20 y 8
    numero es elemento EN_RAX de marco
    a es elemento EN_RDI de marco
    elemento EN_RAX de marco es 0
    si numero es SALIR
        elemento actual de codigos es a
        cierra_tarea con actual y SALIO
        cambia_de_tarea
    si no si numero es MANDA_LETRA
        si a es mayor o igual que 0 y a es menor que 256
            letra_de_programa con a
        fin
    si no si numero es CEDE
        si es_controlador con actual
            elemento actual de paciencia_gastada es 0
        fin
        cambia_de_tarea
    si no si numero es PIDE_TICS
        elemento EN_RAX de marco es tics
    si no si numero es DUERME y a es mayor o igual que 0 y a es menor que 100000
        elemento actual de hora_de_despertar es tics mas a
        elemento actual de estados_tarea es DORMIDA
        cambia_de_tarea
    si no si numero es HAZ_PREGUNTA
        elemento EN_RAX de marco es RECHAZADA
        pregunta_a con a y (elemento EN_RSI de marco)
    si no si numero es ESCUCHA
        elemento EN_RAX de marco es escucha_mensaje
    si no si numero es CONTESTA
        elemento EN_RAX de marco es contesta_a con a
    si no si numero es ESPERA_AVISO
        elemento EN_RAX de marco es aguarda_aviso con a
    si no si numero es ENTREGA_TECLA
        elemento EN_RAX de marco es recibe_tecla con a
    si no si numero es ENTREGA_RATON
        elemento EN_RAX de marco es recibe_raton con a y (elemento EN_RSI de marco)
    si no si numero es LEE_TECLA
        elemento EN_RAX de marco es da_tecla
    si no si numero es PIDE_VENTANA
        elemento EN_RAX de marco es cambia_tamano con a y (elemento EN_RSI de marco)
    si no si numero es PON_CASILLA
        elemento EN_RAX de marco es pon_en_casilla con a y (elemento EN_RSI de marco)
    si no si numero es PIDE_MEMORIA
        elemento EN_RAX de marco es da_memoria
    si no si numero es GUARDA o numero es LEE_GUARDADO
        elemento EN_RAX de marco es encarga con numero y a y (elemento EN_RSI de marco)
    si no
        elemento EN_RAX de marco es rechaza_a_actual
    fin
fin

funcion al_fallar con numero y codigo y direccion
    marco es region con contexto y 20 y 8
    rip es elemento EN_RIP de marco
    elemento actual de codigos es codigo
    elemento actual de direcciones es direccion
    elemento actual de registro_rax es elemento EN_RAX de marco
    elemento actual de registro_rdx es elemento EN_RDX de marco
    elemento actual de instrucciones es 0
    fin_codigo es DONDE_VAN mas elemento actual de programa_tamano
    si rip es mayor o igual que DONDE_VAN y rip es menor que fin_codigo
        byte es region con rip y 1
        elemento actual de instrucciones es elemento 1 de byte
    fin
    cierra_tarea con actual y numero
    cambia_de_tarea
fin

funcion abre_entrada
    pon_en_puerto con CONTROLADOR_DATOS y TODAS_ABIERTAS
    pon_en_puerto con ESCLAVO_DATOS y ESCLAVO_ABIERTO
fin

funcion cierra_entrada
    pon_en_puerto con CONTROLADOR_DATOS y SIN_TECLADO
    pon_en_puerto con ESCLAVO_DATOS y ESCLAVO_CERRADO
fin

funcion al_pulsar
    comparte tecla_sin_leer
    tecla_sin_leer es verdadero
    cierra_entrada
    pon_en_puerto con CONTROLADOR y YA_ESTA
    avisa_a con TAREA_TECLADO y AVISO_TECLA
    cambia_de_tarea
fin

funcion al_mover
    comparte raton_sin_leer
    raton_sin_leer es verdadero
    cierra_entrada
    pon_en_puerto con ESCLAVO y YA_ESTA
    pon_en_puerto con CONTROLADOR y YA_ESTA
    avisa_a con TAREA_TECLADO y AVISO_RATON
    cambia_de_tarea
fin

funcion al_falso_del_esclavo
    pon_en_puerto con CONTROLADOR y YA_ESTA
fin

funcion puede_escribir_8042
    para cada vuelta desde 1 hasta 100000
        si ((lee_puerto de ESTADO_8042) resto 4) es menor que 2
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion hay_byte_8042
    para cada vuelta desde 1 hasta 100000
        si ((lee_puerto de ESTADO_8042) resto 2) es 1
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion orden_8042 con valor
    si puede_escribir_8042
        pon_en_puerto con ESTADO_8042 y valor
    fin
fin

funcion dato_8042 con valor
    si puede_escribir_8042
        pon_en_puerto con DATOS_8042 y valor
    fin
fin

funcion manda_al_raton con valor
    orden_8042 con 212
    dato_8042 con valor
    si hay_byte_8042
        devuelve (lee_puerto de DATOS_8042) es 250
    fin
    devuelve falso
fin

funcion prepara_raton
    comparte hay_raton
    repite 16 veces
        si ((lee_puerto de ESTADO_8042) resto 2) es 1
            basura es lee_puerto de DATOS_8042
        fin
    fin
    orden_8042 con 168
    orden_8042 con 32
    si no hay_byte_8042
        devuelve nada
    fin
    ajustes es lee_puerto de DATOS_8042
    si ((cociente con ajustes y 2) resto 2) es 0
        ajustes es ajustes mas 2
    fin
    si ((cociente con ajustes y 32) resto 2) es 1
        ajustes es ajustes menos 32
    fin
    orden_8042 con 96
    dato_8042 con ajustes
    por_defecto es manda_al_raton con 246
    activado es manda_al_raton con 244
    hay_raton es por_defecto y activado
fin

funcion vigila con t
    estado es elemento t de estados_tarea
    si estado es SIN_USAR o estado es CERRADA o estado es EN_ESPERA
        devuelve nada
    fin
    si estado es EN_MARCHA y t no es igual a actual
        devuelve nada
    fin
    elemento t de paciencia_gastada es (elemento t de paciencia_gastada) mas 1
    si (elemento t de paciencia_gastada) es mayor que PACIENCIA
        cierra_tarea con t y SE_COLGO
    fin
fin

funcion al_tic
    comparte tics y tics_dormido y pantalla_sucia y aviso_disco_hasta y aviso_pegado_hasta
    tics es tics mas 1
    si (tics resto TICS_POR_SEGUNDO) es 0
        mira_el_reloj
    fin
    si aviso_disco_hasta no es igual a 0 y tics es mayor o igual que aviso_disco_hasta
        aviso_disco_hasta es 0
        pantalla_sucia es verdadero
    fin
    si aviso_pegado_hasta no es igual a 0 y tics es mayor o igual que aviso_pegado_hasta
        aviso_pegado_hasta es 0
        pantalla_sucia es verdadero
    fin
    si borra_portapapeles_en no es igual a 0
        si tics es mayor o igual que borra_portapapeles_en
            vacia_portapapeles con POR_TIEMPO
        si no si (tics resto TICS_POR_SEGUNDO) es 0
            pantalla_sucia es verdadero
        fin
    fin
    elemento actual de tiempo_de es (elemento actual de tiempo_de) mas 1
    si actual es CONSOLA y esperando
        tics_dormido es tics_dormido mas 1
    fin
    si hay_cerrojo y no bloqueado y tics menos ultima_actividad es mayor o igual que PLAZO_BLOQUEO
        bloquea_ya con POR_QUIETO
    fin
    pon_en_puerto con CONTROLADOR y YA_ESTA
    vigila con TAREA_TECLADO
    vigila con TAREA_DISCO
    vigila con TAREA_PANTALLA
    si pantalla_sucia y no hay_graficos
        pantalla_sucia es falso
        compone
    si no si pantalla_sucia y (elemento TAREA_PANTALLA de avisos) es 0
        pantalla_sucia es falso
        compone
        avisa_a con TAREA_PANTALLA y AVISO_PINTA
    fin
    cambia_de_tarea
fin

funcion siguiente_tecla
    comparte sale y esperando
    desactiva_interrupciones
    mientras sale es entra
        si hay_cerradas
            activa_interrupciones
            recoge_tareas con verdadero
        si no si hay_encargos
            activa_interrupciones
            atiende_encargos
        si no
            esperando es verdadero
            espera_interrupcion
            esperando es falso
        fin
        desactiva_interrupciones
    fin
    codigo es elemento sale mas 1 de llegadas
    sale es (sale mas 1) resto CAPACIDAD
    activa_interrupciones
    devuelve codigo
fin

funcion atiende con tecla
    si modo_clave no es igual a SIN_CLAVE
        atiende_clave con tecla
    si no si tecla es menor que TECLA_INTRO
        teclea con tecla
    si no si tecla es TECLA_INTRO
        ejecuta
    si no si tecla es TECLA_BORRA
        borra
    si no si tecla es TECLA_IZQUIERDA
        mueve_a con pos menos 1
    si no si tecla es TECLA_DERECHA
        mueve_a con pos mas 1
    si no si tecla es TECLA_INICIO
        mueve_a con 0
    si no si tecla es TECLA_FIN
        mueve_a con escritas
    si no si tecla es TECLA_SUPRIME
        suprime
    si no si tecla es TECLA_ARRIBA y mirando es mayor que 1
        recupera con mirando menos 1
    si no si tecla es TECLA_ABAJO y mirando es menor o igual que guardadas
        recupera con mirando mas 1
    fin
fin

funcion prepara_interrupciones
    pon_en_puerto con CONTROLADOR y 17
    pon_en_puerto con ESCLAVO y 17
    pon_en_puerto con CONTROLADOR_DATOS y 32
    pon_en_puerto con ESCLAVO_DATOS y 40
    pon_en_puerto con CONTROLADOR_DATOS y 4
    pon_en_puerto con ESCLAVO_DATOS y 2
    pon_en_puerto con CONTROLADOR_DATOS y 1
    pon_en_puerto con ESCLAVO_DATOS y 1
    abre_entrada
    divisor es cociente con 1193182 y TICS_POR_SEGUNDO
    pon_en_puerto con RELOJ_ORDEN y 54
    pon_en_puerto con RELOJ y (divisor resto 256)
    pon_en_puerto con RELOJ y (cociente con divisor y 256)
    atiende_interrupcion con 32 y al_tic
    atiende_interrupcion con 33 y al_pulsar
    atiende_interrupcion con 44 y al_mover
    atiende_interrupcion con 47 y al_falso_del_esclavo
    atiende_llamadas con al_llamar
    atiende_fallos con al_fallar
    activa_interrupciones
fin

funcion minuscula con c
    si c es mayor o igual que 65 y c es menor o igual que 90
        devuelve c mas 32
    fin
    devuelve c
fin

funcion teclea con c
    comparte escritas y pos
    si escritas es menor que LARGO_ORDEN
        i es escritas
        mientras i es mayor que pos
            elemento i mas 1 de orden es elemento i de orden
            i es i menos 1
        fin
        elemento pos mas 1 de orden es c
        escritas es escritas mas 1
        pos es pos mas 1
        redibuja
    fin
fin

funcion saca_letra con i
    comparte escritas
    mientras i es menor que escritas
        elemento i de orden es elemento i mas 1 de orden
        i es i mas 1
    fin
    escritas es escritas menos 1
fin

funcion borra
    comparte pos
    si pos es mayor que 0
        saca_letra con pos
        pos es pos menos 1
        redibuja
    fin
fin

funcion suprime
    si pos es menor que escritas
        saca_letra con pos mas 1
        redibuja
    fin
fin

funcion mueve_a con donde
    comparte pos y columna
    si donde es mayor o igual que 0 y donde es menor o igual que escritas
        pos es donde
        columna es INICIO mas pos
        mueve_cursor
    fin
fin

funcion redibuja
    comparte columna
    base es (fila menos 1) por ANCHO mas INICIO menos 1
    para cada i desde 1 hasta LARGO_ORDEN mas 1
        letra es 32
        si i es menor o igual que escritas
            letra es elemento i de orden
        fin
        elemento base mas i de pantalla es color por 256 mas letra
    fin
    columna es INICIO mas pos
    mueve_cursor
fin

funcion sitio_en_historial con k
    devuelve (k menos 1) por 80 mas 1
fin

funcion igual_que_la_ultima
    si guardadas es 0
        devuelve falso
    fin
    sitio es sitio_en_historial con guardadas
    si (elemento sitio de historial) no es igual a escritas
        devuelve falso
    fin
    para cada i desde 1 hasta escritas
        si (elemento sitio mas i de historial) no es igual a (elemento i de orden)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion guarda_en_historial
    comparte guardadas y mirando
    si escritas es mayor que 0 y no (igual_que_la_ultima)
        si guardadas es CUPO_HISTORIAL
            para cada i desde 1 hasta (CUPO_HISTORIAL menos 1) por 80
                elemento i de historial es elemento i mas 80 de historial
            fin
            guardadas es guardadas menos 1
        fin
        guardadas es guardadas mas 1
        sitio es sitio_en_historial con guardadas
        elemento sitio de historial es escritas
        para cada i desde 1 hasta escritas
            elemento sitio mas i de historial es elemento i de orden
        fin
    fin
    mirando es guardadas mas 1
fin

funcion recupera con k
    comparte escritas y pos y mirando
    mirando es k
    escritas es 0
    si k es menor o igual que guardadas
        sitio es sitio_en_historial con k
        escritas es elemento sitio de historial
        para cada i desde 1 hasta escritas
            elemento i de orden es elemento sitio mas i de historial
        fin
    fin
    pos es escritas
    redibuja
fin

funcion es_orden con nombre
    si largo de nombre no es igual a escritas
        devuelve falso
    fin
    para cada i desde 1 hasta escritas
        si (minuscula con (elemento i de orden)) no es igual a (elemento i de nombre)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion empieza_por con nombre
    si escritas es menor que largo de nombre
        devuelve falso
    fin
    para cada i desde 1 hasta largo de nombre
        si (minuscula con (elemento i de orden)) no es igual a (elemento i de nombre)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion resto_es con primera y nombre
    si escritas menos primera mas 1 no es igual a largo de nombre
        devuelve falso
    fin
    para cada i desde 1 hasta largo de nombre
        si (minuscula con (elemento primera mas i menos 1 de orden)) no es igual a (elemento i de nombre)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion indicador
    pon_color con CIAN_CLARO y NEGRO
    pinta con "> "
    pon_color con GRIS y NEGRO
fin

funcion ejecuta
    comparte escritas y pos
    pinta_linea con ""
    guarda_en_historial
    si escritas es 0
        escritas es 0
    si no si es_orden con "ayuda"
        ayuda
    si no si es_orden con "limpia"
        limpia
        barra
        ve_a con 3 y 1
    si no si es_orden con "hora"
        hora
    si no si es_orden con "colores"
        colores
    si no si es_orden con "encendido"
        encendido
    si no si es_orden con "memoria"
        memoria
    si no si es_orden con "programas"
        programas
    si no si es_orden con "tareas"
        tareas
    si no si es_orden con "permisos"
        permisos
    si no si es_orden con "registro"
        ensena_registro
    si no si empieza_por con "permite "
        permite
    si no si empieza_por con "prohibe "
        prohibe
    si no si empieza_por con "teclado "
        da_el_teclado
    si no si empieza_por con "lanza "
        lanza
    si no si empieza_por con "para "
        para_tarea
    si no si es_orden con "disco"
        orden_disco
    si no si empieza_por con "lee "
        lee_archivo
    si no si es_orden con "portapapeles"
        ensena_portapapeles
    si no si es_orden con "olvida portapapeles"
        vacia_portapapeles con A_MANO
        pinta_linea con "  Borrado: donde estaba solo quedan ceros."
        pinta_linea con ""
    si no si empieza_por con "olvida "
        olvida
    si no si empieza_por con "deja siempre "
        decide_guardar con 14 y DISCO_SI y verdadero
    si no si empieza_por con "deja "
        decide_guardar con 6 y DISCO_SI y falso
    si no si empieza_por con "niega "
        decide_guardar con 7 y DISCO_NO y falso
    si no si empieza_por con "cuelga "
        estropea con 8 y AVISO_CUELGA
    si no si empieza_por con "rompe "
        estropea con 7 y AVISO_ROMPE
    si no si es_orden con "reinicia"
        reinicia
    si no si es_orden con "cerrojo"
        pon_cerrojo
    si no si es_orden con "bloquea"
        orden_bloquea
    si no si es_orden con "sin cerrojo"
        quita_cerrojo
    si no
        no_conozco
    fin
    escritas es 0
    pos es 0
    si modo_clave es SIN_CLAVE
        indicador
    fin
fin

funcion ayuda
    pinta_linea con "  ayuda  limpia  hora  colores  encendido  memoria  reinicia"
    pinta_linea con ""
    pinta_linea con "  programas      los programas que hay en el disco"
    pinta_linea con "  lanza X        los carga del disco y los pone a correr"
    pinta_linea con "  tareas         lo que está corriendo ahora"
    pinta_linea con "  para N         cierra la tarea N"
    pinta_linea con "  teclado N      lo que escribas va al programa N, y Esc lo devuelve"
    pinta_linea con ""
    pinta_linea con "  permisos       quién puede hablar con quién y tocar qué"
    pinta_linea con "  permite N M    deja que la tarea N hable con la M"
    pinta_linea con "  prohibe N M    se lo quita, en el acto"
    pinta_linea con "  registro       qué programa ha leído o guardado qué, y cuándo"
    pinta_linea con ""
    pinta_linea con "  disco          lo que hay en el disco"
    pinta_linea con "  lee X          enseña un archivo del disco"
    pinta_linea con "  deja N         deja que el programa N guarde en su archivo"
    pinta_linea con "  deja siempre N y no vuelve a preguntarte, aunque reinicies"
    pinta_linea con "  niega N        no le deja guardar nada, y le quita el siempre"
    pinta_linea con "  olvida X       borra de verdad lo que guardó X"
    pinta_linea con ""
    pinta_linea con "  cerrojo        pon o cambia la contraseña de la pantalla"
    pinta_linea con "  bloquea        bloquea ya. Solo, a los 5 minutos sin tocarme"
    pinta_linea con "  sin cerrojo    quita la contraseña"
    pinta_linea con ""
    pinta_linea con "  cuelga X       cuelga a propósito el teclado, el disco o la pantalla"
    pinta_linea con "  rompe X        hace que intenten algo prohibido"
    pinta_linea con ""
    pinta_linea con "  Con el ratón, una ventana se mueve arrastrando su título, se cierra"
    pinta_linea con "  con la x roja, y un clic en ella le da el teclado."
    pinta_linea con ""
    pinta_linea con "  Arrastrando el ratón sobre un texto lo marcas. Ctrl+C lo copia y"
    pinta_linea con "  Ctrl+V lo pega en la ventana que tiene el teclado. Se borra solo a"
    pinta_linea con "  los 30 segundos, y ningún programa lo puede leer ni cambiar."
    pinta_linea con "  portapapeles   cuánto hay copiado, sin enseñarlo"
    pinta_linea con "  olvida portapapeles   lo borra ya"
    pinta_linea con ""
fin

funcion no_conozco
    pon_color con ROJO_CLARO y NEGRO
    pinta con "  No conozco la orden «"
    para cada i desde 1 hasta escritas
        pon_letra con (elemento i de orden)
    fin
    pinta_linea con "». Escribe ayuda para ver las que sé."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion lee_cmos con registro
    pon_en_puerto con 112 y registro
    devuelve lee_puerto de 113
fin

funcion del_reloj con registro
    v es lee_cmos con registro
    si ((lee_cmos con 11) resto 8) es mayor o igual que 4
        devuelve v
    fin
    devuelve (cociente con v y 16) por 10 mas (v resto 16)
fin

funcion mira_el_reloj
    comparte segundos_del_dia y pantalla_sucia
    si (lee_cmos con 10) es mayor o igual que 128
        devuelve nada
    fin
    antes es cociente con segundos_del_dia y 60
    segundos_del_dia es ((del_reloj con 4) por 60 mas (del_reloj con 2)) por 60 mas (del_reloj con 0)
    si (cociente con segundos_del_dia y 60) no es igual a antes
        pantalla_sucia es verdadero
    fin
fin

funcion pinta_hora con s
    pinta_dos con (cociente con s y 3600)
    pinta con ":"
    pinta_dos con ((cociente con s y 60) resto 60)
    pinta con ":"
    pinta_dos con (s resto 60)
fin

funcion hora
    pinta con "  Son las "
    pon_color con BLANCO y NEGRO
    pinta_hora con segundos_del_dia
    pon_color con GRIS y NEGRO
    pinta_linea con " en UTC."
    pinta_linea con ""
fin

funcion nombre_color con c
    si c es 0
        devuelve "negro"
    si no si c es 1
        devuelve "azul"
    si no si c es 2
        devuelve "verde"
    si no si c es 3
        devuelve "cian"
    si no si c es 4
        devuelve "rojo"
    si no si c es 5
        devuelve "magenta"
    si no si c es 6
        devuelve "marrón"
    si no si c es 7
        devuelve "gris"
    si no si c es 8
        devuelve "gris oscuro"
    si no si c es 9
        devuelve "azul claro"
    si no si c es 10
        devuelve "verde claro"
    si no si c es 11
        devuelve "cian claro"
    si no si c es 12
        devuelve "rojo claro"
    si no si c es 13
        devuelve "magenta claro"
    si no si c es 14
        devuelve "amarillo"
    fin
    devuelve "blanco"
fin

funcion muestra_color con c
    pon_color con c y NEGRO
    pon_letra con 219
    pon_letra con 219
    pon_letra con 219
    pon_color con GRIS y NEGRO
    pinta con " "
    pinta con (nombre_color con c)
fin

funcion colores
    para cada c desde 0 hasta 7
        pinta con "  "
        muestra_color con c
        hasta_columna con 30
        muestra_color con c mas 8
        pinta_linea con ""
    fin
    pinta_linea con ""
fin

funcion encendido
    segundos es cociente con tics y TICS_POR_SEGUNDO
    minutos es cociente con segundos y 60
    pinta con "  Llevo encendido "
    pon_color con BLANCO y NEGRO
    si minutos es mayor que 0
        pinta_numero con minutos
        pinta con " min "
    fin
    pinta_numero con segundos resto 60
    pinta con " s"
    pon_color con GRIS y NEGRO
    pinta con ", y he dormido el "
    pon_color con BLANCO y NEGRO
    pinta_numero con (cociente con tics_dormido por 100 y tics mas 1)
    pinta con " %"
    pon_color con GRIS y NEGRO
    pinta_linea con " del tiempo."
    pinta_linea con ""
fin

funcion cuantas_en con estado
    n es 0
    para cada p desde 1 hasta total_paginas
        si (elemento p de estados) es estado
            n es n mas 1
        fin
    fin
    devuelve n
fin

funcion pinta_tamano con paginas
    kb es paginas por 4
    si kb es menor que 10240
        pinta_numero con kb
        pinta con " KB"
    si no
        pinta_numero con (cociente con kb y 1024)
        pinta con " MB"
    fin
fin

funcion trozo_de_barra con c y celdas
    pon_color con c y NEGRO
    repite celdas veces
        pon_letra con 219
    fin
fin

funcion celdas_de con n
    celdas es cociente con n por 60 y total_paginas
    si n es mayor que 0 y celdas es 0
        devuelve 1
    fin
    devuelve celdas
fin

funcion leyenda con c y nombre y paginas
    pinta con "  "
    pon_color con c y NEGRO
    pon_letra con 254
    pon_color con GRIS y NEGRO
    pinta con " "
    pinta con nombre
    hasta_columna con 44
    pon_color con BLANCO y NEGRO
    pinta_tamano con paginas
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion memoria
    reservadas es cuantas_en con RESERVADA
    mias es cuantas_en con MIA
    prestadas es cuantas_en con PRESTADA
    libres es cuantas_en con LIBRE
    pinta con "  Tengo "
    pon_color con BLANCO y NEGRO
    pinta_numero con (cociente con ram mas (cociente con MEGA y 2) y MEGA)
    pinta con " MB"
    pon_color con GRIS y NEGRO
    pinta_linea con " de memoria, en páginas de 4 KB."
    pinta_linea con ""
    pinta con "  "
    trozo_de_barra con GRIS_OSCURO y (celdas_de con reservadas)
    trozo_de_barra con AZUL_CLARO y (celdas_de con mias)
    trozo_de_barra con AMARILLO y (celdas_de con prestadas)
    trozo_de_barra con VERDE y 60 menos (celdas_de con reservadas) menos (celdas_de con mias) menos (celdas_de con prestadas)
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    pinta_linea con ""
    leyenda con GRIS_OSCURO y "de la BIOS y los aparatos" y reservadas
    leyenda con AZUL_CLARO y "yo: código, pila y tablas" y mias
    leyenda con AMARILLO y "prestadas: tablas y lo que escribes" y prestadas
    leyenda con VERDE y "libres" y libres
    pinta_linea con ""
    prueba es pide_pagina
    hoja es region con prueba y 512 y 8
    elemento 1 de hoja es 1234
    suelta_pagina con prueba
    otra es pide_pagina
    vista es region con otra y 512 y 8
    en_blanco es (elemento 1 de vista) es 0
    suelta_pagina con otra
    pinta_linea con "  Presto una página, escriben en ella, me la devuelven y se la presto"
    pinta con "  a otro: "
    si otra es prueba y en_blanco
        pon_color con VERDE_CLARO y NEGRO
        pinta_linea con "le llega en blanco."
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "le llega con lo que dejó el primero."
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    pinta_linea con "  Y el procesador hace cumplir esto, también a mí:"
    protegido con "mi código es de solo lectura" y verdadero
    protegido con "los datos no se pueden ejecutar" y prohibe_ejecutar no es igual a 0
    protegido con "la dirección 0 no existe" y verdadero
    pinta_linea con ""
fin

funcion protegido con frase y si_esta
    si si_esta
        pon_color con VERDE_CLARO y NEGRO
        pinta con "    sí  "
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta con "    no  "
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con frase
fin

funcion reinicia
    pon_en_puerto con 100 y 254
    congela
fin

funcion programas
    respuesta es pide_archivo con "programas.txt" y "" y 0
    si respuesta es menor que 0 o respuesta es mayor que TOPE_BUZON
        fallo_de_disco con respuesta
    si no
        pinta_buzon con respuesta
        pinta_linea con ""
    fin
fin

funcion hueco_libre
    para cada t desde 1 hasta MAX_TAREAS
        si (elemento t de estados_tarea) es SIN_USAR
            devuelve t
        fin
    fin
    devuelve 0
fin

funcion apunta_pagina con t y nueva
    lista es region con (elemento t de listas_de_paginas) y 512 y 8
    cuantas es (elemento t de paginas_usadas) mas 1
    elemento t de paginas_usadas es cuantas
    elemento cuantas de lista es nueva
fin

funcion pagina_de_tarea con t
    nueva es pide_pagina
    apunta_pagina con t y nueva
    devuelve nueva
fin

funcion copia_directorio con destino
    de_nucleo es region con directorio_nucleo y 512 y 8
    copia es region con destino y 512 y 8
    para cada i desde 1 hasta 512
        elemento i de copia es elemento i de de_nucleo
    fin
fin

funcion monta_programa con t y archivo y total
    comparte primera_de_codigo
    raiz es pagina_de_tarea con t
    nivel_3 es pagina_de_tarea con t
    nivel_2 es pagina_de_tarea con t
    hojas es pagina_de_tarea con t
    arriba es region con raiz y 512 y 8
    medio es region con nivel_3 y 512 y 8
    directorio es region con nivel_2 y 512 y 8
    entradas es region con hojas y 512 y 8
    copia_directorio con nivel_2
    elemento t de directorios es nivel_2
    elemento 1 de arriba es nivel_3 mas PRESENTE mas ESCRIBIBLE mas USUARIO
    elemento 1 de medio es nivel_2 mas PRESENTE mas ESCRIBIBLE mas USUARIO
    elemento (cociente con DONDE_VAN y DOS_MEGAS) mas 1 de directorio es hojas mas PRESENTE mas ESCRIBIBLE mas USUARIO
    mesa es pagina_de_tarea con t
    elemento t de mesas es mesa
    elemento SITIO_MESA de entradas es mesa mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
    si t es TAREA_PANTALLA
        elemento SITIO_BUZON de entradas es rejilla mas PRESENTE mas USUARIO mas prohibe_ejecutar
        para cada p desde 1 hasta PAGINAS_TALLER
            taller es pagina_de_tarea con t
            elemento SITIO_TALLER mas p de entradas es taller mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
        fin
        elemento SITIO_VIDEO de directorio es memoria_de_video mas PRESENTE mas ESCRIBIBLE mas USUARIO mas GRANDE mas prohibe_ejecutar
        elemento SITIO_VIDEO mas 1 de directorio es memoria_de_video mas DOS_MEGAS mas PRESENTE mas ESCRIBIBLE mas USUARIO mas GRANDE mas prohibe_ejecutar
    si no si es_controlador con t
        buzon es pagina_de_tarea con t
        elemento t de buzones es buzon
        elemento SITIO_BUZON de entradas es buzon mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
    fin
    primera_de_codigo es (elemento t de paginas_usadas) mas 1
    de_codigo es paginas_de con archivo
    en_total es paginas_de con total
    para cada p desde 1 hasta en_total
        trozo es pagina_de_tarea con t
        si p es menor o igual que de_codigo
            elemento p de entradas es trozo mas PRESENTE mas USUARIO
        si no
            elemento p de entradas es trozo mas PRESENTE mas ESCRIBIBLE mas USUARIO mas prohibe_ejecutar
        fin
    fin
    devuelve raiz
fin

funcion paginas_de con bytes
    devuelve cociente con (bytes mas PAGINA menos 1) y PAGINA
fin

funcion pagina_de_codigo con t y p
    lista es region con (elemento t de listas_de_paginas) y 512 y 8
    devuelve elemento primera_de_codigo mas p menos 1 de lista
fin

funcion reserva_tarea con t y archivo y total y entrada
    elemento t de avisos es 0
    si t es TAREA_TECLADO y tecla_sin_leer
        elemento t de avisos es AVISO_TECLA
    si no si t es TAREA_TECLADO y raton_sin_leer
        elemento t de avisos es AVISO_RATON
    fin
    elemento t de paciencia_gastada es 0
    elemento t de listas_de_paginas es pide_pagina
    elemento t de paginas_usadas es 0
    elemento t de programa_tamano es archivo
    elemento t de tiempo_de es 0
    elemento t de columna_de es 1
    elemento t de medias_de es 0
    elemento t de generaciones es (elemento t de generaciones) mas 1
    elemento t de atendiendo_a es 0
    elemento t de hablando_con es 0
    elemento t de mensajes_de es 0
    elemento t de rechazos_de es 0
    elemento t de entran_de es 0
    elemento t de salen_de es 0
    elemento t de teclas_recibidas es 0
    elemento t de permiso_disco es DISCO_SIN_PEDIR
    elemento t de raices es monta_programa con t y archivo y total
    pila es pagina_de_tarea con t
    elemento t de pilas es pila mas PAGINA
    marco es region con pila mas PAGINA menos TAMANO_MARCO y 20 y 8
    elemento EN_RIP de marco es entrada
    elemento EN_CS de marco es SEGMENTO_CODIGO
    elemento EN_BANDERAS de marco es BANDERAS
    elemento EN_SS de marco es SEGMENTO_DATOS
    elemento t de contextos es pila mas PAGINA menos TAMANO_MARCO
fin

funcion estrena_tarea con t
    si no (es_controlador con t)
        abre_ventana con t
    fin
    elemento t de estados_tarea es EN_MARCHA
fin

funcion lanza_controlador con t
    imagen es imagen_de con t
    reserva_tarea con t y (elemento 3 de imagen) y (elemento 4 de imagen) y (elemento 2 de imagen)
    para cada p desde 1 hasta paginas_de con (elemento 3 de imagen)
        hoja es region con (pagina_de_codigo con t y p) y 512 y 8
        desde es (p menos 1) por 512
        cuantas es (largo de imagen) menos desde
        si cuantas es mayor que 512
            cuantas es 512
        fin
        copia_region con hoja y 1 y imagen y desde mas 1 y cuantas
    fin
    estrena_tarea con t
fin

funcion trozo_de_orden con primera
    si primera es mayor que escritas
        devuelve ""
    fin
    devuelve region con orden_en mas primera menos 1 y escritas menos primera mas 1
fin

funcion rechaza_programa con nombre y motivo
    pon_color con ROJO_CLARO y NEGRO
    pinta con "  No cargo "
    pinta con nombre
    pinta con ": "
    pon_color con BLANCO y NEGRO
    pinta_linea con motivo
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    al_serie con "rechazado: "
    al_serie con nombre
    escribe ""
fin

funcion mentira_de con firma y entrada y archivo y total
    si firma no es igual a MAGIA
        devuelve "no es un programa."
    fin
    si archivo es menor que LARGO_CABECERA o archivo es mayor que TOPE_PROGRAMA
        devuelve "dice que ocupa algo imposible."
    fin
    si total es menor que archivo o total es mayor que TOPE_PROGRAMA
        devuelve "pide más memoria de la que doy."
    fin
    si entrada es menor que DONDE_VAN mas LARGO_CABECERA o entrada es mayor o igual que DONDE_VAN mas archivo
        devuelve "quiere empezar fuera de sí mismo."
    fin
    devuelve nada
fin

funcion trae_programa con t y nombre y archivo y primero
    para cada p desde 1 hasta paginas_de con archivo
        desde es (p menos 1) por PAGINA
        esperados es archivo menos desde
        si esperados es mayor que PAGINA
            esperados es PAGINA
        fin
        respuesta es primero
        si p es mayor que 1
            respuesta es pide_archivo con nombre y ".prg" y p menos 1
        fin
        si respuesta es menor que 0
            devuelve respuesta
        fin
        si respuesta no es igual a esperados
            devuelve MAS_CORTO
        fin
        buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
        hoja es region con (pagina_de_codigo con t y p) y PAGINA
        copia_region con hoja y 1 y buzon y 1 y esperados
    fin
    devuelve 0
fin

funcion lanza
    nombre es trozo_de_orden con 7
    t es hueco_libre
    si t es 0
        pinta_linea con "  Ya hay cuatro programas corriendo. Cierra uno con: para N"
        pinta_linea con ""
        devuelve nada
    fin
    primero es pide_archivo con nombre y ".prg" y 0
    si primero es NO_ESTA
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ningún programa con ese nombre. Mira: programas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
    si no si primero es menor que 0 o primero es mayor que TOPE_BUZON
        fallo_de_disco con primero
    si no si primero es menor que LARGO_CABECERA
        rechaza_programa con nombre y "no es un programa."
    si no
        cabecera es region con (elemento TAREA_DISCO de buzones) y 4 y 8
        firma es elemento 1 de cabecera
        entrada es elemento 2 de cabecera
        archivo es elemento 3 de cabecera
        total es elemento 4 de cabecera
        motivo es mentira_de con firma y entrada y archivo y total
        si motivo no es igual a nada
            rechaza_programa con nombre y motivo
        si no
            carga_programa con t y nombre y archivo y total y entrada y primero
        fin
    fin
fin

funcion carga_programa con t y nombre y archivo y total y entrada y primero
    apunta_nombre con t y nombre
    reserva_tarea con t y archivo y total y entrada
    traido es trae_programa con t y nombre y archivo y primero
    si traido es 0
        estrena_tarea con t
        pinta con "  "
        pinta con nombre
        pinta con ": "
        pon_color con BLANCO y NEGRO
        pinta_numero con (cociente con archivo y 1024)
        pinta con " KB"
        pon_color con GRIS y NEGRO
        pinta_linea con " leídos del disco. Nace sin permisos, en su propia caja."
        pinta_linea con ""
    si no si traido es MAS_CORTO
        suelta_tarea con t
        rechaza_programa con nombre y "es más corto de lo que dice."
    si no
        suelta_tarea con t
        fallo_de_disco con traido
    fin
fin

funcion numero_entre con primera y ultima
    n es 0
    si primera es mayor que ultima
        devuelve 0
    fin
    para cada i desde primera hasta ultima
        letra es elemento i de orden
        si letra es menor que 48 o letra es mayor que 57 o n es mayor que 1000
            devuelve 0
        fin
        n es n por 10 mas letra menos 48
    fin
    devuelve n
fin

funcion para_tarea
    t es numero_entre con 6 y escritas
    si t es menor que 1 o t es mayor que ULTIMA_TAREA o t es CONSOLA o (elemento t de estados_tarea) es SIN_USAR
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ninguna tarea con ese número. Mira: tareas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
    si no
        desactiva_interrupciones
        cierra_tarea con t y LA_PARARON
        quita_ventana con t
        activa_interrupciones
        recoge_tareas con falso
    fin
fin

funcion da_el_teclado
    comparte foco
    t es numero_entre con 9 y escritas
    bien es t es mayor o igual que 1 y t es menor o igual que MAX_TAREAS
    si bien
        bien es (elemento t de ventana_de) es VENTANA_VIVA y sigue_viva con t
    fin
    si no bien
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ningún programa con ese número. Mira: tareas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    desactiva_interrupciones
    si foco no es igual a t
        apunta_de con R_TECLADO y t y 0
    fin
    foco es t
    sube_ventana con t
    activa_interrupciones
    pinta con "  Lo que escribas va a "
    pon_color con (color_de con t) y NEGRO
    pinta con (nombre_de con t)
    pon_color con GRIS y NEGRO
    pinta_linea con ". Con Esc vuelve aquí."
    pinta_linea con ""
fin

funcion nombre_estado con t
    e es elemento t de estados_tarea
    si e es DORMIDA
        devuelve "durmiendo"
    si no si e es ESCUCHANDO
        devuelve "escuchando"
    si no si e es PREGUNTANDO o e es ESPERA_RESPUESTA
        devuelve "esperando"
    si no si e es EN_ESPERA
        devuelve "esperando trabajo"
    si no si e es CON_EL_DISCO y (elemento t de permiso_disco) es DISCO_PEDIDO
        devuelve "pide permiso"
    si no si e es CON_EL_DISCO
        devuelve "con el disco"
    si no si e es CERRADA
        devuelve "cerrándose"
    fin
    devuelve "corriendo"
fin

funcion linea_de_tarea con t
    pinta con "  "
    pon_color con (color_de con t) y NEGRO
    pinta_numero con t
    pinta con "  "
    pinta con (nombre_de con t)
    pon_color con GRIS y NEGRO
    hasta_columna con 17
    pinta con (nombre_estado con t)
    hasta_columna con 36
    pinta_numero con (cociente con (elemento t de tiempo_de) y TICS_POR_SEGUNDO)
    pinta con " s de procesador"
    hasta_columna con 58
    pinta_tamano con (elemento t de paginas_usadas) mas 1
    si (elemento t de reinicios_de) es mayor que 0
        hasta_columna con 68
        pinta_numero con (elemento t de reinicios_de)
        si (elemento t de reinicios_de) es 1
            pinta con " reinicio"
        si no
            pinta con " reinicios"
        fin
    fin
    pinta_linea con ""
fin

funcion tareas
    para cada t desde 1 hasta MAX_TAREAS
        si (elemento t de estados_tarea) no es igual a SIN_USAR
            linea_de_tarea con t
        fin
    fin
    linea_de_tarea con TAREA_TECLADO
    linea_de_tarea con TAREA_DISCO
    si hay_graficos
        linea_de_tarea con TAREA_PANTALLA
    fin
    pinta_linea con ""
fin

funcion cabecera_de_tarea con t
    pinta con "  "
    pon_color con (color_de con t) y NEGRO
    pinta_numero con t
    pinta con "  "
    pinta con (nombre_de con t)
    pon_color con GRIS y NEGRO
    hasta_columna con 17
fin

funcion permisos
    hay es falso
    para cada t desde 1 hasta MAX_TAREAS
        si sigue_viva con t
            hay es verdadero
            cabecera_de_tarea con t
            ninguna es verdadero
            para cada llave desde 1 hasta LLAVES
                destino es abre_llave con t y llave
                si destino no es igual a 0
                    si ninguna
                        pinta con "habla con "
                    si no
                        pinta con ", "
                    fin
                    ninguna es falso
                    pon_color con (color_de con destino) y NEGRO
                    pinta con (nombre_de con destino)
                    pon_color con GRIS y NEGRO
                fin
            fin
            si ninguna
                pinta con "sin permisos"
            fin
            pinta_linea con ""
            hasta_columna con 17
            pon_color con GRIS_OSCURO y NEGRO
            pinta_numero con (elemento t de mensajes_de)
            pinta con " preguntas, "
            pinta_numero con (elemento t de rechazos_de)
            pinta_linea con " rechazadas"
            pon_color con GRIS y NEGRO
        fin
    fin
    cabecera_de_tarea con TAREA_TECLADO
    pinta_linea con "solo el puerto 96, para leer las teclas"
    cabecera_de_tarea con TAREA_DISCO
    pinta_linea con "solo los puertos del 496 al 503, los del disco"
    si hay_graficos
        cabecera_de_tarea con TAREA_PANTALLA
        pinta_linea con "solo la imagen, y lee lo que hay que pintar sin poder cambiarlo"
    fin
    pinta_linea con ""
    pinta_siempre
    pinta_linea con ""
fin

primer_numero es 0
segundo_numero es 0

funcion dos_numeros con primera
    comparte primer_numero y segundo_numero
    hueco es primera
    mientras hueco es menor que escritas y (elemento hueco de orden) no es igual a 32
        hueco es hueco mas 1
    fin
    primer_numero es numero_entre con primera y hueco menos 1
    segundo_numero es numero_entre con hueco mas 1 y escritas
fin

funcion tareas_buenas
    para cada n desde 1 hasta 2
        t es primer_numero
        si n es 2
            t es segundo_numero
        fin
        si t es menor que 1 o t es mayor que MAX_TAREAS
            devuelve falso
        fin
        si no (sigue_viva con t)
            devuelve falso
        fin
    fin
    devuelve primer_numero no es igual a segundo_numero
fin

funcion no_hay_esas_tareas
    pon_color con ROJO_CLARO y NEGRO
    pinta_linea con "  Necesito dos tareas que existan y sean distintas. Mira: tareas"
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion llave_hacia con t y destino
    para cada llave desde 1 hasta LLAVES
        si (abre_llave con t y llave) es destino
            devuelve llave
        fin
    fin
    devuelve 0
fin

funcion llave_libre con t
    para cada llave desde 1 hasta LLAVES
        si (abre_llave con t y llave) es 0
            devuelve llave
        fin
    fin
    devuelve 0
fin

funcion permite
    dos_numeros con 9
    si no tareas_buenas
        no_hay_esas_tareas
        devuelve nada
    fin
    si (llave_hacia con primer_numero y segundo_numero) no es igual a 0
        pinta_linea con "  Ya tenía ese permiso."
        pinta_linea con ""
        devuelve nada
    fin
    llave es llave_libre con primer_numero
    si llave es 0
        pinta_linea con "  Esa tarea no puede llevar más permisos."
        pinta_linea con ""
        devuelve nada
    fin
    sitio es sitio_de_llave con primer_numero y llave
    desactiva_interrupciones
    elemento sitio de llave_generacion es elemento segundo_numero de generaciones
    elemento sitio de llave_a es segundo_numero
    activa_interrupciones
    pon_color con VERDE_CLARO y NEGRO
    pinta con "  "
    pinta con (nombre_de con primer_numero)
    pinta con " ya puede hablar con "
    pinta_linea con (nombre_de con segundo_numero)
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion prohibe
    dos_numeros con 9
    si no tareas_buenas
        no_hay_esas_tareas
        devuelve nada
    fin
    llave es llave_hacia con primer_numero y segundo_numero
    si llave es 0
        pinta_linea con "  No tenía ese permiso."
        pinta_linea con ""
        devuelve nada
    fin
    elemento (sitio_de_llave con primer_numero y llave) de llave_a es 0
    pon_color con ROJO_CLARO y NEGRO
    pinta con "  "
    pinta con (nombre_de con primer_numero)
    pinta con " ya no puede hablar con "
    pinta_linea con (nombre_de con segundo_numero)
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    al_serie con (nombre_de con primer_numero)
    escribe " pierde el permiso tras " sin salto
    escribe (elemento primer_numero de mensajes_de) sin salto
    escribe " preguntas"
fin

funcion pinta_hex con n
    si n es menor que 0
        pinta con "una dirección imposible"
    si no
        pinta con "0x"
        cifras_hex con 0 menos n
        mueve_cursor
    fin
fin

funcion cifras_hex con n
    si n es menor o igual que menos 16
        cifras_hex con (cociente con n y 16)
    fin
    cifra es 0 menos (n resto 16)
    si cifra es menor que 10
        pon_letra con 48 mas cifra
    si no
        pon_letra con 55 mas cifra
    fin
fin

funcion puerto_legible con t
    d es elemento t de registro_rdx
    devuelve d es mayor o igual que 0 y d es menor que 65536
fin

funcion cuenta_lectura con t
    puerto es elemento t de registro_rdx
    si (puerto_legible con t) y puerto es 96
        pinta_linea con "quiso espiar lo que escribes en el teclado."
    si no si (puerto_legible con t) y puerto es mayor o igual que 496 y puerto es menor o igual que 503
        pinta_linea con "quiso leer el disco por su cuenta."
    si no
        pinta_linea con "quiso leer de un aparato."
    fin
    pinta_linea con "  Ese puerto no es suyo, y el procesador lo ha parado."
fin

funcion cuenta_general con t
    instruccion es elemento t de instrucciones
    si instruccion es 238 y puerto_legible con t
        puerto es elemento t de registro_rdx
        valor es elemento t de registro_rax
        si puerto es 100 y valor es 254
            pinta_linea con "quiso apagar el ordenador."
        si no
            pinta con "quiso escribir en el puerto "
            pinta_numero con puerto
            pinta_linea con "."
        fin
        pinta_linea con "  Ese puerto no es suyo, y el procesador lo ha parado."
    si no si instruccion es 236 o instruccion es 102
        cuenta_lectura con t
    si no
        pinta_linea con "quiso usar una instrucción reservada al núcleo."
    fin
fin

funcion cuenta_pagina con t
    codigo es elemento t de codigos
    direccion es elemento t de direcciones
    escribiendo es ((cociente con codigo y 2) resto 2) es 1
    si ((cociente con codigo y 16) resto 2) es 1
        pinta con "quiso ejecutar "
        pinta_hex con direccion
        pinta_linea con ", que no es código."
    si no si direccion es mayor o igual que DONDE_VAN y direccion es menor que DONDE_VAN mas TOPE_PROGRAMA
        pinta_linea con "quiso reescribir su propio código, que es de solo lectura."
    si no si direccion es mayor o igual que DONDE_VAN o direccion es menor que 0
        pinta con "quiso tocar "
        pinta_hex con direccion
        pinta_linea con ", que no existe."
    si no
        si escribiendo
            pinta con "quiso escribir en "
        si no
            pinta con "quiso leer "
        fin
        pinta_hex con direccion
        pinta_linea con ", que es memoria del núcleo."
        pinta_linea con "  Esa memoria no es suya, y el procesador no le deja tocarla."
    fin
fin

funcion ultima_linea con t
    renglon es elemento t de fila_de_ventana
    si (elemento t de columna_de) es 1 y renglon es mayor que 1
        renglon es renglon menos 1
    fin
    texto es texto_de con t
    final es elemento t de anchos
    mientras final es mayor que 0 y ((elemento (casilla_de_texto con t y renglon y final) de texto) resto 256) es 32
        final es final menos 1
    fin
    c es 1
    mientras c es menor o igual que final
        pon_letra con ((elemento (casilla_de_texto con t y renglon y c) de texto) resto 256)
        c es c mas 1
    fin
    mueve_cursor
fin

funcion cuenta_el_final con t
    causa es elemento t de causas
    nombre es nombre_de con t
    si causa es SE_COLGO
        pon_color con ROJO_CLARO y NEGRO
        pinta con "  "
        pinta con nombre
        pon_color con BLANCO y NEGRO
        pinta_linea con " lleva 1 s sin contestar: se ha colgado."
    si no si causa es SALIO
        pinta con "  "
        pinta con nombre
        si es_controlador con t
            pinta_linea con " ha reventado por dentro."
        si no si (elemento t de codigos) no es igual a 0
            pinta_linea con " ha reventado:"
            pinta con "  "
            ultima_linea con t
            pinta_linea con ""
        si no
            pinta_linea con " ha terminado."
        fin
    si no si causa es LA_PARARON
        pinta con "  He cerrado "
        pinta con nombre
        pinta_linea con "."
        si no (es_controlador con t)
            pinta con "  Le habían llegado "
            pon_color con BLANCO y NEGRO
            pinta_numero con (elemento t de teclas_recibidas)
            pon_color con GRIS y NEGRO
            si (elemento t de teclas_recibidas) es 1
                pinta_linea con " tecla tuya."
            si no
                pinta_linea con " teclas tuyas."
            fin
        fin
        al_serie con nombre
        escribe " cerrado con " sin salto
        escribe (elemento t de mensajes_de) sin salto
        escribe " preguntas y " sin salto
        escribe (elemento t de rechazos_de) sin salto
        escribe " rechazadas"
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta con "  "
        pinta con nombre
        pon_color con BLANCO y NEGRO
        pinta con " "
        si causa es 13
            cuenta_general con t
        si no si causa es 14
            cuenta_pagina con t
        si no
            pinta con "ha roto algo: excepción "
            pinta_numero con causa
            pinta_linea con "."
        fin
        si no (es_controlador con t)
            pon_color con VERDE_CLARO y NEGRO
            pinta_linea con "  Lo he cerrado. Todo lo demás sigue en marcha."
        fin
        al_serie con nombre
        escribe " cerrado por la excepción " sin salto
        escribe causa
    fin
    si no (es_controlador con t)
        si (elemento t de teclas_recibidas) es mayor que 0
            desactiva_interrupciones
            apunta_de con R_TECLAS y t y (elemento t de teclas_recibidas)
            activa_interrupciones
        fin
        al_serie con nombre
        escribe " recibió " sin salto
        escribe (elemento t de teclas_recibidas) sin salto
        escribe " teclas"
    fin
    pon_color con GRIS y NEGRO
fin

funcion suelta_tarea con t
    suelta_dos_megas con (elemento t de memoria_grande_de)
    elemento t de memoria_grande_de es 0
    lista es region con (elemento t de listas_de_paginas) y 512 y 8
    para cada i desde 1 hasta elemento t de paginas_usadas
        suelta_pagina con (elemento i de lista)
    fin
    suelta_pagina con (elemento t de listas_de_paginas)
    si no (es_controlador con t)
        acaba_ventana con t
    fin
    para cada llave desde 1 hasta LLAVES
        elemento (sitio_de_llave con t y llave) de llave_a es 0
    fin
    elemento t de estados_tarea es SIN_USAR
fin

funcion vuelve_a_lanzar con t
    elemento t de reinicios_de es (elemento t de reinicios_de) mas 1
    lanza_controlador con t
    pon_color con VERDE_CLARO y NEGRO
    tardado es (tics menos (elemento t de cerrada_en)) por 10
    pinta con "  He lanzado otro en "
    si tardado es 0
        pinta con "menos de 10"
    si no
        pinta_numero con tardado
    fin
    pinta_linea con " ms. Todo lo demás sigue en marcha."
    pon_color con GRIS y NEGRO
    al_serie con (nombre_de con t)
    escribe " reiniciado, y van " sin salto
    escribe (elemento t de reinicios_de)
fin

funcion recoge_tareas con en_el_indicador
    comparte hay_cerradas y columna
    hay_cerradas es falso
    alguna es falso
    para cada t desde 1 hasta ULTIMA_TAREA
        si t no es igual a CONSOLA y (elemento t de estados_tarea) es CERRADA
            si en_el_indicador y no alguna
                base es (fila menos 1) por ANCHO
                para cada c desde 1 hasta ANCHO
                    elemento base mas c de pantalla es color por 256 mas 32
                fin
                columna es 1
            fin
            alguna es verdadero
            cuenta_el_final con t
            suelta_tarea con t
            si es_controlador con t
                vuelve_a_lanzar con t
            fin
            pinta_linea con ""
        fin
    fin
    si alguna y en_el_indicador
        indicador
        redibuja
    fin
fin

funcion pide_al_disco con peticion
    comparte peticion_abierta y disco_listo y esperando
    recoge_tareas con falso
    desactiva_interrupciones
    disco_listo es falso
    peticion_abierta es verdadero
    avisa_a con TAREA_DISCO y peticion
    mientras no disco_listo
        esperando es verdadero
        espera_interrupcion
        esperando es falso
        desactiva_interrupciones
    fin
    disco_listo es falso
    activa_interrupciones
    devuelve resultado_disco
fin

funcion fallo_de_disco con motivo
    pon_color con ROJO_CLARO y NEGRO
    si motivo es NO_HAY_DISCO
        pinta_linea con "  No hay ningún disco conectado."
    si no si motivo es NO_ES_MIO
        pinta_linea con "  Ese disco no tiene mi formato."
    si no si motivo es NO_ESTA
        pinta_linea con "  No hay ningún archivo con ese nombre. Mira: disco"
    si no si motivo es NO_SE_LEE
        pinta_linea con "  El disco no me deja leer ese trozo."
    si no si motivo es DANADO
        pinta_linea con "  No entiendo el índice de este disco, así que no lo toco."
    si no si motivo es NO_SE_ESCRIBE
        pinta_linea con "  El disco no me deja escribir."
    si no si motivo es LLENO
        pinta_linea con "  El índice del disco está lleno."
    si no si motivo es PROHIBIDO
        pinta_linea con "  Ese nombre no vale."
    si no
        pinta_linea con "  El programa del disco ha caído antes de contestar."
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion pinta_buzon con cuantos
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    i es 1
    mientras i es menor o igual que cuantos
        pon_byte con (elemento i de buzon)
        i es i mas 1
    fin
    mueve_cursor
fin

funcion orden_disco
    respuesta es pide_al_disco con ORDEN_LISTA
    si respuesta es menor que 0 o respuesta es mayor que TOPE_BUZON
        fallo_de_disco con respuesta
    si no
        pinta_buzon con respuesta
        pinta_linea con ""
        pinta_linea con "  Lo ha leído un programa sin permisos, que solo toca ocho puertos."
        pinta_linea con ""
    fin
fin

funcion nombre_al_buzon con nombre y cola
    recoge_tareas con falso
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    i es 0
    para cada b en nombre
        i es i mas 1
        elemento i de buzon es b
    fin
    para cada b en cola
        i es i mas 1
        elemento i de buzon es b
    fin
    elemento i mas 1 de buzon es 0
    devuelve buzon
fin

funcion pide_archivo con nombre y cola y trozo
    nombre_al_buzon con nombre y cola
    devuelve pide_al_disco con ORDEN_TROZO mas trozo
fin

funcion haz_encargo con t
    nombre es nombre_de con t
    cuantos es elemento t de cuantos_de
    suya es region con (elemento t de mesas) mas (elemento t de desde_de) y cuantos
    si largo de nombre mas 4 es mayor que NOMBRE_EN_DISCO
        devuelve NO_ESTA
    fin
    si (elemento t de pedido_de) es LEE_GUARDADO
        traido es pide_archivo con nombre y ".dat" y 0
        si traido es mayor que cuantos
            traido es cuantos
        fin
        si traido es mayor que 0
            buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
            copia_region con suya y 1 y buzon y 1 y traido
        fin
        devuelve traido
    fin
    buzon es nombre_al_buzon con nombre y ".dat"
    elemento 41 de buzon es cociente con cuantos y 256
    elemento 42 de buzon es cuantos resto 256
    copia_region con buzon y 513 y suya y 1 y cuantos
    devuelve pide_al_disco con ORDEN_GUARDA
fin

funcion atiende_encargos
    comparte hay_encargos
    hay_encargos es falso
    para cada t desde 1 hasta MAX_TAREAS
        si (elemento t de estados_tarea) es CON_EL_DISCO
            pedido es elemento t de pedido_de
            permiso es elemento t de permiso_disco
            si pedido es GUARDA y permiso es DISCO_SIN_PEDIR y (esta_siempre con (nombre_de con t)) es mayor que 0
                elemento t de permiso_disco es DISCO_SI
                permiso es DISCO_SI
            fin
            si pedido es GUARDA y permiso es DISCO_SIN_PEDIR
                elemento t de permiso_disco es DISCO_PEDIDO
                pide_permiso_de con t
            si no si pedido es LEE_GUARDADO o permiso es DISCO_SI
                termina_encargo con t y (haz_encargo con t)
            si no si permiso es DISCO_NO
                termina_encargo con t y NEGADO
            fin
        fin
    fin
fin

funcion termina_encargo con t y hecho
    comparte aviso_disco_hasta y disco_lo_usa y disco_guardaba
    al_serie con (nombre_de con t)
    si hecho es mayor o igual que 0
        disco_lo_usa es t
        disco_guardaba es (elemento t de pedido_de) es GUARDA
        aviso_disco_hasta es tics mas 3 por TICS_POR_SEGUNDO
        ensucia
    fin
    si (elemento t de pedido_de) es GUARDA
        escribe " guardó en el disco: " sin salto
    si no
        escribe " leyó del disco: " sin salto
    fin
    escribe hecho
    desactiva_interrupciones
    si (elemento t de pedido_de) es GUARDA y hecho es mayor o igual que 0
        apunta_de con R_GUARDO y t y hecho
    si no si (elemento t de pedido_de) es GUARDA y hecho es NEGADO
        apunta_de con R_NEGADO y t y 0
    si no si hecho es mayor o igual que 0
        apunta_de con R_LEYO y t y hecho
    si no si hecho es NO_ESTA
        apunta_de con R_BUSCO y t y 0
    fin
    si (elemento t de estados_tarea) es CON_EL_DISCO
        despierta_con con t y hecho
    fin
    activa_interrupciones
fin

funcion pide_permiso_de con t
    comparte columna
    base es (fila menos 1) por ANCHO
    para cada c desde 1 hasta ANCHO
        elemento base mas c de pantalla es color por 256 mas 32
    fin
    columna es 1
    pon_color con (color_de con t) y NEGRO
    pinta con "  "
    pinta con (nombre_de con t)
    pon_color con BLANCO y NEGRO
    pinta con " quiere guardar "
    pinta_numero con (elemento t de cuantos_de)
    pinta con " bytes en el disco, en "
    pinta con (nombre_de con t)
    pinta_linea con ".dat."
    pon_color con GRIS y NEGRO
    pinta con "  Si le dejas: deja "
    pinta_numero con t
    pinta con ". Si no: niega "
    pinta_numero con t
    pinta_linea con ". Hasta que me contestes, espera."
    pinta_linea con ""
    al_serie con (nombre_de con t)
    escribe " pide permiso para guardar"
    desactiva_interrupciones
    apunta_de con R_PIDE y t y (elemento t de cuantos_de)
    activa_interrupciones
    indicador
    redibuja
fin

funcion decide_guardar con primera y permiso y para_siempre
    comparte hay_encargos
    t es numero_entre con primera y escritas
    bien es t es mayor o igual que 1 y t es menor o igual que MAX_TAREAS
    si bien
        bien es sigue_viva con t
    fin
    si no bien y permiso es DISCO_NO
        nombre es trozo_de_orden con primera
        si (esta_siempre con nombre) es mayor que 0
            quita_siempre con nombre y GRIS
            pon_color con ROJO_CLARO y NEGRO
            pinta con "  "
            pinta con nombre
            pinta_linea con " ya no guardará nada sin preguntarte."
            pon_color con GRIS y NEGRO
            pinta_linea con ""
            devuelve nada
        fin
    fin
    si no bien
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No hay ningún programa con ese número. Mira: tareas"
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    desactiva_interrupciones
    elemento t de permiso_disco es permiso
    hay_encargos es verdadero
    si permiso es DISCO_SI y para_siempre
        apunta_de con R_SIEMPRE y t y 0
    si no si permiso es DISCO_SI
        apunta_de con R_DEJASTE y t y 0
    si no
        apunta_de con R_NEGASTE y t y 0
    fin
    activa_interrupciones
    nombre es nombre_de con t
    pinta con "  "
    si permiso es DISCO_SI y para_siempre
        si anade_siempre con nombre
            pon_color con VERDE_CLARO y NEGRO
            pinta con nombre
            pinta_linea con " puede guardar siempre, también cuando reinicies."
            pon_color con GRIS y NEGRO
            pinta con "  Para quitárselo: niega "
            pinta_linea con nombre
        si no
            pon_color con AMARILLO y NEGRO
            pinta con nombre
            pinta_linea con " puede guardar hasta que se cierre. Lo de siempre"
            pinta_linea con "  no he podido apuntarlo en el disco."
        fin
    si no si permiso es DISCO_SI
        pon_color con VERDE_CLARO y NEGRO
        pinta con nombre
        pinta_linea con " puede guardar en su archivo hasta que se cierre."
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta con nombre
        pinta_linea con " no guardará nada en el disco."
        si (esta_siempre con nombre) es mayor que 0
            quita_siempre con nombre y (color_de con t)
            pon_color con GRIS y NEGRO
            pinta_linea con "  Y le he quitado el permiso para siempre."
        fin
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion olvida
    nombre es trozo_de_orden con 8
    nombre_al_buzon con nombre y ".dat"
    respuesta es pide_al_disco con ORDEN_OLVIDA
    si respuesta es NO_ESTA
        pinta con "  "
        pinta con nombre
        pinta_linea con " no tiene nada guardado."
        pinta_linea con ""
    si no si respuesta es menor que 0
        fallo_de_disco con respuesta
    si no
        pon_color con VERDE_CLARO y NEGRO
        pinta con "  He borrado "
        pinta con nombre
        pinta con ".dat: "
        pinta_numero con respuesta
        pinta_linea con " bytes. Donde estaban, ahora solo hay ceros."
        desactiva_interrupciones
        apunta con R_OLVIDASTE y nombre y GRIS y respuesta
        activa_interrupciones
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        al_serie con nombre
        escribe " olvidado: " sin salto
        escribe respuesta
    fin
fin

funcion lee_archivo
    respuesta es pide_archivo con (trozo_de_orden con 5) y "" y 0
    si respuesta es menor que 0 o respuesta es mayor que TOPE_BUZON
        fallo_de_disco con respuesta
    si no
        pon_color con BLANCO y NEGRO
        pinta_buzon con respuesta
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        escribe "archivo leido: " sin salto
        escribe respuesta
    fin
fin

funcion estropea con primera y aviso
    objetivo es 0
    si resto_es con primera y "teclado"
        objetivo es TAREA_TECLADO
    si no si resto_es con primera y "disco"
        objetivo es TAREA_DISCO
    si no si hay_graficos y resto_es con primera y "pantalla"
        objetivo es TAREA_PANTALLA
    fin
    si objetivo es 0
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  Solo sé hacerlo con el teclado, el disco o la pantalla."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    desactiva_interrupciones
    avisa_a con objetivo y aviso
    activa_interrupciones
fin

funcion apunta con clase y nombre y tinta y numero
    comparte apuntados
    cuantas es largo de nombre
    si cuantas es mayor que 32
        cuantas es 32
    fin
    si apuntados es mayor que 0
        base es ((apuntados menos 1) resto CUPO_REGISTRO) por 8
        sitio es ((apuntados menos 1) resto CUPO_REGISTRO) por 32
        mismo es (elemento base mas 2 de apuntes) es clase y (elemento base mas 4 de apuntes) es numero y (elemento base mas 5 de apuntes) es cuantas
        i es 1
        mientras mismo y i es menor o igual que cuantas
            si (elemento sitio mas i de apuntes_nombres) no es igual a (elemento i de nombre)
                mismo es falso
            fin
            i es i mas 1
        fin
        si mismo
            elemento base mas 1 de apuntes es segundos_del_dia
            elemento base mas 6 de apuntes es (elemento base mas 6 de apuntes) mas 1
            devuelve nada
        fin
    fin
    base es (apuntados resto CUPO_REGISTRO) por 8
    sitio es (apuntados resto CUPO_REGISTRO) por 32
    elemento base mas 1 de apuntes es segundos_del_dia
    elemento base mas 2 de apuntes es clase
    elemento base mas 3 de apuntes es tinta
    elemento base mas 4 de apuntes es numero
    elemento base mas 5 de apuntes es cuantas
    elemento base mas 6 de apuntes es 1
    i es 1
    mientras i es menor o igual que cuantas
        elemento sitio mas i de apuntes_nombres es elemento i de nombre
        i es i mas 1
    fin
    apuntados es apuntados mas 1
fin

funcion apunta_de con clase y t y numero
    apunta con clase y (nombre_de con t) y (color_de con t) y numero
fin

funcion es_tuya con clase
    si clase es R_CERROJO o clase es R_BLOQUEASTE o clase es R_ABRISTE o clase es R_SIN_CERROJO
        devuelve verdadero
    fin
    si clase es R_COPIASTE o clase es R_PEGASTE o clase es R_VACIASTE
        devuelve verdadero
    fin
    devuelve clase es mayor o igual que R_DEJASTE y clase es menor o igual que R_TECLADO
fin

funcion pinta_de con nombre y tinta
    pon_color con tinta y NEGRO
    pinta con nombre
    pon_color con GRIS y NEGRO
fin

funcion pinta_cuantos con n
    pon_color con BLANCO y NEGRO
    pinta_numero con n
    pon_color con GRIS y NEGRO
fin

funcion pinta_apunte con k
    base es (k resto CUPO_REGISTRO) por 8
    clase es elemento base mas 2 de apuntes
    tinta es elemento base mas 3 de apuntes
    n es elemento base mas 4 de apuntes
    veces es elemento base mas 6 de apuntes
    nombre es region con apuntes_nombres_en mas (k resto CUPO_REGISTRO) por 32 y (elemento base mas 5 de apuntes)
    al_serie con nombre
    escribe " apunte " sin salto
    escribe clase sin salto
    escribe " " sin salto
    escribe n
    pon_color con GRIS_OSCURO y NEGRO
    pinta con "  "
    pinta_hora con (elemento base mas 1 de apuntes)
    hasta_columna con 13
    si es_tuya con clase
        pinta_de con "tú" y BLANCO
    si no
        pinta_de con nombre y tinta
    fin
    pinta con " "
    hasta_columna con 25
    si clase es R_LEYO
        pinta con "leyó "
        pinta_cuantos con n
        pinta con " bytes de "
        pinta con nombre
        pinta con ".dat"
    si no si clase es R_BUSCO
        pinta con "buscó "
        pinta con nombre
        pinta con ".dat y no había nada"
    si no si clase es R_PIDE
        pinta con "pidió guardar "
        pinta_cuantos con n
        pinta con " bytes"
    si no si clase es R_GUARDO
        pinta con "guardó "
        pinta_cuantos con n
        pinta con " bytes en "
        pinta con nombre
        pinta con ".dat"
    si no si clase es R_NEGADO
        pinta_de con "quiso guardar y no le dejé" y ROJO_CLARO
    si no si clase es R_TECLAS
        pinta con "se cerró con "
        pinta_cuantos con n
        si n es 1
            pinta con " tecla tuya"
        si no
            pinta con " teclas tuyas"
        fin
    si no si clase es R_LEE_LISTA
        pinta con "leyó quién guarda sin preguntarte"
    si no si clase es R_GUARDA_LISTA
        pinta con "apuntó quién guarda sin preguntarte"
    si no si clase es R_DEJASTE
        pinta con "dejaste guardar a "
        pinta_de con nombre y tinta
    si no si clase es R_SIEMPRE
        pinta con "dejaste guardar siempre a "
        pinta_de con nombre y tinta
    si no si clase es R_NEGASTE
        pinta con "no dejaste guardar a "
        pinta_de con nombre y tinta
    si no si clase es R_QUITASTE
        pinta con "quitaste el siempre a "
        pinta_de con nombre y tinta
    si no si clase es R_OLVIDASTE
        pinta con "borraste "
        pinta con nombre
        pinta con ".dat, "
        pinta_cuantos con n
        pinta con " bytes"
    si no si clase es R_TECLADO
        pinta con "diste el teclado a "
        pinta_de con nombre y tinta
    si no si clase es R_CERROJO
        pinta con "pusiste contraseña a la pantalla"
    si no si clase es R_BLOQUEASTE
        pinta con "bloqueaste la pantalla"
    si no si clase es R_SE_BLOQUEO
        pinta con "bloqueó la pantalla: 5 minutos sin tocarla"
    si no si clase es R_ABRISTE
        pinta con "abriste la pantalla"
    si no si clase es R_MALA
        pinta_de con "alguien probó una contraseña mala" y ROJO_CLARO
    si no si clase es R_SIN_CERROJO
        pinta con "quitaste la contraseña de la pantalla"
    si no si clase es R_COPIASTE
        pinta con "copiaste "
        pinta_cuantos con n
        pinta con " letras de "
        pinta_de con nombre y tinta
    si no si clase es R_PEGASTE
        pinta con "pegaste "
        pinta_cuantos con n
        pinta con " letras en "
        pinta_de con nombre y tinta
    si no si clase es R_VACIASTE
        pinta con "borraste el portapapeles"
    si no si clase es R_SE_BORRO y n es AL_BLOQUEAR
        pinta con "borró el portapapeles al bloquear"
    si no si clase es R_SE_BORRO
        pinta con "borró el portapapeles: pasaron 30 s"
    fin
    si veces es mayor que 1
        pon_color con GRIS_OSCURO y NEGRO
        pinta con " ("
        pinta_numero con veces
        pinta con " veces)"
        pon_color con GRIS y NEGRO
    fin
    pinta_linea con ""
fin

funcion ensena_registro
    si apuntados es 0
        pinta_linea con "  Todavía nadie ha leído ni guardado nada."
        pinta_linea con ""
        devuelve nada
    fin
    desde es 0
    si apuntados es mayor que CUPO_REGISTRO
        desde es apuntados menos CUPO_REGISTRO
    fin
    pon_color con GRIS_OSCURO y NEGRO
    pinta_linea con "  hora UTC  quién       qué"
    pon_color con GRIS y NEGRO
    k es desde
    mientras k es menor que apuntados
        pinta_apunte con k
        k es k mas 1
    fin
    pinta_linea con ""
    pon_color con GRIS_OSCURO y NEGRO
    si desde es mayor que 0
        pinta con "  Antes hubo "
        pinta_numero con desde
        pinta_linea con " más, ya olvidados: guardo los 16 últimos."
    fin
    pinta_linea con "  Este registro solo vive en memoria. No lo escribo en el disco,"
    pinta_linea con "  se borra al apagar y ningún programa lo puede leer."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion esta_siempre con nombre
    i es 1
    mientras i es menor o igual que siempre_mide
        final es i
        mientras final es menor o igual que siempre_mide y (elemento final de siempre) no es igual a 10
            final es final mas 1
        fin
        si (final menos i) es (largo de nombre)
            parecido es verdadero
            j es 1
            mientras parecido y j es menor o igual que largo de nombre
                si (minuscula con (elemento i mas j menos 1 de siempre)) no es igual a (minuscula con (elemento j de nombre))
                    parecido es falso
                fin
                j es j mas 1
            fin
            si parecido
                devuelve i
            fin
        fin
        i es final mas 1
    fin
    devuelve 0
fin

funcion guarda_siempre
    respuesta es 0
    buzon es nombre_al_buzon con "permisos" y ".sis"
    si siempre_mide es 0
        respuesta es pide_al_disco con ORDEN_OLVIDA
        si respuesta es NO_ESTA
            respuesta es 0
        fin
    si no
        elemento 41 de buzon es cociente con siempre_mide y 256
        elemento 42 de buzon es siempre_mide resto 256
        copia_region con buzon y 513 y siempre y 1 y siempre_mide
        respuesta es pide_al_disco con ORDEN_GUARDA
    fin
    si respuesta es mayor o igual que 0
        desactiva_interrupciones
        apunta con R_GUARDA_LISTA y "FalOS" y BLANCO y siempre_mide
        activa_interrupciones
    fin
    al_serie con "permisos.sis guardado: "
    escribe respuesta
    devuelve respuesta
fin

funcion anade_siempre con nombre
    comparte siempre_mide
    si (esta_siempre con nombre) es mayor que 0
        devuelve verdadero
    fin
    viejo es siempre_mide
    si siempre_mide mas (largo de nombre) mas 1 es mayor que TOPE_SIEMPRE
        devuelve falso
    fin
    para cada b en nombre
        siempre_mide es siempre_mide mas 1
        elemento siempre_mide de siempre es b
    fin
    siempre_mide es siempre_mide mas 1
    elemento siempre_mide de siempre es 10
    si (guarda_siempre) es menor que 0
        siempre_mide es viejo
        devuelve falso
    fin
    devuelve verdadero
fin

funcion quita_siempre con nombre y tinta
    comparte siempre_mide
    i es esta_siempre con nombre
    si i es 0
        devuelve nada
    fin
    quitar es (largo de nombre) mas 1
    j es i
    mientras j mas quitar es menor o igual que siempre_mide
        elemento j de siempre es elemento j mas quitar de siempre
        j es j mas 1
    fin
    siempre_mide es siempre_mide menos quitar
    desactiva_interrupciones
    apunta con R_QUITASTE y nombre y tinta y 0
    activa_interrupciones
    guarda_siempre
fin

funcion lee_siempre
    comparte siempre_mide
    siempre_mide es 0
    traido es pide_archivo con "permisos" y ".sis" y 0
    si traido es menor que 1 o traido es mayor que TOPE_SIEMPRE
        devuelve nada
    fin
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    si (elemento traido de buzon) no es igual a 10
        devuelve nada
    fin
    i es 1
    mientras i es menor o igual que traido
        b es elemento i de buzon
        si b no es igual a 10 y (b es menor que 33 o b es mayor que 126)
            devuelve nada
        fin
        i es i mas 1
    fin
    copia_region con siempre y 1 y buzon y 1 y traido
    siempre_mide es traido
    desactiva_interrupciones
    apunta con R_LEE_LISTA y "FalOS" y BLANCO y traido
    activa_interrupciones
    al_serie con "permisos.sis leido: "
    escribe traido
fin

funcion pinta_siempre
    si siempre_mide es 0
        pinta_linea con "  Ningún programa guarda sin preguntarte."
        devuelve nada
    fin
    pinta con "  Guardan sin preguntarte: "
    pon_color con BLANCO y NEGRO
    i es 1
    mientras i es menor o igual que siempre_mide
        b es elemento i de siempre
        si b es 10 y i es menor que siempre_mide
            pinta con ", "
        si no si b no es igual a 10
            pon_letra con b
        fin
        i es i mas 1
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    pinta_linea con "  Para quitárselo a uno: niega y su nombre."
fin

funcion olvida_lo_escrito
    comparte clave_mide y primera_mide
    para cada i desde 1 hasta 32
        elemento i de clave_escrita es 0
        elemento i de clave_primera es 0
        elemento i de comprobada es 0
    fin
    clave_mide es 0
    primera_mide es 0
fin

funcion bloquea_ya con por_que
    comparte bloqueado y foco y agarrada y modo_clave y mensaje_cerrojo y malas y cortado
    si bloqueado o no hay_cerrojo
        devuelve nada
    fin
    si modo_clave es CLAVE_NUEVA o modo_clave es CLAVE_REPITE
        cortado es verdadero
    fin
    bloqueado es verdadero
    foco es CONSOLA
    agarrada es 0
    olvida_seleccion
    olvida_lo_escrito
    modo_clave es CLAVE_ABRE
    mensaje_cerrojo es NADA_QUE_DECIR
    malas es 0
    si por_que es POR_TI
        apunta con R_BLOQUEASTE y "FalOS" y BLANCO y 0
    si no si por_que es POR_QUIETO
        apunta con R_SE_BLOQUEO y "FalOS" y BLANCO y 0
    fin
    vacia_portapapeles con AL_BLOQUEAR
    ensucia
fin

funcion saca_sal con destino y desde
    trozos es region con azar_en y 4 y 8
    si hay_azar
        elemento 1 de trozos es azar_del_procesador
        elemento 2 de trozos es azar_del_procesador
    si no
        elemento 3 de trozos es tics
        elemento 4 de trozos es segundos_del_dia
        blake2b con taller_cerrojo y (region con azar_en mas 16 y 16) y 16 y "" y (region con azar_en y 16) y 16
    fin
    copia_region con destino y desde y (region con azar_en y 16) y 1 y 16
    para cada i desde 1 hasta 4
        elemento i de trozos es 0
    fin
fin

funcion huella_de con sal y salida
    argon2id con memoria_cerrojo y BLOQUES_CERROJO y PASADAS_CERROJO y (region con clave_en y clave_mide) y sal y salida
fin

funcion es_la_buena
    distinto es 0
    para cada i desde 1 hasta 32
        distinto es distinto mas o_exclusivo con (elemento 20 mas i de cerrojo) y (elemento i de comprobada)
    fin
    si distinto es 0
        devuelve verdadero
    fin
    devuelve falso
fin

funcion pon_cerrojo
    comparte modo_clave
    si memoria_cerrojo es 0
        pinta_linea con "  No me quedan 2 MB seguidos para Argon2id, así que no puedo."
        pinta_linea con ""
        devuelve nada
    fin
    pinta_linea con "  No guardo tu contraseña: guardo su huella, hecha con Argon2id."
    pinta_linea con "  Si le das a Intro sin escribir nada, todo sigue como está."
    pinta con "  Contraseña nueva: "
    olvida_lo_escrito
    modo_clave es CLAVE_NUEVA
fin

funcion orden_bloquea
    si no hay_cerrojo
        pinta_linea con "  Primero ponle contraseña: cerrojo."
        pinta_linea con ""
        devuelve nada
    fin
    desactiva_interrupciones
    bloquea_ya con POR_TI
    activa_interrupciones
fin

funcion quita_cerrojo
    comparte hay_cerrojo
    si no hay_cerrojo
        pinta_linea con "  La pantalla no tiene contraseña."
        pinta_linea con ""
        devuelve nada
    fin
    nombre_al_buzon con "cerrojo" y ".sis"
    respuesta es pide_al_disco con ORDEN_OLVIDA
    al_serie con "cerrojo.sis olvidado: "
    escribe respuesta
    si respuesta es menor que 0 y respuesta no es igual a NO_ESTA
        fallo_de_disco con respuesta
        devuelve nada
    fin
    hay_cerrojo es falso
    para cada i desde 1 hasta TOPE_CERROJO
        elemento i de cerrojo es 0
    fin
    desactiva_interrupciones
    apunta con R_SIN_CERROJO y "FalOS" y BLANCO y 0
    activa_interrupciones
    pinta_linea con "  Quitada, y su huella borrada del disco con ceros."
    pinta_linea con ""
fin

funcion guarda_cerrojo
    comparte hay_cerrojo
    fichero es region con clave_en mas 256 y TOPE_CERROJO
    i es 1
    para cada letra en MARCA_CERROJO
        elemento i de fichero es letra
        i es i mas 1
    fin
    saca_sal con fichero y 5
    huella_de con (region con clave_en mas 260 y 16) y (region con clave_en mas 276 y 32)
    buzon es nombre_al_buzon con "cerrojo" y ".sis"
    elemento 41 de buzon es 0
    elemento 42 de buzon es TOPE_CERROJO
    copia_region con buzon y 513 y fichero y 1 y TOPE_CERROJO
    respuesta es pide_al_disco con ORDEN_GUARDA
    al_serie con "cerrojo.sis guardado: "
    escribe respuesta
    si respuesta es menor que 0
        fallo_de_disco con respuesta
        pinta_linea con "  No la he guardado, así que todo sigue como estaba."
        devuelve nada
    fin
    copia_region con cerrojo y 1 y fichero y 1 y TOPE_CERROJO
    hay_cerrojo es verdadero
    desactiva_interrupciones
    apunta con R_CERROJO y "FalOS" y BLANCO y 0
    activa_interrupciones
    pon_color con VERDE_CLARO y NEGRO
    pinta_linea con "  Hecho. Para entrar hará falta, también al arrancar."
    pon_color con GRIS y NEGRO
    pinta_linea con "  Escribe bloquea para bloquear ya. Y me bloqueo solo si pasan"
    pinta_linea con "  5 minutos sin que toques el teclado ni el ratón."
fin

funcion abre_cerrojo
    comparte bloqueado y modo_clave y mensaje_cerrojo y malas y cortado y ultima_actividad
    si clave_mide es 0
        devuelve nada
    fin
    mensaje_cerrojo es COMPROBANDO
    ensucia
    huella_de con (region con cerrojo_en mas 4 y 16) y comprobada
    buena es es_la_buena
    olvida_lo_escrito
    si no buena
        malas es malas mas 1
        mensaje_cerrojo es NO_ES_ESA
        desactiva_interrupciones
        apunta con R_MALA y "FalOS" y BLANCO y 0
        activa_interrupciones
        ensucia
        devuelve nada
    fin
    desactiva_interrupciones
    bloqueado es falso
    modo_clave es SIN_CLAVE
    mensaje_cerrojo es NADA_QUE_DECIR
    ultima_actividad es tics
    apunta con R_ABRISTE y "FalOS" y BLANCO y 0
    activa_interrupciones
    si cortado
        pinta_linea con ""
        pinta_linea con "  Me bloqueé antes de que acabaras la contraseña. Nada cambia."
        pinta_linea con ""
        indicador
        cortado es falso
    fin
    si malas es mayor que 0
        pinta_linea con ""
        pon_color con AMARILLO y NEGRO
        pinta con "  Mientras estaba bloqueado, alguien probó "
        pinta_numero con malas
        si malas es 1
            pinta_linea con " contraseña mala."
        si no
            pinta_linea con " contraseñas malas."
        fin
        pon_color con GRIS y NEGRO
        pinta_linea con "  Lo tienes en registro."
        pinta_linea con ""
        indicador
        redibuja
        malas es 0
    fin
    ensucia
fin

funcion atiende_clave con tecla
    comparte clave_mide y columna y mensaje_cerrojo
    si tecla es TECLA_INTRO
        termina_clave
    si no si tecla es TECLA_BORRA y clave_mide es mayor que 0
        elemento clave_mide de clave_escrita es 0
        clave_mide es clave_mide menos 1
        si modo_clave es CLAVE_ABRE
            ensucia
        si no
            columna es columna menos 1
            pinta con " "
            columna es columna menos 1
            mueve_cursor
        fin
    si no si tecla es mayor o igual que 32 y tecla es menor que 256 y clave_mide es menor que 32
        clave_mide es clave_mide mas 1
        elemento clave_mide de clave_escrita es tecla
        si modo_clave es CLAVE_ABRE
            mensaje_cerrojo es NADA_QUE_DECIR
            ensucia
        si no
            pinta con "*"
        fin
    fin
fin

funcion termina_clave
    comparte modo_clave y primera_mide y clave_mide
    si modo_clave es CLAVE_ABRE
        abre_cerrojo
        devuelve nada
    fin
    pinta_linea con ""
    si modo_clave es CLAVE_NUEVA
        si clave_mide es 0
            pinta_linea con "  Nada cambia."
            acaba_clave
            devuelve nada
        fin
        copia_region con clave_primera y 1 y clave_escrita y 1 y 32
        primera_mide es clave_mide
        para cada i desde 1 hasta 32
            elemento i de clave_escrita es 0
        fin
        clave_mide es 0
        pinta con "  Repítela: "
        modo_clave es CLAVE_REPITE
        devuelve nada
    fin
    iguales es clave_mide es primera_mide
    para cada i desde 1 hasta 32
        si (elemento i de clave_escrita) no es igual a (elemento i de clave_primera)
            iguales es falso
        fin
    fin
    si iguales y clave_mide es mayor que 0
        pinta_linea con "  Calculando la huella..."
        guarda_cerrojo
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No son iguales. No cambio nada."
        pon_color con GRIS y NEGRO
    fin
    acaba_clave
fin

funcion acaba_clave
    comparte modo_clave
    olvida_lo_escrito
    modo_clave es SIN_CLAVE
    pinta_linea con ""
    indicador
fin

funcion lee_cerrojo
    comparte hay_cerrojo
    traido es pide_archivo con "cerrojo" y ".sis" y 0
    si traido es menor que 0
        devuelve nada
    fin
    buzon es region con (elemento TAREA_DISCO de buzones) y TOPE_BUZON
    bien es traido es TOPE_CERROJO
    i es 1
    para cada letra en MARCA_CERROJO
        si bien y (elemento i de buzon) no es igual a letra
            bien es falso
        fin
        i es i mas 1
    fin
    al_serie con "cerrojo.sis leido: "
    escribe traido
    si no bien o memoria_cerrojo es 0
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "  No entiendo cerrojo.sis, así que arranco sin contraseña."
        pinta_linea con "  Si no lo has tocado tú, alguien ha estado en el disco."
        pon_color con GRIS y NEGRO
        pinta_linea con ""
        devuelve nada
    fin
    copia_region con cerrojo y 1 y buzon y 1 y TOPE_CERROJO
    hay_cerrojo es verdadero
    desactiva_interrupciones
    bloquea_ya con AL_ARRANCAR
    activa_interrupciones
fin

funcion barra
    pon_color con BLANCO y AZUL
    ve_a con 1 y 1
    para cada c desde 1 hasta ANCHO
        pinta con " "
    fin
    ve_a con 1 y 3
    pinta con "FalOS"
    ve_a con 1 y 74
    pinta con "día 13"
    pon_color con GRIS y NEGRO
fin

funcion portada
    pon_color con GRIS y NEGRO
    limpia
    barra
    ve_a con 3 y 3
    pon_color con BLANCO y NEGRO
    pinta_linea con "Hola. Soy FalOS, un sistema operativo escrito en Fal."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    si hay_graficos
        pinta_linea con "  Arranqué en modo de 64 bits. La letra que lees la he dibujado yo,"
        pinta_linea con "  píxel a píxel, y la pinta un programa sin permisos."
    si no
        pinta_linea con "  Arranqué en modo de 64 bits. Esta tarjeta no me deja pintar píxeles,"
        pinta_linea con "  así que esto va en modo de texto, casilla a casilla."
    fin
    pinta_linea con ""
    pinta_linea con "  Hago varias cosas a la vez. Los programas salen del disco y nacen sin"
    pinta_linea con "  permisos, solo hablan entre ellos si tú les dejas, y si intentan algo"
    pinta_linea con "  más, los cierro. El teclado, el disco y la pantalla ya no van dentro"
    pinta_linea con "  de mí: son programas, y si se cuelgan, lanzo otros."
    pinta_linea con ""
    pinta_linea con "  Cada programa sale en su ventana, y el borde lo pinto yo, del color"
    pinta_linea con "  de su caja. Él no puede tocarlo. Y lo que escribes solo le llega"
    pinta_linea con "  al programa al que tú le das el teclado."
    pinta_linea con ""
    pinta_linea con "  Hay un juego en el disco (lanza serpiente) y un bloc de notas"
    pinta_linea con "  (lanza notas) que guarda lo que escribes cifrado con tu clave."
    pinta_linea con "  Y registro te dice qué programa ha tocado tus cosas, y cuándo."
    pinta_linea con "  Con cerrojo, la pantalla pide contraseña para entrar."
    pinta_linea con "  Lo que copias con Ctrl+C no lo puede leer ningún programa."
    pon_color con AMARILLO y NEGRO
    pinta_linea con "  Escribe ayuda para ver lo que sé hacer."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

escribe "FalOS arrancado"
portada
compone
si hay_graficos
    lanza_controlador con TAREA_PANTALLA
fin
lanza_controlador con TAREA_TECLADO
lanza_controlador con TAREA_DISCO
prepara_raton
si hay_raton
    escribe "ratón listo"
fin
mira_el_reloj
prepara_interrupciones
lee_siempre
lee_cerrojo
indicador
escribe "pantalla lista"

mientras verdadero
    atiende con siguiente_tecla
fin
