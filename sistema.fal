VERSION_MAXIMA es 45253

funcion lee_pci con ranura y registro
    pon_doble con PCI_DIRECCION y PCI_ACTIVO mas ranura por 2048 mas registro
    devuelve lee_doble de PCI_DATOS
fin

funcion busca_graficos
    comparte hay_graficos y memoria_de_video y lo_que_se_ve
    pon_palabra con GRAFICOS_INDICE y 0
    version es lee_palabra de GRAFICOS_DATOS
    si version es menor que VERSION_MINIMA o version es mayor que VERSION_MAXIMA
        devuelve nada
    fin
    para cada ranura desde 0 hasta 31
        si (lee_pci con ranura y 0) es TARJETA_QEMU
            base es lee_pci con ranura y BAR_0
            memoria_de_video es base menos base resto 16
            si (base resto 8) es 0 y memoria_de_video es mayor que 0 y (memoria_de_video resto DOS_MEGAS) es 0
                hay_graficos es verdadero
                lo_que_se_ve es region con rejilla y ANCHO por ALTO y 2
            fin
            devuelve nada
        fin
    fin
fin

busca_graficos

funcion sin_parpadeo
    basura es lee_puerto de 986
    pon_en_puerto con 960 y 48
    ajustes es lee_puerto de 961
    si ((cociente con ajustes y 8) resto 2) es 1
        ajustes es ajustes menos 8
    fin
    pon_en_puerto con 960 y ajustes
fin

si no hay_graficos
    sin_parpadeo
fin

