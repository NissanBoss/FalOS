funcion pon_color con letra y fondo
    comparte color
    color es fondo por 16 mas letra
fin

funcion ve_a con f y c
    comparte fila y columna
    fila es f
    columna es c
    mueve_cursor
fin

funcion limpia
    para cada i desde 1 hasta ANCHO por ABAJO
        elemento i de pantalla es color por 256 mas 32
    fin
    olvida_seleccion_de con CONSOLA
    ve_a con 1 y 1
fin

funcion mueve_cursor
    comparte cursor_sitio
    cursor_sitio es (fila menos 1) por ANCHO mas columna menos 1
    ensucia
fin

funcion ensucia
    comparte pantalla_sucia
    pantalla_sucia es verdadero
fin

funcion pon_letra con codigo
    comparte columna
    si codigo es 10
        baja
    si no
        elemento (fila menos 1) por ANCHO mas columna de pantalla es color por 256 mas codigo
        columna es columna mas 1
        si columna es mayor que ANCHO
            baja
        fin
    fin
fin

funcion baja
    comparte fila y columna
    columna es 1
    fila es fila mas 1
    si fila es mayor que ABAJO
        sube_todo
        fila es ABAJO
    fin
fin

funcion sube_todo
    copia_region con pantalla y ANCHO mas 1 y pantalla y ANCHO por 2 mas 1 y ANCHO por (ABAJO menos 2)
    para cada i desde ANCHO por (ABAJO menos 1) mas 1 hasta ANCHO por ABAJO
        elemento i de pantalla es color por 256 mas 32
    fin
    olvida_seleccion_de con CONSOLA
    elemento SUBIDAS de control es (elemento SUBIDAS de control) mas 1
fin

funcion pon_byte con b
    comparte a_medias
    si a_medias no es igual a 0
        pon_letra con (en_437 con a_medias y b)
        a_medias es 0
    si no si b es mayor o igual que 192
        a_medias es b
    si no si b es menor que 128
        pon_letra con b
    fin
fin

funcion en_437 con primero y segundo
    si primero es 195
        si segundo es 161
            devuelve 160
        si no si segundo es 169
            devuelve 130
        si no si segundo es 173
            devuelve 161
        si no si segundo es 179
            devuelve 162
        si no si segundo es 186
            devuelve 163
        si no si segundo es 177
            devuelve 164
        si no si segundo es 145
            devuelve 165
        si no si segundo es 188
            devuelve 129
        si no si segundo es 156
            devuelve 154
        si no si segundo es 137
            devuelve 144
        si no si segundo es 167
            devuelve 135
        si no si segundo es 135
            devuelve 128
        si no si segundo es 129
            devuelve mayuscula_con_tilde con 65 y 181
        si no si segundo es 141
            devuelve mayuscula_con_tilde con 73 y 214
        si no si segundo es 147
            devuelve mayuscula_con_tilde con 79 y 224
        si no si segundo es 154
            devuelve mayuscula_con_tilde con 85 y 233
        fin
    si no si primero es 194
        si segundo es 191
            devuelve 168
        si no si segundo es 161
            devuelve 173
        si no si segundo es 186
            devuelve 167
        si no si segundo es 170
            devuelve 166
        si no si segundo es 171
            devuelve 174
        si no si segundo es 187
            devuelve 175
        fin
    fin
    devuelve 63
fin

funcion mayuscula_con_tilde con en_texto y en_mi_letra
    si hay_graficos
        devuelve en_mi_letra
    fin
    devuelve en_texto
fin

funcion pinta con t
    para cada b en t
        pon_byte con b
    fin
    mueve_cursor
fin

funcion pinta_linea con t
    pinta con t
    pinta con "\n"
fin

funcion pinta_numero con n
    si n es menor que 0
        pinta con "-"
        cifras con n
    si no
        cifras con 0 menos n
    fin
    mueve_cursor
fin

funcion cifras con n
    si n es menor que menos 9
        cifras con (cociente con n y 10)
    fin
    pon_letra con 48 menos (n resto 10)
fin

funcion pinta_dos con n
    si n es menor que 10
        pinta con "0"
    fin
    pinta_numero con n
fin

funcion hasta_columna con n
    mientras columna es menor que n
        pon_letra con 32
    fin
fin

PAGINA es 4096
MEGA es 1048576
VISIBLE es 805306368
RESERVADA es 0
LIBRE es 1
MIA es 2
PRESTADA es 3

estados es nada
total_paginas es 0
ram es 0
pista es 1

funcion reparte_memoria
    comparte estados y total_paginas y ram
    si datos_de_arranque es 0
        falla "El cargador no me ha dicho cuánta memoria hay."
    fin
    info es region con datos_de_arranque y 13 y 4
    si ((elemento 1 de info) resto 128) es menor que 64
        falla "El cargador no me ha dado el mapa de la memoria."
    fin
    tope es 0
    mapa es elemento 13 de info
    fin_mapa es mapa mas elemento 12 de info
    mientras mapa es menor que fin_mapa
        entrada es region con mapa y 6 y 4
        si (elemento 6 de entrada) es 1
            cuanto es (elemento 4 de entrada) mas (elemento 5 de entrada) por 4294967296
            ram es ram mas cuanto
            hasta es (elemento 2 de entrada) mas (elemento 3 de entrada) por 4294967296 mas cuanto
            si hasta es mayor que tope
                tope es hasta
            fin
        fin
        mapa es mapa mas 4 mas elemento 1 de entrada
    fin
    si tope es mayor que VISIBLE
        tope es VISIBLE
    fin
    total_paginas es cociente con tope y PAGINA
    estados es region con final_del_nucleo y total_paginas
    para cada p desde 1 hasta total_paginas
        elemento p de estados es RESERVADA
    fin
    mapa es elemento 13 de info
    mientras mapa es menor que fin_mapa
        entrada es region con mapa y 6 y 4
        desde es (elemento 2 de entrada) mas (elemento 3 de entrada) por 4294967296
        hasta es desde mas (elemento 4 de entrada) mas (elemento 5 de entrada) por 4294967296
        si hasta es mayor que tope
            hasta es tope
        fin
        primera es (cociente con (desde mas PAGINA menos 1) y PAGINA) mas 1
        ultima es cociente con hasta y PAGINA
        si (elemento 6 de entrada) es 1 y primera es menor o igual que ultima
            para cada p desde primera hasta ultima
                elemento p de estados es LIBRE
            fin
        fin
        mapa es mapa mas 4 mas elemento 1 de entrada
    fin
    para cada p desde 1 hasta (cociente con MEGA y PAGINA)
        elemento p de estados es RESERVADA
    fin
    hasta_aqui es cociente con (final_del_nucleo mas total_paginas mas PAGINA menos 1) y PAGINA
    para cada p desde (cociente con MEGA y PAGINA) mas 1 hasta hasta_aqui
        elemento p de estados es MIA
    fin
fin

funcion pide_pagina
    comparte pista
    p es pista
    vistas es 0
    mientras vistas es menor que total_paginas
        si (elemento p de estados) es LIBRE
            elemento p de estados es PRESTADA
            pista es p
            direccion es (p menos 1) por PAGINA
            hoja es region con direccion y 512 y 8
            para cada i desde 1 hasta 512
                elemento i de hoja es 0
            fin
            devuelve direccion
        fin
        p es (p resto total_paginas) mas 1
        vistas es vistas mas 1
    fin
    falla "Me he quedado sin memoria."
fin

funcion pide_dos_megas
    seguidas es cociente con DOS_MEGAS y PAGINA
    primera es seguidas mas 1
    mientras primera mas seguidas menos 1 es menor o igual que total_paginas
        libres es verdadero
        i es 0
        mientras libres y i es menor que seguidas
            si (elemento primera mas i de estados) no es igual a LIBRE
                libres es falso
            fin
            i es i mas 1
        fin
        si libres
            i es 0
            mientras i es menor que seguidas
                elemento primera mas i de estados es PRESTADA
                i es i mas 1
            fin
            direccion es (primera menos 1) por PAGINA
            todo es region con direccion y (cociente con DOS_MEGAS y 8) y 8
            i es 1
            mientras i es menor o igual que largo de todo
                elemento i de todo es 0
                i es i mas 1
            fin
            devuelve direccion
        fin
        primera es primera mas seguidas
    fin
    devuelve 0
fin

funcion suelta_dos_megas con direccion
    si direccion es 0
        devuelve nada
    fin
    i es 0
    mientras i es menor que cociente con DOS_MEGAS y PAGINA
        suelta_pagina con direccion mas i por PAGINA
        i es i mas 1
    fin
fin

funcion suelta_pagina con direccion
    p es (cociente con direccion y PAGINA) mas 1
    si (direccion resto PAGINA) no es igual a 0 o direccion es menor que 0 o p es mayor que total_paginas
        falla "Eso no es el principio de una página."
    fin
    si (elemento p de estados) no es igual a PRESTADA
        falla "Esa página no estaba prestada. Devolver dos veces la misma es un fallo, y lo paro aquí."
    fin
    hoja es region con direccion y 512 y 8
    para cada i desde 1 hasta 512
        elemento i de hoja es 0
    fin
    elemento p de estados es LIBRE
fin

PRESENTE es 1
ESCRIBIBLE es 2
GRANDE es 128
NO_EJECUTABLE es 0 menos 9223372036854775807 menos 1
DOS_MEGAS es 2097152

prohibe_ejecutar es 0
raiz_nucleo es 0
directorio_nucleo es 0

funcion permisos_de con direccion
    si direccion es 0
        devuelve 0
    fin
    si direccion es mayor o igual que inicio_del_codigo y direccion es menor que final_del_codigo
        devuelve PRESENTE
    fin
    devuelve PRESENTE mas ESCRIBIBLE mas prohibe_ejecutar
fin

funcion protege_memoria
    comparte prohibe_ejecutar y raiz_nucleo y directorio_nucleo
    si hay_no_ejecutar
        prohibe_ejecutar es NO_EJECUTABLE
    fin
    raiz es pide_pagina
    nivel_3 es pide_pagina
    nivel_2 es pide_pagina
    arriba es region con raiz y 512 y 8
    medio es region con nivel_3 y 512 y 8
    directorio es region con nivel_2 y 512 y 8
    raiz_nucleo es raiz
    directorio_nucleo es nivel_2
    elemento 1 de arriba es nivel_3 mas PRESENTE mas ESCRIBIBLE
    elemento 1 de medio es nivel_2 mas PRESENTE mas ESCRIBIBLE
    con_detalle es cociente con (final_del_codigo mas DOS_MEGAS menos 1) y DOS_MEGAS
    para cada t desde 1 hasta 512
        desde es (t menos 1) por DOS_MEGAS
        si t es menor o igual que con_detalle
            tabla es pide_pagina
            paginas es region con tabla y 512 y 8
            para cada i desde 1 hasta 512
                direccion es desde mas (i menos 1) por PAGINA
                elemento i de paginas es direccion mas (permisos_de con direccion)
            fin
            elemento t de directorio es tabla mas PRESENTE mas ESCRIBIBLE
        si no
            elemento t de directorio es desde mas PRESENTE mas ESCRIBIBLE mas GRANDE mas prohibe_ejecutar
        fin
    fin
    usa_tablas con raiz
fin

reparte_memoria
protege_memoria

