funcion por_ventana con hueco y fisica
    entradas es region con directorio_nucleo y 512 y 8
    principio es fisica menos fisica resto DOS_MEGAS
    elemento hueco de entradas es principio mas PRESENTE mas ESCRIBIBLE mas GRANDE mas SIN_CACHE mas prohibe_ejecutar
    elemento hueco mas 1 de entradas es principio mas DOS_MEGAS mas PRESENTE mas ESCRIBIBLE mas GRANDE mas SIN_CACHE mas prohibe_ejecutar
    usa_tablas con raiz_nucleo
    devuelve (hueco menos 1) por DOS_MEGAS mas fisica resto DOS_MEGAS
fin

funcion mira_acpi con fisica
    si fisica mas DOS_MEGAS es menor o igual que VISIBLE
        devuelve fisica
    fin
    devuelve por_ventana con HUECO_ACPI y fisica
fin

funcion numero_en con zona y sitio y bytes
    n es 0
    i es bytes
    mientras i es mayor que 0
        n es n por 256 mas elemento sitio mas i menos 1 de zona
        i es i menos 1
    fin
    devuelve n
fin

funcion firma_en con zona y sitio y firma
    para cada i desde 1 hasta largo de firma
        si (elemento sitio mas i menos 1 de zona) no es igual a (elemento i de firma)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion busca_rsdp_en con inicio y bytes
    zona es region con (mira_acpi con inicio) y bytes
    sitio es 1
    mientras sitio mas 19 es menor o igual que bytes
        si firma_en con zona y sitio y "RSD PTR "
            suma es 0
            para cada i desde 0 hasta 19
                suma es suma mas elemento sitio mas i de zona
            fin
            si (suma resto 256) es 0
                devuelve inicio mas sitio menos 1
            fin
        fin
        sitio es sitio mas 16
    fin
    devuelve 0
fin

funcion busca_rsdp
    sitio es busca_rsdp_en con 524288 y 131072
    si sitio no es igual a 0
        devuelve sitio
    fin
    sitio es busca_rsdp_en con 917504 y 131072
    si sitio no es igual a 0
        devuelve sitio
    fin
    devuelve busca_rsdp_en_el_mapa
fin

funcion busca_rsdp_en_el_mapa
    info es region con datos_de_arranque y 13 y 4
    mapa es elemento 13 de info
    fin_mapa es mapa mas elemento 12 de info
    mientras mapa es menor que fin_mapa
        entrada es region con mapa y 6 y 4
        clase es elemento 6 de entrada
        trozo es (elemento 2 de entrada) mas (elemento 3 de entrada) por 4294967296
        queda es (elemento 4 de entrada) mas (elemento 5 de entrada) por 4294967296
        si (clase es 3 o clase es 4) y trozo es mayor o igual que MEGA y queda es menor o igual que TOPE_ACPI
            mientras queda es mayor o igual que 36
                cuanto es queda
                si cuanto es mayor que MEGA
                    cuanto es MEGA
                fin
                sitio es busca_rsdp_en con trozo y cuanto
                si sitio no es igual a 0
                    devuelve sitio
                fin
                trozo es trozo mas cuanto
                queda es queda menos cuanto
            fin
        fin
        mapa es mapa mas 4 mas elemento 1 de entrada
    fin
    devuelve 0
fin

funcion busca_tabla_acpi con rsdp y firma
    puntero es region con (mira_acpi con rsdp) y 36
    raiz es numero_en con puntero y 17 y 4
    salto es 4
    si (elemento 16 de puntero) es mayor o igual que 2
        extendida es numero_en con puntero y 25 y 8
        si extendida no es igual a 0
            raiz es extendida
            salto es 8
        fin
    fin
    cabeza es region con (mira_acpi con raiz) y 36
    total es numero_en con cabeza y 5 y 4
    si total es menor que 36 o total es mayor que DOS_MEGAS
        devuelve 0
    fin
    cuantas es cociente con (total menos 36) y salto
    i es 0
    mientras i es menor que cuantas
        i es i mas 1
        indice es region con (mira_acpi con raiz) y total
        donde es numero_en con indice y 37 mas (i menos 1) por salto y salto
        si donde no es igual a 0
            cabeza es region con (mira_acpi con donde) y 8
            si firma_en con cabeza y 1 y firma
                devuelve donde
            fin
        fin
    fin
    devuelve 0
fin

funcion lee_pci_en con bus y ranura y parte y registro
    pon_doble con PCI_DIRECCION y PCI_ACTIVO mas bus por 65536 mas ranura por 2048 mas parte por 256 mas registro
    devuelve lee_doble de PCI_DATOS
fin

funcion apunta_rmrr con t y sitio y cuanto
    comparte rmrr_cuantos y rmrr_raros
    primero es numero_en con t y sitio mas 8 y 8
    ultimo es numero_en con t y sitio mas 16 y 8
    lista es region con rmrr_en y MAX_RMRR por 5 y 8
    s es sitio mas 24
    mientras s mas 5 es menor o igual que sitio mas cuanto menos 1
        alcance es elemento s mas 1 de t
        si alcance es menor que 8
            rmrr_raros es rmrr_raros mas 1
            devuelve nada
        fin
        bus es elemento s mas 5 de t
        pasos es cociente con (alcance menos 6) y 2
        p es 1
        mientras p es menor que pasos
            puente es lee_pci_en con bus y (elemento s mas 4 mas p por 2 de t) y (elemento s mas 5 mas p por 2 de t) y 24
            bus es (cociente con puente y 256) resto 256
            p es p mas 1
        fin
        si (elemento s de t) es 1 y rmrr_cuantos es menor que MAX_RMRR y ultimo menos primero es menor que 64 por MEGA
            k es rmrr_cuantos por 5
            elemento k mas 1 de lista es bus
            elemento k mas 2 de lista es elemento s mas 4 mas pasos por 2 de t
            elemento k mas 3 de lista es elemento s mas 5 mas pasos por 2 de t
            elemento k mas 4 de lista es primero
            elemento k mas 5 de lista es ultimo
            rmrr_cuantos es rmrr_cuantos mas 1
        si no
            rmrr_raros es rmrr_raros mas 1
        fin
        s es s mas alcance
    fin
fin

funcion es_la_grafica con t y sitio y cuanto
    si cuanto no es igual a 24
        devuelve falso
    fin
    devuelve (elemento sitio mas 16 de t) es 1 y (elemento sitio mas 21 de t) es 0 y (elemento sitio mas 22 de t) es 2 y (elemento sitio mas 23 de t) es 0
fin

funcion lee_dmar con rsdp
    comparte fisica_iommu y unidades_sin_tocar y unidad_grafica y unidad_mide
    dmar es busca_tabla_acpi con rsdp y "DMAR"
    si dmar es 0
        devuelve falso
    fin
    cabeza es region con (mira_acpi con dmar) y 8
    total es numero_en con cabeza y 5 y 4
    si total es menor que 48 o total es mayor que DOS_MEGAS
        devuelve falso
    fin
    t es region con (mira_acpi con dmar) y total
    sitio es 49
    mientras sitio mas 3 es menor o igual que total
        clase es numero_en con t y sitio y 2
        cuanto es numero_en con t y sitio mas 2 y 2
        si cuanto es menor que 4 o sitio mas cuanto menos 1 es mayor que total
            devuelve fisica_iommu no es igual a 0
        fin
        si clase es 0 y (es_la_grafica con t y sitio y cuanto)
            unidad_grafica es verdadero
        si no si clase es 0 y fisica_iommu es 0
            fisica_iommu es numero_en con t y sitio mas 8 y 8
            si cuanto es menor o igual que PAGINA
                copia_region con (region con unidad_en y cuanto) y 1 y t y sitio y cuanto
                unidad_mide es cuanto
            fin
        si no si clase es 0
            unidades_sin_tocar es unidades_sin_tocar mas 1
        si no si clase es 1
            apunta_rmrr con t y sitio y cuanto
        fin
        sitio es sitio mas cuanto
    fin
    devuelve fisica_iommu no es igual a 0
fin

funcion la_cubre con bus y ranura y parte
    si unidad_mide es 0
        devuelve falso
    fin
    t es region con unidad_en y unidad_mide
    si ((elemento 5 de t) resto 2) es 1
        devuelve unidades_sin_tocar es 0
    fin
    s es 17
    mientras s mas 7 es menor o igual que unidad_mide
        alcance es elemento s mas 1 de t
        si alcance es menor que 8 o s mas alcance menos 1 es mayor que unidad_mide
            devuelve falso
        fin
        si alcance es 8 y (elemento s de t) es 1 y (elemento s mas 5 de t) es bus y (elemento s mas 6 de t) es ranura y (elemento s mas 7 de t) es parte
            devuelve verdadero
        fin
        s es s mas alcance
    fin
    devuelve falso
fin

funcion mapea_para_aparato con arriba y direccion y fisica y permisos
    tabla es arriba
    paso es PAGINA
    para cada n desde 2 hasta niveles_iommu
        paso es paso por 512
    fin
    nivel es niveles_iommu
    mientras nivel es mayor que 1
        entradas es region con tabla y 512 y 8
        cual es ((cociente con direccion y paso) resto 512) mas 1
        si (elemento cual de entradas) es 0
            nueva es pide_pagina
            elemento cual de entradas es nueva mas 3
        fin
        tabla es (elemento cual de entradas) menos 3
        paso es cociente con paso y 512
        nivel es nivel menos 1
    fin
    hojas es region con tabla y 512 y 8
    elemento ((cociente con direccion y PAGINA) resto 512) mas 1 de hojas es fisica mas permisos
fin

funcion dominio_de con bus y ranura y parte
    comparte siguiente_dominio
    raices es region con raiz_iommu y 512 y 8
    si (elemento bus por 2 mas 1 de raices) es 0
        nueva es pide_pagina
        elemento bus por 2 mas 1 de raices es nueva mas 1
    fin
    contextos es region con ((elemento bus por 2 mas 1 de raices) menos 1) y 512 y 8
    k es (ranura por 8 mas parte) por 2
    si (elemento k mas 1 de contextos) no es igual a 0
        devuelve (elemento k mas 1 de contextos) menos 1
    fin
    arriba es pide_pagina
    elemento k mas 2 de contextos es ancho_iommu mas siguiente_dominio por 256
    elemento k mas 1 de contextos es arriba mas 1
    siguiente_dominio es siguiente_dominio mas 1
    devuelve arriba
fin

funcion dominio_limpio con bus y ranura y parte
    viejo es dominio_de con bus y ranura y parte
    raices es region con raiz_iommu y 512 y 8
    contextos es region con ((elemento bus por 2 mas 1 de raices) menos 1) y 512 y 8
    arriba es pide_pagina
    elemento (ranura por 8 mas parte) por 2 mas 1 de contextos es arriba mas 1
    devuelve arriba
fin

funcion sin_bit con valor y bit
    si ((cociente con valor y bit) resto 2) es 1
        devuelve valor menos bit
    fin
    devuelve valor
fin

funcion estado_iommu
    r es region con registros_iommu y 1024 y 4
    estado es elemento 8 de r
    estado es sin_bit con estado y BIT_30
    estado es sin_bit con estado y 536870912
    estado es sin_bit con estado y 134217728
    devuelve sin_bit con estado y 16777216
fin

funcion espera_estado con bit y encendido
    r es region con registros_iommu y 1024 y 4
    para cada vuelta desde 1 hasta VUELTAS_IOMMU
        puesto es ((cociente con (elemento 8 de r) y bit) resto 2) es 1
        si puesto es encendido
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion espera_que_acabe con k
    r es region con registros_iommu y 512 y 8
    para cada vuelta desde 1 hasta VUELTAS_IOMMU
        si (elemento k de r) es mayor o igual que 0
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion a_la_cola con primera y segunda
    comparte cola_pone
    cola es region con cola_iommu y 512 y 8
    elemento cola_pone por 2 mas 1 de cola es primera
    elemento cola_pone por 2 mas 2 de cola es segunda
    cola_pone es (cola_pone mas 1) resto 256
fin

funcion vacia_cola
    aviso_en es cola_iommu mas PAGINA
    hecha es region con aviso_en y 1 y 4
    elemento 1 de hecha es 0
    a_la_cola con 4294967296 mas 37 y aviso_en
    vacia_caches
    r es region con registros_iommu y 512 y 8
    elemento 18 de r es cola_pone por 16
    para cada vuelta desde 1 hasta VUELTAS_IOMMU
        si (elemento 1 de hecha) es 1
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion iommu_olvida
    si con_cola
        a_la_cola con 17 y 0
        a_la_cola con 18 mas con_drenaje y 0
        devuelve vacia_cola
    fin
    vacia_caches
    r es region con registros_iommu y 512 y 8
    elemento 6 de r es ULTIMO_BIT mas 2305843009213693952
    si no (espera_que_acabe con 6)
        devuelve falso
    fin
    elemento iotlb_en de r es ULTIMO_BIT mas 1152921504606846976
    devuelve espera_que_acabe con iotlb_en
fin

funcion apaga_en_iommu con bit
    r es region con registros_iommu y 1024 y 4
    estado es estado_iommu
    si ((cociente con estado y bit) resto 2) es 0
        devuelve verdadero
    fin
    elemento 7 de r es estado menos bit
    devuelve espera_estado con bit y falso
fin

funcion enciende_en_iommu con bit
    r es region con registros_iommu y 1024 y 4
    elemento 7 de r es estado_iommu mas bit
    devuelve espera_estado con bit y verdadero
fin

funcion estrena_cola
    comparte cola_iommu y con_cola
    cola_iommu es pide_dos_paginas
    si cola_iommu es 0
        devuelve falso
    fin
    r es region con registros_iommu y 512 y 8
    elemento 18 de r es 0
    elemento 19 de r es cola_iommu
    vacia_caches
    si no (enciende_en_iommu con BIT_26)
        devuelve falso
    fin
    con_cola es verdadero
    devuelve verdadero
fin

funcion pide_dos_paginas
    una es pide_pagina
    otra es pide_pagina
    si otra es una mas PAGINA
        devuelve una
    fin
    devuelve 0
fin

funcion cierra_interrupciones_ajenas
    comparte interrupciones_cerradas
    si no hay_iommu o no con_cola o no puede_remapear
        devuelve nada
    fin
    r es region con registros_iommu y 512 y 8
    elemento 24 de r es pide_pagina mas 7
    a_la_cola con 4 y 0
    si no (enciende_en_iommu con BIT_24)
        devuelve nada
    fin
    si no vacia_cola
        devuelve nada
    fin
    si no (enciende_en_iommu con BIT_25)
        devuelve nada
    fin
    empezo es tics
    vuelta es 0
    mientras tics es menor que empezo mas 2 y vuelta es menor que VUELTAS_IOMMU
        basura es lee_puerto de 128
        vuelta es vuelta mas 1
    fin
    si tics es menor que empezo mas 2
        apagado es apaga_en_iommu con BIT_25
        devuelve nada
    fin
    interrupciones_cerradas es verdadero
    al_serie con "iommu: ningún aparato puede fingir interrupciones"
    escribe ""
fin

funcion prepara_iommu
    comparte hay_iommu y por_que_no_iommu y registros_iommu y raiz_iommu y niveles_iommu y ancho_iommu y iotlb_en y faltas_en y faltas_cuantas y rmrr_en y unidad_en y puede_remapear y con_drenaje
    si sin_iommu
        por_que_no_iommu es IOMMU_LO_PEDISTE
        devuelve nada
    fin
    rsdp es busca_rsdp
    si rsdp es 0
        por_que_no_iommu es IOMMU_SIN_ACPI
        devuelve nada
    fin
    rmrr_en es pide_pagina
    unidad_en es pide_pagina
    si no (lee_dmar con rsdp)
        por_que_no_iommu es IOMMU_SIN_DMAR
        devuelve nada
    fin
    si rmrr_raros es mayor que 0
        por_que_no_iommu es IOMMU_RMRR_RARO
        devuelve nada
    fin
    registros_iommu es por_ventana con HUECO_IOMMU y fisica_iommu
    r es region con registros_iommu y 1024 y 4
    cap_bajo es elemento 3 de r
    cap_alto es elemento 4 de r
    sagaw es (cociente con cap_bajo y 256) resto 32
    si ((cociente con sagaw y 2) resto 2) es 1
        niveles_iommu es 3
        ancho_iommu es 1
    si no si ((cociente con sagaw y 4) resto 2) es 1
        niveles_iommu es 4
        ancho_iommu es 2
    si no
        por_que_no_iommu es IOMMU_SIN_NIVELES
        devuelve nada
    fin
    faltas_en es ((cociente con cap_bajo y 16777216) mas (cap_alto resto 4) por 256) por 4 mas 1
    faltas_cuantas es ((cociente con cap_alto y 256) resto 256) mas 1
    ecap_bajo es elemento 5 de r
    iotlb_en es ((cociente con ecap_bajo y 256) resto 1024) por 2 mas 2
    puede_remapear es ((cociente con ecap_bajo y 8) resto 2) es 1
    con_drenaje es ((cociente con cap_alto y 4194304) resto 4) por 64
    raiz_iommu es pide_pagina
    lista es region con rmrr_en y MAX_RMRR por 5 y 8
    c es 0
    mientras c es menor que rmrr_cuantos por 5
        arriba es dominio_de con (elemento c mas 1 de lista) y (elemento c mas 2 de lista) y (elemento c mas 3 de lista)
        direccion es (elemento c mas 4 de lista) menos (elemento c mas 4 de lista) resto PAGINA
        mientras direccion es menor o igual que elemento c mas 5 de lista
            mapea_para_aparato con arriba y direccion y direccion y 3
            direccion es direccion mas PAGINA
        fin
        c es c mas 5
    fin
    vacia_caches
    por_que_no_iommu es IOMMU_NO_RESPONDE
    si no (apaga_en_iommu con BIT_31)
        devuelve nada
    fin
    si no (apaga_en_iommu con BIT_25)
        devuelve nada
    fin
    si no (apaga_en_iommu con BIT_26)
        devuelve nada
    fin
    r8 es region con registros_iommu y 512 y 8
    elemento 5 de r8 es raiz_iommu
    si no (enciende_en_iommu con BIT_30)
        devuelve nada
    fin
    si ((cociente con ecap_bajo y 2) resto 2) es 1
        si no estrena_cola
            devuelve nada
        fin
    fin
    si no iommu_olvida
        devuelve nada
    fin
    si no (enciende_en_iommu con BIT_31)
        devuelve nada
    fin
    hay_iommu es verdadero
fin

prepara_iommu

CLASE_XHCI es 787248
CLASE_EHCI es 787232
PAGINAS_USB es 64
TOPE_REGISTROS_USB es 16
CAJA_USB es 857735168
USB_NO_HAY es 0
USB_SIN_IOMMU es 1
USB_SIN_CUBRIR es 2
USB_NO_PARA es 3
USB_RARO es 4
USB_LISTO es 5
USB_SE_CAE es 6

usb_como es USB_NO_HAY
usb_ranura es 0
usb_parte es 0
usb_quien es 0
usb_registros es 0
usb_mide es 0
usb_hojas es region con pide_pagina y 512 y 8

funcion pon_pci_en con ranura y parte y registro y valor
    pon_doble con PCI_DIRECCION y PCI_ACTIVO mas ranura por 2048 mas parte por 256 mas registro
    pon_doble con PCI_DATOS y valor
fin

funcion busca_usb
    comparte usb_ranura y usb_parte y usb_quien
    para cada ranura desde 0 hasta 31
        para cada parte desde 0 hasta 7
            si (lee_pci_en con 0 y ranura y parte y 0) no es igual a 4294967295
                si (cociente con (lee_pci_en con 0 y ranura y parte y 8) y 256) es CLASE_XHCI
                    usb_ranura es ranura
                    usb_parte es parte
                    usb_quien es lee_pci_en con 0 y ranura y parte y 0
                    devuelve verdadero
                fin
            fin
        fin
    fin
    devuelve falso
fin

funcion mando_pci con ranura y parte y encendido
    mando es (lee_pci_en con 0 y ranura y parte y 4) resto 65536
    mando es sin_bit con (sin_bit con (sin_bit con (sin_bit con mando y 1) y 2) y 4) y 1024
    pon_pci_en con ranura y parte y 4 y mando mas 1024 mas encendido
fin

funcion mando_usb con encendido
    mando_pci con usb_ranura y usb_parte y encendido
fin

barra_en es 0
barra_mide es 0

funcion mide_barra con ranura y parte
    comparte barra_en y barra_mide
    leida es lee_pci_en con 0 y ranura y parte y BAR_0
    si (leida resto 2) es 1
        devuelve falso
    fin
    clase es (cociente con leida y 2) resto 4
    barra_alta es 0
    si clase es 2
        barra_alta es lee_pci_en con 0 y ranura y parte y BAR_0 mas 4
    fin
    mando_pci con ranura y parte y 0
    pon_pci_en con ranura y parte y BAR_0 y 4294967295
    cabe es lee_pci_en con 0 y ranura y parte y BAR_0
    pon_pci_en con ranura y parte y BAR_0 y leida
    cabe es 4294967296 menos (cabe menos cabe resto 16)
    barra_en es leida menos leida resto 16 mas barra_alta por 4294967296
    barra_mide es cociente con cabe y PAGINA
    devuelve barra_mide es mayor que 0 y (barra_en resto PAGINA) es 0 y barra_en es mayor que 0 y barra_alta es menor que 1048576
fin

funcion mide_usb
    comparte usb_registros y usb_mide
    si no (mide_barra con usb_ranura y usb_parte)
        devuelve falso
    fin
    usb_registros es barra_en
    usb_mide es barra_mide
    si usb_mide es mayor que TOPE_REGISTROS_USB
        usb_mide es TOPE_REGISTROS_USB
    fin
    devuelve verdadero
fin

funcion puertos_de_intel
    si (usb_quien resto 65536) no es igual a 32902
        devuelve nada
    fin
    para cada ranura desde 0 hasta 31
        para cada parte desde 0 hasta 7
            si (cociente con (lee_pci_en con 0 y ranura y parte y 8) y 256) es CLASE_EHCI
                pon_pci_en con usb_ranura y usb_parte y 216 y (lee_pci_en con 0 y usb_ranura y usb_parte y 220)
                pon_pci_en con usb_ranura y usb_parte y 208 y (lee_pci_en con 0 y usb_ranura y usb_parte y 212)
                devuelve nada
            fin
        fin
    fin
fin

funcion espera_usb con r y sitio y bit y valor
    para cada vuelta desde 1 hasta VUELTAS_IOMMU
        si ((cociente con (elemento sitio de r) y bit) resto 2) es valor
            devuelve verdadero
        fin
        basura es lee_puerto de 128
    fin
    devuelve falso
fin

funcion quita_usb_a_la_bios con r
    e es (cociente con (elemento 5 de r) y 65536) mas 1
    vueltas es 0
    tope es usb_mide por 1024
    mientras e es mayor que 1 y e es menor que tope y vueltas es menor que 64
        extra es elemento e de r
        si (extra resto 256) es 1
            si ((cociente con extra y 16777216) resto 2) es 0
                elemento e de r es extra mas 16777216
            fin
            suelto es espera_usb con r y e y 65536 y 0
            si no suelto
                elemento e de r es 16777217 mas ((cociente con extra y 256) resto 256) por 256
            fin
            ajustes es elemento e mas 1 de r
            quedan es (ajustes resto 16) menos (ajustes resto 2)
            quedan es quedan mas (ajustes resto 8192) menos (ajustes resto 32)
            quedan es quedan mas (ajustes resto 1048576) menos (ajustes resto 131072)
            elemento e mas 1 de r es quedan mas 3758096384
        fin
        salto es (cociente con extra y 256) resto 256
        si salto es 0
            devuelve nada
        fin
        e es e mas salto
        vueltas es vueltas mas 1
    fin
fin

funcion calla_usb
    r es region con (por_ventana con HUECO_APARATO y usb_registros) y usb_mide por 1024 y 4
    mando_usb con 2
    quita_usb_a_la_bios con r
    puertos_de_intel
    op es cociente con ((elemento 1 de r) resto 256) y 4
    elemento op mas 1 de r es 0
    si no (espera_usb con r y op mas 2 y 1 y 1)
        devuelve falso
    fin
    elemento op mas 1 de r es 2
    si no (espera_usb con r y op mas 1 y 2 y 0)
        devuelve falso
    fin
    devuelve espera_usb con r y op mas 2 y 2048 y 0
fin

funcion prepara_usb
    comparte usb_como
    si no busca_usb
        devuelve nada
    fin
    si no hay_iommu
        usb_como es USB_SIN_IOMMU
        devuelve nada
    fin
    si no (la_cubre con 0 y usb_ranura y usb_parte)
        usb_como es USB_SIN_CUBRIR
        devuelve nada
    fin
    si no mide_usb
        usb_como es USB_RARO
        devuelve nada
    fin
    usb_como es USB_NO_PARA
    si no calla_usb
        mando_usb con 0
        devuelve nada
    fin
    mando_usb con 0
    arriba es dominio_limpio con 0 y usb_ranura y usb_parte
    para cada k desde 1 hasta PAGINAS_USB
        hoja es pide_pagina
        elemento k de usb_hojas es hoja
        mapea_para_aparato con arriba y CAJA_USB mas (TOPE_REGISTROS_USB mas k menos 1) por PAGINA y hoja y 3
    fin
    si iommu_olvida
        usb_como es USB_LISTO
    fin
fin

