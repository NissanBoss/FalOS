NEGRO es 0
AZUL es 1
VERDE es 2
CIAN es 3
ROJO es 4
MAGENTA es 5
MARRON es 6
GRIS es 7
GRIS_OSCURO es 8
AZUL_CLARO es 9
VERDE_CLARO es 10
CIAN_CLARO es 11
ROJO_CLARO es 12
MAGENTA_CLARO es 13
AMARILLO es 14
BLANCO es 15

ANCHO es 80
ALTO es 25
pantalla es region con 753664 y ANCHO por ALTO y 2

fila es 1
columna es 1
color es GRIS

a_medias es 0

funcion pon_color con letra y fondo
    comparte color
    color es fondo por 16 mas letra
fin

funcion ve_a con f y c
    comparte fila y columna
    fila es f
    columna es c
    mueve_cursor
fin

funcion limpia
    para cada i desde 1 hasta ANCHO por ALTO
        elemento i de pantalla es color por 256 mas 32
    fin
    ve_a con 1 y 1
fin

funcion mueve_cursor
    sitio es (fila menos 1) por ANCHO mas columna menos 1
    pon_en_puerto con 980 y 15
    pon_en_puerto con 981 y (sitio resto 256)
    pon_en_puerto con 980 y 14
    pon_en_puerto con 981 y (cociente con sitio y 256)
fin

funcion pon_letra con codigo
    comparte columna
    si codigo es 10
        baja
    si no
        elemento (fila menos 1) por ANCHO mas columna de pantalla es color por 256 mas codigo
        columna es columna mas 1
        si columna es mayor que ANCHO
            baja
        fin
    fin
fin

funcion baja
    comparte fila y columna
    columna es 1
    fila es fila mas 1
    si fila es mayor que ALTO
        sube_todo
        fila es ALTO
    fin
fin

funcion sube_todo
    para cada i desde 1 hasta ANCHO por (ALTO menos 1)
        elemento i de pantalla es elemento i mas ANCHO de pantalla
    fin
    para cada i desde ANCHO por (ALTO menos 1) mas 1 hasta ANCHO por ALTO
        elemento i de pantalla es color por 256 mas 32
    fin
fin

funcion pon_byte con b
    comparte a_medias
    si a_medias no es igual a 0
        pon_letra con (en_437 con a_medias y b)
        a_medias es 0
    si no si b es mayor o igual que 192
        a_medias es b
    si no si b es menor que 128
        pon_letra con b
    fin
fin

funcion en_437 con primero y segundo
    si primero es 195
        si segundo es 161
            devuelve 160
        si no si segundo es 169
            devuelve 130
        si no si segundo es 173
            devuelve 161
        si no si segundo es 179
            devuelve 162
        si no si segundo es 186
            devuelve 163
        si no si segundo es 177
            devuelve 164
        si no si segundo es 145
            devuelve 165
        si no si segundo es 188
            devuelve 129
        si no si segundo es 156
            devuelve 154
        si no si segundo es 137
            devuelve 144
        si no si segundo es 129
            devuelve 65
        si no si segundo es 141
            devuelve 73
        si no si segundo es 147
            devuelve 79
        si no si segundo es 154
            devuelve 85
        fin
    si no si primero es 194
        si segundo es 191
            devuelve 168
        si no si segundo es 161
            devuelve 173
        si no si segundo es 186
            devuelve 167
        si no si segundo es 170
            devuelve 166
        si no si segundo es 171
            devuelve 174
        si no si segundo es 187
            devuelve 175
        fin
    fin
    devuelve 63
fin

funcion pinta con t
    para cada b en t
        pon_byte con b
    fin
    mueve_cursor
fin

funcion pinta_linea con t
    pinta con t
    pinta con "\n"
fin

funcion pinta_numero con n
    si n es menor que 0
        pinta con "-"
        cifras con n
    si no
        cifras con 0 menos n
    fin
    mueve_cursor
fin

funcion cifras con n
    si n es menor que menos 9
        cifras con (cociente con n y 10)
    fin
    pon_letra con 48 menos (n resto 10)
fin

funcion pinta_dos con n
    si n es menor que 10
        pinta con "0"
    fin
    pinta_numero con n
fin

funcion hasta_columna con n
    mientras columna es menor que n
        pon_letra con 32
    fin
fin

TECLAS es "~~1234567890'~~~qwertyuiop~+~~asdfghjkl~~~~~zxcvbnm,.-~*~ "
TECLAS_MAYUS es "~~!\"~$%&/()=?~~~QWERTYUIOP~*~~ASDFGHJKL~~~~~ZXCVBNM;:_~*~ "

mayus es falso
bloq_mayus es falso
tilde es 0
altgr es falso
prefijo es falso

PAGINA es 4096
MEGA es 1048576
VISIBLE es 1073741824
RESERVADA es 0
LIBRE es 1
MIA es 2
PRESTADA es 3

estados es nada
total_paginas es 0
ram es 0
pista es 1

funcion reparte_memoria
    comparte estados y total_paginas y ram
    si datos_de_arranque es 0
        falla "El cargador no me ha dicho cuánta memoria hay."
    fin
    info es region con datos_de_arranque y 13 y 4
    si ((elemento 1 de info) resto 128) es menor que 64
        falla "El cargador no me ha dado el mapa de la memoria."
    fin
    tope es 0
    mapa es elemento 13 de info
    fin_mapa es mapa mas elemento 12 de info
    mientras mapa es menor que fin_mapa
        entrada es region con mapa y 6 y 4
        si (elemento 6 de entrada) es 1
            cuanto es (elemento 4 de entrada) mas (elemento 5 de entrada) por 4294967296
            ram es ram mas cuanto
            hasta es (elemento 2 de entrada) mas (elemento 3 de entrada) por 4294967296 mas cuanto
            si hasta es mayor que tope
                tope es hasta
            fin
        fin
        mapa es mapa mas 4 mas elemento 1 de entrada
    fin
    si tope es mayor que VISIBLE
        tope es VISIBLE
    fin
    total_paginas es cociente con tope y PAGINA
    estados es region con final_del_nucleo y total_paginas
    para cada p desde 1 hasta total_paginas
        elemento p de estados es RESERVADA
    fin
    mapa es elemento 13 de info
    mientras mapa es menor que fin_mapa
        entrada es region con mapa y 6 y 4
        desde es (elemento 2 de entrada) mas (elemento 3 de entrada) por 4294967296
        hasta es desde mas (elemento 4 de entrada) mas (elemento 5 de entrada) por 4294967296
        si hasta es mayor que tope
            hasta es tope
        fin
        primera es (cociente con (desde mas PAGINA menos 1) y PAGINA) mas 1
        ultima es cociente con hasta y PAGINA
        si (elemento 6 de entrada) es 1 y primera es menor o igual que ultima
            para cada p desde primera hasta ultima
                elemento p de estados es LIBRE
            fin
        fin
        mapa es mapa mas 4 mas elemento 1 de entrada
    fin
    para cada p desde 1 hasta (cociente con MEGA y PAGINA)
        elemento p de estados es RESERVADA
    fin
    hasta_aqui es cociente con (final_del_nucleo mas total_paginas mas PAGINA menos 1) y PAGINA
    para cada p desde (cociente con MEGA y PAGINA) mas 1 hasta hasta_aqui
        elemento p de estados es MIA
    fin
fin

funcion pide_pagina
    comparte pista
    p es pista
    vistas es 0
    mientras vistas es menor que total_paginas
        si (elemento p de estados) es LIBRE
            elemento p de estados es PRESTADA
            pista es p
            direccion es (p menos 1) por PAGINA
            hoja es region con direccion y 512 y 8
            para cada i desde 1 hasta 512
                elemento i de hoja es 0
            fin
            devuelve direccion
        fin
        p es (p resto total_paginas) mas 1
        vistas es vistas mas 1
    fin
    falla "Me he quedado sin memoria."
fin

funcion suelta_pagina con direccion
    p es (cociente con direccion y PAGINA) mas 1
    si (direccion resto PAGINA) no es igual a 0 o direccion es menor que 0 o p es mayor que total_paginas
        falla "Eso no es el principio de una página."
    fin
    si (elemento p de estados) no es igual a PRESTADA
        falla "Esa página no estaba prestada. Devolver dos veces la misma es un fallo, y lo paro aquí."
    fin
    elemento p de estados es LIBRE
fin

reparte_memoria

LARGO_ORDEN es 70
INICIO es 3
orden es region con pide_pagina y LARGO_ORDEN
escritas es 0
pos es 0

HISTORIAL es 16
historial es region con pide_pagina y HISTORIAL por 80
guardadas es 0
mirando es 1

CONTROLADOR es 32
CONTROLADOR_DATOS es 33
ESCLAVO es 160
ESCLAVO_DATOS es 161
YA_ESTA es 32
RELOJ es 64
RELOJ_ORDEN es 67
TECLADO es 96
TICS_POR_SEGUNDO es 100
CAPACIDAD es 64

llegadas es region con pide_pagina y CAPACIDAD
entra es 0
sale es 0
tics es 0

funcion al_pulsar
    comparte entra
    codigo es lee_puerto de TECLADO
    siguiente es (entra mas 1) resto CAPACIDAD
    si siguiente no es igual a sale
        elemento entra mas 1 de llegadas es codigo
        entra es siguiente
    fin
    pon_en_puerto con CONTROLADOR y YA_ESTA
fin

funcion al_tic
    comparte tics
    tics es tics mas 1
    pon_en_puerto con CONTROLADOR y YA_ESTA
fin

funcion siguiente_tecla
    comparte sale
    desactiva_interrupciones
    mientras sale es entra
        espera_interrupcion
        desactiva_interrupciones
    fin
    codigo es elemento sale mas 1 de llegadas
    sale es (sale mas 1) resto CAPACIDAD
    activa_interrupciones
    devuelve codigo
fin

funcion prepara_interrupciones
    pon_en_puerto con CONTROLADOR y 17
    pon_en_puerto con ESCLAVO y 17
    pon_en_puerto con CONTROLADOR_DATOS y 32
    pon_en_puerto con ESCLAVO_DATOS y 40
    pon_en_puerto con CONTROLADOR_DATOS y 4
    pon_en_puerto con ESCLAVO_DATOS y 2
    pon_en_puerto con CONTROLADOR_DATOS y 1
    pon_en_puerto con ESCLAVO_DATOS y 1
    pon_en_puerto con CONTROLADOR_DATOS y 252
    pon_en_puerto con ESCLAVO_DATOS y 255
    divisor es cociente con 1193182 y TICS_POR_SEGUNDO
    pon_en_puerto con RELOJ_ORDEN y 54
    pon_en_puerto con RELOJ y (divisor resto 256)
    pon_en_puerto con RELOJ y (cociente con divisor y 256)
    atiende_interrupcion con 32 y al_tic
    atiende_interrupcion con 33 y al_pulsar
    activa_interrupciones
fin

funcion atiende con codigo
    comparte mayus y bloq_mayus y prefijo
    extendida es prefijo
    prefijo es falso
    si codigo es 224
        prefijo es verdadero
    si no si extendida
        atiende_extendida con codigo
    si no si codigo es 42 o codigo es 54
        mayus es verdadero
    si no si codigo es 170 o codigo es 182
        mayus es falso
    si no si codigo es 58
        bloq_mayus es no bloq_mayus
    si no si codigo es 28
        ejecuta
    si no si codigo es 14
        borra
    si no si altgr
        si codigo es menor que 128
            teclea con (con_altgr con codigo)
        fin
    si no si codigo es 40
        pon_tilde
    si no si codigo es menor que 128
        teclea con (letra_de con codigo)
    fin
fin

funcion atiende_extendida con codigo
    comparte altgr
    si codigo es 56
        altgr es verdadero
    si no si codigo es 184
        altgr es falso
    si no si codigo es 28
        ejecuta
    si no si codigo es 53
        teclea con 47
    si no si codigo es 75
        mueve_a con pos menos 1
    si no si codigo es 77
        mueve_a con pos mas 1
    si no si codigo es 71
        mueve_a con 0
    si no si codigo es 79
        mueve_a con escritas
    si no si codigo es 83
        suprime
    si no si codigo es 72 y mirando es mayor que 1
        recupera con mirando menos 1
    si no si codigo es 80 y mirando es menor o igual que guardadas
        recupera con mirando mas 1
    fin
fin

funcion con_altgr con codigo
    si codigo es 2
        devuelve 124
    si no si codigo es 3
        devuelve 64
    si no si codigo es 4
        devuelve 35
    si no si codigo es 5
        devuelve 126
    si no si codigo es 7
        devuelve 170
    si no si codigo es 26
        devuelve 91
    si no si codigo es 27
        devuelve 93
    si no si codigo es 40
        devuelve 123
    si no si codigo es 41
        devuelve 92
    si no si codigo es 43
        devuelve 125
    fin
    devuelve 0
fin

funcion pon_tilde
    comparte tilde
    si mayus
        tilde es 2
    si no
        tilde es 1
    fin
fin

funcion es_letra con c
    devuelve c es mayor o igual que 97 y c es menor o igual que 122
fin

funcion minuscula con c
    si c es mayor o igual que 65 y c es menor o igual que 90
        devuelve c mas 32
    fin
    devuelve c
fin

funcion letra_de con codigo
    grande es mayus no es igual a bloq_mayus
    si codigo es 13
        si mayus
            devuelve 168
        fin
        devuelve 173
    fin
    si codigo es 39
        si grande
            devuelve 165
        fin
        devuelve 164
    fin
    si codigo es 43
        si grande
            devuelve 128
        fin
        devuelve 135
    fin
    si codigo es 41
        si mayus
            devuelve 166
        fin
        devuelve 167
    fin
    si codigo es 4 y mayus
        devuelve 250
    fin
    si codigo es mayor que 57
        devuelve 0
    fin
    letra es elemento codigo mas 1 de TECLAS
    si es_letra con letra
        si grande
            devuelve letra menos 32
        fin
        devuelve letra
    fin
    si mayus
        letra es elemento codigo mas 1 de TECLAS_MAYUS
    fin
    si letra es 126
        devuelve 0
    fin
    devuelve letra
fin

funcion con_tilde con c
    si tilde es 1
        si c es 97
            devuelve 160
        si no si c es 101
            devuelve 130
        si no si c es 105
            devuelve 161
        si no si c es 111
            devuelve 162
        si no si c es 117
            devuelve 163
        si no si c es 69
            devuelve 144
        si no si c es 32
            devuelve 39
        fin
    si no si tilde es 2
        si c es 117
            devuelve 129
        si no si c es 85
            devuelve 154
        si no si c es 32
            devuelve 34
        fin
    fin
    devuelve c
fin

funcion teclea con c
    comparte tilde y escritas y pos
    si c no es igual a 0 y escritas es menor que LARGO_ORDEN
        si tilde no es igual a 0
            c es con_tilde con c
            tilde es 0
        fin
        i es escritas
        mientras i es mayor que pos
            elemento i mas 1 de orden es elemento i de orden
            i es i menos 1
        fin
        elemento pos mas 1 de orden es c
        escritas es escritas mas 1
        pos es pos mas 1
        redibuja
    fin
fin

funcion saca_letra con i
    comparte escritas
    mientras i es menor que escritas
        elemento i de orden es elemento i mas 1 de orden
        i es i mas 1
    fin
    escritas es escritas menos 1
fin

funcion borra
    comparte pos
    si pos es mayor que 0
        saca_letra con pos
        pos es pos menos 1
        redibuja
    fin
fin

funcion suprime
    si pos es menor que escritas
        saca_letra con pos mas 1
        redibuja
    fin
fin

funcion mueve_a con donde
    comparte pos y columna
    si donde es mayor o igual que 0 y donde es menor o igual que escritas
        pos es donde
        columna es INICIO mas pos
        mueve_cursor
    fin
fin

funcion redibuja
    comparte columna
    base es (fila menos 1) por ANCHO mas INICIO menos 1
    para cada i desde 1 hasta LARGO_ORDEN mas 1
        letra es 32
        si i es menor o igual que escritas
            letra es elemento i de orden
        fin
        elemento base mas i de pantalla es color por 256 mas letra
    fin
    columna es INICIO mas pos
    mueve_cursor
fin

funcion sitio_en_historial con k
    devuelve (k menos 1) por 80 mas 1
fin

funcion igual_que_la_ultima
    si guardadas es 0
        devuelve falso
    fin
    sitio es sitio_en_historial con guardadas
    si (elemento sitio de historial) no es igual a escritas
        devuelve falso
    fin
    para cada i desde 1 hasta escritas
        si (elemento sitio mas i de historial) no es igual a (elemento i de orden)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion guarda_en_historial
    comparte guardadas y mirando
    si escritas es mayor que 0 y no (igual_que_la_ultima)
        si guardadas es HISTORIAL
            para cada i desde 1 hasta (HISTORIAL menos 1) por 80
                elemento i de historial es elemento i mas 80 de historial
            fin
            guardadas es guardadas menos 1
        fin
        guardadas es guardadas mas 1
        sitio es sitio_en_historial con guardadas
        elemento sitio de historial es escritas
        para cada i desde 1 hasta escritas
            elemento sitio mas i de historial es elemento i de orden
        fin
    fin
    mirando es guardadas mas 1
fin

funcion recupera con k
    comparte escritas y pos y mirando
    mirando es k
    escritas es 0
    si k es menor o igual que guardadas
        sitio es sitio_en_historial con k
        escritas es elemento sitio de historial
        para cada i desde 1 hasta escritas
            elemento i de orden es elemento sitio mas i de historial
        fin
    fin
    pos es escritas
    redibuja
fin

funcion es_orden con nombre
    si largo de nombre no es igual a escritas
        devuelve falso
    fin
    para cada i desde 1 hasta escritas
        si (minuscula con (elemento i de orden)) no es igual a (elemento i de nombre)
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

funcion indicador
    pon_color con CIAN_CLARO y NEGRO
    pinta con "> "
    pon_color con GRIS y NEGRO
fin

funcion ejecuta
    comparte escritas y pos
    pinta_linea con ""
    guarda_en_historial
    si escritas es 0
        escritas es 0
    si no si es_orden con "ayuda"
        ayuda
    si no si es_orden con "limpia"
        limpia
        barra
        ve_a con 3 y 1
    si no si es_orden con "hora"
        hora
    si no si es_orden con "colores"
        colores
    si no si es_orden con "encendido"
        encendido
    si no si es_orden con "memoria"
        memoria
    si no si es_orden con "reinicia"
        reinicia
    si no
        no_conozco
    fin
    escritas es 0
    pos es 0
    indicador
fin

funcion ayuda
    pinta_linea con "  ayuda      lo que estás leyendo"
    pinta_linea con "  limpia     deja la pantalla en blanco"
    pinta_linea con "  hora       la hora del reloj del ordenador, en UTC"
    pinta_linea con "  colores    los 16 colores que tiene la pantalla"
    pinta_linea con "  encendido  cuánto llevo encendido"
    pinta_linea con "  memoria    cuánta memoria tengo y quién la usa"
    pinta_linea con "  reinicia   vuelve a arrancar"
    pinta_linea con ""
    pinta_linea con "  Con las flechas te mueves por lo que escribes, y con las de arriba"
    pinta_linea con "  y abajo vuelves a las órdenes de antes."
    pinta_linea con ""
fin

funcion no_conozco
    pon_color con ROJO_CLARO y NEGRO
    pinta con "  No conozco la orden «"
    para cada i desde 1 hasta escritas
        pon_letra con (elemento i de orden)
    fin
    pinta_linea con "». Escribe ayuda para ver las que sé."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion lee_cmos con registro
    pon_en_puerto con 112 y registro
    devuelve lee_puerto de 113
fin

funcion del_reloj con registro
    v es lee_cmos con registro
    si ((lee_cmos con 11) resto 8) es mayor o igual que 4
        devuelve v
    fin
    devuelve (cociente con v y 16) por 10 mas (v resto 16)
fin

funcion hora
    mientras (lee_cmos con 10) es mayor o igual que 128
    fin
    pinta con "  Son las "
    pon_color con BLANCO y NEGRO
    pinta_dos con (del_reloj con 4)
    pinta con ":"
    pinta_dos con (del_reloj con 2)
    pinta con ":"
    pinta_dos con (del_reloj con 0)
    pon_color con GRIS y NEGRO
    pinta_linea con " en UTC."
    pinta_linea con ""
fin

funcion nombre_color con c
    si c es 0
        devuelve "negro"
    si no si c es 1
        devuelve "azul"
    si no si c es 2
        devuelve "verde"
    si no si c es 3
        devuelve "cian"
    si no si c es 4
        devuelve "rojo"
    si no si c es 5
        devuelve "magenta"
    si no si c es 6
        devuelve "marrón"
    si no si c es 7
        devuelve "gris"
    si no si c es 8
        devuelve "gris oscuro"
    si no si c es 9
        devuelve "azul claro"
    si no si c es 10
        devuelve "verde claro"
    si no si c es 11
        devuelve "cian claro"
    si no si c es 12
        devuelve "rojo claro"
    si no si c es 13
        devuelve "magenta claro"
    si no si c es 14
        devuelve "amarillo"
    fin
    devuelve "blanco"
fin

funcion muestra_color con c
    pon_color con c y NEGRO
    pon_letra con 219
    pon_letra con 219
    pon_letra con 219
    pon_color con GRIS y NEGRO
    pinta con " "
    pinta con (nombre_color con c)
fin

funcion colores
    para cada c desde 0 hasta 7
        pinta con "  "
        muestra_color con c
        hasta_columna con 30
        muestra_color con c mas 8
        pinta_linea con ""
    fin
    pinta_linea con ""
fin

funcion encendido
    segundos es cociente con tics y TICS_POR_SEGUNDO
    minutos es cociente con segundos y 60
    pinta con "  Llevo encendido "
    pon_color con BLANCO y NEGRO
    si minutos es mayor que 0
        pinta_numero con minutos
        pinta con " min "
    fin
    pinta_numero con segundos resto 60
    pinta con " s"
    pon_color con GRIS y NEGRO
    pinta_linea con ", y casi todo ese tiempo, dormido."
    pinta_linea con ""
fin

funcion cuantas_en con estado
    n es 0
    para cada p desde 1 hasta total_paginas
        si (elemento p de estados) es estado
            n es n mas 1
        fin
    fin
    devuelve n
fin

funcion pinta_tamano con paginas
    kb es paginas por 4
    si kb es menor que 10240
        pinta_numero con kb
        pinta con " KB"
    si no
        pinta_numero con (cociente con kb y 1024)
        pinta con " MB"
    fin
fin

funcion trozo_de_barra con c y celdas
    pon_color con c y NEGRO
    repite celdas veces
        pon_letra con 219
    fin
fin

funcion celdas_de con n
    celdas es cociente con n por 60 y total_paginas
    si n es mayor que 0 y celdas es 0
        devuelve 1
    fin
    devuelve celdas
fin

funcion leyenda con c y nombre y paginas
    pinta con "  "
    pon_color con c y NEGRO
    pon_letra con 254
    pon_color con GRIS y NEGRO
    pinta con " "
    pinta con nombre
    hasta_columna con 40
    pon_color con BLANCO y NEGRO
    pinta_tamano con paginas
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion memoria
    reservadas es cuantas_en con RESERVADA
    mias es cuantas_en con MIA
    prestadas es cuantas_en con PRESTADA
    libres es cuantas_en con LIBRE
    pinta con "  Tengo "
    pon_color con BLANCO y NEGRO
    pinta_numero con (cociente con ram mas (cociente con MEGA y 2) y MEGA)
    pinta con " MB"
    pon_color con GRIS y NEGRO
    pinta_linea con " de memoria, en páginas de 4 KB."
    pinta_linea con ""
    pinta con "  "
    trozo_de_barra con GRIS_OSCURO y (celdas_de con reservadas)
    trozo_de_barra con AZUL_CLARO y (celdas_de con mias)
    trozo_de_barra con AMARILLO y (celdas_de con prestadas)
    trozo_de_barra con VERDE y 60 menos (celdas_de con reservadas) menos (celdas_de con mias) menos (celdas_de con prestadas)
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    pinta_linea con ""
    leyenda con GRIS_OSCURO y "de la BIOS y los aparatos" y reservadas
    leyenda con AZUL_CLARO y "yo: código, pila y tablas" y mias
    leyenda con AMARILLO y "prestadas: lo que escribes" y prestadas
    leyenda con VERDE y "libres" y libres
    pinta_linea con ""
    prueba es pide_pagina
    hoja es region con prueba y 512 y 8
    elemento 1 de hoja es 1234
    suelta_pagina con prueba
    otra es pide_pagina
    vista es region con otra y 512 y 8
    en_blanco es (elemento 1 de vista) es 0
    suelta_pagina con otra
    pinta_linea con "  Presto una página, escriben en ella, me la devuelven y se la presto"
    pinta con "  a otro: "
    si otra es prueba y en_blanco
        pon_color con VERDE_CLARO y NEGRO
        pinta_linea con "le llega en blanco."
    si no
        pon_color con ROJO_CLARO y NEGRO
        pinta_linea con "le llega con lo que dejó el primero."
    fin
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

funcion reinicia
    pon_en_puerto con 100 y 254
    congela
fin

funcion barra
    pon_color con BLANCO y AZUL
    ve_a con 1 y 1
    para cada c desde 1 hasta ANCHO
        pinta con " "
    fin
    ve_a con 1 y 3
    pinta con "FalOS"
    ve_a con 1 y 74
    pinta con "día 2"
    pon_color con GRIS y NEGRO
fin

funcion portada
    pon_color con GRIS y NEGRO
    limpia
    barra
    ve_a con 3 y 3
    pon_color con BLANCO y NEGRO
    pinta_linea con "Hola. Soy FalOS, un sistema operativo escrito en Fal."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
    pinta_linea con "  Arranqué en modo de 64 bits, y esto que lees lo he pintado yo,"
    pinta_linea con "  casilla a casilla, en la memoria de la pantalla."
    pinta_linea con ""
    pinta_linea con "  Ya sé leer el teclado español, con su ñ y sus tildes. Y mientras"
    pinta_linea con "  espero, duermo: el teclado me despierta cuando pulsas una tecla."
    pon_color con AMARILLO y NEGRO
    pinta_linea con "  Escribe ayuda para ver lo que sé hacer."
    pon_color con GRIS y NEGRO
    pinta_linea con ""
fin

escribe "FalOS arrancado"
portada
prepara_interrupciones
indicador
escribe "pantalla lista"

mientras verdadero
    atiende con siguiente_tecla
fin
