interrumpe es 0
puertos es 0
ranuras es 0
contexto_mide es 8
orden_pone es 0
orden_ciclo es 1
suceso_lee es 0
suceso_ciclo es 1
orden_hecha es falso
orden_como es 0
orden_ranura es 0
