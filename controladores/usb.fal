funcion pagina_de_aparato con d y cual
    devuelve P_APARATOS mas (d menos 1) por 4 mas cual
fin

funcion de_puerto con p y campo
    devuelve elemento 512 mas (p menos 1) por 4 mas campo de buzon
fin

funcion en_puerto con p y campo y valor
    elemento 512 mas (p menos 1) por 4 mas campo de buzon es valor
fin

Q_ESTADO es 1
Q_QUIEN es 2
Q_APARATO es 3
Q_VISTO es 4

funcion sitio_puerto con p
    devuelve op mas 1024 mas (p menos 1) por 16
fin

funcion espera_registro con sitio y bit y valor
    limite es ahora mas PACIENCIA
    mientras (bits con (mira con sitio) y bit y 2) no es igual a valor
        si ahora es mayor que limite
            devuelve falso
        fin
        llama_al_sistema con CEDE y 0
    fin
    devuelve verdadero
fin

funcion descansa con cuantos
    limite es ahora mas cuantos
    mientras ahora es menor o igual que limite
        mira_sucesos
        llama_al_sistema con CEDE y 0
    fin
fin

funcion para_el_controlador
    manda con op y 0
    si no (espera_registro con op mas 4 y 1 y 1)
        devuelve falso
    fin
    manda con op y 2
    si no (espera_registro con op y 2 y 0)
        devuelve falso
    fin
    devuelve espera_registro con op mas 4 y 2048 y 0
fin

funcion arranca
    comparte op y timbres y interrumpe y puertos y ranuras y contexto_mide
    tope es (elemento 1 de buzon) por PAGINA
    op es (elemento 1 de regs) resto 256
    hechura es mira con 4
    puertos es cociente con hechura y 16777216
    ranuras es hechura resto 256
    si ranuras es mayor que TOPE_RANURAS
        ranuras es TOPE_RANURAS
    fin
    mas_hechura es mira con 8
    borradores es (bits con mas_hechura y 2097152 y 32) por 32 mas cociente con mas_hechura y 134217728
    si (bits con (mira con 16) y 4 y 2) es 1
        contexto_mide es 16
    fin
    timbres es (mira con 20) menos (mira con 20) resto 4
    interrumpe es (mira con 24) menos (mira con 24) resto 32 mas 32
    si puertos es mayor que TOPE_PUERTOS
        puertos es TOPE_PUERTOS
    fin
    si (op resto 4) no es igual a 0 o op mas 1024 mas puertos por 16 es mayor que tope
        devuelve REGISTROS_FUERA
    fin
    si timbres mas 1024 es mayor que tope o interrumpe mas 32 es mayor que tope
        devuelve REGISTROS_FUERA
    fin
    si (mira con op mas 8) resto 2 no es igual a 1
        devuelve PAGINAS_RARAS
    fin
    si borradores es mayor que PAGINAS_DMA menos P_BORRADORES
        devuelve PIDE_DEMASIADO
    fin
    si no para_el_controlador
        devuelve NO_PARA
    fin
    manda con op mas 56 y ranuras
    si borradores es mayor que 0
        pon con P_INDICE y 0 y (sitio_de con P_INDICE) mas 2048
        para cada b desde 1 hasta borradores
            pon con P_INDICE y 512 mas (b menos 1) por 2 y (sitio_de con P_BORRADORES mas b menos 1)
        fin
    fin
    apunta_a con op mas 48 y (sitio_de con P_INDICE)
    pon con P_ORDENES y (TRBS menos 1) por 4 y (sitio_de con P_ORDENES)
    apunta_a con op mas 24 y (sitio_de con P_ORDENES) mas 1
    pon con P_DONDE_SUCESOS y 0 y (sitio_de con P_SUCESOS)
    pon con P_DONDE_SUCESOS y 2 y TRBS
    manda con interrumpe y 0
    manda con interrumpe mas 8 y 1
    apunta_a con interrumpe mas 24 y (sitio_de con P_SUCESOS)
    apunta_a con interrumpe mas 16 y (sitio_de con P_DONDE_SUCESOS)
    manda con op y 1
    si no (espera_registro con op mas 4 y 1 y 0)
        devuelve NO_ARRANCA
    fin
    elemento 3 de buzon es puertos
    devuelve EN_MARCHA
fin

funcion mira_sucesos
    comparte suceso_lee y suceso_ciclo
    vistos es 0
    mientras vistos es menor que TRBS
        base es suceso_lee por 4
        que es ve con P_SUCESOS y base mas 3
        si (que resto 2) no es igual a suceso_ciclo
            devuelve nada
        fin
        direccion es ve con P_SUCESOS y base
        como_fue es ve con P_SUCESOS y base mas 2
        suceso_lee es suceso_lee mas 1
        si suceso_lee es TRBS
            suceso_lee es 0
            suceso_ciclo es 1 menos suceso_ciclo
        fin
        apunta_a con interrumpe mas 24 y (sitio_de con P_SUCESOS) mas suceso_lee por 16 mas 8
        trata_suceso con que y direccion y como_fue
        vistos es vistos mas 1
    fin
fin

funcion trata_suceso con que y direccion y como_fue
    comparte orden_hecha y orden_como y orden_ranura y control_hecho y control_como y pen_hecho y pen_como y pen_sobra
    clase es bits con que y 1024 y 64
    codigo es cociente con como_fue y 16777216
    ranura es cociente con que y 16777216
    punto es bits con que y 65536 y 32
    si clase es S_ORDEN
        orden_hecha es verdadero
        orden_como es codigo
        orden_ranura es ranura
    si no si clase es S_TRANSFERENCIA
        d es aparato_de con ranura
        si d no es igual a 0 y punto es 1 y d es control_de
            control_hecho es verdadero
            control_como es codigo
        si no si d no es igual a 0 y d es pen_d y punto es pen_pide
            pen_hecho es verdadero
            pen_como es codigo
            pen_sobra es como_fue resto 16777216
        si no si d no es igual a 0 y punto no es igual a 1 y punto es (de_aparato con d y A_PUNTO)
            llego_informe con d y codigo y (de_aparato con d y A_MIDE) menos (como_fue resto 16777216)
        fin
    fin
fin

funcion aparato_de con ranura
    para cada d desde 1 hasta APARATOS
        si (de_aparato con d y A_PUERTO) no es igual a 0 y (de_aparato con d y A_RANURA) es ranura
            devuelve d
        fin
    fin
    devuelve 0
fin

funcion orden con d0 y d3
    comparte orden_pone y orden_ciclo y orden_hecha
    base es orden_pone por 4
    pon con P_ORDENES y base y d0
    pon con P_ORDENES y base mas 1 y 0
    pon con P_ORDENES y base mas 2 y 0
    orden_hecha es falso
    pon con P_ORDENES y base mas 3 y d3 mas orden_ciclo
    orden_pone es orden_pone mas 1
    si orden_pone es TRBS menos 1
        pon con P_ORDENES y (TRBS menos 1) por 4 mas 3 y T_ENLACE mas 2 mas orden_ciclo
        orden_pone es 0
        orden_ciclo es 1 menos orden_ciclo
    fin
    manda con timbres y 0
    limite es ahora mas PACIENCIA
    mientras no orden_hecha
        mira_sucesos
        si no orden_hecha
            si ahora es mayor que limite
                llama_al_sistema con SALIR y 1
            fin
            llama_al_sistema con CEDE y 0
        fin
    fin
    devuelve orden_como
fin

funcion a_la_ranura con ranura
    devuelve ranura por 16777216
fin

funcion pon_trb con d y d0 y d1 y d2 y d3
    p es pagina_de_aparato con d y 1
    sitio es de_aparato con d y A_PONE
    ciclo es de_aparato con d y A_CICLO
    pon con p y sitio por 4 y d0
    pon con p y sitio por 4 mas 1 y d1
    pon con p y sitio por 4 mas 2 y d2
    pon con p y sitio por 4 mas 3 y d3 mas ciclo
    sitio es sitio mas 1
    si sitio es TRBS menos 1
        pon con p y (TRBS menos 1) por 4 y (sitio_de con p)
        pon con p y (TRBS menos 1) por 4 mas 3 y T_ENLACE mas 2 mas ciclo
        sitio es 0
        ciclo es 1 menos ciclo
    fin
    en_aparato con d y A_PONE y sitio
    en_aparato con d y A_CICLO y ciclo
fin

funcion control con d y que y valor y indice y cuantos
    comparte control_de y control_hecho
    es_lectura es (bits con que y 128 y 2) es 1
    sentido es 0
    si cuantos es mayor que 0
        sentido es 131072
        si es_lectura
            sentido es 196608
        fin
    fin
    control_de es d
    control_hecho es falso
    pon_trb con d y que mas valor por 65536 y indice mas cuantos por 65536 y 8 y T_PREPARA mas 64 mas sentido
    vuelta es 65536
    si cuantos es mayor que 0
        pon_trb con d y (sitio_de con P_BANDEJA) y 0 y cuantos y T_DATOS mas 65536
        vuelta es 0
    fin
    pon_trb con d y 0 y 0 y 0 y T_CIERRE mas 32 mas vuelta
    ranura es de_aparato con d y A_RANURA
    manda con timbres mas ranura por 4 y 1
    limite es ahora mas PACIENCIA
    mientras no control_hecho
        mira_sucesos
        si no control_hecho
            si ahora es mayor que limite
                control_de es 0
                devuelve falso
            fin
            llama_al_sistema con CEDE y 0
        fin
    fin
    control_de es 0
    si control_como es BIEN o control_como es MAS_CORTA
        devuelve verdadero
    fin
    hecho es orden con 0 y O_LEVANTA mas 65536 mas (a_la_ranura con ranura)
    si hecho es BIEN
        sitio es (sitio_de con (pagina_de_aparato con d y 1)) mas (de_aparato con d y A_PONE) por 16
        hecho es orden con sitio mas (de_aparato con d y A_CICLO) y O_COLOCA mas 65536 mas (a_la_ranura con ranura)
    fin
    devuelve falso
fin

funcion lee_descriptor con d y cual y cuantos
    para cada i desde 0 hasta 1023
        pon con P_BANDEJA y i y 0
    fin
    devuelve control con d y 128 mas 6 por 256 y cual por 256 y 0 y cuantos
fin

funcion byte_leido con i
    devuelve elemento P_BANDEJA por PAGINA mas i mas 1 de dma_bytes
fin

funcion aparato_libre
    para cada d desde 1 hasta APARATOS
        si (de_aparato con d y A_PUERTO) es 0
            devuelve d
        fin
    fin
    devuelve 0
fin

funcion suelta_aparato con d
    comparte repite_d y pen_d
    ranura es de_aparato con d y A_RANURA
    si d es pen_d
        pen_d es 0
        elemento 4 de buzon es 0
        llama_al_sistema con AVISA_PENDRIVE y pen_puerto y 0
    fin
    si ranura no es igual a 0
        hecho es orden con 0 y O_CIERRA_RANURA mas (a_la_ranura con ranura)
        pon con P_INDICE y ranura por 2 y 0
    fin
    para cada campo desde 1 hasta 24
        en_aparato con d y campo y 0
    fin
    si repite_d es d
        repite_d es 0
    fin
fin

funcion descarta con p y d y por_que
    si d no es igual a 0
        suelta_aparato con d
    fin
    en_puerto con p y Q_APARATO y 0
    en_puerto con p y Q_ESTADO y por_que
fin

funcion en_entrada con contexto y campo y valor
    pon con P_ENTRADA y contexto por contexto_mide mas campo y valor
fin

funcion prepara_contexto con d y p y paquete
    limpia_pagina con P_ENTRADA
    en_entrada con 0 y 1 y 3
    en_entrada con 1 y 0 y 134217728 mas (de_aparato con d y A_VELOCIDAD) por 1048576
    en_entrada con 1 y 1 y p por 65536
    en_entrada con 2 y 1 y 6 mas 32 mas paquete por 65536
    en_entrada con 2 y 2 y (sitio_de con (pagina_de_aparato con d y 1)) mas 1
    en_entrada con 2 y 4 y 8
fin

funcion paquete_bueno con paquete
    devuelve paquete es 8 o paquete es 16 o paquete es 32 o paquete es 64
fin

funcion reinicia_puerto con p
    sitio es sitio_puerto con p
    manda con sitio y BIT_9 mas 16
    limite es ahora mas 50
    mientras (bits con (mira con sitio) y CAMBIO_REINICIO y 2) es 0
        si ahora es mayor que limite
            devuelve falso
        fin
        llama_al_sistema con CEDE y 0
    fin
    manda con sitio y BIT_9 mas CAMBIO_REINICIO
    descansa con 2
    devuelve (bits con (mira con sitio) y 2 y 2) es 1
fin

funcion enumera con p
    d es aparato_libre
    si d es 0
        descarta con p y 0 y NO_CABE
        devuelve nada
    fin
    si (bits con (mira con (sitio_puerto con p)) y 1024 y 16) es mayor que 5
        descarta con p y 0 y ES_OTRO
        devuelve nada
    fin
    si no (reinicia_puerto con p)
        descarta con p y 0 y NO_PUDE
        devuelve nada
    fin
    velocidad es bits con (mira con (sitio_puerto con p)) y 1024 y 16
    si velocidad es menor que 1 o velocidad es mayor que 5
        descarta con p y 0 y ES_OTRO
        devuelve nada
    fin
    si (orden con 0 y O_ABRE_RANURA) no es igual a BIEN
        descarta con p y 0 y NO_PUDE
        devuelve nada
    fin
    ranura es orden_ranura
    si ranura es 0 o ranura es mayor que ranuras
        llama_al_sistema con SALIR y 1
    fin
    para cada cual desde 0 hasta 3
        limpia_pagina con (pagina_de_aparato con d y cual)
    fin
    en_aparato con d y A_PUERTO y p
    en_aparato con d y A_RANURA y ranura
    en_aparato con d y A_VELOCIDAD y velocidad
    en_aparato con d y A_CICLO y 1
    en_aparato con d y A_CICLO_TECLAS y 1
    en_puerto con p y Q_APARATO y d
    pon con P_INDICE y ranura por 2 y (sitio_de con (pagina_de_aparato con d y 0))
    paquete es 8
    si velocidad es 3
        paquete es 64
    si no si velocidad es mayor que 3
        paquete es 512
    fin
    prepara_contexto con d y p y paquete
    si (orden con (sitio_de con P_ENTRADA) y O_DA_DIRECCION mas (a_la_ranura con ranura)) no es igual a BIEN
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    descansa con 2
    si no (lee_descriptor con d y 1 y 8)
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    mejor es byte_leido con 7
    si velocidad es mayor que 3
        mejor es 512
    si no si no (paquete_bueno con mejor)
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    si mejor no es igual a paquete
        limpia_pagina con P_ENTRADA
        en_entrada con 0 y 1 y 2
        en_entrada con 2 y 1 y 6 mas 32 mas mejor por 65536
        en_entrada con 2 y 2 y (sitio_de con (pagina_de_aparato con d y 1)) mas 1
        en_entrada con 2 y 4 y 8
        si (orden con (sitio_de con P_ENTRADA) y O_CORRIGE mas (a_la_ranura con ranura)) no es igual a BIEN
            descarta con p y d y NO_PUDE
            devuelve nada
        fin
    fin
    si no (lee_descriptor con d y 1 y 18)
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    en_puerto con p y Q_QUIEN y ((byte_leido con 9) por 256 mas byte_leido con 8) por 65536 mas (byte_leido con 11) por 256 mas byte_leido con 10
    si no (lee_descriptor con d y 2 y 9)
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    en_total es (byte_leido con 3) por 256 mas byte_leido con 2
    si en_total es menor que 9 o en_total es mayor que 1024
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    si no (lee_descriptor con d y 2 y en_total)
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    si no (busca_teclado con d y en_total)
        prueba_pendrive con p y d y en_total
        devuelve nada
    fin
    si no (enciende_teclado con d)
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    en_puerto con p y Q_ESTADO y ES_TECLADO
    llama_al_sistema con AVISA_TECLADO y p y 1
    pide_informe con d
fin

ajuste es 0
intervalo es 0

funcion busca_teclado con d y en_total
    comparte ajuste y intervalo
    ajuste es byte_leido con 5
    en_el_mio es falso
    i es 0
    mientras i mas 2 es menor o igual que en_total
        largo es byte_leido con i
        clase es byte_leido con i mas 1
        si largo es menor que 2 o i mas largo es mayor que en_total
            devuelve falso
        fin
        si clase es 4 y largo es mayor o igual que 9
            en_el_mio es (byte_leido con i mas 3) es 0 y (byte_leido con i mas 5) es 3 y (byte_leido con i mas 6) es 1 y (byte_leido con i mas 7) es 1
            si en_el_mio
                en_aparato con d y A_INTERFAZ y (byte_leido con i mas 2)
            fin
        si no si en_el_mio y clase es 5 y largo es mayor o igual que 7
            punto es byte_leido con i mas 2
            mide es (byte_leido con i mas 4) mas ((byte_leido con i mas 5) resto 8) por 256
            de_interrupcion es ((byte_leido con i mas 3) resto 4) es 3
            si punto es mayor que 128 y punto es menor que 144 y de_interrupcion y mide es mayor o igual que 8 y mide es menor o igual que 1024
                en_aparato con d y A_PUNTO y (punto menos 128) por 2 mas 1
                en_aparato con d y A_MIDE y mide
                intervalo es byte_leido con i mas 6
                devuelve verdadero
            fin
        fin
        i es i mas largo
    fin
    devuelve falso
fin

funcion busca_pendrive con d y en_total
    comparte ajuste y pen_entra y pen_sale y pen_mide_e y pen_mide_s y pen_rafaga_e y pen_rafaga_s
    ajuste es byte_leido con 5
    pen_entra es 0
    pen_sale es 0
    pen_rafaga_e es 0
    pen_rafaga_s es 0
    en_el_mio es falso
    ultimo es 0
    i es 0
    mientras i mas 2 es menor o igual que en_total
        largo es byte_leido con i
        clase es byte_leido con i mas 1
        si largo es menor que 2 o i mas largo es mayor que en_total
            devuelve falso
        fin
        si clase es 4 y largo es mayor o igual que 9
            si pen_entra no es igual a 0 y pen_sale no es igual a 0
                devuelve verdadero
            fin
            en_el_mio es (byte_leido con i mas 3) es 0 y (byte_leido con i mas 5) es 8 y (byte_leido con i mas 6) es 6 y (byte_leido con i mas 7) es 80
            pen_entra es 0
            pen_sale es 0
            ultimo es 0
            si en_el_mio
                en_aparato con d y A_INTERFAZ y (byte_leido con i mas 2)
            fin
        si no si en_el_mio y clase es 5 y largo es mayor o igual que 7
            punto es byte_leido con i mas 2
            mide es (byte_leido con i mas 4) mas ((byte_leido con i mas 5) resto 8) por 256
            en_bloque es ((byte_leido con i mas 3) resto 4) es 2
            ultimo es 0
            si en_bloque y mide es mayor o igual que 8 y mide es menor o igual que 1024
                si punto es mayor que 128 y punto es menor que 144 y pen_entra es 0
                    pen_entra es (punto menos 128) por 2 mas 1
                    pen_mide_e es mide
                    ultimo es 1
                si no si punto es mayor que 0 y punto es menor que 16 y pen_sale es 0
                    pen_sale es punto por 2
                    pen_mide_s es mide
                    ultimo es 2
                fin
            fin
        si no si en_el_mio y clase es 48 y largo es mayor o igual que 6 y (byte_leido con i mas 2) es menor que 16
            si ultimo es 1
                pen_rafaga_e es byte_leido con i mas 2
            si no si ultimo es 2
                pen_rafaga_s es byte_leido con i mas 2
            fin
            ultimo es 0
        fin
        i es i mas largo
    fin
    devuelve pen_entra no es igual a 0 y pen_sale no es igual a 0
fin

funcion dos_elevado_a con cuanto
    valor es 1
    para cada n desde 1 hasta cuanto
        valor es valor por 2
    fin
    devuelve valor
fin

funcion enciende_pendrive con d
    comparte pen_pone_e y pen_pone_s y pen_ciclo_e y pen_ciclo_s
    pen_pone_e es 0
    pen_pone_s es 0
    pen_ciclo_e es 1
    pen_ciclo_s es 1
    limpia_pagina con P_PEN_ORDEN
    limpia_pagina con P_PEN_DATOS
    limpia_pagina con P_ENTRADA
    mayor_punto es pen_entra
    si pen_sale es mayor que mayor_punto
        mayor_punto es pen_sale
    fin
    en_entrada con 0 y 1 y (dos_elevado_a con pen_entra) mas (dos_elevado_a con pen_sale) mas 1
    mio es pagina_de_aparato con d y 0
    en_entrada con 1 y 0 y ((ve con mio y 0) resto 134217728) mas mayor_punto por 134217728
    en_entrada con 1 y 1 y (ve con mio y 1)
    en_entrada con pen_entra mas 1 y 1 y 6 mas 48 mas pen_rafaga_e por 256 mas pen_mide_e por 65536
    en_entrada con pen_entra mas 1 y 2 y (sitio_de con (pagina_de_aparato con d y 2)) mas 1
    en_entrada con pen_entra mas 1 y 4 y 1024
    en_entrada con pen_sale mas 1 y 1 y 6 mas 16 mas pen_rafaga_s por 256 mas pen_mide_s por 65536
    en_entrada con pen_sale mas 1 y 2 y (sitio_de con (pagina_de_aparato con d y 3)) mas 1
    en_entrada con pen_sale mas 1 y 4 y 1024
    si (orden con (sitio_de con P_ENTRADA) y O_CONFIGURA mas (a_la_ranura con (de_aparato con d y A_RANURA))) no es igual a BIEN
        devuelve falso
    fin
    devuelve control con d y 9 por 256 y ajuste y 0 y 0
fin

funcion pasa_bloque con entrando y direccion y cuantos
    comparte pen_hecho y pen_pide y pen_pone_e y pen_pone_s y pen_ciclo_e y pen_ciclo_s
    p es pagina_de_aparato con pen_d y 3
    sitio es pen_pone_s
    ciclo es pen_ciclo_s
    punto es pen_sale
    si entrando
        p es pagina_de_aparato con pen_d y 2
        sitio es pen_pone_e
        ciclo es pen_ciclo_e
        punto es pen_entra
    fin
    pon con p y sitio por 4 y direccion
    pon con p y sitio por 4 mas 1 y 0
    pon con p y sitio por 4 mas 2 y cuantos
    pen_hecho es falso
    pen_pide es punto
    pon con p y sitio por 4 mas 3 y T_NORMAL mas 36 mas ciclo
    sitio es sitio mas 1
    si sitio es TRBS menos 1
        pon con p y (TRBS menos 1) por 4 y (sitio_de con p)
        pon con p y (TRBS menos 1) por 4 mas 3 y T_ENLACE mas 2 mas ciclo
        sitio es 0
        ciclo es 1 menos ciclo
    fin
    si entrando
        pen_pone_e es sitio
        pen_ciclo_e es ciclo
    si no
        pen_pone_s es sitio
        pen_ciclo_s es ciclo
    fin
    manda con timbres mas (de_aparato con pen_d y A_RANURA) por 4 y punto
    limite es ahora mas PACIENCIA_PEN
    mientras no pen_hecho
        mira_sucesos
        si no pen_hecho
            si ahora es mayor que limite o ((mira con (sitio_puerto con pen_puerto)) resto 2) es 0
                pen_pide es 0
                devuelve SE_ROMPIO
            fin
            llama_al_sistema con CEDE y 0
        fin
    fin
    pen_pide es 0
    si pen_como es BIEN o pen_como es MAS_CORTA
        devuelve cuantos menos pen_sobra
    si no si pen_como es ATASCADO
        devuelve SE_ATASCO
    fin
    devuelve SE_ROMPIO
fin

funcion despega con entrando
    ranura es de_aparato con pen_d y A_RANURA
    punto es pen_sale
    sitio es (sitio_de con (pagina_de_aparato con pen_d y 3)) mas pen_pone_s por 16 mas pen_ciclo_s
    quien es cociente con pen_sale y 2
    si entrando
        punto es pen_entra
        sitio es (sitio_de con (pagina_de_aparato con pen_d y 2)) mas pen_pone_e por 16 mas pen_ciclo_e
        quien es (cociente con pen_entra y 2) mas 128
    fin
    hecho es orden con 0 y O_LEVANTA mas punto por 65536 mas (a_la_ranura con ranura)
    si hecho no es igual a BIEN
        devuelve falso
    fin
    hecho es orden con sitio y O_COLOCA mas punto por 65536 mas (a_la_ranura con ranura)
    si hecho no es igual a BIEN
        devuelve falso
    fin
    devuelve control con pen_d y 2 mas 256 y 0 y quien y 0
fin

funcion en_orden con i y valor
    elemento P_PEN_ORDEN por PAGINA mas i mas 1 de dma_bytes es valor
fin

funcion de_mayor con i y valor y cuantos
    queda es valor
    n es cuantos
    mientras n es mayor que 0
        n es n menos 1
        en_orden con i mas n y queda resto 256
        queda es cociente con queda y 256
    fin
fin

funcion prepara_scsi con cual
    para cada i desde 0 hasta 7
        pon con P_PEN_ORDEN y i y 0
    fin
    en_orden con 15 y cual
fin

funcion scsi con mide y sentido y direccion y cuantos
    comparte pen_marca
    pen_marca es (pen_marca mas 1) resto 65536
    pon con P_PEN_ORDEN y 0 y 1128420181
    pon con P_PEN_ORDEN y 1 y pen_marca
    pon con P_PEN_ORDEN y 2 y cuantos
    si sentido es 1
        en_orden con 12 y 128
    fin
    en_orden con 14 y mide
    para cada i desde 256 hasta 259
        pon con P_PEN_ORDEN y i y 0
    fin
    si (pasa_bloque con falso y (sitio_de con P_PEN_ORDEN) y 31) no es igual a 31
        devuelve SE_ROMPIO
    fin
    si cuantos es mayor que 0
        movidos es pasa_bloque con sentido es 1 y direccion y cuantos
        si movidos es SE_ROMPIO
            devuelve SE_ROMPIO
        fin
        si movidos es SE_ATASCO
            si no (despega con sentido es 1)
                devuelve SE_ROMPIO
            fin
        fin
    fin
    llegan es pasa_bloque con verdadero y (sitio_de con P_PEN_ORDEN) mas 1024 y 13
    si llegan es SE_ATASCO
        si no (despega con verdadero)
            devuelve SE_ROMPIO
        fin
        llegan es pasa_bloque con verdadero y (sitio_de con P_PEN_ORDEN) mas 1024 y 13
    fin
    si llegan no es igual a 13 o (ve con P_PEN_ORDEN y 256) no es igual a 1396855637 o (ve con P_PEN_ORDEN y 257) no es igual a pen_marca
        devuelve SE_ROMPIO
    fin
    salio es (ve con P_PEN_ORDEN y 259) resto 256
    si salio es mayor que 1
        devuelve SE_ROMPIO
    fin
    si salio es 0 y (ve con P_PEN_ORDEN y 258) no es igual a 0
        devuelve 1
    fin
    devuelve salio
fin

funcion pide_por_que
    prepara_scsi con 3
    en_orden con 19 y 18
    devuelve scsi con 6 y 1 y (sitio_de con P_PEN_ORDEN) mas 2048 y 18
fin

funcion sectores_scsi con cual y numero y cuantos
    si numero es menor que 0 o cuantos es menor que 1 o cuantos es mayor que 8 o numero mas cuantos es mayor que pen_sectores
        devuelve 1
    fin
    sentido es 1
    si cual es 42
        sentido es 2
    fin
    para cada intento desde 1 hasta 3
        prepara_scsi con cual
        de_mayor con 17 y numero y 4
        de_mayor con 22 y cuantos y 2
        salio es scsi con 10 y sentido y (sitio_de con P_PEN_DATOS) y cuantos por 512
        si salio es 0 o salio es SE_ROMPIO
            devuelve salio
        fin
        si (pide_por_que) es SE_ROMPIO
            devuelve SE_ROMPIO
        fin
    fin
    devuelve 1
fin

funcion byte_pen con i
    devuelve elemento P_PEN_DATOS por PAGINA mas i mas 1 de dma_bytes
fin

funcion numero_pen con i
    devuelve (byte_pen con i) mas (byte_pen con i mas 1) por 256 mas (byte_pen con i mas 2) por 65536 mas (byte_pen con i mas 3) por 16777216
fin

funcion dice_pen con i y texto
    k es 0
    para cada letra en texto
        si (byte_pen con i mas k) no es igual a letra
            devuelve falso
        fin
        k es k mas 1
    fin
    devuelve verdadero
fin

funcion lee_medida
    comparte pen_sectores
    prepara_scsi con 37
    salio es scsi con 10 y 1 y (sitio_de con P_PEN_DATOS) y 8
    si salio no es igual a 0
        devuelve salio
    fin
    por_sector es ((byte_pen con 4) por 256 mas byte_pen con 5) por 65536 mas (byte_pen con 6) por 256 mas byte_pen con 7
    si por_sector no es igual a 512
        devuelve 1
    fin
    pen_sectores es ((byte_pen con 0) por 256 mas byte_pen con 1) por 65536 mas (byte_pen con 2) por 256 mas (byte_pen con 3) mas 1
    devuelve 0
fin

funcion espera_que_este_listo
    prepara_scsi con 18
    en_orden con 19 y 36
    si (scsi con 6 y 1 y (sitio_de con P_PEN_DATOS) y 36) es SE_ROMPIO
        devuelve falso
    fin
    si (byte_pen con 0) no es igual a 0
        devuelve falso
    fin
    para cada intento desde 1 hasta 50
        prepara_scsi con 0
        salio es scsi con 6 y 0 y 0 y 0
        si salio es 0
            devuelve verdadero
        fin
        si salio es SE_ROMPIO
            devuelve falso
        fin
        si (pide_por_que) es SE_ROMPIO
            devuelve falso
        fin
        descansa con 10
    fin
    devuelve falso
fin

funcion mismo_nombre con i y nombre
    mide es byte_pen con i
    si mide es menor que largo de nombre
        devuelve falso
    fin
    si mide es mayor que largo de nombre
        si (byte_pen con i mas 1 mas largo de nombre) no es igual a 59
            devuelve falso
        fin
    fin
    k es 1
    para cada letra en nombre
        suya es byte_pen con i mas k
        si suya es mayor o igual que 97 y suya es menor o igual que 122
            suya es suya menos 32
        fin
        si suya no es igual a letra
            devuelve falso
        fin
        k es k mas 1
    fin
    devuelve verdadero
fin

funcion busca_en_carpeta con donde y mide y nombre
    comparte hallado_en y hallado_mide
    trozos es cociente con mide mas 2047 y 2048
    si trozos es mayor que 16
        trozos es 16
    fin
    t es 0
    mientras t es menor que trozos
        si (sectores_scsi con 40 y (donde mas t) por 4 y 4) no es igual a 0
            devuelve falso
        fin
        i es 0
        mientras i es menor que 2014
            largo es byte_pen con i
            si largo es menor que 34 o i mas largo es mayor que 2048
                detente
            fin
            si (byte_pen con i mas 32) es mayor que largo menos 33
                detente
            fin
            si mismo_nombre con i mas 32 y nombre
                hallado_en es numero_pen con i mas 2
                hallado_mide es numero_pen con i mas 10
                devuelve verdadero
            fin
            i es i mas largo
        fin
        t es t mas 1
    fin
    devuelve falso
fin

funcion es_el_de_falos
    comparte pen_donde y pen_disco
    si (sectores_scsi con 40 y 64 y 4) no es igual a 0
        devuelve falso
    fin
    si (byte_pen con 0) no es igual a 1 o no (dice_pen con 1 y "CD001")
        devuelve falso
    fin
    si no (busca_en_carpeta con (numero_pen con 158) y (numero_pen con 166) y "BOOT")
        devuelve falso
    fin
    carpeta es hallado_en
    carpeta_mide es hallado_mide
    si no (busca_en_carpeta con carpeta y carpeta_mide y "DISCO.IMG")
        devuelve falso
    fin
    pen_disco es hallado_en por 4
    si hallado_mide es menor que PAGINA
        devuelve falso
    fin
    si no (busca_en_carpeta con carpeta y carpeta_mide y "GUARDADO.IMG")
        devuelve falso
    fin
    pen_donde es hallado_en por 4
    si hallado_mide es menor que PAGINAS_PEN por PAGINA o pen_donde mas PAGINAS_PEN por 8 es mayor que pen_sectores
        devuelve falso
    fin
    si (sectores_scsi con 40 y pen_donde y 8) no es igual a 0
        devuelve falso
    fin
    devuelve dice_pen con 0 y MARCA_PEN
fin

funcion prueba_pendrive con p y d y en_total
    comparte pen_d y pen_puerto
    si pen_d no es igual a 0
        descarta con p y d y ES_OTRO
        devuelve nada
    fin
    si no (busca_pendrive con d y en_total)
        descarta con p y d y ES_OTRO
        devuelve nada
    fin
    si no (enciende_pendrive con d)
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    pen_d es d
    pen_puerto es p
    si no espera_que_este_listo
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    salio es lee_medida
    si salio es 1
        si (pide_por_que) no es igual a SE_ROMPIO
            salio es lee_medida
        fin
    fin
    si salio no es igual a 0
        descarta con p y d y ES_AJENO
        devuelve nada
    fin
    si no es_el_de_falos
        descarta con p y d y ES_AJENO
        devuelve nada
    fin
    elemento 4 de buzon es pen_sectores
    en_puerto con p y Q_ESTADO y ES_PENDRIVE
    llama_al_sistema con AVISA_PENDRIVE y p y 1
fin

funcion pierde_pendrive
    comparte pen_caidas
    p es pen_puerto
    d es pen_d
    pen_caidas es pen_caidas mas 1
    si pen_caidas es menor que 4
        descarta con p y d y VACIO
        en_puerto con p y Q_VISTO y ahora mas 1
    si no
        descarta con p y d y NO_PUDE
    fin
fin

funcion asienta_pendrive
    prepara_scsi con 53
    salio es scsi con 10 y 0 y 0 y 0
    si salio no es igual a 1
        devuelve salio
    fin
    si (pide_por_que) es SE_ROMPIO
        devuelve SE_ROMPIO
    fin
    si ((elemento P_PEN_ORDEN por PAGINA mas 2051 de dma_bytes) resto 16) es 5
        devuelve 0
    fin
    devuelve 1
fin

funcion atiende_pendrive con pedido
    comparte pen_caidas
    si pen_d es 0
        devuelve SE_ROMPIO
    fin
    salio es 1
    si pedido es PIDE_ASIENTA
        salio es asienta_pendrive
    si no si pedido es PIDE_DISCO
        salio es sectores_scsi con 40 y pen_disco y 8
    si no si pedido es mayor o igual que PIDE_LEE y pedido es menor que PIDE_LEE mas PAGINAS_PEN
        salio es sectores_scsi con 40 y pen_donde mas (pedido menos PIDE_LEE) por 8 y 8
    si no si pedido es mayor que PIDE_ESCRIBE y pedido es menor que PIDE_ESCRIBE mas PAGINAS_PEN
        salio es sectores_scsi con 42 y pen_donde mas (pedido menos PIDE_ESCRIBE) por 8 y 8
    fin
    si salio es SE_ROMPIO
        pierde_pendrive
    si no si salio es 0
        pen_caidas es 0
    fin
    devuelve salio
fin

funcion intervalo_de con velocidad
    si velocidad es 3
        si intervalo es menor que 1
            devuelve 0
        si no si intervalo es mayor que 16
            devuelve 15
        fin
        devuelve intervalo menos 1
    fin
    exponente es 3
    cuanto es intervalo
    mientras cuanto es mayor o igual que 2 y exponente es menor que 10
        cuanto es cociente con cuanto y 2
        exponente es exponente mas 1
    fin
    devuelve exponente
fin

funcion enciende_teclado con d
    ranura es de_aparato con d y A_RANURA
    punto es de_aparato con d y A_PUNTO
    mide es de_aparato con d y A_MIDE
    limpia_pagina con P_ENTRADA
    alta es 1
    para cada n desde 1 hasta punto
        alta es alta por 2
    fin
    en_entrada con 0 y 1 y alta mas 1
    mio es pagina_de_aparato con d y 0
    en_entrada con 1 y 0 y ((ve con mio y 0) resto 134217728) mas punto por 134217728
    en_entrada con 1 y 1 y (ve con mio y 1)
    en_entrada con punto mas 1 y 0 y (intervalo_de con (de_aparato con d y A_VELOCIDAD)) por 65536
    en_entrada con punto mas 1 y 1 y 6 mas 56 mas mide por 65536
    en_entrada con punto mas 1 y 2 y (sitio_de con (pagina_de_aparato con d y 2)) mas 1
    en_entrada con punto mas 1 y 4 y mide mas mide por 65536
    si (orden con (sitio_de con P_ENTRADA) y O_CONFIGURA mas (a_la_ranura con ranura)) no es igual a BIEN
        devuelve falso
    fin
    si no (control con d y 9 por 256 y ajuste y 0 y 0)
        devuelve falso
    fin
    si no (control con d y 33 mas 11 por 256 y 0 y (de_aparato con d y A_INTERFAZ) y 0)
        devuelve falso
    fin
    callado es control con d y 33 mas 10 por 256 y 0 y (de_aparato con d y A_INTERFAZ) y 0
    devuelve verdadero
fin

funcion pide_informe con d
    p es pagina_de_aparato con d y 2
    sitio es de_aparato con d y A_PONE_TECLAS
    ciclo es de_aparato con d y A_CICLO_TECLAS
    pon con p y sitio por 4 y (sitio_de con (pagina_de_aparato con d y 3))
    pon con p y sitio por 4 mas 1 y 0
    pon con p y sitio por 4 mas 2 y (de_aparato con d y A_MIDE)
    pon con p y sitio por 4 mas 3 y T_NORMAL mas 36 mas ciclo
    sitio es sitio mas 1
    si sitio es TRBS menos 1
        pon con p y (TRBS menos 1) por 4 y (sitio_de con p)
        pon con p y (TRBS menos 1) por 4 mas 3 y T_ENLACE mas 2 mas ciclo
        sitio es 0
        ciclo es 1 menos ciclo
    fin
    en_aparato con d y A_PONE_TECLAS y sitio
    en_aparato con d y A_CICLO_TECLAS y ciclo
    manda con timbres mas (de_aparato con d y A_RANURA) por 4 y (de_aparato con d y A_PUNTO)
fin

funcion llego_informe con d y codigo y cuantos
    si codigo no es igual a BIEN y codigo no es igual a MAS_CORTA
        en_aparato con d y A_ROTO y codigo
        devuelve nada
    fin
    en_aparato con d y A_FALLOS y 0
    si cuantos es mayor o igual que 8
        lee_informe con d
    fin
    pide_informe con d
fin

funcion arregla con d
    ranura es de_aparato con d y A_RANURA
    punto es de_aparato con d y A_PUNTO
    en_aparato con d y A_ROTO y 0
    en_aparato con d y A_FALLOS y (de_aparato con d y A_FALLOS) mas 1
    si (de_aparato con d y A_FALLOS) es mayor que 5
        p es de_aparato con d y A_PUERTO
        llama_al_sistema con AVISA_TECLADO y p y 0
        descarta con p y d y NO_PUDE
        devuelve nada
    fin
    hecho es orden con 0 y O_LEVANTA mas punto por 65536 mas (a_la_ranura con ranura)
    sitio es (sitio_de con (pagina_de_aparato con d y 2)) mas (de_aparato con d y A_PONE_TECLAS) por 16
    hecho es orden con sitio mas (de_aparato con d y A_CICLO_TECLAS) y O_COLOCA mas punto por 65536 mas (a_la_ranura con ranura)
    si hecho es BIEN
        desatascado es control con d y 2 mas 256 y 0 y (cociente con (punto menos 1) y 2) mas 128 y 0
        pide_informe con d
    si no
        en_aparato con d y A_ROTO y ATASCADO
    fin
fin

funcion lee_informe con d
    comparte repite_d y repite_tecla y repite_en
    base es (pagina_de_aparato con d y 3) por PAGINA
    si (elemento base mas 3 de dma_bytes) es 1
        devuelve nada
    fin
    modos es elemento base mas 1 de dma_bytes
    si repite_d es d y no (esta_en con base mas 3 y repite_tecla)
        repite_d es 0
    fin
    para cada k desde 0 hasta 5
        tecla es elemento base mas 3 mas k de dma_bytes
        si tecla es mayor que 3 y no (estaba con d y tecla)
            pulsa con d y tecla y modos
            repite_d es d
            repite_tecla es tecla
            repite_en es ahora mas 50
        fin
    fin
    para cada k desde 0 hasta 5
        en_aparato con d y A_ANTES mas k y (elemento base mas 3 mas k de dma_bytes)
    fin
    en_aparato con d y A_ANTES mas 6 y modos
fin

funcion esta_en con sitio y tecla
    para cada k desde 0 hasta 5
        si (elemento sitio mas k de dma_bytes) es tecla
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion estaba con d y tecla
    para cada k desde 0 hasta 5
        si (de_aparato con d y A_ANTES mas k) es tecla
            devuelve verdadero
        fin
    fin
    devuelve falso
fin

funcion codigo_de_letra con letra
    para cada i desde 1 hasta largo de teclas_solas
        si (elemento i de teclas_solas) es letra
            devuelve i menos 1
        fin
    fin
    devuelve 0
fin

funcion codigo_de con tecla
    si tecla es mayor o igual que 4 y tecla es menor o igual que 29
        devuelve codigo_de_letra con tecla mas 93
    si no si tecla es mayor o igual que 30 y tecla es menor o igual que 38
        devuelve tecla menos 28
    si no si tecla es 39
        devuelve 11
    si no si tecla es 44
        devuelve 57
    si no si tecla es 45 o tecla es 46
        devuelve tecla menos 33
    si no si tecla es 47 o tecla es 48
        devuelve tecla menos 21
    si no si tecla es 49 o tecla es 50
        devuelve 43
    si no si tecla es mayor o igual que 51 y tecla es menor o igual que 53
        devuelve tecla menos 12
    si no si tecla es mayor o igual que 54 y tecla es menor o igual que 56
        devuelve tecla menos 3
    si no si tecla es 100
        devuelve 86
    fin
    devuelve 0
fin

funcion especial con tecla
    si tecla es 40 o tecla es 88
        devuelve TECLA_INTRO
    si no si tecla es 41
        devuelve TECLA_ESCAPE
    si no si tecla es 42
        devuelve TECLA_BORRA
    si no si tecla es 74
        devuelve TECLA_INICIO
    si no si tecla es 76
        devuelve TECLA_SUPRIME
    si no si tecla es 77
        devuelve TECLA_FIN
    si no si tecla es 79
        devuelve TECLA_DERECHA
    si no si tecla es 80
        devuelve TECLA_IZQUIERDA
    si no si tecla es 81
        devuelve TECLA_ABAJO
    si no si tecla es 82
        devuelve TECLA_ARRIBA
    fin
    devuelve 0
fin

funcion del_numerico con tecla
    si tecla es mayor o igual que 89 y tecla es menor o igual que 97
        devuelve tecla menos 40
    si no si tecla es 98
        devuelve 48
    si no si tecla es 84
        devuelve 47
    si no si tecla es 85
        devuelve 42
    si no si tecla es 86
        devuelve 45
    si no si tecla es 87
        devuelve 43
    si no si tecla es 99
        devuelve 46
    fin
    devuelve 0
fin

funcion da_tecla con d y c
    si c no es igual a 0
        llama_al_sistema con ENTREGA y c y (de_aparato con d y A_PUERTO)
    fin
fin

funcion escribe_letra con d y c
    si c no es igual a 0
        cual es de_aparato con d y A_TILDE
        en_aparato con d y A_TILDE y 0
        da_tecla con d y (con_tilde con c y cual)
    fin
fin

funcion pulsa con d y tecla y modos
    mayus es (bits con modos y 2 y 2) es 1 o (bits con modos y 32 y 2) es 1
    control_puesto es (modos resto 2) es 1 o (bits con modos y 16 y 2) es 1
    altgr es (bits con modos y 64 y 2) es 1
    bloq es (de_aparato con d y A_BLOQ) es 1
    codigo es codigo_de con tecla
    si tecla es 57
        en_aparato con d y A_BLOQ y 1 menos (de_aparato con d y A_BLOQ)
    si no si (especial con tecla) no es igual a 0
        da_tecla con d y (especial con tecla)
    si no si control_puesto
        si tecla es 6
            da_tecla con d y TECLA_COPIA
        si no si tecla es 25
            da_tecla con d y TECLA_PEGA
        fin
    si no si (del_numerico con tecla) no es igual a 0
        escribe_letra con d y (del_numerico con tecla)
    si no si altgr
        escribe_letra con d y (con_altgr con codigo)
    si no si codigo es 40
        si mayus
            en_aparato con d y A_TILDE y 2
        si no
            en_aparato con d y A_TILDE y 1
        fin
    si no si codigo no es igual a 0
        escribe_letra con d y (letra_de con codigo y mayus y bloq)
    fin
fin

funcion repite_la_tecla
    comparte repite_en
    si repite_d es 0
        devuelve nada
    fin
    si ahora es menor que repite_en
        devuelve nada
    fin
    repite_en es ahora mas 3
    si repite_tecla no es igual a 57
        pulsa con repite_d y repite_tecla y (de_aparato con repite_d y A_ANTES mas 6)
    fin
fin

funcion se_fue con p
    comparte pen_caidas
    si p es pen_puerto
        pen_caidas es 0
    fin
    si (de_puerto con p y Q_ESTADO) es ES_TECLADO
        llama_al_sistema con AVISA_TECLADO y p y 0
    fin
    descarta con p y (de_puerto con p y Q_APARATO) y VACIO
    en_puerto con p y Q_QUIEN y 0
    en_puerto con p y Q_VISTO y 0
fin

funcion mira_puerto con p
    sitio es sitio_puerto con p
    visto es mira con sitio
    si (bits con visto y BIT_9 y 2) es 0
        manda con sitio y BIT_9
        devuelve nada
    fin
    si (bits con visto y CAMBIO_CONEXION y 128) no es igual a 0
        manda con sitio y BIT_9 mas (visto resto 16777216) menos (visto resto CAMBIO_CONEXION)
        si (bits con visto y CAMBIO_CONEXION y 2) es 1 y (de_puerto con p y Q_VISTO) no es igual a 0
            se_fue con p
        fin
    fin
    si (visto resto 2) es 0
        si (de_puerto con p y Q_VISTO) no es igual a 0
            se_fue con p
        fin
    si no si (de_puerto con p y Q_VISTO) es 0
        en_puerto con p y Q_VISTO y ahora mas 1
    si no si (de_puerto con p y Q_ESTADO) es VACIO y ahora es mayor o igual que (de_puerto con p y Q_VISTO) mas 10
        enumera con p
    fin
fin

funcion mira_puertos
    comparte proxima_mirada
    si ahora es menor que proxima_mirada
        devuelve nada
    fin
    proxima_mirada es ahora mas 10
    p es 1
    mientras p es menor o igual que puertos
        mira_puerto con p
        p es p mas 1
    fin
fin

funcion arregla_los_rotos
    para cada d desde 1 hasta APARATOS
        si (de_aparato con d y A_PUERTO) no es igual a 0 y (de_aparato con d y A_ROTO) no es igual a 0
            visto es mira con (sitio_puerto con (de_aparato con d y A_PUERTO))
            si (visto resto 2) es 1 y (bits con visto y CAMBIO_CONEXION y 2) es 0
                arregla con d
            fin
        fin
    fin
fin

funcion roba_memoria
    manda con op y 0
    parado es espera_registro con op mas 4 y 1 y 1
    apunta_a con op mas 24 y 1048577
    manda con op y 1
    manda con timbres y 0
fin

funcion atiende_aviso con aviso
    si aviso es AVISO_CUELGA
        mientras verdadero
        fin
    si no si aviso es AVISO_ROMPE
        roba_memoria
    si no si aviso es mayor o igual que PIDE_LEE
        devuelve atiende_pendrive con aviso
    fin
    devuelve SIN_RESPUESTA
fin

estado es arranca
elemento 2 de buzon es estado
respuesta es SIN_RESPUESTA
mientras verdadero
    si estado es EN_MARCHA
        mira_sucesos
        mira_puertos
        arregla_los_rotos
        repite_la_tecla
    fin
    respuesta es atiende_aviso con (llama_al_sistema con ESPERA y respuesta)
fin
