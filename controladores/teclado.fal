ESPERA es 8
ENTREGA es 9
ENTREGA_RATON es 10
AVISO_TECLA es 1
AVISO_RATON es 2
DATOS es 96
AVISO_CUELGA es 0 menos 2
AVISO_ROMPE es 0 menos 3
SIN_RESPUESTA es 0 menos 100

TECLA_INTRO es 256
TECLA_BORRA es 257
TECLA_IZQUIERDA es 258
TECLA_DERECHA es 259
TECLA_INICIO es 260
TECLA_FIN es 261
TECLA_SUPRIME es 262
TECLA_ARRIBA es 263
TECLA_ABAJO es 264

TECLAS es "~~1234567890'~~~qwertyuiop~+~~asdfghjkl~~~~~zxcvbnm,.-~*~ "
TECLAS_MAYUS es "~~!\"~$%&/()=?~~~QWERTYUIOP~*~~ASDFGHJKL~~~~~ZXCVBNM;:_~*~ "

mayus es falso
bloq_mayus es falso
tilde es 0
altgr es falso
prefijo es falso
recibidos es 0
primero es 0
segundo es 0

funcion manda con c
    si c no es igual a 0
        llama_al_sistema con ENTREGA y c
    fin
fin

funcion teclea con c
    comparte tilde
    si c no es igual a 0
        si tilde no es igual a 0
            c es con_tilde con c
            tilde es 0
        fin
        manda con c
    fin
fin

funcion atiende con codigo
    comparte mayus y bloq_mayus y prefijo
    extendida es prefijo
    prefijo es falso
    si codigo es 224
        prefijo es verdadero
    si no si extendida
        atiende_extendida con codigo
    si no si codigo es 42 o codigo es 54
        mayus es verdadero
    si no si codigo es 170 o codigo es 182
        mayus es falso
    si no si codigo es 58
        bloq_mayus es no bloq_mayus
    si no si codigo es 28
        manda con TECLA_INTRO
    si no si codigo es 14
        manda con TECLA_BORRA
    si no si altgr
        si codigo es menor que 128
            teclea con (con_altgr con codigo)
        fin
    si no si codigo es 40
        pon_tilde
    si no si codigo es menor que 128
        teclea con (letra_de con codigo)
    fin
fin

funcion atiende_extendida con codigo
    comparte altgr
    si codigo es 56
        altgr es verdadero
    si no si codigo es 184
        altgr es falso
    si no si codigo es 28
        manda con TECLA_INTRO
    si no si codigo es 53
        teclea con 47
    si no si codigo es 75
        manda con TECLA_IZQUIERDA
    si no si codigo es 77
        manda con TECLA_DERECHA
    si no si codigo es 71
        manda con TECLA_INICIO
    si no si codigo es 79
        manda con TECLA_FIN
    si no si codigo es 83
        manda con TECLA_SUPRIME
    si no si codigo es 72
        manda con TECLA_ARRIBA
    si no si codigo es 80
        manda con TECLA_ABAJO
    fin
fin

funcion con_altgr con codigo
    si codigo es 2
        devuelve 124
    si no si codigo es 3
        devuelve 64
    si no si codigo es 4
        devuelve 35
    si no si codigo es 5
        devuelve 126
    si no si codigo es 7
        devuelve 170
    si no si codigo es 26
        devuelve 91
    si no si codigo es 27
        devuelve 93
    si no si codigo es 40
        devuelve 123
    si no si codigo es 41
        devuelve 92
    si no si codigo es 43
        devuelve 125
    fin
    devuelve 0
fin

funcion pon_tilde
    comparte tilde
    si mayus
        tilde es 2
    si no
        tilde es 1
    fin
fin

funcion es_letra con c
    devuelve c es mayor o igual que 97 y c es menor o igual que 122
fin

funcion letra_de con codigo
    grande es mayus no es igual a bloq_mayus
    si codigo es 13
        si mayus
            devuelve 168
        fin
        devuelve 173
    fin
    si codigo es 39
        si grande
            devuelve 165
        fin
        devuelve 164
    fin
    si codigo es 43
        si grande
            devuelve 128
        fin
        devuelve 135
    fin
    si codigo es 41
        si mayus
            devuelve 166
        fin
        devuelve 167
    fin
    si codigo es 4 y mayus
        devuelve 250
    fin
    si codigo es mayor que 57
        devuelve 0
    fin
    letra es elemento codigo mas 1 de TECLAS
    si es_letra con letra
        si grande
            devuelve letra menos 32
        fin
        devuelve letra
    fin
    si mayus
        letra es elemento codigo mas 1 de TECLAS_MAYUS
    fin
    si letra es 126
        devuelve 0
    fin
    devuelve letra
fin

funcion con_tilde con c
    si tilde es 1
        si c es 97
            devuelve 160
        si no si c es 101
            devuelve 130
        si no si c es 105
            devuelve 161
        si no si c es 111
            devuelve 162
        si no si c es 117
            devuelve 163
        si no si c es 69
            devuelve 144
        si no si c es 32
            devuelve 39
        fin
    si no si tilde es 2
        si c es 117
            devuelve 129
        si no si c es 85
            devuelve 154
        si no si c es 32
            devuelve 34
        fin
    fin
    devuelve c
fin

funcion del_raton con byte
    comparte recibidos y primero y segundo
    si recibidos es 0
        si ((cociente con byte y 8) resto 2) es 1
            primero es byte
            recibidos es 1
        fin
    si no si recibidos es 1
        segundo es byte
        recibidos es 2
    si no
        recibidos es 0
        si primero es menor que 64
            dx es segundo
            si ((cociente con primero y 16) resto 2) es 1
                dx es dx menos 256
            fin
            dy es byte
            si ((cociente con primero y 32) resto 2) es 1
                dy es dy menos 256
            fin
            llama_al_sistema con ENTREGA_RATON y (dx mas 256) y (((dy mas 256) por 8) mas (primero resto 8))
        fin
    fin
fin

aviso es llama_al_sistema con ESPERA y SIN_RESPUESTA
mientras verdadero
    si aviso es AVISO_CUELGA
        mientras verdadero
        fin
    si no si aviso es AVISO_ROMPE
        pon_en_puerto con 100 y 254
    si no si aviso es AVISO_TECLA
        atiende con (lee_puerto de DATOS)
    si no si aviso es AVISO_RATON
        del_raton con (lee_puerto de DATOS)
    fin
    aviso es llama_al_sistema con ESPERA y SIN_RESPUESTA
fin
